@using System.Security.Claims
@using System.Text.Json
@inject ApptechDashboard.Services.ISidebarMenuService SidebarMenuService
@{
    var menuItems = await SidebarMenuService.GetMenuAsync();
    var currentPath = Context.Request.Path.Value ?? "/";
    var pageTitle = ViewData["Title"]?.ToString() ?? "Dashboard";
    var breadcrumb = ViewData["Breadcrumb"]?.ToString() ?? "Trang chủ / Dashboard";
    var displayName = User.FindFirstValue("display_name") ?? User.Identity?.Name ?? "Tài khoản";
    var roleLabel = User.FindFirstValue("role_label") ?? "Người dùng hệ thống";
    var avatarUrl = User.FindFirstValue("avatar_url");
    var avatarText = User.FindFirstValue("initials")
        ?? (!string.IsNullOrWhiteSpace(displayName)
            ? displayName[..1].ToUpperInvariant()
            : "U");
    var menuJson = JsonSerializer.Serialize(menuItems, new JsonSerializerOptions
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase
    });
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#099a74" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Apptech Dashboard" />
    <title>@pageTitle - Apptech Dashboard</title>
    <link rel="icon" type="image/png" href="~/images/apptech-logo-512.png" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/images/apptech-logo-512.png" asp-append-version="true" />
    <link rel="manifest" href="~/manifest.webmanifest" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    @await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body data-current-path="@currentPath">
    <div class="app-shell">
        <header class="topbar">
            <div class="topbar-left">
                <a class="brand brand-link" href="/trang-chu">
                    <div class="brand-mark">
                        <img src="~/images/apptech-logo-512.png" alt="Apptech logo" class="brand-logo" />
                    </div>
                    <div class="brand-copy">
                        <div class="brand-title">Apptech</div>
                        <div class="brand-subtitle">Smart Dashboard</div>
                    </div>
                </a>

                <button type="button"
                        class="menu-launcher"
                        data-menu-trigger
                        aria-haspopup="dialog"
                        aria-expanded="false"
                        aria-controls="appMenuPopup">
                    <i class="fa-solid fa-bars-staggered" aria-hidden="true"></i>
                    <span>Menu</span>
                </button>
            </div>

            <div class="topbar-actions">
                <button type="button"
                        class="topbar-utility-button"
                        data-qr-lookup-trigger
                        aria-haspopup="dialog"
                        aria-expanded="false"
                        aria-controls="qrLookupPopup"
                        aria-label="Quét QR để tra cứu vật tư">
                    <img src="~/images/qr-scan-icon.svg" alt="" class="qr-scan-icon qr-scan-icon-topbar" />
                </button>

                <button type="button" class="user-card" data-account-trigger aria-haspopup="dialog" aria-expanded="false" aria-controls="accountMenuPopup">
                    <div class="avatar">
                        @if (!string.IsNullOrWhiteSpace(avatarUrl))
                        {
                            <img src="@avatarUrl" alt="Avatar người dùng" class="avatar-image" />
                        }
                        else
                        {
                            <span>@avatarText</span>
                        }
                    </div>
                    <div>
                        <div class="user-name">@displayName</div>
                        <div class="user-role">@roleLabel</div>
                    </div>
                </button>
            </div>
        </header>

        <div class="menu-popup-shell account-popup-shell" data-account-popup-shell hidden>
            <div class="menu-popup-backdrop" aria-hidden="true"></div>

            <section class="menu-popup account-popup-modal" id="accountMenuPopup" role="dialog" aria-modal="true" aria-label="Thông tin tài khoản">
                <div class="menu-popup-header">
                    <div class="menu-popup-heading">
                        <div class="menu-popup-eyebrow">Tài khoản</div>
                        <div class="menu-popup-title">Thông tin tài khoản</div>
                    </div>

                    <button type="button" class="menu-nav-button" data-account-close aria-label="Đóng menu tài khoản">
                        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                    </button>
                </div>

                <div class="account-popup-actions">
                    <a class="account-popup-item" href="/tai-khoan/cap-nhat">
                        <span class="account-popup-item-icon"><i class="fa-solid fa-user-pen" aria-hidden="true"></i></span>
                        <span class="account-popup-item-label">Cập nhật tài khoản</span>
                    </a>
                    <a class="account-popup-item danger" href="/dang-xuat-he-thong">
                        <span class="account-popup-item-icon"><i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i></span>
                        <span class="account-popup-item-label">Đăng xuất hệ thống</span>
                    </a>
                </div>
            </section>
        </div>

        <div class="menu-popup-shell qr-lookup-popup-shell" data-qr-lookup-popup-shell hidden>
            <div class="menu-popup-backdrop" aria-hidden="true"></div>

            <section class="menu-popup qr-lookup-popup-modal" id="qrLookupPopup" role="dialog" aria-modal="true" aria-label="Tra cứu vật tư bằng QR">
                <div class="menu-popup-header qr-lookup-popup-header">
                    <div class="menu-popup-heading">
                        <div class="menu-popup-title">Tra cứu vật tư bằng QR</div>
                    </div>

                    <button type="button" class="menu-nav-button" data-qr-lookup-close aria-label="Đóng popup scan QR">
                        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                    </button>
                </div>

                <div class="qr-scanner-shell qr-lookup-scanner-shell" data-global-qr-lookup>
                    <input type="hidden" data-global-qr-result />

                    <div class="qr-display-card is-empty qr-lookup-display-card">
                        <div class="qr-display-default qr-lookup-default" data-global-qr-default>
                            <div class="qr-display-icon qr-lookup-icon">
                                <img src="~/images/qr-scan-icon.svg" alt="" class="qr-scan-icon qr-scan-icon-popup" />
                            </div>
                        </div>

                        <div class="qr-scanner-panel qr-lookup-panel" data-global-qr-panel hidden>
                            <div class="qr-scanner-reader" data-global-qr-reader></div>
                            <div class="qr-scanner-frame" aria-hidden="true"></div>
                        </div>
                    </div>

                    <div class="qr-scanner-status qr-lookup-status" data-global-qr-status>
                        Sẵn sàng quét QR để tra cứu vật tư trên hệ thống.
                    </div>

                    <div class="qr-scanner-actions qr-lookup-actions">
                        <button type="button" class="secondary-button qr-scanner-button" data-global-qr-start>
                            <i class="fa-solid fa-camera" aria-hidden="true"></i>
                            <span>Quét camera</span>
                        </button>

                        <label class="secondary-button qr-scanner-button qr-file-button" for="globalQrImageFile">
                            <i class="fa-regular fa-image" aria-hidden="true"></i>
                            <span>Quét từ ảnh</span>
                        </label>

                        <button type="button" class="secondary-button qr-scanner-button" data-global-qr-stop hidden>
                            <i class="fa-solid fa-stop" aria-hidden="true"></i>
                            <span>Dừng quét</span>
                        </button>

                        <div class="qr-camera-select-shell" data-global-qr-camera-shell hidden>
                            <span class="login-input-shell select-shell">
                                <i class="fa-solid fa-camera-rotate" aria-hidden="true"></i>
                                <select data-global-qr-camera></select>
                                <span class="select-indicator"><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></span>
                            </span>
                        </div>

                        <input type="file"
                               id="globalQrImageFile"
                               accept="image/*"
                               hidden
                               data-global-qr-file />
                    </div>
                </div>
            </section>
        </div>

        <div class="menu-popup-shell" data-menu-popup hidden>
            <div class="menu-popup-backdrop" aria-hidden="true"></div>

            <section class="menu-popup" id="appMenuPopup" role="dialog" aria-modal="true" aria-label="Menu điều hướng">
                <div class="menu-popup-header">
                    <button type="button" class="menu-nav-button" data-menu-back hidden aria-label="Quay lại menu trước">
                        <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
                    </button>

                    <div class="menu-popup-heading">
                        <div class="menu-popup-eyebrow">Điều hướng</div>
                        <div class="menu-popup-title" data-menu-title>Menu chính</div>
                    </div>

                    <button type="button" class="menu-nav-button" data-menu-close aria-label="Đóng menu">
                        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                    </button>
                </div>

                <div class="menu-grid-viewport" data-menu-viewport>
                    <div class="menu-grid" data-menu-grid></div>
                </div>
            </section>
        </div>

        <div class="main-panel">
            <section class="page-overview">
                <div class="crumbs">@breadcrumb</div>
                <h1 class="page-title">@pageTitle</h1>
            </section>

            <main class="content-area">
                @RenderBody()
            </main>
        </div>
    </div>

    <script id="menu-data" type="application/json">@Html.Raw(menuJson)</script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
