@model CongViecReportViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Báo cáo công việc";
    ViewData["Breadcrumb"] = "Trang chủ / Báo cáo / Công việc";

    var selectedEmployeeIds = Model.SelectedEmployeeIds.ToHashSet();
    var detailPayload = Model.Details.Select(item => new
    {
        item.EmployeeId,
        statusGroup = item.IsCompleted ? "completed" : "incomplete",
        item.MaYeuCau,
        item.TenKhachHang,
        item.DiaDiem,
        ngayYeuCau = item.NgayYeuCau?.ToString("dd/MM/yyyy"),
        item.TenCongViec,
        item.TrangThaiCongViec,
        detailUrl = Url.Action("Edit", "YeuCau", new { id = item.YeuCauId }) ?? "#"
    });
    var detailJson = JsonSerializer.Serialize(detailPayload, new JsonSerializerOptions
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase
    });
}

<section class="master-data-page cong-viec-report-page" data-work-report>
    <article class="panel master-data-panel cham-cong-report-panel">
        <div class="panel-header master-data-header">
            <div>
                <h3>Báo cáo công việc</h3>
                <p>Theo dõi công việc hoàn thành và chưa hoàn thành theo thời gian, nhân viên.</p>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
        {
            <div class="page-alert @Model.StatusType master-data-status-alert">
                @Model.StatusMessage
            </div>
        }

        <form method="get" asp-action="CongViec" class="master-data-filter-form cham-cong-report-filter">
            <label class="master-data-filter-field" for="dateFrom">
                <span>Từ ngày</span>
                <span class="login-input-shell">
                    <i class="fa-solid fa-calendar-day" aria-hidden="true"></i>
                    <input id="dateFrom" name="dateFrom" type="date" value="@Model.DateFrom.ToString("yyyy-MM-dd")" />
                </span>
            </label>

            <label class="master-data-filter-field" for="dateTo">
                <span>Đến ngày</span>
                <span class="login-input-shell">
                    <i class="fa-solid fa-calendar-check" aria-hidden="true"></i>
                    <input id="dateTo" name="dateTo" type="date" value="@Model.DateTo.ToString("yyyy-MM-dd")" />
                </span>
            </label>

            <div class="master-data-filter-field cham-cong-report-employee-filter" data-report-employee-picker>
                <span>Nhân viên</span>
                <button type="button"
                        class="login-input-shell cham-cong-report-employee-button"
                        data-report-employee-toggle
                        aria-expanded="false">
                    <i class="fa-solid fa-users" aria-hidden="true"></i>
                    <span data-report-employee-summary>@(Model.AllEmployeesSelected ? "Tất cả nhân viên" : $"{Model.SelectedEmployeeIds.Count} nhân viên")</span>
                    <span class="select-indicator"><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></span>
                </button>
                <div class="cham-cong-report-employee-menu" data-report-employee-menu hidden>
                    <label class="cham-cong-report-employee-choice cham-cong-report-employee-choice-all">
                        <input type="checkbox" data-report-employee-all checked="@Model.AllEmployeesSelected" />
                        <span>Tất cả nhân viên</span>
                    </label>
                    @foreach (var employee in Model.EmployeeOptions)
                    {
                        var isChecked = Model.AllEmployeesSelected || selectedEmployeeIds.Contains(employee.EmployeeId);
                        <label class="cham-cong-report-employee-choice">
                            <input type="checkbox"
                                   name="EmployeeIds"
                                   value="@employee.EmployeeId"
                                   data-report-employee-checkbox
                                   checked="@isChecked" />
                            <span>@employee.DisplayText</span>
                        </label>
                    }
                </div>
            </div>

            <div class="master-data-filter-actions">
                <button type="submit" class="primary-button master-data-filter-button">
                    <span class="button-content">
                        <i class="fa-solid fa-filter" aria-hidden="true"></i>
                        <span>Xem báo cáo</span>
                    </span>
                </button>
                <a class="secondary-button master-data-reset-button" asp-action="CongViec">30 ngày gần nhất</a>
            </div>
        </form>

        <div class="work-report-summary">
            <button type="button" class="work-report-summary-card completed" data-report-detail-open data-employee-id="0" data-status-group="completed">
                <span>Đã hoàn thành</span>
                <strong>@Model.TotalCompleted</strong>
            </button>
            <button type="button" class="work-report-summary-card incomplete" data-report-detail-open data-employee-id="0" data-status-group="incomplete">
                <span>Chưa hoàn thành</span>
                <strong>@Model.TotalIncomplete</strong>
            </button>
        </div>

        <div class="table-wrap cham-cong-report-wrap">
            <table class="data-table master-data-table work-report-table">
                <thead>
                    <tr>
                        <th>TT</th>
                        <th>Nhân viên</th>
                        <th>Chức vụ</th>
                        <th>Đã hoàn thành</th>
                        <th>Chưa hoàn thành</th>
                        <th>Tổng</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Employees.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="master-data-empty">Không có dữ liệu công việc phù hợp.</td>
                        </tr>
                    }
                    else
                    {
                        for (var index = 0; index < Model.Employees.Count; index++)
                        {
                            var employee = Model.Employees[index];
                            <tr>
                                <td>@(index + 1)</td>
                                <td>@employee.HoTen</td>
                                <td>@(string.IsNullOrWhiteSpace(employee.ChucVu) ? "-" : employee.ChucVu)</td>
                                <td>
                                    <button type="button" class="work-report-count completed" data-report-detail-open data-employee-id="@employee.EmployeeId" data-status-group="completed">
                                        @employee.CompletedCount
                                    </button>
                                </td>
                                <td>
                                    <button type="button" class="work-report-count incomplete" data-report-detail-open data-employee-id="@employee.EmployeeId" data-status-group="incomplete">
                                        @employee.IncompleteCount
                                    </button>
                                </td>
                                <td>@(employee.CompletedCount + employee.IncompleteCount)</td>
                            </tr>
                        }
                    }
                </tbody>
                @if (Model.Employees.Count > 0)
                {
                    <tfoot>
                        <tr>
                            <td colspan="3">Tổng cộng</td>
                            <td>
                                <button type="button" class="work-report-count completed" data-report-detail-open data-employee-id="0" data-status-group="completed">@Model.TotalCompleted</button>
                            </td>
                            <td>
                                <button type="button" class="work-report-count incomplete" data-report-detail-open data-employee-id="0" data-status-group="incomplete">@Model.TotalIncomplete</button>
                            </td>
                            <td>@(Model.TotalCompleted + Model.TotalIncomplete)</td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    </article>

    <div class="crud-modal-shell work-report-detail-shell" data-report-detail-shell hidden>
        <div class="crud-modal-backdrop" aria-hidden="true" data-report-detail-close></div>
        <section class="crud-modal work-report-detail-modal" role="dialog" aria-modal="true" aria-labelledby="work-report-detail-title">
            <div class="crud-modal-header">
                <div class="crud-modal-heading">
                    <h2 id="work-report-detail-title" data-report-detail-title>Chi tiết công việc</h2>
                    <p class="crud-modal-subtitle" data-report-detail-subtitle></p>
                </div>
                <button type="button" class="menu-nav-button crud-close-button" aria-label="Đóng popup" data-report-detail-close>
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="crud-form work-report-detail-body">
                <div class="table-wrap">
                    <table class="data-table master-data-table work-report-detail-table">
                        <thead>
                            <tr>
                                <th>Mã phiếu yêu cầu</th>
                                <th>Tên khách</th>
                                <th>Địa điểm</th>
                                <th>Ngày yêu cầu</th>
                                <th>Công việc</th>
                                <th>Trạng thái công việc</th>
                            </tr>
                        </thead>
                        <tbody data-report-detail-body></tbody>
                    </table>
                </div>
            </div>
        </section>
    </div>

    <script type="application/json" data-report-details-json>@Html.Raw(detailJson)</script>
</section>

@section Scripts {
    <script>
        (function () {
            const root = document.querySelector("[data-work-report]");
            if (!(root instanceof HTMLElement)) {
                return;
            }

            const picker = root.querySelector("[data-report-employee-picker]");
            const toggle = root.querySelector("[data-report-employee-toggle]");
            const menu = root.querySelector("[data-report-employee-menu]");
            const summary = root.querySelector("[data-report-employee-summary]");
            const allCheckbox = root.querySelector("[data-report-employee-all]");
            const employeeCheckboxes = Array.from(root.querySelectorAll("[data-report-employee-checkbox]"));
            const detailsElement = root.querySelector("[data-report-details-json]");
            const detailShell = root.querySelector("[data-report-detail-shell]");
            const detailTitle = root.querySelector("[data-report-detail-title]");
            const detailSubtitle = root.querySelector("[data-report-detail-subtitle]");
            const detailBody = root.querySelector("[data-report-detail-body]");
            const closeButtons = root.querySelectorAll("[data-report-detail-close]");
            const details = JSON.parse(detailsElement?.textContent || "[]");

            const syncEmployeeSummary = () => {
                const checkedCount = employeeCheckboxes.filter((item) => item.checked).length;
                const isAll = allCheckbox instanceof HTMLInputElement && allCheckbox.checked;
                if (summary instanceof HTMLElement) {
                    summary.textContent = isAll || checkedCount === employeeCheckboxes.length
                        ? "Tất cả nhân viên"
                        : `${checkedCount} nhân viên`;
                }
            };

            if (toggle instanceof HTMLButtonElement && menu instanceof HTMLElement) {
                toggle.addEventListener("click", () => {
                    menu.hidden = !menu.hidden;
                    toggle.setAttribute("aria-expanded", menu.hidden ? "false" : "true");
                });
            }

            if (allCheckbox instanceof HTMLInputElement) {
                allCheckbox.addEventListener("change", () => {
                    employeeCheckboxes.forEach((checkbox) => {
                        checkbox.checked = allCheckbox.checked;
                    });
                    syncEmployeeSummary();
                });
            }

            employeeCheckboxes.forEach((checkbox) => {
                checkbox.addEventListener("change", () => {
                    if (allCheckbox instanceof HTMLInputElement) {
                        allCheckbox.checked = employeeCheckboxes.every((item) => item.checked);
                    }
                    syncEmployeeSummary();
                });
            });

            document.addEventListener("click", (event) => {
                if (picker instanceof HTMLElement && menu instanceof HTMLElement && !picker.contains(event.target)) {
                    menu.hidden = true;
                    if (toggle instanceof HTMLButtonElement) {
                        toggle.setAttribute("aria-expanded", "false");
                    }
                }
            });

            const closeDetails = () => {
                if (detailShell instanceof HTMLElement) {
                    detailShell.hidden = true;
                }
            };

            const escapeHtml = (value) => `${value ?? ""}`
                .replaceAll("&", "&amp;")
                .replaceAll("<", "&lt;")
                .replaceAll(">", "&gt;")
                .replaceAll('"', "&quot;")
                .replaceAll("'", "&#039;");

            const openDetails = (employeeId, statusGroup) => {
                if (!(detailShell instanceof HTMLElement) || !(detailBody instanceof HTMLElement)) {
                    return;
                }

                const rows = details.filter((item) =>
                    (employeeId === 0 || Number(item.employeeId) === employeeId) &&
                    item.statusGroup === statusGroup);
                const statusLabel = statusGroup === "completed" ? "đã hoàn thành" : "chưa hoàn thành";

                if (detailTitle instanceof HTMLElement) {
                    detailTitle.textContent = `Danh sách công việc ${statusLabel}`;
                }
                if (detailSubtitle instanceof HTMLElement) {
                    detailSubtitle.textContent = `${rows.length} công việc`;
                }

                detailBody.innerHTML = rows.length === 0
                    ? `<tr><td colspan="6" class="master-data-empty">Không có công việc phù hợp.</td></tr>`
                    : rows.map((item) => `
                        <tr>
                            <td>
                                <a class="work-report-request-link"
                                   href="${escapeHtml(item.detailUrl)}"
                                   target="_blank"
                                   rel="noopener"
                                   data-request-detail-url="${escapeHtml(item.detailUrl)}">${escapeHtml(item.maYeuCau)}</a>
                            </td>
                            <td>${escapeHtml(item.tenKhachHang)}</td>
                            <td>${escapeHtml(item.diaDiem)}</td>
                            <td>${escapeHtml(item.ngayYeuCau)}</td>
                            <td>${escapeHtml(item.tenCongViec)}</td>
                            <td>${escapeHtml(item.trangThaiCongViec)}</td>
                        </tr>
                    `).join("");

                detailShell.hidden = false;
            };

            root.querySelectorAll("[data-report-detail-open]").forEach((button) => {
                button.addEventListener("click", () => {
                    if (!(button instanceof HTMLElement)) {
                        return;
                    }

                    openDetails(
                        Number.parseInt(button.dataset.employeeId || "0", 10) || 0,
                        button.dataset.statusGroup === "completed" ? "completed" : "incomplete");
                });
            });

            if (detailBody instanceof HTMLElement) {
                detailBody.addEventListener("click", (event) => {
                    const link = event.target instanceof HTMLElement
                        ? event.target.closest("[data-request-detail-url]")
                        : null;
                    if (!(link instanceof HTMLElement)) {
                        return;
                    }

                    const url = link.dataset.requestDetailUrl || link.getAttribute("href") || "";
                    if (!url || url === "#") {
                        return;
                    }

                    event.preventDefault();
                    window.open(url, "_blank", "noopener");
                });
            }

            closeButtons.forEach((button) => {
                button.addEventListener("click", closeDetails);
            });

            document.addEventListener("keydown", (event) => {
                if (event.key === "Escape") {
                    closeDetails();
                }
            });
        })();
    </script>
}
