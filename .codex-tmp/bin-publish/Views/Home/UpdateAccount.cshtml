@model ApptechDashboard.Models.UpdateAccountViewModel
@{
    var activeForm = (ViewData["ActiveForm"]?.ToString() ?? "profile").ToLowerInvariant();
    var statusMessage = ViewData["StatusMessage"]?.ToString();
    var statusType = ViewData["StatusType"]?.ToString() ?? "info";
    bool HasError(string key) => ViewData.ModelState.TryGetValue(key, out var state) && state.Errors.Count > 0;

    var nameTokens = (Model.Profile.FullName ?? string.Empty)
        .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    var avatarInitials = nameTokens.Length switch
    {
        0 => "U",
        1 => nameTokens[0][0].ToString().ToUpperInvariant(),
        _ => string.Concat(nameTokens[0][0], nameTokens[^1][0]).ToUpperInvariant()
    };
}

<section class="account-page">
    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="page-alert @statusType" data-status-alert>
            <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
            <span>@statusMessage</span>
        </div>
    }

    <div class="account-grid">
        <section class="panel account-panel">
            <div class="panel-header">
                <div>
                    <h3>Thông tin cá nhân</h3>
                    <p>Cập nhật avatar, họ tên, nhóm người dùng, email, ngày sinh, địa chỉ, điện thoại, giới tính và Zalo ID.</p>
                </div>
            </div>

            @if (activeForm == "profile")
            {
                <div asp-validation-summary="ModelOnly" class="page-alert error"></div>
            }

            <form asp-action="UpdateAccount" method="post" enctype="multipart/form-data" class="account-form">
                @Html.AntiForgeryToken()

                <div class="profile-shell">
                    <div class="avatar-editor">
                        <div class="profile-avatar">
                            <img src="@Model.Profile.AvatarUrl"
                                 alt="Avatar người dùng"
                                 class="profile-avatar-image @(string.IsNullOrWhiteSpace(Model.Profile.AvatarUrl) ? "is-hidden" : null)"
                                 data-avatar-preview />
                            <span class="profile-avatar-fallback @(string.IsNullOrWhiteSpace(Model.Profile.AvatarUrl) ? null : "is-hidden")"
                                  data-avatar-fallback>@avatarInitials</span>
                        </div>

                        <div class="avatar-editor-copy">
                            <label asp-for="Profile.AvatarFile" class="avatar-upload-label"></label>
                            <div class="avatar-editor-actions">
                                <label class="secondary-button image-upload-button" for="profileAvatarFile">
                                    <i class="fa-solid fa-image" aria-hidden="true"></i>
                                    <span>Tải từ thiết bị</span>
                                </label>

                                <button type="button"
                                        class="secondary-button image-upload-button"
                                        data-avatar-camera-open>
                                    <i class="fa-solid fa-camera" aria-hidden="true"></i>
                                    <span>Chụp camera</span>
                                </button>
                            </div>
                            <input id="profileAvatarFile"
                                   asp-for="Profile.AvatarFile"
                                   type="file"
                                   accept=".jpg,.jpeg,.png,.webp,image/png,image/jpeg,image/webp"
                                   class="avatar-upload-input"
                                   data-avatar-input
                                   hidden />
                            <input id="profileAvatarCamera"
                                   name="Profile.AvatarFile"
                                   type="file"
                                   accept="image/*"
                                   capture="user"
                                   class="avatar-upload-input"
                                   data-avatar-input
                                   data-avatar-camera-fallback
                                   hidden />
                            <div class="avatar-camera-panel" data-avatar-camera-panel hidden>
                                <video class="avatar-camera-video" data-avatar-camera-video autoplay playsinline muted></video>
                                <canvas data-avatar-camera-canvas hidden></canvas>
                                <div class="avatar-camera-actions">
                                    <button type="button" class="primary-button" data-avatar-camera-capture>
                                        <i class="fa-solid fa-camera" aria-hidden="true"></i>
                                        <span>Chụp ảnh</span>
                                    </button>
                                    <button type="button" class="secondary-button" data-avatar-camera-close>Dừng camera</button>
                                </div>
                                <div class="page-alert info avatar-camera-status" data-avatar-camera-status hidden></div>
                            </div>
                            <span asp-validation-for="Profile.AvatarFile" class="login-field-error"></span>
                            <p>Hỗ trợ JPG, PNG, WEBP. Dung lượng tối đa 2MB.</p>
                        </div>
                    </div>

                    <div class="account-form-grid">
                        <div class="login-field">
                            <label asp-for="Profile.Username"></label>
                            <div class="login-input-shell readonly-shell">
                                <i class="fa-solid fa-user" aria-hidden="true"></i>
                                <input asp-for="Profile.Username" readonly />
                            </div>
                        </div>

                        <div class="login-field @(HasError("Profile.GroupName") ? "has-error" : null)">
                            <label asp-for="Profile.GroupName"></label>
                            <div class="login-input-shell select-shell">
                                <i class="fa-solid fa-users" aria-hidden="true"></i>
                                <select asp-for="Profile.GroupName">
                                    <option value="">Chọn nhóm người dùng</option>
                                    <option value="Quản trị viên">Quản trị viên</option>
                                    <option value="Nhân viên">Nhân viên</option>
                                    <option value="Kỹ thuật">Kỹ thuật</option>
                                    <option value="Kế toán">Kế toán</option>
                                </select>
                                <span class="select-indicator" aria-hidden="true">
                                    <i class="fa-solid fa-chevron-down"></i>
                                </span>
                            </div>
                            <span asp-validation-for="Profile.GroupName" class="login-field-error"></span>
                        </div>

                        <div class="login-field @(HasError("Profile.FullName") ? "has-error" : null)">
                            <label asp-for="Profile.FullName"></label>
                            <div class="login-input-shell">
                                <i class="fa-solid fa-id-card" aria-hidden="true"></i>
                                <input asp-for="Profile.FullName" placeholder="Nhập họ và tên" />
                            </div>
                            <span asp-validation-for="Profile.FullName" class="login-field-error"></span>
                        </div>

                        <div class="login-field @(HasError("Profile.Email") ? "has-error" : null)">
                            <label asp-for="Profile.Email"></label>
                            <div class="login-input-shell">
                                <i class="fa-solid fa-envelope" aria-hidden="true"></i>
                                <input asp-for="Profile.Email" placeholder="Nhập email" />
                            </div>
                            <span asp-validation-for="Profile.Email" class="login-field-error"></span>
                        </div>

                        <div class="login-field @(HasError("Profile.DateOfBirth") ? "has-error" : null)">
                            <label asp-for="Profile.DateOfBirth"></label>
                            <div class="login-input-shell">
                                <i class="fa-solid fa-calendar-days" aria-hidden="true"></i>
                                <input asp-for="Profile.DateOfBirth" type="date" />
                            </div>
                            <span asp-validation-for="Profile.DateOfBirth" class="login-field-error"></span>
                        </div>

                        <div class="login-field @(HasError("Profile.PhoneNumber") ? "has-error" : null)">
                            <label asp-for="Profile.PhoneNumber"></label>
                            <div class="login-input-shell">
                                <i class="fa-solid fa-phone" aria-hidden="true"></i>
                                <input asp-for="Profile.PhoneNumber" placeholder="Nhập số điện thoại" />
                            </div>
                            <span asp-validation-for="Profile.PhoneNumber" class="login-field-error"></span>
                        </div>

                        <div class="login-field @(HasError("Profile.Gender") ? "has-error" : null)">
                            <label asp-for="Profile.Gender"></label>
                            <div class="login-input-shell select-shell">
                                <i class="fa-solid fa-venus-mars" aria-hidden="true"></i>
                                <select asp-for="Profile.Gender">
                                    <option value="">Chọn giới tính</option>
                                    <option value="Nam">Nam</option>
                                    <option value="Nữ">Nữ</option>
                                    <option value="Khác">Khác</option>
                                </select>
                                <span class="select-indicator" aria-hidden="true">
                                    <i class="fa-solid fa-chevron-down"></i>
                                </span>
                            </div>
                            <span asp-validation-for="Profile.Gender" class="login-field-error"></span>
                        </div>

                        <div class="login-field @(HasError("Profile.ZaloId") ? "has-error" : null)">
                            <label asp-for="Profile.ZaloId"></label>
                            <div class="login-input-shell">
                                <i class="fa-brands fa-rocketchat" aria-hidden="true"></i>
                                <input asp-for="Profile.ZaloId" placeholder="Nhập Zalo ID" />
                            </div>
                            <span asp-validation-for="Profile.ZaloId" class="login-field-error"></span>
                        </div>

                        <div class="login-field field-span-2 @(HasError("Profile.Address") ? "has-error" : null)">
                            <label asp-for="Profile.Address"></label>
                            <div class="login-textarea-shell">
                                <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
                                <textarea asp-for="Profile.Address" rows="3" placeholder="Nhập địa chỉ"></textarea>
                            </div>
                            <span asp-validation-for="Profile.Address" class="login-field-error"></span>
                        </div>
                    </div>
                </div>

                <button type="submit"
                        class="primary-button account-submit"
                        data-processing-button
                        data-processing-text="Đang lưu thông tin">
                    <span class="button-content">
                        <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i>
                        <span>Lưu thông tin người dùng</span>
                    </span>
                    <span class="button-processing" aria-hidden="true">
                        <span class="button-processing-dot"></span>
                        <span class="button-processing-text">Đang lưu thông tin</span>
                    </span>
                </button>
            </form>
        </section>

        <section class="panel account-panel">
            <div class="panel-header">
                <div>
                    <h3>Đổi mật khẩu</h3>
                    <p>Phải nhập đúng mật khẩu hiện tại. Sau khi đổi thành công, hệ thống sẽ đăng xuất để đăng nhập lại.</p>
                </div>
            </div>

            @if (activeForm == "password")
            {
                <div asp-validation-summary="ModelOnly" class="page-alert error"></div>
            }

            <form action="/tai-khoan/doi-mat-khau" method="post" class="account-form">
                @Html.AntiForgeryToken()

                <div class="account-form-grid single-column">
                    <div class="login-field @(HasError("Password.CurrentPassword") ? "has-error" : null)">
                        <label asp-for="Password.CurrentPassword"></label>
                        <div class="login-input-shell">
                            <i class="fa-solid fa-lock" aria-hidden="true"></i>
                            <input asp-for="Password.CurrentPassword" data-password-input />
                            <button type="button"
                                    class="login-input-action"
                                    data-password-toggle
                                    aria-label="Hiển thị mật khẩu"
                                    aria-controls="Password_CurrentPassword"
                                    aria-pressed="false">
                                <i class="fa-solid fa-eye-slash" aria-hidden="true"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password.CurrentPassword" class="login-field-error"></span>
                    </div>

                    <div class="login-field @(HasError("Password.NewPassword") ? "has-error" : null)">
                        <label asp-for="Password.NewPassword"></label>
                        <div class="login-input-shell">
                            <i class="fa-solid fa-key" aria-hidden="true"></i>
                            <input asp-for="Password.NewPassword" data-password-input />
                            <button type="button"
                                    class="login-input-action"
                                    data-password-toggle
                                    aria-label="Hiển thị mật khẩu"
                                    aria-controls="Password_NewPassword"
                                    aria-pressed="false">
                                <i class="fa-solid fa-eye-slash" aria-hidden="true"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password.NewPassword" class="login-field-error"></span>
                    </div>

                    <div class="login-field @(HasError("Password.ConfirmNewPassword") ? "has-error" : null)">
                        <label asp-for="Password.ConfirmNewPassword"></label>
                        <div class="login-input-shell">
                            <i class="fa-solid fa-shield-heart" aria-hidden="true"></i>
                            <input asp-for="Password.ConfirmNewPassword" data-password-input />
                            <button type="button"
                                    class="login-input-action"
                                    data-password-toggle
                                    aria-label="Hiển thị mật khẩu"
                                    aria-controls="Password_ConfirmNewPassword"
                                    aria-pressed="false">
                                <i class="fa-solid fa-eye-slash" aria-hidden="true"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password.ConfirmNewPassword" class="login-field-error"></span>
                    </div>
                </div>

                <button type="submit"
                        class="primary-button account-submit password-submit"
                        data-processing-button
                        data-processing-text="Đang đổi mật khẩu">
                    <span class="button-content">
                        <i class="fa-solid fa-key" aria-hidden="true"></i>
                        <span>Đổi mật khẩu</span>
                    </span>
                    <span class="button-processing" aria-hidden="true">
                        <span class="button-processing-dot"></span>
                        <span class="button-processing-text">Đang đổi mật khẩu</span>
                    </span>
                </button>
            </form>
        </section>
    </div>
</section>
