@model VaiTroManagementViewModel
@{
    ViewData["Title"] = "Vai trò";
    ViewData["Breadcrumb"] = "Trang chủ / Hệ thống / Vai trò";

    var tenVaiTroHasError = ViewData.ModelState.TryGetValue("Form.TenVaiTro", out var tenVaiTroState) && tenVaiTroState.Errors.Count > 0;
    var mieuTaHasError = ViewData.ModelState.TryGetValue("Form.MieuTa", out var mieuTaState) && mieuTaState.Errors.Count > 0;
    var trangThaiHasError = ViewData.ModelState.TryGetValue("Form.TrangThaiSuDung", out var trangThaiState) && trangThaiState.Errors.Count > 0;
    var summaryErrors = ViewData.ModelState.TryGetValue(string.Empty, out var summaryState)
        ? summaryState.Errors.Select(error => error.ErrorMessage).Where(message => !string.IsNullOrWhiteSpace(message)).ToArray()
        : [];

    var permissionRows = new List<(VaiTroPermissionNode Node, int Depth)>();
    void AddPermissionRows(IEnumerable<VaiTroPermissionNode> nodes, int depth)
    {
        foreach (var node in nodes)
        {
            permissionRows.Add((node, depth));
            AddPermissionRows(node.Children, depth + 1);
        }
    }

    if (Model.PermissionMatrix is not null)
    {
        AddPermissionRows(Model.PermissionMatrix.Nodes, 0);
    }
}

<section class="master-data-page">
    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="floating-status-toast @Model.StatusType"
             data-status-toast
             role="status"
             aria-live="polite">
            <div class="floating-status-toast-icon" aria-hidden="true">
                <i class="fa-solid @(Model.StatusType == "success" ? "fa-circle-check" : Model.StatusType == "error" ? "fa-circle-exclamation" : "fa-circle-info")"></i>
            </div>
            <div class="floating-status-toast-body">
                <strong>@(Model.StatusType == "success" ? "Thành công" : Model.StatusType == "error" ? "Có lỗi xảy ra" : "Thông báo")</strong>
                <span>@Model.StatusMessage</span>
            </div>
            <button type="button" class="floating-status-toast-close" data-status-toast-close aria-label="Đóng thông báo">
                <span aria-hidden="true">×</span>
            </button>
        </div>
    }

    <article class="panel master-data-panel">
        <div class="panel-header master-data-header">
            <div>
                <h3>Danh sách vai trò</h3>
                <p>Quản lý vai trò và phân quyền theo chức năng hệ thống.</p>
            </div>

            <div class="master-data-header-actions">
                <a class="master-data-add-button" asp-permission-action="insert"
                   asp-action="Index"
                   asp-route-keyword="@Model.Filter.Keyword"
                   asp-route-statusFilter="@Model.Filter.StatusFilter"
                   asp-route-page="@Model.CurrentPage"
                   asp-route-showCreatePopup="true">
                    <i class="fa-solid fa-plus" aria-hidden="true"></i>
                    <span>Thêm mới</span>
                </a>
            </div>
        </div>

        <form method="get" asp-action="Index" class="master-data-filter-form">
            <label class="master-data-filter-field" for="keyword">
                <span>Tìm theo tên vai trò hoặc miêu tả</span>
                <span class="login-input-shell">
                    <i class="fa-solid fa-user-shield" aria-hidden="true"></i>
                    <input id="keyword" name="keyword" type="search" value="@Model.Filter.Keyword" placeholder="Nhập từ khóa tìm kiếm..." />
                </span>
            </label>

            <label class="master-data-filter-field" for="statusFilter">
                <span>Trạng thái sử dụng</span>
                <span class="login-input-shell select-shell">
                    <i class="fa-solid fa-power-off" aria-hidden="true"></i>
                    <select id="statusFilter" name="statusFilter">
                        <option value="" selected="@(Model.Filter.StatusFilter is null)">Tất cả trạng thái</option>
                        <option value="true" selected="@(Model.Filter.StatusFilter == true)">Kích hoạt</option>
                        <option value="false" selected="@(Model.Filter.StatusFilter == false)">Khóa</option>
                    </select>
                    <span class="select-indicator"><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></span>
                </span>
            </label>

            <div class="master-data-filter-actions">
                <button type="submit" class="primary-button master-data-filter-button">
                    <span class="button-content">
                        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                        <span>Tìm kiếm</span>
                    </span>
                    <span class="button-processing" aria-hidden="true">
                        <span class="button-processing-dot"></span>
                        <span class="button-processing-text">Đang xử lý</span>
                    </span>
                </button>

                <a class="secondary-button master-data-reset-button" asp-action="Index">Làm mới</a>
            </div>
        </form>

        <div class="master-data-summary">
            <div><strong>@Model.TotalCount</strong> vai trò</div>
            <div>Trang <strong>@Model.CurrentPage</strong>@(Model.TotalPages > 0 ? $" / {Model.TotalPages}" : "")</div>
        </div>

        <div class="table-wrap">
            <table class="data-table master-data-table">
                <thead>
                    <tr>
                        <th>Tên vai trò</th>
                        <th>Miêu tả</th>
                        <th>Trạng thái</th>
                        <th class="actions-col">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="4" class="master-data-empty">Không có dữ liệu phù hợp.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td><div class="master-data-name">@item.TenVaiTro</div></td>
                                <td>@(string.IsNullOrWhiteSpace(item.MieuTa) ? "-" : item.MieuTa)</td>
                                <td>
                                    <span class="status-pill @(item.TrangThaiSuDung ? "active" : "locked")">
                                        @(item.TrangThaiSuDung ? "Kích hoạt" : "Khóa")
                                    </span>
                                </td>
                                <td class="actions-col">
                                    <div class="master-data-actions">
                                        <a class="table-action-button edit" asp-permission-action="update"
                                           asp-action="Index"
                                           asp-route-keyword="@Model.Filter.Keyword"
                                           asp-route-statusFilter="@Model.Filter.StatusFilter"
                                           asp-route-page="@Model.CurrentPage"
                                           asp-route-permissionRoleId="@item.Id">
                                            <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
                                            <span>Phân quyền</span>
                                        </a>

                                        <a class="table-action-button edit" asp-permission-action="update"
                                           asp-action="Index"
                                           asp-route-keyword="@Model.Filter.Keyword"
                                           asp-route-statusFilter="@Model.Filter.StatusFilter"
                                           asp-route-page="@Model.CurrentPage"
                                           asp-route-editId="@item.Id">
                                            <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
                                            <span>Sửa</span>
                                        </a>

                                        <form method="post" asp-action="Delete" class="inline-action-form">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="Id" value="@item.Id" />
                                            <input type="hidden" name="Keyword" value="@Model.Filter.Keyword" />
                                            <input type="hidden" name="StatusFilter" value="@Model.Filter.StatusFilter" />
                                            <input type="hidden" name="Page" value="@Model.CurrentPage" />
                                            <button type="submit"
                                                    class="table-action-button delete" asp-permission-action="delete"
                                                    data-delete-confirm="Bạn có chắc muốn xóa vai trò này?">
                                                <i class="fa-solid fa-trash-can" aria-hidden="true"></i>
                                                <span>Xóa</span>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="pagination-bar" aria-label="Phân trang vai trò">
                <a class="pagination-button @(Model.CurrentPage <= 1 ? "disabled" : "")"
                   asp-action="Index"
                   asp-route-keyword="@Model.Filter.Keyword"
                   asp-route-statusFilter="@Model.Filter.StatusFilter"
                   asp-route-page="@(Model.CurrentPage - 1)">
                    <i class="fa-solid fa-angle-left" aria-hidden="true"></i>
                    <span>Trước</span>
                </a>

                <div class="pagination-pages">
                    @foreach (var pageNumber in Model.VisiblePages)
                    {
                        <a class="pagination-page @(pageNumber == Model.CurrentPage ? "active" : "")"
                           asp-action="Index"
                           asp-route-keyword="@Model.Filter.Keyword"
                           asp-route-statusFilter="@Model.Filter.StatusFilter"
                           asp-route-page="@pageNumber">
                            @pageNumber
                        </a>
                    }
                </div>

                <a class="pagination-button @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")"
                   asp-action="Index"
                   asp-route-keyword="@Model.Filter.Keyword"
                   asp-route-statusFilter="@Model.Filter.StatusFilter"
                   asp-route-page="@(Model.CurrentPage + 1)">
                    <span>Sau</span>
                    <i class="fa-solid fa-angle-right" aria-hidden="true"></i>
                </a>
            </nav>
        }
    </article>
</section>

@if (Model.PopupMode is VaiTroPopupMode.Create or VaiTroPopupMode.Edit)
{
    <div class="crud-modal-shell" data-crud-modal-shell>
        <div class="crud-modal-backdrop" aria-hidden="true"></div>

        <section class="crud-modal" role="dialog" aria-modal="true" aria-labelledby="vai-tro-modal-title">
            <div class="crud-modal-header">
                <div class="crud-modal-heading">
                    <h2 id="vai-tro-modal-title">@Model.PopupTitle</h2>
                    <p class="crud-modal-subtitle">Cập nhật tên vai trò, miêu tả và trạng thái sử dụng.</p>
                </div>

                <a class="menu-nav-button crud-close-button"
                   data-crud-modal-close
                   aria-label="Đóng popup"
                   asp-action="Index"
                   asp-route-keyword="@Model.Filter.Keyword"
                   asp-route-statusFilter="@Model.Filter.StatusFilter"
                   asp-route-page="@Model.CurrentPage">
                    <span aria-hidden="true">&times;</span>
                </a>
            </div>

            <form method="post" asp-action="@Model.SubmitAction" class="account-form crud-form">
                @Html.AntiForgeryToken()
                <input asp-for="Form.Id" type="hidden" />
                <input asp-for="Form.Keyword" type="hidden" />
                <input asp-for="Form.StatusFilter" type="hidden" />
                <input asp-for="Form.Page" type="hidden" />

                @if (summaryErrors.Length > 0)
                {
                    <div class="page-alert error validation-summary">
                        <i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i>
                        <div>
                            @foreach (var message in summaryErrors)
                            {
                                <div>@message</div>
                            }
                        </div>
                    </div>
                }

                <div class="account-form-grid single-column">
                    <label class="login-field @(tenVaiTroHasError ? "has-error" : "")">
                        <span>Tên vai trò</span>
                        <span class="login-input-shell">
                            <i class="fa-solid fa-user-shield" aria-hidden="true"></i>
                            <input asp-for="Form.TenVaiTro" autocomplete="off" autofocus />
                        </span>
                        <span asp-validation-for="Form.TenVaiTro" class="login-field-error"></span>
                    </label>

                    <label class="login-field @(mieuTaHasError ? "has-error" : "")">
                        <span>Miêu tả</span>
                        <span class="login-textarea-shell">
                            <i class="fa-regular fa-note-sticky" aria-hidden="true"></i>
                            <textarea asp-for="Form.MieuTa" rows="3"></textarea>
                        </span>
                        <span asp-validation-for="Form.MieuTa" class="login-field-error"></span>
                    </label>

                    <label class="login-field @(trangThaiHasError ? "has-error" : "")">
                        <span>Trạng thái sử dụng</span>
                        <span class="switch-field-shell">
                            <span class="switch-field-icon"><i class="fa-solid fa-toggle-on" aria-hidden="true"></i></span>
                            <label class="status-switch">
                                <input asp-for="Form.TrangThaiSuDung" class="status-switch-input" />
                                <span class="status-switch-track"><span class="status-switch-thumb"></span></span>
                                <span class="status-switch-labels" aria-hidden="true">
                                    <span>Kích hoạt</span>
                                    <span>Khóa</span>
                                </span>
                            </label>
                        </span>
                    </label>
                </div>

                <div class="crud-modal-actions">
                    <a class="secondary-button crud-cancel-button"
                       asp-action="Index"
                       asp-route-keyword="@Model.Filter.Keyword"
                       asp-route-statusFilter="@Model.Filter.StatusFilter"
                       asp-route-page="@Model.CurrentPage">
                        Hủy
                    </a>

                    <button type="submit" class="primary-button" asp-permission-action="@(Model.PopupMode == VaiTroPopupMode.Edit ? "update" : "insert")" data-processing-button data-processing-text="Đang lưu">
                        <span class="button-content">
                            <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i>
                            <span>@(Model.PopupMode == VaiTroPopupMode.Edit ? "Lưu cập nhật" : "Thêm mới")</span>
                        </span>
                        <span class="button-processing" aria-hidden="true">
                            <span class="button-processing-dot"></span>
                            <span class="button-processing-text">Đang lưu</span>
                        </span>
                    </button>
                </div>
            </form>
        </section>
    </div>
}

@if (Model.PopupMode == VaiTroPopupMode.Permissions && Model.PermissionMatrix is not null)
{
    <div class="crud-modal-shell permission-modal-shell" data-permission-modal-shell>
        <div class="crud-modal-backdrop" aria-hidden="true"></div>

        <section class="crud-modal permission-modal" role="dialog" aria-modal="true" aria-labelledby="vai-tro-permission-title">
            <div class="crud-modal-header">
                <div class="crud-modal-heading">
                    <h2 id="vai-tro-permission-title">Phân quyền: @Model.PermissionMatrix.RoleName</h2>
                    <p class="crud-modal-subtitle">Tick menu cha để chọn toàn bộ menu con và quyền bên dưới.</p>
                </div>

                <a class="menu-nav-button crud-close-button"
                   aria-label="Đóng popup phân quyền"
                   asp-action="Index"
                   asp-route-keyword="@Model.Filter.Keyword"
                   asp-route-statusFilter="@Model.Filter.StatusFilter"
                   asp-route-page="@Model.CurrentPage">
                    <span aria-hidden="true">&times;</span>
                </a>
            </div>

            <form method="post" asp-action="SavePermissions" class="account-form permission-form" data-permission-form>
                @Html.AntiForgeryToken()
                <input type="hidden" name="RoleId" value="@Model.PermissionMatrix.RoleId" />
                <input type="hidden" name="Keyword" value="@Model.Filter.Keyword" />
                <input type="hidden" name="StatusFilter" value="@Model.Filter.StatusFilter" />
                <input type="hidden" name="Page" value="@Model.CurrentPage" />

                <div class="permission-tree">
                    @if (permissionRows.Count == 0)
                    {
                        <div class="master-data-empty">Chưa có chức năng đang kích hoạt.</div>
                    }
                    else
                    {
                        @foreach (var (node, depth) in permissionRows)
                        {
                            var hasAnySelected = node.Permissions.Any(permission => permission.IsSelected);
                            <section class="permission-node is-collapsed"
                                     style="--permission-depth:@depth"
                                     data-node-code="@node.MaChucNang"
                                     data-parent-code="@node.MaChucNangCha">
                                <div class="permission-node-head">
                                    <label class="permission-node-check-label">
                                        <input type="checkbox"
                                               class="permission-node-check"
                                               data-node-check
                                               @(hasAnySelected ? "checked" : null) />
                                        <span>
                                            <strong>@node.TenChucNang</strong>
                                            @if (!string.IsNullOrWhiteSpace(node.MieuTa))
                                            {
                                                <small>@node.MieuTa</small>
                                            }
                                        </span>
                                    </label>

                                    <button type="button"
                                            class="permission-collapse-button"
                                            data-permission-toggle
                                            aria-expanded="false"
                                            aria-label="Thu gọn hoặc mở rộng chức năng">
                                            <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
                                    </button>
                                </div>

                                <div class="permission-node-body" data-permission-node-body>
                                    <div class="permission-list">
                                    @foreach (var permission in node.Permissions)
                                    {
                                        <label class="permission-item">
                                            <input type="checkbox"
                                                   name="SelectedPermissionIds"
                                                   value="@permission.QuyenId"
                                                   data-permission-check
                                                   @(permission.IsSelected ? "checked" : null) />
                                            <span class="permission-item-body">
                                                <strong>@permission.TenQuyen</strong>
                                                <small>@(string.IsNullOrWhiteSpace(permission.MieuTa) ? "-" : permission.MieuTa)</small>
                                            </span>
                                        </label>
                                    }
                                    </div>
                                </div>
                            </section>
                        }
                    }
                </div>

                <div class="crud-modal-actions">
                    <a class="secondary-button crud-cancel-button"
                       asp-action="Index"
                       asp-route-keyword="@Model.Filter.Keyword"
                       asp-route-statusFilter="@Model.Filter.StatusFilter"
                       asp-route-page="@Model.CurrentPage">
                        Hủy
                    </a>

                    <button type="submit" class="primary-button" asp-permission-action="update" data-processing-button data-processing-text="Đang lưu">
                        <span class="button-content">
                            <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i>
                            <span>Lưu quyền</span>
                        </span>
                        <span class="button-processing" aria-hidden="true">
                            <span class="button-processing-dot"></span>
                            <span class="button-processing-text">Đang lưu</span>
                        </span>
                    </button>
                </div>
            </form>
        </section>
    </div>
}

@section Scripts {
    <script>
        (function () {
            const form = document.querySelector("[data-permission-form]");
            if (!(form instanceof HTMLFormElement)) {
                return;
            }

            const nodes = Array.from(form.querySelectorAll("[data-node-code]"));
            const getDescendants = (code) => {
                const descendants = [];
                const visit = (parentCode) => {
                    nodes.forEach((node) => {
                        if (!(node instanceof HTMLElement) || node.dataset.parentCode !== parentCode) {
                            return;
                        }

                        descendants.push(node);
                        visit(node.dataset.nodeCode || "");
                    });
                };
                visit(code);
                return descendants;
            };

            const syncNodeState = (node) => {
                if (!(node instanceof HTMLElement)) {
                    return;
                }

                const nodeCheck = node.querySelector("[data-node-check]");
                const permissionChecks = Array.from(node.querySelectorAll("[data-permission-check]"));
                if (!(nodeCheck instanceof HTMLInputElement)) {
                    return;
                }

                const checkedCount = permissionChecks.filter((input) => input instanceof HTMLInputElement && input.checked).length;
                nodeCheck.checked = permissionChecks.length > 0 && checkedCount === permissionChecks.length;
                nodeCheck.indeterminate = checkedCount > 0 && checkedCount < permissionChecks.length;
            };

            nodes.forEach((node) => {
                if (!(node instanceof HTMLElement)) {
                    return;
                }

                const nodeCheck = node.querySelector("[data-node-check]");
                nodeCheck?.addEventListener("change", () => {
                    if (!(nodeCheck instanceof HTMLInputElement)) {
                        return;
                    }

                    const targets = [node, ...getDescendants(node.dataset.nodeCode || "")];
                    targets.forEach((target) => {
                        target.querySelectorAll("[data-node-check], [data-permission-check]").forEach((input) => {
                            if (input instanceof HTMLInputElement) {
                                input.checked = nodeCheck.checked;
                                input.indeterminate = false;
                            }
                        });
                    });
                });

                const toggleButton = node.querySelector("[data-permission-toggle]");
                toggleButton?.addEventListener("click", () => {
                    if (!(toggleButton instanceof HTMLButtonElement)) {
                        return;
                    }

                    const isCollapsed = node.classList.toggle("is-collapsed");
                    toggleButton.setAttribute("aria-expanded", isCollapsed ? "false" : "true");
                    const icon = toggleButton.querySelector("i");
                    if (icon instanceof HTMLElement) {
                        icon.className = isCollapsed ? "fa-solid fa-chevron-down" : "fa-solid fa-chevron-up";
                    }
                });

                node.querySelectorAll("[data-permission-check]").forEach((input) => {
                    input.addEventListener("change", () => {
                        syncNodeState(node);
                    });
                });

                syncNodeState(node);
            });
        })();
    </script>
}
