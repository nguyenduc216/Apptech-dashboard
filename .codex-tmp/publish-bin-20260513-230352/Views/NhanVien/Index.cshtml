@model NhanVienManagementViewModel
@{
    ViewData["Title"] = "Nhân viên";
    ViewData["Breadcrumb"] = "Trang chủ / Nhân viên";
}

<section class="master-data-page">
    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="floating-status-toast @Model.StatusType"
             data-status-toast
             role="status"
             aria-live="polite">
            <div class="floating-status-toast-icon" aria-hidden="true">
                <i class="fa-solid @(Model.StatusType == "success" ? "fa-circle-check" : Model.StatusType == "error" ? "fa-circle-exclamation" : "fa-circle-info")"></i>
            </div>
            <div class="floating-status-toast-body">
                <strong>@(Model.StatusType == "success" ? "Thành công" : Model.StatusType == "error" ? "Có lỗi xảy ra" : "Thông báo")</strong>
                <span>@Model.StatusMessage</span>
            </div>
            <button type="button" class="floating-status-toast-close" data-status-toast-close aria-label="Đóng thông báo">
                <span aria-hidden="true">×</span>
            </button>
        </div>
    }

    <article class="panel master-data-panel">
        <div class="panel-header master-data-header">
            <div>
                <h3>Danh sách nhân viên</h3>
                <p>Quản lý hồ sơ nhân viên và liên kết tài khoản người dùng.</p>
            </div>

            <div class="master-data-header-actions">
                <a class="master-data-add-button" asp-permission-action="insert"
                   asp-action="Create"
                   asp-route-keyword="@Model.Filter.Keyword"
                   asp-route-statusFilter="@Model.Filter.StatusFilter"
                   asp-route-page="@Model.CurrentPage">
                    <i class="fa-solid fa-plus" aria-hidden="true"></i>
                    <span>Thêm mới</span>
                </a>
            </div>
        </div>

        <form method="get" asp-action="Index" class="master-data-filter-form">
            <label class="master-data-filter-field" for="keyword">
                <span>Tìm theo họ tên, email, chức vụ, phòng ban hoặc tên đăng nhập</span>
                <span class="login-input-shell">
                    <i class="fa-solid fa-users" aria-hidden="true"></i>
                    <input id="keyword" name="keyword" type="search" value="@Model.Filter.Keyword" placeholder="Nhập từ khóa tìm kiếm..." />
                </span>
            </label>

            <label class="master-data-filter-field" for="statusFilter">
                <span>Trạng thái sử dụng</span>
                <span class="login-input-shell select-shell">
                    <i class="fa-solid fa-power-off" aria-hidden="true"></i>
                    <select id="statusFilter" name="statusFilter">
                        <option value="" selected="@(Model.Filter.StatusFilter is null)">Tất cả trạng thái</option>
                        <option value="true" selected="@(Model.Filter.StatusFilter == true)">Kích hoạt</option>
                        <option value="false" selected="@(Model.Filter.StatusFilter == false)">Khóa</option>
                    </select>
                    <span class="select-indicator"><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></span>
                </span>
            </label>

            <div class="master-data-filter-actions">
                <button type="submit" class="primary-button master-data-filter-button">
                    <span class="button-content">
                        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                        <span>Tìm kiếm</span>
                    </span>
                    <span class="button-processing" aria-hidden="true">
                        <span class="button-processing-dot"></span>
                        <span class="button-processing-text">Đang xử lý</span>
                    </span>
                </button>

                <a class="secondary-button master-data-reset-button" asp-action="Index">Làm mới</a>
            </div>
        </form>

        <div class="master-data-summary">
            <div><strong>@Model.TotalCount</strong> nhân viên</div>
            <div>Trang <strong>@Model.CurrentPage</strong>@(Model.TotalPages > 0 ? $" / {Model.TotalPages}" : "")</div>
        </div>

        <div class="table-wrap">
            <table class="data-table master-data-table nhan-vien-table">
                <thead>
                    <tr>
                        <th>Nhân viên</th>
                        <th>Phòng ban</th>
                        <th>Chức vụ</th>
                        <th>Email</th>
                        <th>Tài khoản</th>
                        <th>Trạng thái</th>
                        <th class="actions-col">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="master-data-empty">Không có dữ liệu phù hợp.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    <div class="employee-cell">
                                        <div class="employee-avatar">
                                            <img src="@(string.IsNullOrWhiteSpace(item.Avatar) ? "/images/default-avatar.svg" : item.Avatar)"
                                                 alt="Avatar @item.HoTen"
                                                 onerror="this.onerror=null;this.src='/images/default-avatar.svg';" />
                                        </div>
                                        <div>
                                            <a class="master-data-name master-data-name-link"
                                               asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               asp-route-keyword="@Model.Filter.Keyword"
                                               asp-route-statusFilter="@Model.Filter.StatusFilter"
                                               asp-route-page="@Model.CurrentPage">
                                                @item.HoTen
                                            </a>
                                            <div>@(item.NgaySinh.HasValue ? item.NgaySinh.Value.ToString("dd/MM/yyyy") : "-") · @(string.IsNullOrWhiteSpace(item.GioiTinh) ? "-" : item.GioiTinh)</div>
                                        </div>
                                    </div>
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(item.TenPhongBan) ? "-" : item.TenPhongBan)</td>
                                <td>@(string.IsNullOrWhiteSpace(item.ChucVu) ? "-" : item.ChucVu)</td>
                                <td>@(string.IsNullOrWhiteSpace(item.Email) ? "-" : item.Email)</td>
                                <td>
                                    <div>@(string.IsNullOrWhiteSpace(item.TenDangNhap) ? "-" : item.TenDangNhap)</div>
                                    @if (item.IsAdministrator)
                                    {
                                        <span class="status-pill admin">Quản trị</span>
                                    }
                                </td>
                                <td>
                                    <span class="status-pill @(item.TrangThaiSuDung ? "active" : "locked")">
                                        @(item.TrangThaiSuDung ? "Kích hoạt" : "Khóa")
                                    </span>
                                </td>
                                <td class="actions-col">
                                    <div class="master-data-actions">
                                        <a class="table-action-button edit" asp-permission-action="update"
                                           asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           asp-route-keyword="@Model.Filter.Keyword"
                                           asp-route-statusFilter="@Model.Filter.StatusFilter"
                                           asp-route-page="@Model.CurrentPage">
                                            <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
                                            <span>Sửa</span>
                                        </a>

                                        @if (!item.IsAdministrator && item.IDTaiKhoan.HasValue)
                                        {
                                            <a class="table-action-button role"
                                               asp-action="Index"
                                               asp-route-keyword="@Model.Filter.Keyword"
                                               asp-route-statusFilter="@Model.Filter.StatusFilter"
                                               asp-route-page="@Model.CurrentPage"
                                               asp-route-roleEmployeeId="@item.Id">
                                                <i class="fa-solid fa-user-shield" aria-hidden="true"></i>
                                                <span>Vai trò</span>
                                            </a>
                                        }
                                        else if (!item.IsAdministrator)
                                        {
                                            <button type="button" class="table-action-button role" disabled title="Nhân viên chưa có tài khoản">
                                                <i class="fa-solid fa-user-shield" aria-hidden="true"></i>
                                                <span>Vai trò</span>
                                            </button>
                                        }

                                        @if (!item.IsAdministrator)
                                        {
                                            <form method="post" asp-action="Delete" class="inline-action-form">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="Id" value="@item.Id" />
                                                <input type="hidden" name="Keyword" value="@Model.Filter.Keyword" />
                                                <input type="hidden" name="StatusFilter" value="@Model.Filter.StatusFilter" />
                                                <input type="hidden" name="Page" value="@Model.CurrentPage" />
                                                <button type="submit"
                                                        class="table-action-button delete" asp-permission-action="delete"
                                                        data-delete-confirm="Bạn có chắc muốn xóa nhân viên này?">
                                                    <i class="fa-solid fa-trash-can" aria-hidden="true"></i>
                                                    <span>Xóa</span>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="pagination-bar" aria-label="Phân trang nhân viên">
                <a class="pagination-button @(Model.CurrentPage <= 1 ? "disabled" : "")"
                   asp-action="Index"
                   asp-route-keyword="@Model.Filter.Keyword"
                   asp-route-statusFilter="@Model.Filter.StatusFilter"
                   asp-route-page="@(Model.CurrentPage - 1)">
                    <i class="fa-solid fa-angle-left" aria-hidden="true"></i>
                    <span>Trước</span>
                </a>

                <div class="pagination-pages">
                    @foreach (var pageNumber in Model.VisiblePages)
                    {
                        <a class="pagination-page @(pageNumber == Model.CurrentPage ? "active" : "")"
                           asp-action="Index"
                           asp-route-keyword="@Model.Filter.Keyword"
                           asp-route-statusFilter="@Model.Filter.StatusFilter"
                           asp-route-page="@pageNumber">
                            @pageNumber
                        </a>
                    }
                </div>

                <a class="pagination-button @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")"
                   asp-action="Index"
                   asp-route-keyword="@Model.Filter.Keyword"
                   asp-route-statusFilter="@Model.Filter.StatusFilter"
                   asp-route-page="@(Model.CurrentPage + 1)">
                    <span>Sau</span>
                    <i class="fa-solid fa-angle-right" aria-hidden="true"></i>
                </a>
            </nav>
        }
    </article>

    @if (Model.IsRolePopupOpen && Model.RoleAssignment is not null)
    {
        <div class="crud-modal-shell" data-crud-modal-shell>
            <div class="crud-modal-backdrop" aria-hidden="true"></div>

            <section class="crud-modal" role="dialog" aria-modal="true" aria-labelledby="nhan-vien-role-title">
                <div class="crud-modal-header">
                    <div class="crud-modal-heading">
                        <h2 id="nhan-vien-role-title">Phân vai trò</h2>
                        <p class="crud-modal-subtitle">@Model.RoleAssignment.EmployeeName (@(string.IsNullOrWhiteSpace(Model.RoleAssignment.Username) ? "chưa có tên đăng nhập" : Model.RoleAssignment.Username))</p>
                    </div>

                    <a class="crud-modal-close-button"
                       asp-action="Index"
                       asp-route-keyword="@Model.Filter.Keyword"
                       asp-route-statusFilter="@Model.Filter.StatusFilter"
                       asp-route-page="@Model.CurrentPage"
                       aria-label="Đóng popup">
                        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                    </a>
                </div>

                <form method="post" asp-action="SaveRoles">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="EmployeeId" value="@Model.RoleAssignment.EmployeeId" />
                    <input type="hidden" name="AccountId" value="@Model.RoleAssignment.AccountId" />
                    <input type="hidden" name="Keyword" value="@Model.Filter.Keyword" />
                    <input type="hidden" name="StatusFilter" value="@Model.Filter.StatusFilter" />
                    <input type="hidden" name="Page" value="@Model.CurrentPage" />

                    <div class="role-assignment-list">
                        @if (Model.RoleOptions.Count == 0)
                        {
                            <div class="master-data-empty">Chưa có vai trò khả dụng.</div>
                        }
                        else
                        {
                            @foreach (var role in Model.RoleOptions)
                            {
                                var selected = Model.RoleAssignment.SelectedRoleIds.Contains(role.Id);
                                <label class="role-assignment-item">
                                    <span class="role-assignment-check">
                                        <input type="checkbox" name="SelectedRoleIds" value="@role.Id" checked="@(selected ? "checked" : null)" />
                                    </span>
                                    <span class="role-assignment-copy">
                                        <strong>@role.TenVaiTro</strong>
                                        @if (!string.IsNullOrWhiteSpace(role.MieuTa))
                                        {
                                            <small>@role.MieuTa</small>
                                        }
                                    </span>
                                </label>
                            }
                        }
                    </div>

                    <div class="crud-modal-actions">
                        <a class="secondary-button crud-cancel-button"
                           asp-action="Index"
                           asp-route-keyword="@Model.Filter.Keyword"
                           asp-route-statusFilter="@Model.Filter.StatusFilter"
                           asp-route-page="@Model.CurrentPage">Hủy</a>
                        <button type="submit" class="primary-button" asp-permission-action="update">
                            <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i>
                            <span>Lưu vai trò</span>
                        </button>
                    </div>
                </form>
            </section>
        </div>
    }
</section>
