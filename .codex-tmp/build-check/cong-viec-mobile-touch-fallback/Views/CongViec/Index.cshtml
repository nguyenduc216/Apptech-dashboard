@using System.Globalization
@model CongViecManagementViewModel
@{
    ViewData["Title"] = "Công việc";
    ViewData["Breadcrumb"] = "Trang chủ / Danh mục / Công việc";

    var tenCongViecHasError = ViewData.ModelState.TryGetValue("Form.TenCongViec", out var tenCongViecState) && tenCongViecState.Errors.Count > 0;
    var mieuTaHasError = ViewData.ModelState.TryGetValue("Form.MieuTa", out var mieuTaState) && mieuTaState.Errors.Count > 0;
    var donGiaHasError = ViewData.ModelState.TryGetValue("Form.DonGia", out var donGiaState) && donGiaState.Errors.Count > 0;
    var soLuongAnhCheckInHasError = ViewData.ModelState.TryGetValue("Form.SoLuongAnhCheckIn", out var soLuongAnhCheckInState) && soLuongAnhCheckInState.Errors.Count > 0;
    var soLuongAnhCheckOutHasError = ViewData.ModelState.TryGetValue("Form.SoLuongAnhCheckOut", out var soLuongAnhCheckOutState) && soLuongAnhCheckOutState.Errors.Count > 0;
    var trangThaiHasError = ViewData.ModelState.TryGetValue("Form.TrangThaiSuDung", out var trangThaiState) && trangThaiState.Errors.Count > 0;
    var summaryErrors = ViewData.ModelState.TryGetValue(string.Empty, out var summaryState)
        ? summaryState.Errors.Select(error => error.ErrorMessage).Where(message => !string.IsNullOrWhiteSpace(message)).ToArray()
        : [];
    var viCulture = CultureInfo.GetCultureInfo("vi-VN");
    var donGiaDisplay = Model.Form.DonGia.HasValue ? Model.Form.DonGia.Value.ToString("#,##0", viCulture) : string.Empty;
    var activeTab = string.IsNullOrWhiteSpace(Model.Form.ActiveTab) ? "cong-viec" : Model.Form.ActiveTab;
    var checklistItems = Model.Form.DanhSachChecklist
        .OrderBy(item => item.ViTri > 0 ? item.ViTri : int.MaxValue)
        .ThenBy(item => item.TenChecklist)
        .ToList();
}

@if (Model.ShouldClearChecklistDraftCache)
{
    <div data-cong-viec-checklist-clear-draft hidden></div>
}

<section class="master-data-page">
    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="floating-status-toast @Model.StatusType"
             data-status-toast
             role="status"
             aria-live="polite">
            <div class="floating-status-toast-icon" aria-hidden="true">
                <i class="fa-solid @(Model.StatusType == "success" ? "fa-circle-check" : Model.StatusType == "error" ? "fa-circle-exclamation" : "fa-circle-info")"></i>
            </div>
            <div class="floating-status-toast-body">
                <strong>@(Model.StatusType == "success" ? "Thành công" : Model.StatusType == "error" ? "Có lỗi xảy ra" : "Thông báo")</strong>
                <span>@Model.StatusMessage</span>
            </div>
            <button type="button" class="floating-status-toast-close" data-status-toast-close aria-label="Đóng thông báo">
                <span aria-hidden="true">×</span>
            </button>
        </div>
    }

    <article class="panel master-data-panel">
        <div class="panel-header master-data-header">
            <div>
                <h3>Danh sách công việc</h3>
                <p>Quản lý danh mục công việc, đơn giá và số lượng ảnh check-in/check-out.</p>
            </div>

            <div class="master-data-header-actions">
                <div class="data-actions" data-data-actions>
                    <button type="button"
                            class="secondary-button data-actions-trigger"
                            data-data-actions-trigger
                            aria-haspopup="menu"
                            aria-expanded="false">
                        <i class="fa-solid fa-database" aria-hidden="true"></i>
                        <span>Data</span>
                        <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
                    </button>

                    <div class="data-actions-menu" data-data-actions-menu hidden>
                        <button type="button" class="data-actions-item" data-import-trigger>
                            <i class="fa-solid fa-file-arrow-up" aria-hidden="true"></i>
                            <span>Import data</span>
                        </button>
                        <a class="data-actions-item" asp-action="ExportTemplate">
                            <i class="fa-solid fa-file-excel" aria-hidden="true"></i>
                            <span>Export template</span>
                        </a>
                    </div>
                </div>

                <a class="master-data-add-button"
                   asp-action="Index"
                   asp-route-keyword="@Model.Filter.Keyword"
                   asp-route-statusFilter="@Model.Filter.StatusFilter"
                   asp-route-page="@Model.CurrentPage"
                   asp-route-showCreatePopup="true">
                    <i class="fa-solid fa-plus" aria-hidden="true"></i>
                    <span>Thêm mới</span>
                </a>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
        {
            <div class="page-alert @Model.StatusType master-data-status-alert">
                <i class="fa-solid @(Model.StatusType == "success" ? "fa-circle-check" : Model.StatusType == "error" ? "fa-circle-exclamation" : "fa-circle-info")" aria-hidden="true"></i>
                <span>@Model.StatusMessage</span>
            </div>
        }

        <form method="post" asp-action="ImportData" enctype="multipart/form-data" class="data-import-form" data-import-form>
            @Html.AntiForgeryToken()
            <input type="hidden" name="keyword" value="@Model.Filter.Keyword" />
            <input type="hidden" name="statusFilter" value="@Model.Filter.StatusFilter" />
            <input type="hidden" name="page" value="@Model.CurrentPage" />
            <input type="file"
                   name="file"
                   accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
                   data-import-file
                   hidden />
        </form>

        <form method="get" asp-action="Index" class="master-data-filter-form">
            <label class="master-data-filter-field" for="keyword">
                <span>Tìm theo tên công việc / mô tả</span>
                <span class="login-input-shell">
                    <i class="fa-solid fa-briefcase" aria-hidden="true"></i>
                    <input id="keyword" name="keyword" type="search" value="@Model.Filter.Keyword" placeholder="Nhập tên công việc hoặc mô tả..." />
                </span>
            </label>

            <label class="master-data-filter-field" for="statusFilter">
                <span>Trạng thái kích hoạt</span>
                <span class="login-input-shell select-shell">
                    <i class="fa-solid fa-power-off" aria-hidden="true"></i>
                    <select id="statusFilter" name="statusFilter">
                        @if (Model.Filter.StatusFilter is null)
                        {
                            <option value="" selected>Tất cả trạng thái</option>
                        }
                        else
                        {
                            <option value="">Tất cả trạng thái</option>
                        }

                        @if (Model.Filter.StatusFilter == true)
                        {
                            <option value="true" selected>Kích hoạt</option>
                        }
                        else
                        {
                            <option value="true">Kích hoạt</option>
                        }

                        @if (Model.Filter.StatusFilter == false)
                        {
                            <option value="false" selected>Khóa</option>
                        }
                        else
                        {
                            <option value="false">Khóa</option>
                        }
                    </select>
                    <span class="select-indicator"><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></span>
                </span>
            </label>

            <div class="master-data-filter-actions">
                <button type="submit" class="primary-button master-data-filter-button">
                    <span class="button-content">
                        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                        <span>Tìm kiếm</span>
                    </span>
                    <span class="button-processing" aria-hidden="true">
                        <span class="button-processing-dot"></span>
                        <span class="button-processing-text">Đang xử lý</span>
                    </span>
                </button>

                <a class="secondary-button master-data-reset-button" asp-action="Index">Làm mới</a>
            </div>
        </form>

        <div class="master-data-summary">
            <div><strong>@Model.TotalCount</strong> công việc</div>
            <div>Trang <strong>@Model.CurrentPage</strong>@(Model.TotalPages > 0 ? $" / {Model.TotalPages}" : "")</div>
        </div>

        <div class="table-wrap">
            <table class="data-table master-data-table">
                <thead>
                    <tr>
                        <th>Tên công việc</th>
                        <th>Mô tả</th>
                        <th>Đơn giá</th>
                        <th>Ảnh check-in</th>
                        <th>Ảnh check-out</th>
                        <th>Trạng thái</th>
                        <th class="actions-col">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="master-data-empty">Không có dữ liệu phù hợp.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td><div class="master-data-name">@item.TenCongViec</div></td>
                                <td>@(string.IsNullOrWhiteSpace(item.MieuTa) ? "-" : item.MieuTa)</td>
                                <td>@(item.DonGia.HasValue ? item.DonGia.Value.ToString("#,##0", viCulture) : "-")</td>
                                <td>@(item.SoLuongAnhCheckIn?.ToString(viCulture) ?? "-")</td>
                                <td>@(item.SoLuongAnhCheckOut?.ToString(viCulture) ?? "-")</td>
                                <td>
                                    <span class="status-pill @(item.TrangThaiSuDung ? "active" : "locked")">
                                        @(item.TrangThaiSuDung ? "Kích hoạt" : "Khóa")
                                    </span>
                                </td>
                                <td class="actions-col">
                                    <div class="master-data-actions">
                                        <a class="table-action-button edit"
                                           asp-action="Index"
                                           asp-route-keyword="@Model.Filter.Keyword"
                                           asp-route-statusFilter="@Model.Filter.StatusFilter"
                                           asp-route-page="@Model.CurrentPage"
                                           asp-route-editId="@item.Id">
                                            <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
                                            <span>Sửa</span>
                                        </a>

                                        <form method="post" asp-action="Delete" class="inline-action-form">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="Id" value="@item.Id" />
                                            <input type="hidden" name="Keyword" value="@Model.Filter.Keyword" />
                                            <input type="hidden" name="StatusFilter" value="@Model.Filter.StatusFilter" />
                                            <input type="hidden" name="Page" value="@Model.CurrentPage" />
                                            <button type="submit"
                                                    class="table-action-button delete"
                                                    data-delete-confirm="Bạn có chắc muốn xóa công việc này?">
                                                <i class="fa-solid fa-trash-can" aria-hidden="true"></i>
                                                <span>Xóa</span>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="pagination-bar" aria-label="Phân trang công việc">
                <a class="pagination-button @(Model.CurrentPage <= 1 ? "disabled" : "")"
                   asp-action="Index"
                   asp-route-keyword="@Model.Filter.Keyword"
                   asp-route-statusFilter="@Model.Filter.StatusFilter"
                   asp-route-page="@(Model.CurrentPage - 1)">
                    <i class="fa-solid fa-angle-left" aria-hidden="true"></i>
                    <span>Trước</span>
                </a>

                <div class="pagination-pages">
                    @foreach (var pageNumber in Model.VisiblePages)
                    {
                        <a class="pagination-page @(pageNumber == Model.CurrentPage ? "active" : "")"
                           asp-action="Index"
                           asp-route-keyword="@Model.Filter.Keyword"
                           asp-route-statusFilter="@Model.Filter.StatusFilter"
                           asp-route-page="@pageNumber">
                            @pageNumber
                        </a>
                    }
                </div>

                <a class="pagination-button @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")"
                   asp-action="Index"
                   asp-route-keyword="@Model.Filter.Keyword"
                   asp-route-statusFilter="@Model.Filter.StatusFilter"
                   asp-route-page="@(Model.CurrentPage + 1)">
                    <span>Sau</span>
                    <i class="fa-solid fa-angle-right" aria-hidden="true"></i>
                </a>
            </nav>
        }
    </article>
</section>

@if (Model.IsPopupOpen)
{
    <div class="crud-modal-shell" data-crud-modal-shell>
        <div class="crud-modal-backdrop" aria-hidden="true"></div>

        <section class="crud-modal cong-viec-modal" role="dialog" aria-modal="true" aria-labelledby="cong-viec-modal-title">
            <div class="crud-modal-header">
                <div class="crud-modal-heading">
                    <h2 id="cong-viec-modal-title">@Model.PopupTitle</h2>
                    <p class="crud-modal-subtitle">Cập nhật thông tin công việc và danh sách checklist. Có thể kéo thả checklist để sắp xếp vị trí ngay trong popup.</p>
                </div>

                <a class="menu-nav-button crud-close-button"
                   data-crud-modal-close
                   aria-label="Đóng popup"
                   asp-action="Index"
                   asp-route-keyword="@Model.Filter.Keyword"
                   asp-route-statusFilter="@Model.Filter.StatusFilter"
                   asp-route-page="@Model.CurrentPage">
                    <span aria-hidden="true">&times;</span>
                </a>
            </div>

            <form method="post"
                  asp-action="@Model.SubmitAction"
                  class="account-form crud-form"
                  data-cong-viec-checklist-manager-root
                  data-draft-enabled="@(Model.PopupMode == CongViecPopupMode.Create ? "true" : "false")">
                @Html.AntiForgeryToken()

                <input asp-for="Form.Id" type="hidden" />
                <input asp-for="Form.Keyword" type="hidden" />
                <input asp-for="Form.StatusFilter" type="hidden" />
                <input asp-for="Form.Page" type="hidden" />

                @if (summaryErrors.Length > 0)
                {
                    <div class="page-alert error validation-summary">
                        <i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i>
                        <div>
                            @foreach (var message in summaryErrors)
                            {
                                <div>@message</div>
                            }
                        </div>
                    </div>
                }

                <div class="crud-tabs" data-tab-group>
                    <input asp-for="Form.ActiveTab" type="hidden" data-active-tab-input />

                    <div class="crud-tab-list" role="tablist" aria-label="Nhóm thông tin công việc">
                        <button type="button"
                                class="crud-tab-button @(activeTab == "cong-viec" ? "is-active" : "")"
                                data-tab-button
                                data-tab="cong-viec"
                                role="tab"
                                aria-selected="@(activeTab == "cong-viec" ? "true" : "false")">
                            <i class="fa-solid fa-briefcase" aria-hidden="true"></i>
                            <span>Công việc</span>
                        </button>

                        <button type="button"
                                class="crud-tab-button @(activeTab == "danh-sach-checklist" ? "is-active" : "")"
                                data-tab-button
                                data-tab="danh-sach-checklist"
                                role="tab"
                                aria-selected="@(activeTab == "danh-sach-checklist" ? "true" : "false")">
                            <i class="fa-solid fa-list-check" aria-hidden="true"></i>
                            <span>Danh sách checklist</span>
                        </button>
                    </div>

                    <div class="crud-tab-panel @(activeTab == "cong-viec" ? "is-active" : "")"
                         data-tab-panel
                         data-tab="cong-viec"
                         role="tabpanel"
                         @(activeTab == "cong-viec" ? null : "hidden")>
                        <div class="account-form-grid single-column">
                            <label class="login-field @(tenCongViecHasError ? "has-error" : "")">
                                <span>Tên công việc</span>
                                <span class="login-input-shell">
                                    <i class="fa-solid fa-briefcase" aria-hidden="true"></i>
                                    <input asp-for="Form.TenCongViec" autocomplete="off" autofocus />
                                </span>
                                <span asp-validation-for="Form.TenCongViec" class="login-field-error"></span>
                            </label>

                            <label class="login-field @(mieuTaHasError ? "has-error" : "")">
                                <span>Mô tả</span>
                                <span class="login-textarea-shell">
                                    <i class="fa-solid fa-align-left" aria-hidden="true"></i>
                                    <textarea asp-for="Form.MieuTa" rows="3" placeholder="Nhập mô tả ngắn cho công việc..."></textarea>
                                </span>
                                <span asp-validation-for="Form.MieuTa" class="login-field-error"></span>
                            </label>

                            <label class="login-field @(donGiaHasError ? "has-error" : "")">
                                <span>Đơn giá</span>
                                <span class="login-input-shell">
                                    <i class="fa-solid fa-money-bill-wave" aria-hidden="true"></i>
                                    <input asp-for="Form.DonGia" type="hidden" data-digit-group-target />
                                    <input type="text"
                                           value="@donGiaDisplay"
                                           inputmode="numeric"
                                           autocomplete="off"
                                           data-digit-group-input
                                           data-digit-group-locale="vi-VN" />
                                </span>
                                <span asp-validation-for="Form.DonGia" class="login-field-error"></span>
                            </label>

                            <label class="login-field @(soLuongAnhCheckInHasError ? "has-error" : "")">
                                <span>Số lượng ảnh check-in</span>
                                <span class="login-input-shell">
                                    <i class="fa-solid fa-camera" aria-hidden="true"></i>
                                    <input asp-for="Form.SoLuongAnhCheckIn"
                                           type="number"
                                           inputmode="numeric"
                                           pattern="[0-9]*"
                                           min="0"
                                           step="1"
                                           autocomplete="off" />
                                </span>
                                <span asp-validation-for="Form.SoLuongAnhCheckIn" class="login-field-error"></span>
                            </label>

                            <label class="login-field @(soLuongAnhCheckOutHasError ? "has-error" : "")">
                                <span>Số lượng ảnh check-out</span>
                                <span class="login-input-shell">
                                    <i class="fa-solid fa-camera-retro" aria-hidden="true"></i>
                                    <input asp-for="Form.SoLuongAnhCheckOut"
                                           type="number"
                                           inputmode="numeric"
                                           pattern="[0-9]*"
                                           min="0"
                                           step="1"
                                           autocomplete="off" />
                                </span>
                                <span asp-validation-for="Form.SoLuongAnhCheckOut" class="login-field-error"></span>
                            </label>

                            <label class="login-field @(trangThaiHasError ? "has-error" : "")">
                                <span>Trạng thái sử dụng</span>
                                <span class="switch-field-shell">
                                    <span class="switch-field-icon">
                                        <i class="fa-solid fa-toggle-on" aria-hidden="true"></i>
                                    </span>
                                    <label class="status-switch">
                                        <input asp-for="Form.TrangThaiSuDung" class="status-switch-input" />
                                        <span class="status-switch-track">
                                            <span class="status-switch-thumb"></span>
                                        </span>
                                        <span class="status-switch-labels" aria-hidden="true">
                                            <span>Kích hoạt</span>
                                            <span>Khóa</span>
                                        </span>
                                    </label>
                                </span>
                            </label>
                        </div>
                    </div>

                    <div class="crud-tab-panel @(activeTab == "danh-sach-checklist" ? "is-active" : "")"
                         data-tab-panel
                         data-tab="danh-sach-checklist"
                         role="tabpanel"
                         @(activeTab == "danh-sach-checklist" ? null : "hidden")>
                        <div class="cong-viec-checklist-panel" data-cong-viec-checklist-manager>
                            <div class="cong-viec-checklist-toolbar">
                                <div>
                                    <h3>Checklist công việc</h3>
                                    <p>Thêm các đầu mục checklist, bật/tắt trạng thái sử dụng và kéo thả để đổi vị trí.</p>
                                </div>

                                <button type="button" class="secondary-button" data-checklist-add>
                                    <i class="fa-solid fa-plus" aria-hidden="true"></i>
                                    <span>Thêm checklist</span>
                                </button>
                            </div>

                            <div class="cong-viec-checklist-empty @(checklistItems.Count > 0 ? "is-hidden" : null)" data-checklist-empty>
                                <i class="fa-regular fa-clipboard" aria-hidden="true"></i>
                                <span>Chưa có checklist nào. Nhấn “Thêm checklist” để bắt đầu.</span>
                            </div>

                            <div class="cong-viec-checklist-list" data-checklist-list>
                                @for (var index = 0; index < checklistItems.Count; index++)
                                {
                                    var checklist = checklistItems[index];

                                    <article class="cong-viec-checklist-item" data-checklist-item>
                                        <button type="button"
                                                class="cong-viec-checklist-drag"
                                                data-checklist-drag-handle
                                                draggable="true"
                                                aria-label="Kéo để sắp xếp checklist">
                                            <i class="fa-solid fa-grip-vertical" aria-hidden="true"></i>
                                        </button>

                                        <div class="cong-viec-checklist-content">
                                            <div class="cong-viec-checklist-meta">
                                                <span class="cong-viec-checklist-position-badge">
                                                    Vị trí <strong data-checklist-position-label>@(index + 1)</strong>
                                                </span>
                                            </div>

                                            <input type="hidden"
                                                   name="Form.DanhSachChecklist[@index].ViTri"
                                                   value="@(index + 1)"
                                                   data-checklist-position />
                                            <input type="hidden"
                                                   name="Form.DanhSachChecklist[@index].TrangThaiSuDung"
                                                   value="@(checklist.TrangThaiSuDung ? "true" : "false")"
                                                   data-checklist-status />

                                            <label class="login-field">
                                                <span>Tên checklist</span>
                                                <span class="login-input-shell">
                                                    <i class="fa-solid fa-list-check" aria-hidden="true"></i>
                                                    <input type="text"
                                                           name="Form.DanhSachChecklist[@index].TenChecklist"
                                                           value="@checklist.TenChecklist"
                                                           maxlength="250"
                                                           autocomplete="off"
                                                           placeholder="Nhập tên checklist..."
                                                           data-checklist-name />
                                                </span>
                                            </label>

                                            <div class="cong-viec-checklist-actions">
                                                <div class="login-field cong-viec-checklist-status-field">
                                                    <span>Trạng thái sử dụng</span>
                                                    <span class="switch-field-shell">
                                                        <span class="switch-field-icon">
                                                            <i class="fa-solid fa-toggle-on" aria-hidden="true"></i>
                                                        </span>
                                                        <label class="status-switch">
                                                            <input type="checkbox"
                                                                   class="status-switch-input"
                                                                   data-checklist-enabled
                                                                   @(checklist.TrangThaiSuDung ? "checked" : null) />
                                                            <span class="status-switch-track">
                                                                <span class="status-switch-thumb"></span>
                                                            </span>
                                                            <span class="status-switch-labels" aria-hidden="true">
                                                                <span>Kích hoạt</span>
                                                                <span>Khóa</span>
                                                            </span>
                                                        </label>
                                                    </span>
                                                </div>

                                                <button type="button" class="table-action-button delete" data-checklist-remove>
                                                    <i class="fa-solid fa-trash-can" aria-hidden="true"></i>
                                                    <span>Xóa</span>
                                                </button>
                                            </div>
                                        </div>
                                    </article>
                                }
                            </div>

                            <template data-checklist-template>
                                <article class="cong-viec-checklist-item" data-checklist-item>
                                    <button type="button"
                                            class="cong-viec-checklist-drag"
                                            data-checklist-drag-handle
                                            draggable="true"
                                            aria-label="Kéo để sắp xếp checklist">
                                        <i class="fa-solid fa-grip-vertical" aria-hidden="true"></i>
                                    </button>

                                    <div class="cong-viec-checklist-content">
                                        <div class="cong-viec-checklist-meta">
                                            <span class="cong-viec-checklist-position-badge">
                                                Vị trí <strong data-checklist-position-label>1</strong>
                                            </span>
                                        </div>

                                        <input type="hidden" value="1" data-checklist-position />
                                        <input type="hidden" value="true" data-checklist-status />

                                        <label class="login-field">
                                            <span>Tên checklist</span>
                                            <span class="login-input-shell">
                                                <i class="fa-solid fa-list-check" aria-hidden="true"></i>
                                                <input type="text"
                                                       maxlength="250"
                                                       autocomplete="off"
                                                       placeholder="Nhập tên checklist..."
                                                       data-checklist-name />
                                            </span>
                                        </label>

                                        <div class="cong-viec-checklist-actions">
                                            <div class="login-field cong-viec-checklist-status-field">
                                                <span>Trạng thái sử dụng</span>
                                                <span class="switch-field-shell">
                                                    <span class="switch-field-icon">
                                                        <i class="fa-solid fa-toggle-on" aria-hidden="true"></i>
                                                    </span>
                                                    <label class="status-switch">
                                                        <input type="checkbox" class="status-switch-input" data-checklist-enabled checked />
                                                        <span class="status-switch-track">
                                                            <span class="status-switch-thumb"></span>
                                                        </span>
                                                        <span class="status-switch-labels" aria-hidden="true">
                                                            <span>Kích hoạt</span>
                                                            <span>Khóa</span>
                                                        </span>
                                                    </label>
                                                </span>
                                            </div>

                                            <button type="button" class="table-action-button delete" data-checklist-remove>
                                                <i class="fa-solid fa-trash-can" aria-hidden="true"></i>
                                                <span>Xóa</span>
                                            </button>
                                        </div>
                                    </div>
                                </article>
                            </template>
                        </div>
                    </div>
                </div>

                <div class="crud-modal-actions">
                    <a class="secondary-button crud-cancel-button"
                       asp-action="Index"
                       asp-route-keyword="@Model.Filter.Keyword"
                       asp-route-statusFilter="@Model.Filter.StatusFilter"
                       asp-route-page="@Model.CurrentPage">
                        Hủy
                    </a>

                    <button type="submit" class="primary-button" data-processing-button data-processing-text="Đang lưu">
                        <span class="button-content">
                            <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i>
                            <span>@(Model.PopupMode == CongViecPopupMode.Edit ? "Lưu cập nhật" : "Thêm mới")</span>
                        </span>
                        <span class="button-processing" aria-hidden="true">
                            <span class="button-processing-dot"></span>
                            <span class="button-processing-text">Đang lưu</span>
                        </span>
                    </button>
                </div>
            </form>
        </section>
    </div>
}
