@model DashboardViewModel
@{
    ViewData["Title"] = Model.DashboardTitle;
    var chamCong = Model.ChamCong;
    var invariantCulture = System.Globalization.CultureInfo.InvariantCulture;
    var isolateChamCongDashboard = true;
    var allChamCongEmployeesSelected = chamCong.EmployeeOptions.Count > 0 &&
        chamCong.SelectedEmployeeIds.Count >= chamCong.EmployeeOptions.Count;

    string GetPriorityClass(string priority) => priority switch
    {
        "Cao" => "cao",
        "Trung bình" => "trung-binh",
        "Thấp" => "thap",
        _ => "thap"
    };
}

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
          integrity="sha256-p4NxAoJBhIINfQ8QzPI5Z7nU03RLX10PVtPY3GqB4iI="
          crossorigin="" />
}

@if (!isolateChamCongDashboard)
{
<section class="hero-panel">
    <div>
        <div class="eyebrow">GIÁM SÁT TRUNG TÂM</div>
        <h2>@Model.CompanyName</h2>
        <p>@Model.Subtitle</p>
    </div>
    <div class="hero-stats">
        <div class="hero-pill">
            <span>Khách hàng đang kết nối</span>
            <strong>32 công trình</strong>
        </div>
        <div class="hero-pill">
            <span>Tỷ lệ hệ thống ổn định</span>
            <strong>94.8%</strong>
        </div>
    </div>
</section>

<section class="metrics-grid">
    @foreach (var item in Model.MetricCards)
    {
        <article class="metric-card @item.Variant">
            <div class="metric-title">@item.Title</div>
            <div class="metric-value">@item.Value</div>
            <div class="metric-note">@item.Note</div>
        </article>
    }
</section>
}

<section class="panel cham-cong-panel"
         data-cham-cong
         data-history-url="@Url.Action("ChamCongHistory", "Home")"
         data-checkin-url="@Url.Action("ChamCongCheckin", "Home")"
         data-checkout-url="@Url.Action("ChamCongCheckout", "Home")"
         data-distance-limit="@(chamCong.CheckinDistanceLimitMeters?.ToString(invariantCulture) ?? "")"
         data-current-employee-id="@(chamCong.CurrentEmployeeId?.ToString(invariantCulture) ?? "")"
         data-action-employee-id="@(chamCong.SelectedEmployeeIds.FirstOrDefault(chamCong.CurrentEmployeeId ?? 0).ToString(invariantCulture))"
         data-can-select-employees="@chamCong.CanSelectEmployees.ToString().ToLowerInvariant()"
         data-can-admin-manage-attendance="@chamCong.CanAdminManageAttendance.ToString().ToLowerInvariant()"
         data-today-date="@DateTime.Today.ToString("yyyy-MM-dd")"
         data-open-checkin-id="@(chamCong.OpenCheckin?.Id.ToString(invariantCulture) ?? "")">
    <div class="panel-header">
        <div>
            <h3>Chấm công</h3>
            <p>Checkin tại địa điểm khách hàng AppTech và theo dõi lịch sử trong ngày.</p>
        </div>
        <form class="cham-cong-date-form" method="get" asp-action="Index">
            <label class="master-data-filter-field" for="chamCongDate">
                <span>Ngày xem</span>
                <span class="cham-cong-date-stepper">
                    <button type="button"
                            class="cham-cong-date-step-button"
                            data-cham-cong-date-step="-1"
                            aria-label="Ngày trước"
                            title="Ngày trước">
                        <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
                    </button>
                    <span class="login-input-shell">
                        <i class="fa-solid fa-calendar-day" aria-hidden="true"></i>
                        <input id="chamCongDate"
                               name="chamCongDate"
                               type="date"
                               value="@chamCong.SelectedDate.ToString("yyyy-MM-dd")"
                               data-cham-cong-date />
                    </span>
                    <button type="button"
                            class="cham-cong-date-step-button"
                            data-cham-cong-date-step="1"
                            aria-label="Ngày sau"
                            title="Ngày sau">
                        <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
                    </button>
                </span>
            </label>
            @if (chamCong.CanSelectEmployees)
            {
                <label class="master-data-filter-field" for="chamCongEmployees">
                    <span>Nhân viên</span>
                    <span class="cham-cong-employee-picker" data-cham-cong-employee-picker>
                        <button type="button"
                                class="login-input-shell cham-cong-employee-picker-button"
                                id="chamCongEmployees"
                                data-cham-cong-employee-toggle
                                aria-expanded="false">
                            <i class="fa-solid fa-users" aria-hidden="true"></i>
                            <span data-cham-cong-employee-summary>Chọn nhân viên</span>
                            <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
                        </button>
                        <span class="cham-cong-employee-menu" data-cham-cong-employee-menu hidden>
                            <label class="cham-cong-employee-choice cham-cong-employee-choice-all">
                                <input type="checkbox"
                                       checked="@allChamCongEmployeesSelected"
                                       data-cham-cong-employee-all />
                                <span>Tất cả nhân viên</span>
                            </label>
                            @foreach (var employee in chamCong.EmployeeOptions)
                            {
                                <label class="cham-cong-employee-choice">
                                    <input type="checkbox"
                                           name="employeeIds"
                                           value="@employee.Id"
                                           checked="@chamCong.SelectedEmployeeIds.Contains(employee.Id)"
                                           data-cham-cong-employee-checkbox />
                                    <span>@employee.HoTen</span>
                                </label>
                            }
                        </span>
                    </span>
                </label>
            }
        </form>
    </div>

    @Html.AntiForgeryToken()

    <div class="cham-cong-body">
        <div class="cham-cong-timeline">
            <div class="cham-cong-timeline-head">
                <strong>Lịch sử chấm công</strong>
                <span data-cham-cong-history-count>@chamCong.History.Count lượt</span>
            </div>
            <div class="cham-cong-timeline-list" data-cham-cong-history>
                @if (chamCong.History.Count == 0)
                {
                    <div class="cham-cong-empty">Chưa có dữ liệu chấm công trong ngày đã chọn.</div>
                }
                else
                {
                    var orderedHistory = chamCong.History
                        .OrderBy(item => item.ThoiDiem ?? DateTime.MaxValue)
                        .ThenBy(item => item.Id)
                        .ToList();
                    for (var historyIndex = 0; historyIndex < orderedHistory.Count; historyIndex++)
                    {
                        var item = orderedHistory[historyIndex];
                        <div class="cham-cong-timeline-item @(item.ThoiDiemCheckOut.HasValue ? "is-complete" : "is-pending") @(item.IsOpen ? "is-open" : "")" style="order:@historyIndex">
                            <div class="cham-cong-dot"></div>
                            <div class="cham-cong-split">
                                <strong class="cham-cong-employee-name">@(item.HoTenNhanVien ?? "Nhân viên")</strong>
                                <section class="cham-cong-attendance-line is-checkin @(item.IsCheckinViolation ? "is-attendance-violation" : "")">
                                    <div class="cham-cong-entry-photo">
                                        @if (!string.IsNullOrWhiteSpace(item.ImgPath))
                                        {
                                            <button type="button" class="cham-cong-entry-image-button" data-cham-cong-image-open data-image-src="@item.ImgPath" data-image-title="Ảnh checkin @item.HoTenNhanVien">
                                                <img src="@item.ImgPath" alt="Ảnh checkin" />
                                            </button>
                                        }
                                        else
                                        {
                                            <i class="fa-solid fa-image" aria-hidden="true"></i>
                                        }
                                    </div>
                                    <div class="cham-cong-entry-content">
                                        <strong><i class="fa-solid fa-right-to-bracket" aria-hidden="true"></i>@(item.ThoiDiem?.ToString("dd/MM/yyyy HH:mm") ?? "--:--")</strong>
                                        @if (!string.IsNullOrWhiteSpace(item.GhiChuNhanVien))
                                        {
                                            <p class="cham-cong-note"><i class="fa-solid fa-note-sticky" aria-hidden="true"></i><span>@item.GhiChuNhanVien</span></p>
                                        }
                                    </div>
                                </section>
                                <section class="cham-cong-attendance-line @(item.ThoiDiemCheckOut.HasValue ? "is-checkout-complete" : "is-checkout-pending") @(item.IsCheckoutViolation ? "is-attendance-violation" : "")">
                                    <div class="cham-cong-entry-photo">
                                        @if (!string.IsNullOrWhiteSpace(item.ImgPathCheckOut))
                                        {
                                            <button type="button" class="cham-cong-entry-image-button" data-cham-cong-image-open data-image-src="@item.ImgPathCheckOut" data-image-title="Ảnh checkout @item.HoTenNhanVien">
                                                <img src="@item.ImgPathCheckOut" alt="Ảnh checkout" />
                                            </button>
                                        }
                                        else
                                        {
                                            <i class="fa-solid fa-image" aria-hidden="true"></i>
                                        }
                                    </div>
                                    <div class="cham-cong-entry-content">
                                        <strong><i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i>@(item.ThoiDiemCheckOut?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa checkout")</strong>
                                        @if (!string.IsNullOrWhiteSpace(item.GhiChuCheckOut))
                                        {
                                            <p class="cham-cong-note"><i class="fa-solid fa-note-sticky" aria-hidden="true"></i><span>@item.GhiChuCheckOut</span></p>
                                        }
                                    </div>
                                </section>
                                <section class="cham-cong-entry">
                                    <div class="cham-cong-entry-photo">
                                        @if (!string.IsNullOrWhiteSpace(item.ImgPath))
                                        {
                                            <img src="@item.ImgPath" alt="Ảnh checkin" />
                                        }
                                        else
                                        {
                                            <i class="fa-solid fa-image" aria-hidden="true"></i>
                                        }
                                    </div>
                                    <strong><i class="fa-solid fa-right-to-bracket" aria-hidden="true"></i>@(item.ThoiDiem?.ToString("HH:mm") ?? "--:--")</strong>
                                    @if (!string.IsNullOrWhiteSpace(item.GhiChuNhanVien))
                                    {
                                        <p class="cham-cong-note"><i class="fa-solid fa-note-sticky" aria-hidden="true"></i><span>@item.GhiChuNhanVien</span></p>
                                    }
                                </section>
                                <section class="cham-cong-entry">
                                    <div class="cham-cong-entry-photo">
                                        @if (!string.IsNullOrWhiteSpace(item.ImgPathCheckOut))
                                        {
                                            <img src="@item.ImgPathCheckOut" alt="Ảnh checkout" />
                                        }
                                        else
                                        {
                                            <i class="fa-solid fa-image" aria-hidden="true"></i>
                                        }
                                    </div>
                                    <strong><i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i>@(item.ThoiDiemCheckOut?.ToString("HH:mm") ?? "Đang làm")</strong>
                                    @if (!string.IsNullOrWhiteSpace(item.GhiChuCheckOut))
                                    {
                                        <p class="cham-cong-note"><i class="fa-solid fa-note-sticky" aria-hidden="true"></i><span>@item.GhiChuCheckOut</span></p>
                                    }
                                </section>
                                <strong>@(item.ThoiDiem?.ToString("HH:mm") ?? "--:--") - @(item.ThoiDiemCheckOut?.ToString("HH:mm") ?? "Đang làm")</strong>
                                <span>@(item.TenKhachHang ?? "AppTech")</span>
                                @if (!string.IsNullOrWhiteSpace(item.GhiChuNhanVien))
                                {
                                    <p class="cham-cong-note"><i class="fa-solid fa-note-sticky" aria-hidden="true"></i><span>@item.GhiChuNhanVien</span></p>
                                }
                                @if (!string.IsNullOrWhiteSpace(item.GhiChuCheckOut))
                                {
                                    <p class="cham-cong-note"><i class="fa-solid fa-flag-checkered" aria-hidden="true"></i><span>@item.GhiChuCheckOut</span></p>
                                }
                                <small>@(string.IsNullOrWhiteSpace(item.DiaChi) ? "Chưa có địa chỉ" : item.DiaChi)</small>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        <div class="cham-cong-control">
            <label class="master-data-filter-field @(chamCong.LocationOptions.Count <= 1 ? "cham-cong-location-hidden" : "")" for="chamCongLocation">
                <span>Địa điểm AppTech</span>
                <span class="login-input-shell select-shell">
                    <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
                    <select id="chamCongLocation" data-cham-cong-location @(chamCong.OpenCheckin is not null ? "disabled" : null)>
                        @if (chamCong.LocationOptions.Count == 0)
                        {
                            <option value="">Chưa có địa điểm AppTech</option>
                        }
                        else
                        {
                            @foreach (var location in chamCong.LocationOptions)
                            {
                                <option value="@location.IDDiaDiem"
                                        data-lat="@(location.LatAddress?.ToString(invariantCulture) ?? "")"
                                        data-long="@(location.LongAddress?.ToString(invariantCulture) ?? "")">
                                    @location.DisplayText
                                </option>
                            }
                        }
                    </select>
                    <span class="select-indicator"><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></span>
                </span>
            </label>

            <div class="cham-cong-actions">
                <button type="button"
                        class="primary-button"
                        data-cham-cong-checkin
                        @(chamCong.OpenCheckin is null && chamCong.CanCheckin ? null : "hidden")>
                    <span class="button-content">
                        <i class="fa-solid fa-right-to-bracket" aria-hidden="true"></i>
                        <span>Checkin</span>
                    </span>
                </button>
                <button type="button"
                        class="primary-button"
                        data-cham-cong-checkout
                        @(chamCong.OpenCheckin is not null ? null : "hidden")>
                    <span class="button-content">
                        <i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i>
                        <span>Checkout</span>
                    </span>
                </button>
            </div>

            <div class="page-alert info cham-cong-status" data-cham-cong-status>
                @if (!chamCong.CurrentEmployeeId.HasValue)
                {
                    <span>Tài khoản chưa liên kết nhân viên nên chưa thể chấm công.</span>
                }
                else if (chamCong.LocationOptions.Count == 0)
                {
                    <span>Chưa có địa điểm khách hàng mã AppTech để chấm công.</span>
                }
                else if (chamCong.OpenCheckin is not null)
                {
                    <span>Đang có lượt checkin chưa checkout.</span>
                }
                else
                {
                    <span>Sẵn sàng chấm công. Trình duyệt sẽ hỏi quyền GPS và camera khi bấm Checkin hoặc Checkout.</span>
                }
            </div>
        </div>
    </div>

    <div class="crud-modal-shell" data-cham-cong-camera-shell hidden>
        <div class="crud-modal-backdrop" aria-hidden="true"></div>
        <section class="crud-modal yeu-cau-checkin-modal" role="dialog" aria-modal="true" aria-labelledby="cham-cong-camera-title">
            <div class="crud-modal-header">
                <div class="crud-modal-heading">
                    <h2 id="cham-cong-camera-title" data-cham-cong-camera-title>Chụp ảnh chấm công</h2>
                    <p class="crud-modal-subtitle" data-cham-cong-camera-subtitle>Đang chờ lấy vị trí GPS.</p>
                </div>
                <button type="button" class="crud-modal-close" data-cham-cong-camera-close aria-label="Đóng">
                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </button>
            </div>
            <div class="crud-form yeu-cau-checkin-body">
                <input type="file" accept="image/*" data-cham-cong-file hidden />
                <div class="cham-cong-camera-map-shell">
                    <button type="button"
                            class="yeu-cau-checkin-distance-toggle"
                            data-state="info"
                            data-cham-cong-map-toggle
                            aria-expanded="false">
                        <span data-cham-cong-map-title>Khoảng cách: đang chờ GPS</span>
                        <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
                    </button>
                    <div class="yeu-cau-checkin-distance-content cham-cong-map-content" data-cham-cong-map-content hidden>
                        <div class="yeu-cau-checkin-distance-map cham-cong-camera-map" data-cham-cong-map></div>
                        <div class="yeu-cau-checkin-distance-status" data-cham-cong-map-status>
                            Đang chờ GPS để hiển thị vị trí chấm công.
                        </div>
                        <button type="button" class="secondary-button cham-cong-map-expand-button" data-cham-cong-map-fullscreen-open>
                            <i class="fa-solid fa-up-right-and-down-left-from-center" aria-hidden="true"></i>
                            <span>Mở rộng bản đồ</span>
                        </button>
                        <button type="button" class="secondary-button cham-cong-map-refresh-gps-button" data-cham-cong-refresh-gps>
                            <i class="fa-solid fa-location-crosshairs" aria-hidden="true"></i>
                            <span>Láº¥y láº¡i GPS</span>
                        </button>
                    </div>
                </div>
                <label class="login-field attendance-camera-select-shell" data-cham-cong-camera-select-shell hidden>
                    <span>Camera</span>
                    <span class="login-input-shell select-shell">
                        <i class="fa-solid fa-camera-rotate" aria-hidden="true"></i>
                        <select data-cham-cong-camera-select></select>
                        <span class="select-indicator"><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></span>
                    </span>
                </label>
                <div class="yeu-cau-checkin-camera">
                    <video playsinline autoplay muted data-cham-cong-video></video>
                    <canvas data-cham-cong-canvas hidden></canvas>
                    <img data-cham-cong-preview alt="Ảnh chấm công vừa chụp" hidden />
                    <div class="yeu-cau-checkin-placeholder" data-cham-cong-placeholder>
                        <i class="fa-solid fa-camera" aria-hidden="true"></i>
                        <span>Đang bật camera</span>
                    </div>
                </div>
                <div class="yeu-cau-checkin-actions">
                    <button type="button" class="secondary-button" data-cham-cong-capture>
                        <i class="fa-solid fa-camera" aria-hidden="true"></i>
                        <span>Chụp ảnh</span>
                    </button>
                    <button type="button" class="secondary-button" data-cham-cong-retake disabled>
                        <i class="fa-solid fa-trash-can" aria-hidden="true"></i>
                        <span>Bỏ ảnh</span>
                    </button>
                </div>
                @if (chamCong.CanSelectEmployees)
                {
                    <label class="master-data-filter-field" for="chamCongTime">
                        <span data-cham-cong-time-label>Thời gian checkin</span>
                        <span class="login-input-shell">
                            <i class="fa-solid fa-clock" aria-hidden="true"></i>
                            <input id="chamCongTime" type="datetime-local" data-cham-cong-time />
                        </span>
                    </label>
                }
                <label class="master-data-filter-field cham-cong-note-field" for="chamCongNote">
                    <span data-cham-cong-note-label>Ghi chú checkin</span>
                    <span class="login-textarea-shell">
                        <i class="fa-solid fa-note-sticky" aria-hidden="true"></i>
                        <textarea id="chamCongNote" rows="3" maxlength="1000" data-cham-cong-note></textarea>
                    </span>
                </label>
                <div class="page-alert info cham-cong-status" data-cham-cong-camera-status hidden></div>
            </div>
            <div class="crud-modal-footer cham-cong-camera-footer">
                <button type="button" class="primary-button" data-cham-cong-save>
                    <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i>
                    <span>Lưu</span>
                </button>
                <button type="button" class="secondary-button crud-cancel-button" data-cham-cong-camera-close>Hủy</button>
            </div>
        </section>
    </div>

    <div class="crud-modal-shell cham-cong-map-fullscreen-shell" data-location-view-shell data-cham-cong-map-fullscreen-shell hidden>
        <div class="crud-modal-backdrop" aria-hidden="true" data-cham-cong-map-fullscreen-close></div>
        <section class="crud-modal khach-hang-location-viewer cham-cong-map-fullscreen-modal" role="dialog" aria-modal="true" aria-labelledby="cham-cong-map-fullscreen-title">
            <div class="crud-modal-header">
                <div class="crud-modal-heading">
                    <h2 id="cham-cong-map-fullscreen-title">Bản đồ chấm công</h2>
                    <p class="crud-modal-subtitle" data-cham-cong-map-fullscreen-subtitle>Phóng to để xem chi tiết điểm khách hàng và vị trí hiện tại.</p>
                </div>
                <button type="button" class="crud-modal-close" data-cham-cong-map-fullscreen-close aria-label="Đóng bản đồ">
                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </button>
            </div>
            <div class="crud-form khach-hang-location-viewer-body cham-cong-map-fullscreen-body">
                <div class="khach-hang-location-viewer-map-shell">
                    <div class="khach-hang-location-map khach-hang-location-viewer-map cham-cong-map-fullscreen-canvas" data-cham-cong-map-fullscreen></div>
                    <div class="khach-hang-location-viewer-map-actions" aria-label="Tác vụ bản đồ">
                        <button type="button"
                                class="khach-hang-location-map-action"
                                data-cham-cong-map-refresh
                                aria-label="Làm mới bản đồ">
                            <i class="fa-solid fa-rotate-right" aria-hidden="true"></i>
                        </button>
                        <button type="button"
                                class="khach-hang-location-map-action"
                                data-cham-cong-map-route
                                aria-label="Chỉ đường">
                            <i class="fa-solid fa-route" aria-hidden="true"></i>
                        </button>
                        <a class="khach-hang-location-map-action"
                           href="#"
                           target="_blank"
                           rel="noopener"
                           data-cham-cong-map-external
                           aria-label="Mở bản đồ ngoài">
                            <i class="fa-solid fa-up-right-from-square" aria-hidden="true"></i>
                        </a>
                    </div>
                    <div class="khach-hang-location-viewer-status" data-cham-cong-map-route-status hidden></div>
                </div>
            </div>
        </section>
    </div>

    <div class="crud-modal-shell cham-cong-image-viewer-shell" data-cham-cong-image-viewer-shell hidden>
        <div class="crud-modal-backdrop" aria-hidden="true" data-cham-cong-image-close></div>
        <section class="crud-modal cham-cong-image-viewer" role="dialog" aria-modal="true" aria-labelledby="cham-cong-image-title">
            <div class="crud-modal-header">
                <div class="crud-modal-heading">
                    <h2 id="cham-cong-image-title" data-cham-cong-image-title>Ảnh chấm công</h2>
                </div>
                <div class="cham-cong-image-toolbar">
                    <button type="button" class="menu-nav-button" data-cham-cong-image-zoom-out aria-label="Thu nhỏ"><i class="fa-solid fa-magnifying-glass-minus" aria-hidden="true"></i></button>
                    <button type="button" class="menu-nav-button" data-cham-cong-image-zoom-in aria-label="Phóng to"><i class="fa-solid fa-magnifying-glass-plus" aria-hidden="true"></i></button>
                    <button type="button" class="menu-nav-button" data-cham-cong-image-rotate aria-label="Xoay"><i class="fa-solid fa-rotate-right" aria-hidden="true"></i></button>
                    <a class="menu-nav-button" href="#" download data-cham-cong-image-download aria-label="Tải xuống"><i class="fa-solid fa-download" aria-hidden="true"></i></a>
