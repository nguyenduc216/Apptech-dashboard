            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
            crossorigin=""></script>
    <script>
        (() => {
            const root = document.querySelector("[data-cham-cong]");
            if (!root) {
                return;
            }

            const tokenInput = root.querySelector("input[name='__RequestVerificationToken']");
            const dateInput = root.querySelector("[data-cham-cong-date]");
            const dateStepButtons = root.querySelectorAll("[data-cham-cong-date-step]");
            const employeePicker = root.querySelector("[data-cham-cong-employee-picker]");
            const employeeToggle = root.querySelector("[data-cham-cong-employee-toggle]");
            const employeeMenu = root.querySelector("[data-cham-cong-employee-menu]");
            const employeeSummary = root.querySelector("[data-cham-cong-employee-summary]");
            const employeeAllCheckbox = root.querySelector("[data-cham-cong-employee-all]");
            const employeeCheckboxes = root.querySelectorAll("[data-cham-cong-employee-checkbox]");
            const locationSelect = root.querySelector("[data-cham-cong-location]");
            const checkinButton = root.querySelector("[data-cham-cong-checkin]");
            const checkoutButton = root.querySelector("[data-cham-cong-checkout]");
            const statusElement = root.querySelector("[data-cham-cong-status]");
            const historyElement = root.querySelector("[data-cham-cong-history]");
            const historyCount = root.querySelector("[data-cham-cong-history-count]");
            const mobileHistoryMedia = window.matchMedia("(max-width: 639px)");
            const cameraShell = root.querySelector("[data-cham-cong-camera-shell]");
            const cameraCloseButtons = root.querySelectorAll("[data-cham-cong-camera-close]");
            const cameraTitle = root.querySelector("[data-cham-cong-camera-title]");
            const cameraSubtitle = root.querySelector("[data-cham-cong-camera-subtitle]");
            const cameraStatus = root.querySelector("[data-cham-cong-camera-status]");
            const cameraSelectShell = root.querySelector("[data-cham-cong-camera-select-shell]");
            const cameraSelect = root.querySelector("[data-cham-cong-camera-select]");
            const video = root.querySelector("[data-cham-cong-video]");
            const canvas = root.querySelector("[data-cham-cong-canvas]");
            const preview = root.querySelector("[data-cham-cong-preview]");
            const placeholder = root.querySelector("[data-cham-cong-placeholder]");
            const captureButton = root.querySelector("[data-cham-cong-capture]");
            const retakeButton = root.querySelector("[data-cham-cong-retake]");
            const saveButton = root.querySelector("[data-cham-cong-save]");
            const timeInput = root.querySelector("[data-cham-cong-time]");
            const timeLabel = root.querySelector("[data-cham-cong-time-label]");
            const noteInput = root.querySelector("[data-cham-cong-note]");
            const noteLabel = root.querySelector("[data-cham-cong-note-label]");
            const mapElement = root.querySelector("[data-cham-cong-map]");
            const mapStatus = root.querySelector("[data-cham-cong-map-status]");
            const mapToggle = root.querySelector("[data-cham-cong-map-toggle]");
            const mapTitle = root.querySelector("[data-cham-cong-map-title]");
            const mapContent = root.querySelector("[data-cham-cong-map-content]");
            const mapFullscreenOpen = root.querySelector("[data-cham-cong-map-fullscreen-open]");
            const mapFullscreenShell = root.querySelector("[data-cham-cong-map-fullscreen-shell]");
            const mapFullscreenCloseButtons = root.querySelectorAll("[data-cham-cong-map-fullscreen-close]");
            const mapFullscreenElement = root.querySelector("[data-cham-cong-map-fullscreen]");
            const mapFullscreenSubtitle = root.querySelector("[data-cham-cong-map-fullscreen-subtitle]");
            const mapFullscreenRouteButton = root.querySelector("[data-cham-cong-map-route]");
            const mapFullscreenRefreshButton = root.querySelector("[data-cham-cong-map-refresh]");
            const mapFullscreenExternalLink = root.querySelector("[data-cham-cong-map-external]");
            const mapFullscreenRouteStatus = root.querySelector("[data-cham-cong-map-route-status]");
            const refreshGpsButton = root.querySelector("[data-cham-cong-refresh-gps]");
            const imageViewerShell = root.querySelector("[data-cham-cong-image-viewer-shell]");
            const imageViewerImg = root.querySelector("[data-cham-cong-image-viewer-img]");
            const imageViewerTitle = root.querySelector("[data-cham-cong-image-title]");
            const imageViewerCloseButtons = root.querySelectorAll("[data-cham-cong-image-close]");
            const imageZoomInButton = root.querySelector("[data-cham-cong-image-zoom-in]");
            const imageZoomOutButton = root.querySelector("[data-cham-cong-image-zoom-out]");
            const imageRotateButton = root.querySelector("[data-cham-cong-image-rotate]");
            const imageDownloadLink = root.querySelector("[data-cham-cong-image-download]");
            const distanceLimit = Number.parseFloat(root.dataset.distanceLimit || "");
            let cameraStream = null;
            let attendanceCameraDevices = [];
            let selectedAttendanceCameraId = "";
            let activeMode = "checkin";
            let activeGps = null;
            let capturedBlob = null;
            let attendanceMap = null;
            let customerMarker = null;
            let currentMarker = null;
            let distanceLine = null;
            let fullscreenMap = null;
            let fullscreenCustomerMarker = null;
            let fullscreenCurrentMarker = null;
            let fullscreenDistanceLine = null;
            let fullscreenRouteLayer = null;
            let imageZoom = 1;
            let imageRotation = 0;
            const defaultCenter = [12.2388, 109.1967];
            const defaultZoom = 13;
            const focusZoom = 16;

            refreshGpsButton?.querySelector("span")?.replaceChildren(document.createTextNode("L\u1EA5y GPS"));

            const setStatus = (element, message, type = "info") => {
                if (!element) {
                    return;
                }
                element.hidden = !message;
                element.classList.remove("info", "success", "warning", "error");
                element.classList.add(type);
                element.dataset.state = type;
                element.textContent = message || "";
            };

            const setFullscreenRouteStatus = (message, type = "info") => {
                if (!(mapFullscreenRouteStatus instanceof HTMLElement)) {
                    return;
                }
                mapFullscreenRouteStatus.hidden = !message;
                mapFullscreenRouteStatus.dataset.state = type;
                mapFullscreenRouteStatus.textContent = message || "";
            };

            const setMapCollapsed = (collapsed) => {
                if (mapContent instanceof HTMLElement) {
                    mapContent.hidden = collapsed;
                }
                if (mapToggle instanceof HTMLButtonElement) {
                    mapToggle.setAttribute("aria-expanded", collapsed ? "false" : "true");
                    mapToggle.dataset.state = mapToggle.dataset.state || "info";
                    const icon = mapToggle.querySelector("i");
                    icon?.classList.toggle("fa-chevron-down", collapsed);
                    icon?.classList.toggle("fa-chevron-up", !collapsed);
                }
                if (!collapsed && attendanceMap) {
                    syncAttendanceMap(activeGps);
                }
            };

            const setMapTitle = (message, type = "info") => {
                if (mapTitle) {
                    mapTitle.textContent = message;
                }
                if (mapToggle instanceof HTMLButtonElement) {
                    mapToggle.dataset.state = type;
                }
            };

            const getSelectedLocation = () => {
                if (!(locationSelect instanceof HTMLSelectElement)) {
                    return null;
                }
                const option = locationSelect.selectedOptions[0];
                if (!option || !locationSelect.value) {
                    return null;
                }
                return {
                    id: locationSelect.value,
                    lat: Number.parseFloat(option.dataset.lat || ""),
                    long: Number.parseFloat(option.dataset.long || "")
                };
            };

            const getNavigationPoints = () => {
                const location = getSelectedLocation();
                const hasLocation = location && Number.isFinite(location.lat) && Number.isFinite(location.long);
                const hasGps = activeGps && Number.isFinite(activeGps.lat) && Number.isFinite(activeGps.long);
                return {
                    location,
                    customerPoint: hasLocation ? [location.lat, location.long] : null,
                    currentPoint: hasGps ? [activeGps.lat, activeGps.long] : null
                };
            };

            const syncMapExternalLink = () => {
                if (!(mapFullscreenExternalLink instanceof HTMLAnchorElement)) {
                    return;
                }
                const { customerPoint, currentPoint } = getNavigationPoints();
                if (customerPoint && currentPoint) {
                    mapFullscreenExternalLink.href = `https://www.google.com/maps/dir/?api=1&origin=${currentPoint[0]},${currentPoint[1]}&destination=${customerPoint[0]},${customerPoint[1]}`;
                    mapFullscreenExternalLink.classList.remove("disabled");
                    return;
                }
                if (customerPoint) {
                    mapFullscreenExternalLink.href = `https://www.google.com/maps/search/?api=1&query=${customerPoint[0]},${customerPoint[1]}`;
                    mapFullscreenExternalLink.classList.remove("disabled");
                    return;
                }
                mapFullscreenExternalLink.href = "#";
                mapFullscreenExternalLink.classList.add("disabled");
            };

            const distanceMeters = (startLat, startLong, endLat, endLong) => {
                const toRad = (value) => value * Math.PI / 180;
                const earthRadius = 6371000;
                const deltaLat = toRad(endLat - startLat);
                const deltaLong = toRad(endLong - startLong);
                const lat1 = toRad(startLat);
                const lat2 = toRad(endLat);
                const haversine = Math.sin(deltaLat / 2) ** 2 +
                    Math.cos(lat1) * Math.cos(lat2) * Math.sin(deltaLong / 2) ** 2;
                return 2 * earthRadius * Math.atan2(Math.sqrt(haversine), Math.sqrt(1 - haversine));
            };

            const getDistanceState = (distance) => Number.isFinite(distanceLimit) && distanceLimit > 0 && distance > distanceLimit
                ? "error"
                : "success";

            const validateDistance = (gps) => {
                const location = getSelectedLocation();
                if (!location || !Number.isFinite(location.lat) || !Number.isFinite(location.long)) {
                    throw new Error("Địa điểm chấm công chưa có tọa độ nên không thể kiểm tra khoảng cách.");
                }
                if (Number.isFinite(distanceLimit) && distanceLimit > 0) {
                    const distance = distanceMeters(location.lat, location.long, gps.lat, gps.long);
                    if (distance > distanceLimit) {
                        throw new Error(`Khoảng cách chấm công không được quá ${distanceLimit.toLocaleString("vi-VN")} mét.`);
                    }
                }
            };

            const createAttendanceTileLayer = () => {
                const tileLayer = window.L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
                    maxZoom: 19,
                    attribution: "&copy; OpenStreetMap contributors"
                });
                tileLayer.on("tileerror", (event) => {
                    const map = event?.target?._map;
                    if (map === fullscreenMap) {
                        setFullscreenRouteStatus("Không tải được một phần bản đồ. Vui lòng bấm làm mới bản đồ.", "warning");
                    }
                });
                return tileLayer;
            };

            const ensureAttendanceMap = () => {
                if (mapContent instanceof HTMLElement && mapContent.hidden) {
                    return false;
                }
                if (!(mapElement instanceof HTMLElement) || !(window.L && typeof window.L.map === "function")) {
                    return false;
                }
                if (attendanceMap) {
                    window.setTimeout(() => attendanceMap.invalidateSize(), 120);
                    return true;
                }

                attendanceMap = window.L.map(mapElement, {
                    zoomControl: false,
                    attributionControl: false,
                    dragging: false,
                    scrollWheelZoom: false,
                    doubleClickZoom: false,
                    boxZoom: false,
                    keyboard: false,
                    tap: false,
                    touchZoom: false
                });
                createAttendanceTileLayer().addTo(attendanceMap);
                attendanceMap.setView(defaultCenter, defaultZoom);
                window.setTimeout(() => attendanceMap.invalidateSize(), 120);
                return true;
            };

            const fitAttendanceMap = (customerPoint, currentPoint = null) => {
                if (!attendanceMap) {
                    return;
                }

                attendanceMap.invalidateSize();
                if (customerPoint && currentPoint) {
                    attendanceMap.fitBounds(window.L.latLngBounds([customerPoint, currentPoint]).pad(0.35), { maxZoom: 16 });
                } else if (customerPoint) {
                    attendanceMap.setView(customerPoint, focusZoom);
                } else if (currentPoint) {
                    attendanceMap.setView(currentPoint, focusZoom);
                } else {
                    attendanceMap.setView(defaultCenter, defaultZoom);
                }

                customerMarker?.bringToFront();
                currentMarker?.bringToFront();
            };

            const scheduleFitAttendanceMap = (customerPoint, currentPoint = null) => {
                window.requestAnimationFrame(() => fitAttendanceMap(customerPoint, currentPoint));
                window.setTimeout(() => fitAttendanceMap(customerPoint, currentPoint), 160);
                window.setTimeout(() => fitAttendanceMap(customerPoint, currentPoint), 420);
            };

            const ensureFullscreenMap = () => {
                if (!(mapFullscreenElement instanceof HTMLElement) || !(window.L && typeof window.L.map === "function")) {
                    return false;
                }
                if (fullscreenMap) {
                    window.setTimeout(() => fullscreenMap.invalidateSize(), 120);
                    return true;
                }

                fullscreenMap = window.L.map(mapFullscreenElement, {
                    zoomControl: true,
                    attributionControl: false
                });
                createAttendanceTileLayer().addTo(fullscreenMap);
                fullscreenMap.setView(defaultCenter, defaultZoom);
                window.setTimeout(() => fullscreenMap.invalidateSize(), 120);
                return true;
            };

            const fitFullscreenMap = (customerPoint, currentPoint = null) => {
                if (!fullscreenMap) {
                    return;
                }

                fullscreenMap.invalidateSize();
                if (customerPoint && currentPoint) {
                    fullscreenMap.fitBounds(window.L.latLngBounds([customerPoint, currentPoint]).pad(0.35), { maxZoom: 16 });
                } else if (customerPoint) {
                    fullscreenMap.setView(customerPoint, focusZoom);
                } else if (currentPoint) {
                    fullscreenMap.setView(currentPoint, focusZoom);
                } else {
                    fullscreenMap.setView(defaultCenter, defaultZoom);
                }
            };

            const refreshFullscreenMap = () => {
                if (!fullscreenMap) {
                    return;
                }
                const { customerPoint, currentPoint } = getNavigationPoints();
                fullscreenMap.invalidateSize(true);
                fitFullscreenMap(customerPoint, currentPoint);
                window.setTimeout(() => {
                    fullscreenMap.invalidateSize(true);
                    fitFullscreenMap(customerPoint, currentPoint);
                }, 180);
            };

            const syncFullscreenMap = () => {
                const { location, customerPoint, currentPoint } = getNavigationPoints();

                if (!ensureFullscreenMap()) {
                    return;
                }

                if (customerPoint) {
                    if (!fullscreenCustomerMarker) {
                        fullscreenCustomerMarker = window.L.circleMarker(customerPoint, {
                            radius: 9,
                            color: "#0a6aa1",
                            weight: 3,
                            fillColor: "#1f8fd1",
                            fillOpacity: 0.95
                        }).addTo(fullscreenMap).bindTooltip("Điểm khách hàng");
                    } else {
                        fullscreenCustomerMarker.setLatLng(customerPoint);
                    }
                }

                if (currentPoint) {
                    if (!fullscreenCurrentMarker) {
                        fullscreenCurrentMarker = window.L.circleMarker(currentPoint, {
                            radius: 9,
                            color: "#0aa17d",
                            weight: 3,
                            fillColor: "#11c59b",
                            fillOpacity: 0.92
                        }).addTo(fullscreenMap).bindTooltip("Vị trí hiện tại");
                    } else {
                        fullscreenCurrentMarker.setLatLng(currentPoint);
                    }
                }

                if (customerPoint && currentPoint) {
                    if (fullscreenRouteLayer) {
                        fullscreenMap.removeLayer(fullscreenRouteLayer);
                        fullscreenRouteLayer = null;
                    }
                    if (!fullscreenDistanceLine) {
                        fullscreenDistanceLine = window.L.polyline([customerPoint, currentPoint], {
                            color: "#0a6aa1",
                            weight: 4,
                            opacity: 0.88,
                            dashArray: "8 8"
                        }).addTo(fullscreenMap);
                    } else {
                        fullscreenDistanceLine.setLatLngs([customerPoint, currentPoint]);
                    }

                    const distance = distanceMeters(location.lat, location.long, activeGps.lat, activeGps.long);
                    if (mapFullscreenSubtitle) {
                        mapFullscreenSubtitle.textContent = `Khoảng cách hiện tại: ${Math.round(distance).toLocaleString("vi-VN")} m.`;
                    }
                }

                syncMapExternalLink();
                window.setTimeout(() => fitFullscreenMap(customerPoint, currentPoint), 250);
            };

            const loadFullscreenRoute = async () => {
                const { location, customerPoint, currentPoint } = getNavigationPoints();
                if (!fullscreenMap || !customerPoint || !currentPoint || !location || !activeGps) {
                    setFullscreenRouteStatus("Chưa đủ tọa độ để chỉ đường.", "warning");
                    return;
                }

                try {
                    if (mapFullscreenRouteButton instanceof HTMLButtonElement) {
                        mapFullscreenRouteButton.disabled = true;
                    }
                    setFullscreenRouteStatus("Đang tải tuyến đường...", "info");
                    const response = await fetch(`https://router.project-osrm.org/route/v1/driving/${activeGps.long},${activeGps.lat};${location.long},${location.lat}?overview=full&geometries=geojson`);
                    const payload = await response.json();
                    const route = Array.isArray(payload.routes) ? payload.routes[0] : null;
                    if (!response.ok || !route?.geometry) {
                        throw new Error("Không tìm thấy tuyến đường phù hợp.");
                    }

                    if (fullscreenRouteLayer) {
                        fullscreenMap.removeLayer(fullscreenRouteLayer);
                    }
                    if (fullscreenDistanceLine) {
                        fullscreenMap.removeLayer(fullscreenDistanceLine);
                        fullscreenDistanceLine = null;
                    }
                    fullscreenRouteLayer = window.L.geoJSON(route.geometry, {
                        style: {
                            color: "#0b4f9c",
                            weight: 5,
                            opacity: 0.82
                        }
                    }).addTo(fullscreenMap);
                    const routeBounds = fullscreenRouteLayer.getBounds();
                    if (routeBounds.isValid()) {
                        fullscreenMap.fitBounds(routeBounds.pad(0.15));
                    }
                    const distanceKm = (route.distance / 1000).toFixed(1);
                    const durationMinutes = Math.round(route.duration / 60);
                    setFullscreenRouteStatus(`Tuyến đường khoảng ${distanceKm} km, ${durationMinutes} phút.`, "success");
                } catch (error) {
                    setFullscreenRouteStatus(error instanceof Error ? error.message : "Không thể tải tuyến đường.", "error");
                } finally {
                    if (mapFullscreenRouteButton instanceof HTMLButtonElement) {
                        mapFullscreenRouteButton.disabled = false;
                    }
                }
            };

            const openFullscreenMap = () => {
                if (mapFullscreenShell instanceof HTMLElement) {
                    mapFullscreenShell.hidden = false;
                    document.body.classList.add("modal-open");
                }
                window.requestAnimationFrame(syncFullscreenMap);
                window.setTimeout(syncFullscreenMap, 220);
                window.setTimeout(refreshFullscreenMap, 520);
                window.setTimeout(refreshFullscreenMap, 1100);
            };

            const closeFullscreenMap = () => {
                if (mapFullscreenShell instanceof HTMLElement) {
                    mapFullscreenShell.hidden = true;
                }
                if (!(cameraShell instanceof HTMLElement) || cameraShell.hidden) {
                    document.body.classList.remove("modal-open");
                }
            };

            const syncAttendanceMap = (gps = activeGps) => {
                const location = getSelectedLocation();
                if (!location || !Number.isFinite(location.lat) || !Number.isFinite(location.long)) {
                    setMapTitle("Khoảng cách: địa điểm chưa có tọa độ", "warning");
                    setStatus(mapStatus, "Địa điểm chấm công chưa có tọa độ.", "warning");
                    if (!ensureAttendanceMap()) {
                        return;
                    }
                    if (gps && Number.isFinite(gps.lat) && Number.isFinite(gps.long)) {
                        attendanceMap.setView([gps.lat, gps.long], 16);
                    }
                    return;
                }

                const customerPoint = [location.lat, location.long];
                const hasGps = gps && Number.isFinite(gps.lat) && Number.isFinite(gps.long);
                const currentPoint = hasGps ? [gps.lat, gps.long] : null;
                let distance = null;
                let state = "info";

                if (hasGps) {
                    distance = distanceMeters(location.lat, location.long, gps.lat, gps.long);
                    state = getDistanceState(distance);
                    const roundedDistance = Math.round(distance).toLocaleString("vi-VN");
                    const limitText = Number.isFinite(distanceLimit) && distanceLimit > 0
                        ? ` Giới hạn: ${distanceLimit.toLocaleString("vi-VN")} m.`
                        : "";
                    setMapTitle(`Khoảng cách từ điểm hiện tại tới địa điểm khách hàng: ${roundedDistance} m`, state);
                    setStatus(
                        mapStatus,
                        state === "error"
                            ? `Khoảng cách hiện tại: ${roundedDistance} m. Vượt quá giới hạn chấm công.${limitText}`
                            : `Khoảng cách đường chim bay: ${roundedDistance} m.${limitText}`,
                        state);
                } else {
                    setMapTitle("Khoảng cách: đang chờ GPS hiện tại", "warning");
                    setStatus(mapStatus, "Đang chờ GPS hiện tại.", "info");
                }

                if (!ensureAttendanceMap()) {
                    return;
                }

                if (!customerMarker) {
                    customerMarker = window.L.circleMarker(customerPoint, {
                        radius: 8,
                        color: "#0a6aa1",
                        weight: 3,
                        fillColor: "#1f8fd1",
                        fillOpacity: 0.95
                    }).addTo(attendanceMap);
                } else {
                    customerMarker.setLatLng(customerPoint);
                }

                if (hasGps) {
                    if (!currentMarker) {
                        currentMarker = window.L.circleMarker(currentPoint, {
                            radius: 8,
                            color: "#0aa17d",
                            weight: 2,
                            fillColor: "#11c59b",
                            fillOpacity: 0.9
                        }).addTo(attendanceMap);
                    } else {
                        currentMarker.setLatLng(currentPoint);
                    }

                    if (!distanceLine) {
                        distanceLine = window.L.polyline([customerPoint, currentPoint], {
                            color: "#0a6aa1",
                            weight: 3,
                            dashArray: "6 6"
                        }).addTo(attendanceMap);
                    } else {
                        distanceLine.setLatLngs([customerPoint, currentPoint]);
                    }

                    scheduleFitAttendanceMap(customerPoint, currentPoint);
                } else {
                    scheduleFitAttendanceMap(customerPoint);
                }
                if (mapFullscreenShell instanceof HTMLElement && !mapFullscreenShell.hidden) {
                    syncFullscreenMap();
                }
            };

            const getCurrentPosition = () => new Promise((resolve, reject) => {
                if (!navigator.geolocation) {
                    reject(new Error("Trình duyệt không hỗ trợ GPS."));
                    return;
                }
                navigator.geolocation.getCurrentPosition(resolve, reject, {
                    enableHighAccuracy: true,
                    timeout: 15000,
                    maximumAge: 0
                });
            });

            const resolveGps = async () => {
                setStatus(cameraStatus, "Đang lấy vị trí GPS...", "info");
                const position = await getCurrentPosition();
                const gps = {
                    lat: position.coords.latitude,
                    long: position.coords.longitude
                };
                return gps;
            };

            const refreshGps = async () => {
                if (refreshGpsButton instanceof HTMLButtonElement) {
                    refreshGpsButton.disabled = true;
                }

                try {
                    activeGps = await resolveGps();
                    if (cameraSubtitle) {
                        cameraSubtitle.textContent = `GPS hiá»‡n táº¡i: ${activeGps.lat.toFixed(5)}, ${activeGps.long.toFixed(5)}`;
                    }
                    syncAttendanceMap(activeGps);
                    setStatus(cameraStatus, "ÄÃ£ cáº­p nháº­t láº¡i GPS hiá»‡n táº¡i.", "success");
                } catch (error) {
                    setStatus(cameraStatus, error instanceof Error ? error.message : "KhÃ´ng thá»ƒ láº¥y láº¡i GPS.", "error");
                } finally {
                    if (refreshGpsButton instanceof HTMLButtonElement) {
                        refreshGpsButton.disabled = false;
                    }
                }
            };

            const getCameraLabel = (device, index) => {
                const label = (device?.label || "").trim();
                return label || `Camera ${index + 1}`;
            };

            const syncAttendanceCameraSelect = () => {
                if (!(cameraSelect instanceof HTMLSelectElement)) {
                    return;
                }

                cameraSelect.innerHTML = "";
                attendanceCameraDevices.forEach((device, index) => {
                    const option = document.createElement("option");
                    option.value = device.deviceId;
                    option.textContent = getCameraLabel(device, index);
                    cameraSelect.appendChild(option);
                });

                if (!selectedAttendanceCameraId && attendanceCameraDevices.length > 0) {
                    const backCamera = attendanceCameraDevices.find((device) => /back|rear|environment|sau/i.test(device.label || ""));
                    selectedAttendanceCameraId = (backCamera || attendanceCameraDevices[0]).deviceId;
                }

                if (selectedAttendanceCameraId) {
                    cameraSelect.value = selectedAttendanceCameraId;
                }

                if (cameraSelectShell instanceof HTMLElement) {
                    cameraSelectShell.hidden = attendanceCameraDevices.length <= 1;
                }
            };

            const loadAttendanceCameraDevices = async () => {
                if (!navigator.mediaDevices?.enumerateDevices) {
                    return;
                }

                try {
                    attendanceCameraDevices = (await navigator.mediaDevices.enumerateDevices())
                        .filter((device) => device.kind === "videoinput" && device.deviceId);
                    syncAttendanceCameraSelect();
                } catch {
                }
            };

            const buildAttendanceCameraConstraints = () => selectedAttendanceCameraId
                ? { deviceId: { exact: selectedAttendanceCameraId } }
                : { facingMode: { ideal: "environment" } };

            const startCamera = async () => {
                if (!navigator.mediaDevices?.getUserMedia) {
                    throw new Error("Trình duyệt không hỗ trợ camera.");
                }
                stopCamera();
                cameraStream = await navigator.mediaDevices.getUserMedia({
                    video: buildAttendanceCameraConstraints(),
                    audio: false
                });
                if (video instanceof HTMLVideoElement) {
                    video.srcObject = cameraStream;
                    await video.play();
                }
                if (placeholder instanceof HTMLElement) {
                    placeholder.hidden = true;
                }
                await loadAttendanceCameraDevices();
            };

            const stopCamera = () => {
                cameraStream?.getTracks().forEach((track) => track.stop());
                cameraStream = null;
                if (video instanceof HTMLVideoElement) {
                    video.srcObject = null;
                }
            };

            const resetPhoto = () => {
                capturedBlob = null;
                if (preview instanceof HTMLImageElement) {
                    preview.hidden = true;
                    preview.removeAttribute("src");
                }
                if (video instanceof HTMLVideoElement) {
                    video.hidden = false;
                }
                if (retakeButton instanceof HTMLButtonElement) {
                    retakeButton.disabled = true;
                }
            };

            const formatDateTimeLocalValue = (date = new Date()) => {
                const pad = (value) => `${value}`.padStart(2, "0");
                return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}T${pad(date.getHours())}:${pad(date.getMinutes())}`;
            };

            const getSelectedActionEmployeeId = () => {
                const selected = Array.from(employeeCheckboxes)
                    .filter((checkbox) => checkbox instanceof HTMLInputElement && checkbox.checked && checkbox.value)
                    .map((checkbox) => Number.parseInt(checkbox.value, 10))
                    .find((value) => Number.isFinite(value) && value > 0);
                return selected || Number.parseInt(root.dataset.actionEmployeeId || "", 10) || null;
            };

            const getSelectedDateValue = () => dateInput instanceof HTMLInputElement && dateInput.value
                ? dateInput.value
                : root.dataset.todayDate || "";

            const getSelectedDateWithCurrentTime = () => {
                const selectedDate = getSelectedDateValue();
                const match = selectedDate.match(/^(\d{4})-(\d{2})-(\d{2})$/);
                const now = new Date();
                return match
                    ? new Date(Number(match[1]), Number(match[2]) - 1, Number(match[3]), now.getHours(), now.getMinutes())
                    : now;
            };

            const shiftSelectedDate = (dayDelta) => {
                if (!(dateInput instanceof HTMLInputElement) || !Number.isFinite(dayDelta) || dayDelta === 0) {
                    return false;
                }

                const match = getSelectedDateValue().match(/^(\d{4})-(\d{2})-(\d{2})$/);
                if (!match) {
                    return false;
                }

                const date = new Date(Number(match[1]), Number(match[2]) - 1, Number(match[3]));
                date.setDate(date.getDate() + dayDelta);
                const pad = (value) => `${value}`.padStart(2, "0");
                dateInput.value = `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}`;
                dateInput.dispatchEvent(new Event("change", { bubbles: true }));
                return true;
            };

            const canUseAttendanceAction = () => {
                const selectedDate = getSelectedDateValue();
                const today = root.dataset.todayDate || selectedDate;
                if (selectedDate > today) {
                    return false;
                }

                const isPast = selectedDate < today;
                if (!isPast) {
                    return true;
                }

                const canSelectEmployees = root.dataset.canSelectEmployees === "true";
                if (!canSelectEmployees) {
                    return false;
                }

                const canAdminManageAttendance = root.dataset.canAdminManageAttendance === "true";
                const currentEmployeeId = Number.parseInt(root.dataset.currentEmployeeId || "", 10) || 0;
                const actionEmployeeId = getSelectedActionEmployeeId() || 0;
                return canAdminManageAttendance || actionEmployeeId === currentEmployeeId;
            };

            const capturePhoto = async () => {
                if (!(video instanceof HTMLVideoElement) || !(canvas instanceof HTMLCanvasElement)) {
                    return;
                }
                const width = video.videoWidth || 1280;
                const height = video.videoHeight || 720;
                canvas.width = width;
                canvas.height = height;
                const context = canvas.getContext("2d");
                context?.drawImage(video, 0, 0, width, height);
                capturedBlob = await new Promise((resolve) => canvas.toBlob(resolve, "image/jpeg", 0.88));
                if (preview instanceof HTMLImageElement && capturedBlob) {
                    preview.src = URL.createObjectURL(capturedBlob);
                    preview.hidden = false;
                    video.hidden = true;
                }
                if (retakeButton instanceof HTMLButtonElement) {
                    retakeButton.disabled = !capturedBlob;
                }
                setStatus(cameraStatus, "Đã chụp ảnh. Bấm Lưu để hoàn tất.", "success");
            };

            const openCameraModal = async (mode) => {
                activeMode = mode;
                activeGps = null;
                resetPhoto();
                if (noteInput instanceof HTMLTextAreaElement) {
                    noteInput.value = "";
                }
                if (noteLabel instanceof HTMLElement) {
                    noteLabel.textContent = mode === "checkout" ? "Ghi chú checkout" : "Ghi chú checkin";
                }
                if (timeInput instanceof HTMLInputElement) {
                    timeInput.value = formatDateTimeLocalValue(getSelectedDateWithCurrentTime());
                }
                if (timeLabel instanceof HTMLElement) {
                    timeLabel.textContent = mode === "checkout" ? "Thời gian checkout" : "Thời gian checkin";
                }
                if (cameraTitle) {
                    cameraTitle.textContent = mode === "checkout" ? "Chụp ảnh checkout" : "Chụp ảnh checkin";
                }
                if (cameraSubtitle) {
                    cameraSubtitle.textContent = "Đang kiểm tra GPS và khoảng cách.";
                }
                if (cameraShell instanceof HTMLElement) {
                    cameraShell.hidden = false;
                    document.body.classList.add("modal-open");
                }
                setMapCollapsed(true);
                syncAttendanceMap(null);
                try {
                    activeGps = await resolveGps();
                    if (cameraSubtitle) {
                        cameraSubtitle.textContent = `GPS hiện tại: ${activeGps.lat.toFixed(5)}, ${activeGps.long.toFixed(5)}`;
                    }
                    syncAttendanceMap(activeGps);
                    await startCamera();
                    setStatus(cameraStatus, "Camera đã sẵn sàng. Vui lòng chụp ảnh chấm công.", "success");
                } catch (error) {
                    setStatus(cameraStatus, error instanceof Error ? error.message : "Không thể mở camera.", "error");
                }
            };

            const closeCameraModal = () => {
                stopCamera();
                resetPhoto();
                closeFullscreenMap();
                if (cameraShell instanceof HTMLElement) {
                    cameraShell.hidden = true;
                    document.body.classList.remove("modal-open");
                }
            };

            const postForm = async (url, values, imageBlob) => {
                const payload = new FormData();
                if (tokenInput instanceof HTMLInputElement) {
                    payload.append("__RequestVerificationToken", tokenInput.value);
                }
                Object.entries(values).forEach(([key, value]) => payload.append(key, `${value}`));
                payload.append("imageFile", new File([imageBlob], `chamcong-${Date.now()}.jpg`, { type: "image/jpeg" }));

                const response = await fetch(url, {
                    method: "POST",
                    body: payload,
                    headers: { "X-Requested-With": "XMLHttpRequest" }
                });
                const data = await response.json().catch(() => ({}));
                if (!response.ok || data.succeeded === false) {
                    throw new Error(data.message || "Không thể lưu chấm công.");
                }
                return data;
            };

            const renderHistory = (items) => {
                if (!historyElement) {
                    return;
                }
                const sortedItems = [...items].sort((left, right) => {
                    const leftTime = Number.parseInt(left.checkinSortKey || "", 10) || parseHistoryDate(left.thoiDiem);
                    const rightTime = Number.parseInt(right.checkinSortKey || "", 10) || parseHistoryDate(right.thoiDiem);
                    return leftTime - rightTime || (Number(left.id) || 0) - (Number(right.id) || 0);
                });
                if (historyCount) {
                    historyCount.textContent = `${sortedItems.length} lượt`;
                }
                if (sortedItems.length === 0) {
                    historyElement.innerHTML = '<div class="cham-cong-empty">Chưa có dữ liệu chấm công trong ngày đã chọn.</div>';
                    updateHistoryCounter();
                    return;
                }
                historyElement.innerHTML = sortedItems.map((item, index) => {
                    const range = `${item.checkinTime || "--:--"} - ${item.checkoutTime || "Đang làm"}`;
                    const customer = item.tenKhachHang || "AppTech";
                    const checkinNote = item.ghiChuNhanVien
                        ? `<p class="cham-cong-note"><i class="fa-solid fa-note-sticky" aria-hidden="true"></i><span>${escapeHtml(item.ghiChuNhanVien)}</span></p>`
                        : "";
                    const checkoutNote = item.ghiChuCheckOut
                        ? `<p class="cham-cong-note"><i class="fa-solid fa-flag-checkered" aria-hidden="true"></i><span>${escapeHtml(item.ghiChuCheckOut)}</span></p>`
                        : "";
                    const address = item.diaChi || "Chưa có địa chỉ";
                    const employeeName = item.hoTenNhanVien || "Nhân viên";
                    const checkinPhoto = item.imgPath
                        ? `<button type="button" class="cham-cong-entry-image-button" data-cham-cong-image-open data-image-src="${escapeHtml(item.imgPath)}" data-image-title="Ảnh checkin ${escapeHtml(employeeName)}"><img src="${escapeHtml(item.imgPath)}" alt="Ảnh checkin" /></button>`
                        : '<i class="fa-solid fa-image" aria-hidden="true"></i>';
                    const checkoutPhoto = item.imgPathCheckOut
                        ? `<button type="button" class="cham-cong-entry-image-button" data-cham-cong-image-open data-image-src="${escapeHtml(item.imgPathCheckOut)}" data-image-title="Ảnh checkout ${escapeHtml(employeeName)}"><img src="${escapeHtml(item.imgPathCheckOut)}" alt="Ảnh checkout" /></button>`
                        : '<i class="fa-solid fa-image" aria-hidden="true"></i>';
                    const checkinLineNote = item.ghiChuNhanVien
                        ? `<p class="cham-cong-note"><i class="fa-solid fa-note-sticky" aria-hidden="true"></i><span>${escapeHtml(item.ghiChuNhanVien)}</span></p>`
                        : "";
                    const checkoutLineNote = item.ghiChuCheckOut
                        ? `<p class="cham-cong-note"><i class="fa-solid fa-note-sticky" aria-hidden="true"></i><span>${escapeHtml(item.ghiChuCheckOut)}</span></p>`
                        : "";
                    const checkinClass = `is-checkin ${item.isCheckinViolation ? "is-attendance-violation" : ""}`;
                    const checkoutClass = item.thoiDiemCheckOut ? "is-checkout-complete" : "is-checkout-pending";
                    const checkoutViolationClass = item.isCheckoutViolation ? " is-attendance-violation" : "";
                    return `
                        <div class="cham-cong-timeline-item ${item.thoiDiemCheckOut ? "is-complete" : "is-pending"} ${item.isOpen ? "is-open" : ""}" style="order:${index};">
                            <div class="cham-cong-dot"></div>
                            <div class="cham-cong-split">
                                <strong class="cham-cong-employee-name">${escapeHtml(employeeName)}</strong>
                                <section class="cham-cong-attendance-line ${checkinClass}">
                                    <div class="cham-cong-entry-photo">${checkinPhoto}</div>
                                    <div class="cham-cong-entry-content">
                                        <strong><i class="fa-solid fa-right-to-bracket" aria-hidden="true"></i>${escapeHtml(item.thoiDiem || item.checkinTime || "--:--")}</strong>
                                        ${checkinLineNote}
                                    </div>
                                </section>
                                <section class="cham-cong-attendance-line ${checkoutClass}${checkoutViolationClass}">
                                    <div class="cham-cong-entry-photo">${checkoutPhoto}</div>
                                    <div class="cham-cong-entry-content">
                                        <strong><i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i>${escapeHtml(item.thoiDiemCheckOut || "Chưa checkout")}</strong>
                                        ${checkoutLineNote}
                                    </div>
                                </section>
                                <section class="cham-cong-entry">
                                    <div class="cham-cong-entry-photo">${checkinPhoto}</div>
                                    <strong><i class="fa-solid fa-right-to-bracket" aria-hidden="true"></i>${escapeHtml(item.checkinTime || "--:--")}</strong>
                                    ${checkinNote}
                                </section>
                                <section class="cham-cong-entry">
                                    <div class="cham-cong-entry-photo">${checkoutPhoto}</div>
                                    <strong><i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i>${escapeHtml(item.checkoutTime || "Đang làm")}</strong>
                                    ${checkoutNote}
                                </section>
                                <strong>${escapeHtml(range)}</strong>
                                <span>${escapeHtml(customer)}</span>
                                <small>${escapeHtml(address)}</small>
                                ${checkinNote}
                                ${checkoutNote}
                            </div>
                        </div>`;
                }).join("");
                historyElement.scrollLeft = 0;
                updateHistoryCounter();
            };

            const escapeHtml = (value) => `${value ?? ""}`.replace(/[&<>"']/g, (character) => ({
                "&": "&amp;",
                "<": "&lt;",
                ">": "&gt;",
                '"': "&quot;",
                "'": "&#039;"
            }[character]));

            const parseHistoryDate = (value) => {
                const match = `${value ?? ""}`.match(/^(\d{2})\/(\d{2})\/(\d{4})\s+(\d{2}):(\d{2})$/);
                if (!match) {
                    return Number.MAX_SAFE_INTEGER;
                }
                const [, day, month, year, hour, minute] = match;
                return new Date(Number(year), Number(month) - 1, Number(day), Number(hour), Number(minute)).getTime();
            };

            let historyScrollFrame = 0;
            const updateHistoryCounter = () => {
                if (!(historyCount instanceof HTMLElement) || !(historyElement instanceof HTMLElement)) {
                    return;
                }
                const items = Array.from(historyElement.querySelectorAll(".cham-cong-timeline-item"));
                if (items.length === 0) {
                    historyCount.textContent = mobileHistoryMedia.matches ? "0 / 0" : "0 lượt";
                    return;
                }
                if (!mobileHistoryMedia.matches) {
                    historyCount.textContent = `${items.length} lượt`;
                    return;
                }
                const nearestIndex = items.reduce((bestIndex, item, index) => {
                    const bestItem = items[bestIndex];
                    const bestDistance = Math.abs(bestItem.offsetLeft - historyElement.scrollLeft);
                    const itemDistance = Math.abs(item.offsetLeft - historyElement.scrollLeft);
                    return itemDistance < bestDistance ? index : bestIndex;
                }, 0);
                historyCount.textContent = `${nearestIndex + 1} / ${items.length}`;
            };

            const scheduleHistoryCounterUpdate = () => {
                window.cancelAnimationFrame(historyScrollFrame);
                historyScrollFrame = window.requestAnimationFrame(updateHistoryCounter);
            };

            const loadHistory = async () => {
                const url = new URL(root.dataset.historyUrl || "", window.location.origin);
                if (dateInput instanceof HTMLInputElement && dateInput.value) {
                    url.searchParams.set("date", dateInput.value);
                }
                employeeCheckboxes.forEach((checkbox) => {
                    if (checkbox instanceof HTMLInputElement && checkbox.checked && checkbox.value) {
                        url.searchParams.append("employeeIds", checkbox.value);
                    }
                });
                const response = await fetch(url, { headers: { "X-Requested-With": "XMLHttpRequest" } });
                const data = await response.json();
                if (!response.ok || data.succeeded === false) {
                    throw new Error(data.message || "Không thể tải lịch sử chấm công.");
                }
                root.dataset.openCheckinId = data.openCheckinId ? `${data.openCheckinId}` : "";
                root.dataset.actionEmployeeId = data.actionEmployeeId ? `${data.actionEmployeeId}` : "";
                renderHistory(Array.isArray(data.history) ? data.history : []);
                syncButtons();
            };

            const syncButtons = () => {
                const hasOpen = Boolean(root.dataset.openCheckinId);
                const canAct = canUseAttendanceAction();
                if (checkinButton instanceof HTMLButtonElement) {
                    checkinButton.hidden = hasOpen || !canAct;
                }
                if (checkoutButton instanceof HTMLButtonElement) {
                    checkoutButton.hidden = !hasOpen || !canAct;
                }
                if (locationSelect instanceof HTMLSelectElement) {
                    locationSelect.disabled = hasOpen || !canAct;
                    const validOptions = Array.from(locationSelect.options).filter((option) => option.value);
                    const locationField = locationSelect.closest(".master-data-filter-field");
                    if (locationField instanceof HTMLElement) {
                        locationField.hidden = validOptions.length <= 1;
                        locationField.classList.toggle("cham-cong-location-hidden", validOptions.length <= 1);
                    }
                }
            };

            const syncEmployeeSummary = () => {
                if (!(employeeSummary instanceof HTMLElement)) {
                    return;
                }
                const selectedNames = Array.from(employeeCheckboxes)
                    .filter((checkbox) => checkbox instanceof HTMLInputElement && checkbox.checked)
                    .map((checkbox) => checkbox.closest("label")?.textContent?.trim())
                    .filter(Boolean);
                employeeSummary.textContent = selectedNames.length === 0
                    ? "Chọn nhân viên"
                    : selectedNames.length === 1
                        ? selectedNames[0]
                        : `${selectedNames.length} nhân viên`;
                if (employeeAllCheckbox instanceof HTMLInputElement) {
                    employeeAllCheckbox.checked = selectedNames.length > 0 && selectedNames.length === employeeCheckboxes.length;
                    employeeAllCheckbox.indeterminate = selectedNames.length > 0 && selectedNames.length < employeeCheckboxes.length;
                }
            };

            const closeEmployeeMenu = () => {
                if (employeeMenu instanceof HTMLElement) {
                    employeeMenu.hidden = true;
                }
                employeeToggle?.setAttribute("aria-expanded", "false");
            };

            const syncImageViewerTransform = () => {
                if (imageViewerImg instanceof HTMLImageElement) {
                    imageViewerImg.style.transform = `scale(${imageZoom}) rotate(${imageRotation}deg)`;
                }
            };

            const openImageViewer = (src, title = "Ảnh chấm công") => {
                if (!src || !(imageViewerShell instanceof HTMLElement) || !(imageViewerImg instanceof HTMLImageElement)) {
                    return;
                }
                imageZoom = 1;
                imageRotation = 0;
                imageViewerImg.src = src;
                if (imageViewerTitle instanceof HTMLElement) {
                    imageViewerTitle.textContent = title || "Ảnh chấm công";
                }
                if (imageDownloadLink instanceof HTMLAnchorElement) {
                    imageDownloadLink.href = src;
                }
                syncImageViewerTransform();
                imageViewerShell.hidden = false;
                document.body.classList.add("modal-open");
            };

            const closeImageViewer = () => {
                if (imageViewerShell instanceof HTMLElement) {
                    imageViewerShell.hidden = true;
                }
                if (imageViewerImg instanceof HTMLImageElement) {
                    imageViewerImg.removeAttribute("src");
                }
                document.body.classList.remove("modal-open");
            };

            const saveAttendance = async () => {
                if (!capturedBlob || !activeGps) {
                    setStatus(cameraStatus, "Vui lòng chụp ảnh trước khi lưu.", "error");
                    return;
                }
                try {
                    if (saveButton instanceof HTMLButtonElement) {
                        saveButton.disabled = true;
                    }
                    if (activeMode === "checkout") {
                        const openId = root.dataset.openCheckinId;
                        if (!openId) {
                            throw new Error("Không có lượt checkin đang mở để checkout.");
                        }
                        await postForm(root.dataset.checkoutUrl || "", {
                            Id: openId,
                            IDNhanVien: getSelectedActionEmployeeId() || "",
                            ThoiDiemCheckOut: timeInput instanceof HTMLInputElement ? timeInput.value : "",
                            LongAddressCheckOut: activeGps.long,
                            LatAddressCheckOut: activeGps.lat,
                            GhiChuCheckOut: noteInput instanceof HTMLTextAreaElement ? noteInput.value : ""
                        }, capturedBlob);
                        root.dataset.openCheckinId = "";
                        setStatus(statusElement, "Đã lưu checkout chấm công.", "success");
                    } else {
                        const location = getSelectedLocation();
                        if (!location) {
                            throw new Error("Vui lòng chọn địa điểm chấm công.");
                        }
                        validateDistance(activeGps);
                        await postForm(root.dataset.checkinUrl || "", {
                            IDDiaDiem: location.id,
                            IDNhanVien: getSelectedActionEmployeeId() || "",
                            ThoiDiem: timeInput instanceof HTMLInputElement ? timeInput.value : "",
                            LongAddress: activeGps.long,
                            LatAddress: activeGps.lat,
                            GhiChuNhanVien: noteInput instanceof HTMLTextAreaElement ? noteInput.value : ""
                        }, capturedBlob);
                        setStatus(statusElement, "Đã lưu checkin chấm công.", "success");
                    }
                    closeCameraModal();
                    await loadHistory();
                } catch (error) {
                    setStatus(cameraStatus, error instanceof Error ? error.message : "Không thể lưu chấm công.", "error");
                } finally {
                    if (saveButton instanceof HTMLButtonElement) {
                        saveButton.disabled = false;
                    }
                }
            };

            checkinButton?.addEventListener("click", () => void openCameraModal("checkin"));
            checkoutButton?.addEventListener("click", () => void openCameraModal("checkout"));
            mapToggle?.addEventListener("click", () => {
                const expanded = mapToggle.getAttribute("aria-expanded") === "true";
                setMapCollapsed(expanded);
                if (expanded) {
                    return;
                }
                syncAttendanceMap(activeGps);
            });
            captureButton?.addEventListener("click", () => void capturePhoto());
            retakeButton?.addEventListener("click", () => resetPhoto());
            saveButton?.addEventListener("click", () => void saveAttendance());
            mapFullscreenOpen?.addEventListener("click", openFullscreenMap);
            refreshGpsButton?.addEventListener("click", () => void refreshGps());
            cameraSelect?.addEventListener("change", () => {
                if (cameraSelect instanceof HTMLSelectElement) {
                    selectedAttendanceCameraId = cameraSelect.value;
                }
                if (cameraStream && cameraShell instanceof HTMLElement && !cameraShell.hidden) {
                    void startCamera().catch((error) => {
                        setStatus(cameraStatus, error instanceof Error ? error.message : "Khong the doi camera.", "error");
                    });
                }
            });
            mapFullscreenRefreshButton?.addEventListener("click", refreshFullscreenMap);
            mapFullscreenRouteButton?.addEventListener("click", () => void loadFullscreenRoute());
            mapFullscreenCloseButtons.forEach((button) => button.addEventListener("click", closeFullscreenMap));
            cameraCloseButtons.forEach((button) => button.addEventListener("click", closeCameraModal));
            imageViewerCloseButtons.forEach((button) => button.addEventListener("click", closeImageViewer));
            imageZoomInButton?.addEventListener("click", () => {
                imageZoom = Math.min(4, Number((imageZoom + 0.25).toFixed(2)));
                syncImageViewerTransform();
            });
            imageZoomOutButton?.addEventListener("click", () => {
                imageZoom = Math.max(0.25, Number((imageZoom - 0.25).toFixed(2)));
                syncImageViewerTransform();
            });
            imageRotateButton?.addEventListener("click", () => {
                imageRotation = (imageRotation + 90) % 360;
                syncImageViewerTransform();
            });
            document.addEventListener("keydown", (event) => {
                if (event.key === "Escape"
                    && imageViewerShell instanceof HTMLElement
                    && !imageViewerShell.hidden) {
                    closeImageViewer();
                }
            });
            historyElement?.addEventListener("click", (event) => {
                const trigger = event.target instanceof Element
                    ? event.target.closest("[data-cham-cong-image-open], .cham-cong-entry-photo img")
                    : null;
                if (!trigger) {
                    return;
                }
                const button = trigger.closest("[data-cham-cong-image-open]");
                const img = trigger instanceof HTMLImageElement ? trigger : trigger.querySelector("img");
                const src = button?.dataset.imageSrc || img?.getAttribute("src") || "";
                const title = button?.dataset.imageTitle || img?.getAttribute("alt") || "Ảnh chấm công";
                openImageViewer(src, title);
            });
            dateStepButtons.forEach((button) => {
                button.addEventListener("click", () => {
                    const dayDelta = Number.parseInt(button.dataset.chamCongDateStep || "", 10);
                    shiftSelectedDate(dayDelta);
                });
            });
            dateInput?.addEventListener("change", async () => {
                try {
                    setStatus(statusElement, "Đang tải lịch sử chấm công...", "info");
                    await loadHistory();
                    setStatus(statusElement, "Đã tải lịch sử chấm công.", "success");
                } catch (error) {
                    setStatus(statusElement, error instanceof Error ? error.message : "Không thể tải lịch sử chấm công.", "error");
                }
            });
            employeeToggle?.addEventListener("click", () => {
                if (!(employeeMenu instanceof HTMLElement)) {
                    return;
                }
                const willOpen = employeeMenu.hidden;
                employeeMenu.hidden = !willOpen;
                employeeToggle.setAttribute("aria-expanded", willOpen ? "true" : "false");
            });
            employeeAllCheckbox?.addEventListener("change", async () => {
                if (!(employeeAllCheckbox instanceof HTMLInputElement)) {
                    return;
                }
                employeeCheckboxes.forEach((checkbox) => {
                    if (checkbox instanceof HTMLInputElement) {
                        checkbox.checked = employeeAllCheckbox.checked;
                    }
                });
                syncEmployeeSummary();
                try {
                    setStatus(statusElement, "Đang tải lịch sử chấm công...", "info");
                    await loadHistory();
                    setStatus(statusElement, "Đã tải lịch sử chấm công.", "success");
                } catch (error) {
                    setStatus(statusElement, error instanceof Error ? error.message : "Không thể tải lịch sử chấm công.", "error");
                }
            });
            employeeCheckboxes.forEach((checkbox) => checkbox.addEventListener("change", async () => {
                syncEmployeeSummary();
                try {
                    setStatus(statusElement, "Đang tải lịch sử chấm công...", "info");
                    await loadHistory();
                    setStatus(statusElement, "Đã tải lịch sử chấm công.", "success");
                } catch (error) {
                    setStatus(statusElement, error instanceof Error ? error.message : "Không thể tải lịch sử chấm công.", "error");
                }
            }));
            document.addEventListener("click", (event) => {
                if (employeePicker instanceof HTMLElement && !employeePicker.contains(event.target)) {
                    closeEmployeeMenu();
                }
            });
            historyElement?.addEventListener("scroll", scheduleHistoryCounterUpdate, { passive: true });
            window.addEventListener("resize", scheduleHistoryCounterUpdate);
            mobileHistoryMedia.addEventListener?.("change", updateHistoryCounter);

            syncButtons();
            syncEmployeeSummary();
            updateHistoryCounter();
        })();
    </script>
}
