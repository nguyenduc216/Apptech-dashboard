@using System.Globalization
@model YeuCauManagementViewModel
@{
    ViewData["Title"] = "Yêu cầu";
    ViewData["Breadcrumb"] = "Trang chủ / Kỹ thuật / Quản lý yêu cầu";
    var viCulture = CultureInfo.GetCultureInfo("vi-VN");
}

<section class="master-data-page">
    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="floating-status-toast @Model.StatusType"
             data-status-toast
             role="status"
             aria-live="polite">
            <div class="floating-status-toast-icon" aria-hidden="true">
                <i class="fa-solid @(Model.StatusType == "success" ? "fa-circle-check" : Model.StatusType == "error" ? "fa-circle-exclamation" : "fa-circle-info")"></i>
            </div>
            <div class="floating-status-toast-body">
                <strong>@(Model.StatusType == "success" ? "Thành công" : Model.StatusType == "error" ? "Có lỗi xảy ra" : "Thông báo")</strong>
                <span>@Model.StatusMessage</span>
            </div>
            <button type="button" class="floating-status-toast-close" data-status-toast-close aria-label="Đóng thông báo">
                <span aria-hidden="true">×</span>
            </button>
        </div>
    }

    <article class="panel master-data-panel">
        <div class="panel-header master-data-header">
            <div>
                <h3>Danh sách yêu cầu</h3>
                <p>Ghi nhận các yêu cầu công việc của khách hàng, theo dõi địa điểm thực hiện, người phụ trách và trạng thái xử lý.</p>
            </div>

            <div class="master-data-header-actions">
                <a class="master-data-add-button" asp-permission-action="insert"
                   asp-action="Create"
                   asp-route-keyword="@Model.Filter.Keyword"
                   asp-route-statusFilter="@Model.Filter.StatusFilter"
                   asp-route-requestDateFrom="@(Model.Filter.RequestDateFrom?.ToString("yyyy-MM-dd"))"
                   asp-route-requestDateTo="@(Model.Filter.RequestDateTo?.ToString("yyyy-MM-dd"))"
                   asp-route-executionDateFrom="@(Model.Filter.ExecutionDateFrom?.ToString("yyyy-MM-dd"))"
                   asp-route-executionDateTo="@(Model.Filter.ExecutionDateTo?.ToString("yyyy-MM-dd"))"
                   asp-route-assigneeKeyword="@Model.Filter.AssigneeKeyword"
                   asp-route-workStatusFilter="@Model.Filter.WorkStatusFilter"
                   asp-route-page="@Model.CurrentPage">
                    <i class="fa-solid fa-plus" aria-hidden="true"></i>
                    <span>Thêm mới</span>
                </a>
            </div>
        </div>

        <form method="get" asp-action="Index" class="master-data-filter-form yeu-cau-filter-form">
            <label class="master-data-filter-field" for="keyword">
                <span>Tìm theo mã yêu cầu, khách hàng, địa điểm, liên hệ, điện thoại hoặc ghi chú</span>
                <span class="login-input-shell">
                    <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                    <input id="keyword" name="keyword" type="search" value="@Model.Filter.Keyword" placeholder="Nhập từ khóa tìm kiếm..." />
                </span>
            </label>

            <details class="yeu-cau-advanced-filter">
                <summary>
                    <span>Bộ lọc nâng cao</span>
                    <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
                </summary>

                <div class="yeu-cau-advanced-filter-grid">
                    <label class="master-data-filter-field" for="statusFilter">
                        <span>Trạng thái yêu cầu</span>
                        <span class="login-input-shell select-shell">
                            <i class="fa-solid fa-list-check" aria-hidden="true"></i>
                            <select id="statusFilter" name="statusFilter">
                                <option value="">Tất cả trạng thái</option>
                                @foreach (var option in Model.StatusOptions)
                                {
                                    <option value="@option.Value" selected="@(string.Equals(Model.Filter.StatusFilter, option.Value, StringComparison.Ordinal) ? "selected" : null)">
                                        @option.Label
                                    </option>
                                }
                            </select>
                            <span class="select-indicator"><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></span>
                        </span>
                    </label>

                    <label class="master-data-filter-field" for="workStatusFilter">
                        <span>Trạng thái công việc</span>
                        <span class="login-input-shell select-shell">
                            <i class="fa-solid fa-briefcase" aria-hidden="true"></i>
                            <select id="workStatusFilter" name="workStatusFilter">
                                @foreach (var option in Model.WorkStatusOptions)
                                {
                                    <option value="@option.Value" selected="@(string.Equals(Model.Filter.WorkStatusFilter, option.Value, StringComparison.Ordinal) ? "selected" : null)">
                                        @option.Label
                                    </option>
                                }
                            </select>
                            <span class="select-indicator"><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></span>
                        </span>
                    </label>

                    <label class="master-data-filter-field" for="requestDateFrom">
                        <span>Ngày yêu cầu từ</span>
                        <span class="login-input-shell">
                            <i class="fa-solid fa-calendar-day" aria-hidden="true"></i>
                            <input id="requestDateFrom" name="requestDateFrom" type="date" value="@(Model.Filter.RequestDateFrom?.ToString("yyyy-MM-dd"))" />
                        </span>
                    </label>

                    <label class="master-data-filter-field" for="requestDateTo">
                        <span>Ngày yêu cầu đến</span>
                        <span class="login-input-shell">
                            <i class="fa-solid fa-calendar-day" aria-hidden="true"></i>
                            <input id="requestDateTo" name="requestDateTo" type="date" value="@(Model.Filter.RequestDateTo?.ToString("yyyy-MM-dd"))" />
                        </span>
                    </label>

                    <label class="master-data-filter-field" for="executionDateFrom">
                        <span>Ngày thực hiện từ</span>
                        <span class="login-input-shell">
                            <i class="fa-solid fa-calendar-check" aria-hidden="true"></i>
                            <input id="executionDateFrom" name="executionDateFrom" type="date" value="@(Model.Filter.ExecutionDateFrom?.ToString("yyyy-MM-dd"))" />
                        </span>
                    </label>

                    <label class="master-data-filter-field" for="executionDateTo">
                        <span>Ngày thực hiện đến</span>
                        <span class="login-input-shell">
                            <i class="fa-solid fa-calendar-check" aria-hidden="true"></i>
                            <input id="executionDateTo" name="executionDateTo" type="date" value="@(Model.Filter.ExecutionDateTo?.ToString("yyyy-MM-dd"))" />
                        </span>
                    </label>

                    <label class="master-data-filter-field" for="assigneeKeyword">
                        <span>Nhân viên thực hiện</span>
                        <span class="login-input-shell select-shell">
                            <i class="fa-solid fa-user-check" aria-hidden="true"></i>
                            <select id="assigneeKeyword" name="assigneeKeyword" disabled="@(!Model.CurrentUserIsAdmin)">
                                @if (Model.CurrentUserIsAdmin)
                                {
                                    <option value="">Tất cả nhân viên</option>
                                }
                                @foreach (var employee in Model.NhanVienOptions)
                                {
                                    <option value="@employee.DisplayText" selected="@(Model.CurrentUserIsAdmin ? string.Equals(Model.Filter.AssigneeKeyword, employee.DisplayText, StringComparison.OrdinalIgnoreCase) : employee.Id == Model.CurrentEmployeeId ? "selected" : null)">
                                        @employee.DisplayText
                                    </option>
                                }
                            </select>
                            @if (!Model.CurrentUserIsAdmin)
                            {
                                <input type="hidden" name="assigneeKeyword" value="@Model.Filter.AssigneeKeyword" />
                            }
                            <span class="select-indicator"><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></span>
                        </span>
                    </label>
                </div>
            </details>

            <div class="master-data-filter-actions yeu-cau-filter-actions">
                <button type="submit" class="primary-button master-data-filter-button">
                    <span class="button-content">
                        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                        <span>Tìm kiếm</span>
                    </span>
                    <span class="button-processing" aria-hidden="true">
                        <span class="button-processing-dot"></span>
                        <span class="button-processing-text">Đang xử lý</span>
                    </span>
                </button>

                <a class="secondary-button master-data-reset-button" asp-action="Index">Làm mới</a>
            </div>
        </form>

        <div class="master-data-summary">
            <div><strong>@Model.TotalCount</strong> yêu cầu</div>
            <div>Trang <strong>@Model.CurrentPage</strong>@(Model.TotalPages > 0 ? $" / {Model.TotalPages}" : "")</div>
        </div>

        <div class="table-wrap yeu-cau-table-wrap">
            <table class="data-table master-data-table yeu-cau-list-table">
                <thead>
                    <tr>
                        <th>Tiến độ</th>
                        <th>Mã yêu cầu</th>
                        <th>Khách hàng / Địa điểm</th>
                        <th>Ngày yêu cầu</th>
                        <th>Ngày thực hiện</th>
                        <th>Ngày hết hạn</th>
                        <th>Phụ trách</th>
                        <th>Trạng thái</th>
                        <th class="actions-col">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="9" class="master-data-empty">Không có dữ liệu phù hợp.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    <div class="yeu-cau-work-progress list-progress" style="--progress:@item.TiLeHoanThanh">
                                        <div class="yeu-cau-work-progress-ring">
                                            <span>@item.TiLeHoanThanh%</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <a class="master-data-name master-data-name-link"
                                       asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       asp-route-keyword="@Model.Filter.Keyword"
                                       asp-route-statusFilter="@Model.Filter.StatusFilter"
                                       asp-route-requestDateFrom="@(Model.Filter.RequestDateFrom?.ToString("yyyy-MM-dd"))"
                                       asp-route-requestDateTo="@(Model.Filter.RequestDateTo?.ToString("yyyy-MM-dd"))"
                                       asp-route-executionDateFrom="@(Model.Filter.ExecutionDateFrom?.ToString("yyyy-MM-dd"))"
                                       asp-route-executionDateTo="@(Model.Filter.ExecutionDateTo?.ToString("yyyy-MM-dd"))"
                                       asp-route-assigneeKeyword="@Model.Filter.AssigneeKeyword"
                                       asp-route-workStatusFilter="@Model.Filter.WorkStatusFilter"
                                       asp-route-page="@Model.CurrentPage">
                                        @item.MaYeuCau
                                    </a>
                                    <div class="yeu-cau-secondary-text">@(string.IsNullOrWhiteSpace(item.GhiChu) ? "-" : item.GhiChu)</div>
                                </td>
                                <td>
                                    <div class="master-data-name">@item.TenKhachHangDisplay</div>
                                    <div>@item.DiaChiDisplay</div>
                                    <div class="yeu-cau-secondary-text">
                                        @(string.IsNullOrWhiteSpace(item.NguoiLienHe) ? "-" : item.NguoiLienHe)
                                        ·
                                        @(string.IsNullOrWhiteSpace(item.DienThoai) ? "-" : item.DienThoai)
                                    </div>
                                </td>
                                <td>@(item.NgayYeuCau?.ToString("dd/MM/yyyy", viCulture) ?? "-")</td>
                                <td>@(item.NgayThucHien?.ToString("dd/MM/yyyy", viCulture) ?? "-")</td>
                                <td>@(item.NgayHetHan?.ToString("dd/MM/yyyy", viCulture) ?? "-")</td>
                                <td class="yeu-cau-assignee-cell">
                                    @if (string.IsNullOrWhiteSpace(item.NhanVienThucHien))
                                    {
                                        <span>-</span>
                                    }
                                    else
                                    {
                                        @Html.Raw(item.NhanVienThucHien)
                                    }
                                </td>
                                <td>
                                    <span class="status-pill yeu-cau-status @item.TrangThaiCssClass">
                                        @item.TrangThaiHienThi
                                    </span>
                                </td>
                                <td class="actions-col">
                                    <div class="master-data-actions">
                                        <a class="table-action-button edit" asp-permission-action="update"
                                           asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           asp-route-keyword="@Model.Filter.Keyword"
                                           asp-route-statusFilter="@Model.Filter.StatusFilter"
                                           asp-route-requestDateFrom="@(Model.Filter.RequestDateFrom?.ToString("yyyy-MM-dd"))"
                                           asp-route-requestDateTo="@(Model.Filter.RequestDateTo?.ToString("yyyy-MM-dd"))"
                                           asp-route-executionDateFrom="@(Model.Filter.ExecutionDateFrom?.ToString("yyyy-MM-dd"))"
                                           asp-route-executionDateTo="@(Model.Filter.ExecutionDateTo?.ToString("yyyy-MM-dd"))"
                                           asp-route-assigneeKeyword="@Model.Filter.AssigneeKeyword"
                                           asp-route-workStatusFilter="@Model.Filter.WorkStatusFilter"
                                           asp-route-page="@Model.CurrentPage">
                                            <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
                                            <span>Sửa</span>
                                        </a>

                                        <form method="post" asp-action="Delete" class="inline-action-form">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="Id" value="@item.Id" />
                                            <input type="hidden" name="Keyword" value="@Model.Filter.Keyword" />
                                            <input type="hidden" name="StatusFilter" value="@Model.Filter.StatusFilter" />
                                            <input type="hidden" name="RequestDateFrom" value="@(Model.Filter.RequestDateFrom?.ToString("yyyy-MM-dd"))" />
                                            <input type="hidden" name="RequestDateTo" value="@(Model.Filter.RequestDateTo?.ToString("yyyy-MM-dd"))" />
                                            <input type="hidden" name="ExecutionDateFrom" value="@(Model.Filter.ExecutionDateFrom?.ToString("yyyy-MM-dd"))" />
                                            <input type="hidden" name="ExecutionDateTo" value="@(Model.Filter.ExecutionDateTo?.ToString("yyyy-MM-dd"))" />
                                            <input type="hidden" name="AssigneeKeyword" value="@Model.Filter.AssigneeKeyword" />
                                            <input type="hidden" name="WorkStatusFilter" value="@Model.Filter.WorkStatusFilter" />
                                            <input type="hidden" name="Page" value="@Model.CurrentPage" />
                                            <button type="submit"
                                                    class="table-action-button delete" asp-permission-action="delete"
                                                    data-delete-confirm="Bạn có chắc muốn xóa yêu cầu này?">
                                                <i class="fa-solid fa-trash-can" aria-hidden="true"></i>
                                                <span>Xóa</span>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="pagination-bar" aria-label="Phân trang yêu cầu">
                <a class="pagination-button @(Model.CurrentPage <= 1 ? "disabled" : "")"
                   asp-action="Index"
                   asp-route-keyword="@Model.Filter.Keyword"
                   asp-route-statusFilter="@Model.Filter.StatusFilter"
                   asp-route-requestDateFrom="@(Model.Filter.RequestDateFrom?.ToString("yyyy-MM-dd"))"
                   asp-route-requestDateTo="@(Model.Filter.RequestDateTo?.ToString("yyyy-MM-dd"))"
                   asp-route-executionDateFrom="@(Model.Filter.ExecutionDateFrom?.ToString("yyyy-MM-dd"))"
                   asp-route-executionDateTo="@(Model.Filter.ExecutionDateTo?.ToString("yyyy-MM-dd"))"
                   asp-route-assigneeKeyword="@Model.Filter.AssigneeKeyword"
                   asp-route-workStatusFilter="@Model.Filter.WorkStatusFilter"
                   asp-route-page="@(Model.CurrentPage - 1)">
                    <i class="fa-solid fa-angle-left" aria-hidden="true"></i>
                    <span>Trước</span>
                </a>

                <div class="pagination-pages">
                    @foreach (var pageNumber in Model.VisiblePages)
                    {
                        <a class="pagination-page @(pageNumber == Model.CurrentPage ? "active" : "")"
                           asp-action="Index"
                           asp-route-keyword="@Model.Filter.Keyword"
                           asp-route-statusFilter="@Model.Filter.StatusFilter"
                           asp-route-requestDateFrom="@(Model.Filter.RequestDateFrom?.ToString("yyyy-MM-dd"))"
                           asp-route-requestDateTo="@(Model.Filter.RequestDateTo?.ToString("yyyy-MM-dd"))"
                           asp-route-executionDateFrom="@(Model.Filter.ExecutionDateFrom?.ToString("yyyy-MM-dd"))"
                           asp-route-executionDateTo="@(Model.Filter.ExecutionDateTo?.ToString("yyyy-MM-dd"))"
                           asp-route-assigneeKeyword="@Model.Filter.AssigneeKeyword"
                           asp-route-workStatusFilter="@Model.Filter.WorkStatusFilter"
                           asp-route-page="@pageNumber">
                            @pageNumber
                        </a>
                    }
                </div>

                <a class="pagination-button @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")"
                   asp-action="Index"
                   asp-route-keyword="@Model.Filter.Keyword"
                   asp-route-statusFilter="@Model.Filter.StatusFilter"
                   asp-route-requestDateFrom="@(Model.Filter.RequestDateFrom?.ToString("yyyy-MM-dd"))"
                   asp-route-requestDateTo="@(Model.Filter.RequestDateTo?.ToString("yyyy-MM-dd"))"
                   asp-route-executionDateFrom="@(Model.Filter.ExecutionDateFrom?.ToString("yyyy-MM-dd"))"
                   asp-route-executionDateTo="@(Model.Filter.ExecutionDateTo?.ToString("yyyy-MM-dd"))"
                   asp-route-assigneeKeyword="@Model.Filter.AssigneeKeyword"
                   asp-route-workStatusFilter="@Model.Filter.WorkStatusFilter"
                   asp-route-page="@(Model.CurrentPage + 1)">
                    <span>Sau</span>
                    <i class="fa-solid fa-angle-right" aria-hidden="true"></i>
                </a>
            </nav>
        }
    </article>
</section>
