<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <PublishProtocol>FileSystem</PublishProtocol>
  </PropertyGroup>
  <ItemGroup>
    <!-- Supply environment configuration on IIS; do not copy local credentials or machine keys. -->
    <Content Update="appsettings*.json" CopyToPublishDirectory="Never" />
    <None Update="appsettings*.json" CopyToPublishDirectory="Never" />
    <Content Update="App_Data\DataProtectionKeys\**\*" CopyToPublishDirectory="Never" />
    <Content Update="reports\**\*" CopyToPublishDirectory="Never" />
    <None Update="reports\**\*" CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
