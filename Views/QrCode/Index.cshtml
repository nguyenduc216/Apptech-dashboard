@model QrCodeBatchPageViewModel
@{
    var quantityHasError = ViewData.ModelState.TryGetValue("Request.Quantity", out var quantityState) && quantityState.Errors.Count > 0;
    var perRowHasError = ViewData.ModelState.TryGetValue("Request.QrPerRow", out var perRowState) && perRowState.Errors.Count > 0;
    var widthHasError = ViewData.ModelState.TryGetValue("Request.QrWidth", out var widthState) && widthState.Errors.Count > 0;
    var heightHasError = ViewData.ModelState.TryGetValue("Request.QrHeight", out var heightState) && heightState.Errors.Count > 0;
    var marginLeftHasError = ViewData.ModelState.TryGetValue("Request.MarginLeft", out var marginLeftState) && marginLeftState.Errors.Count > 0;
    var marginRightHasError = ViewData.ModelState.TryGetValue("Request.MarginRight", out var marginRightState) && marginRightState.Errors.Count > 0;
    var marginTopHasError = ViewData.ModelState.TryGetValue("Request.MarginTop", out var marginTopState) && marginTopState.Errors.Count > 0;
    var marginBottomHasError = ViewData.ModelState.TryGetValue("Request.MarginBottom", out var marginBottomState) && marginBottomState.Errors.Count > 0;
    var qrColumns = Math.Max(1, Model.Request.QrPerRow);
    var totalItems = Model.Items.Count;
    var qrStatusOptions = new[]
    {
        new { Value = QrCodeAssignmentQrStatus.MissingQr, Label = "Chưa có QR" }
    };

    string GetSeparatorClasses(int zeroBasedIndex)
    {
        if (!Model.Request.ShowDashedLines || totalItems == 0)
        {
            return string.Empty;
        }

        var classes = new List<string>();
        var isLastItemInRow = (zeroBasedIndex + 1) % qrColumns == 0;
        var hasItemOnRight = !isLastItemInRow && zeroBasedIndex < totalItems - 1;
        var hasItemBelow = zeroBasedIndex + qrColumns < totalItems;

        if (hasItemOnRight)
        {
            classes.Add("has-right-separator");
        }

        if (hasItemBelow)
        {
            classes.Add("has-bottom-separator");
        }

        return string.Join(" ", classes);
    }

    var printStyle = string.Create(
        System.Globalization.CultureInfo.InvariantCulture,
        $"--qr-columns:{Model.Request.QrPerRow};--qr-width:{Model.Request.QrWidth}mm;--qr-height:{Model.Request.QrHeight}mm;--qr-margin-left:{Model.Request.MarginLeft}mm;--qr-margin-right:{Model.Request.MarginRight}mm;--qr-margin-top:{Model.Request.MarginTop}mm;--qr-margin-bottom:{Model.Request.MarginBottom}mm;");
}

<section class="master-data-page qr-generator-page">
    <article class="panel master-data-panel qr-generator-panel qr-screen-only">
        <div class="panel-header qr-generator-header">
            <div>
                <h3>Tạo QR để in</h3>
                <p>Sinh tối đa 999 QR/lần theo mẫu <strong>appTech-XXXXXXXXX</strong>. Phần hậu tố dùng base36 9 ký tự và được cấp tuần tự để không trùng.</p>
            </div>

            <div class="qr-generator-header-actions">
                <button type="button"
                        class="secondary-button"
                        data-qr-assignment-open
                        aria-haspopup="dialog"
                        aria-expanded="false"
                        aria-controls="qrAssignmentModal">
                    <i class="fa-solid fa-link" aria-hidden="true"></i>
                    <span>Đánh mã QR</span>
                </button>

                @if (Model.HasGeneratedItems)
                {
                    <button type="button" class="primary-button" onclick="window.print()">
                        <span class="button-content">
                            <i class="fa-solid fa-print" aria-hidden="true"></i>
                            <span>In danh sách</span>
                        </span>
                        <span class="button-processing" aria-hidden="true">
                            <span class="button-processing-dot"></span>
                            <span class="button-processing-text">Đang xử lý</span>
                        </span>
                    </button>

                    <button type="submit" class="secondary-button qr-export-pdf-button" form="qrExportPdfForm">
                        <i class="fa-regular fa-file-pdf" aria-hidden="true"></i>
                        <span>Xuất PDF</span>
                    </button>
                }
            </div>
        </div>

        <form method="post" asp-action="Index" class="qr-generator-form">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="page-alert error"></div>

            <div class="account-form-grid qr-settings-grid">
                <label class="login-field @(quantityHasError ? "has-error" : "")">
                    <span>Số lượng QR</span>
                    <span class="login-input-shell">
                        <i class="fa-solid fa-hashtag" aria-hidden="true"></i>
                        <input asp-for="Request.Quantity" type="number" min="1" max="999" inputmode="numeric" />
                    </span>
                    <span asp-validation-for="Request.Quantity" class="login-field-error"></span>
                </label>

                <label class="login-field @(perRowHasError ? "has-error" : "")">
                    <span>Số QR / hàng</span>
                    <span class="login-input-shell">
                        <i class="fa-solid fa-table-cells-large" aria-hidden="true"></i>
                        <input asp-for="Request.QrPerRow" type="number" min="1" max="20" inputmode="numeric" />
                    </span>
                    <span asp-validation-for="Request.QrPerRow" class="login-field-error"></span>
                </label>

                <label class="login-field @(widthHasError ? "has-error" : "")">
                    <span>Kích thước ngang QR (mm)</span>
                    <span class="login-input-shell">
                        <i class="fa-solid fa-arrows-left-right" aria-hidden="true"></i>
                        <input asp-for="Request.QrWidth" type="number" min="10" max="135" inputmode="numeric" />
                    </span>
                    <span asp-validation-for="Request.QrWidth" class="login-field-error"></span>
                </label>

                <label class="login-field @(heightHasError ? "has-error" : "")">
                    <span>Kích thước dọc QR (mm)</span>
                    <span class="login-input-shell">
                        <i class="fa-solid fa-arrows-up-down" aria-hidden="true"></i>
                        <input asp-for="Request.QrHeight" type="number" min="10" max="135" inputmode="numeric" />
                    </span>
                    <span asp-validation-for="Request.QrHeight" class="login-field-error"></span>
                </label>

                <label class="login-field @(marginLeftHasError ? "has-error" : "")">
                    <span>Khoảng cách trái (mm)</span>
                    <span class="login-input-shell">
                        <i class="fa-solid fa-left-long" aria-hidden="true"></i>
                        <input asp-for="Request.MarginLeft" type="number" min="0" max="32" inputmode="numeric" />
                    </span>
                    <span asp-validation-for="Request.MarginLeft" class="login-field-error"></span>
                </label>

                <label class="login-field @(marginRightHasError ? "has-error" : "")">
                    <span>Khoảng cách phải (mm)</span>
                    <span class="login-input-shell">
                        <i class="fa-solid fa-right-long" aria-hidden="true"></i>
                        <input asp-for="Request.MarginRight" type="number" min="0" max="32" inputmode="numeric" />
                    </span>
                    <span asp-validation-for="Request.MarginRight" class="login-field-error"></span>
                </label>

                <label class="login-field @(marginTopHasError ? "has-error" : "")">
                    <span>Khoảng cách trên (mm)</span>
                    <span class="login-input-shell">
                        <i class="fa-solid fa-up-long" aria-hidden="true"></i>
                        <input asp-for="Request.MarginTop" type="number" min="0" max="32" inputmode="numeric" />
                    </span>
                    <span asp-validation-for="Request.MarginTop" class="login-field-error"></span>
                </label>

                <label class="login-field @(marginBottomHasError ? "has-error" : "")">
                    <span>Khoảng cách dưới (mm)</span>
                    <span class="login-input-shell">
                        <i class="fa-solid fa-down-long" aria-hidden="true"></i>
                        <input asp-for="Request.MarginBottom" type="number" min="0" max="32" inputmode="numeric" />
                    </span>
                    <span asp-validation-for="Request.MarginBottom" class="login-field-error"></span>
                </label>

                <label class="login-field qr-checkbox-field">
                    <span>Đường kẻ dash</span>
                    <span class="switch-field-shell qr-checkbox-shell">
                        <span class="switch-field-icon">
                            <i class="fa-solid fa-grip-lines" aria-hidden="true"></i>
                        </span>
                        <span class="status-switch">
                            <input asp-for="Request.ShowDashedLines" type="checkbox" class="status-switch-input" />
                            <span class="status-switch-track">
                                <span class="status-switch-thumb"></span>
                            </span>
                            <span class="status-switch-labels">
                                <span>Tắt</span>
                                <span>Bật</span>
                            </span>
                        </span>
                    </span>
                </label>

            </div>

            <div class="qr-generator-form-actions">
                <button type="submit" class="primary-button" data-processing-button data-processing-text="Đang tạo">
                    <span class="button-content">
                        <i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i>
                        <span>Tạo QR</span>
                    </span>
                    <span class="button-processing" aria-hidden="true">
                        <span class="button-processing-dot"></span>
                        <span class="button-processing-text">Đang tạo</span>
                    </span>
                </button>

            </div>
        </form>

        @if (Model.HasGeneratedItems)
        {
            <form method="post" asp-action="ExportPdf" id="qrExportPdfForm" class="qr-export-form">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Request.Quantity" />
                <input type="hidden" asp-for="Request.QrPerRow" />
                <input type="hidden" asp-for="Request.QrWidth" />
                <input type="hidden" asp-for="Request.QrHeight" />
                <input type="hidden" asp-for="Request.MarginLeft" />
                <input type="hidden" asp-for="Request.MarginRight" />
                <input type="hidden" asp-for="Request.MarginTop" />
                <input type="hidden" asp-for="Request.MarginBottom" />
                <input type="hidden" asp-for="Request.ShowDashedLines" />
                @for (var index = 0; index < Model.Items.Count; index++)
                {
                    <input type="hidden" name="Values" value="@Model.Items[index].Value" />
                }
            </form>
        }
    </article>

    <article class="panel master-data-panel qr-generator-panel qr-screen-only qr-180-panel" data-qr180-panel>
        <div class="panel-header"><div><h3>In tem 180 ô</h3><p>Cấu hình riêng cho giấy decal A4 gồm 10 cột × 18 dòng. Thông số QR thông thường phía trên không ảnh hưởng đến bản in này.</p></div></div>
        @if (TempData["Qr180ProfileSuccess"] is string profileSuccess) { <div class="page-alert success">@profileSuccess</div> }
        @if (TempData["Qr180ProfileError"] is string profileError) { <div class="page-alert error">@profileError</div> }

        <form method="post" class="qr-generator-form" data-qr180-print-form>
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="page-alert error"></div>
            <div class="account-form-grid qr-180-settings-grid">
                <label class="login-field"><span>Số trang</span><span class="login-input-shell"><i class="fa-regular fa-file-lines"></i><input asp-for="Print180.PageCount" type="number" min="1" max="50" /></span><span asp-validation-for="Print180.PageCount" class="login-field-error"></span></label>
                <label class="login-field"><span>Cấu hình máy in</span><span class="login-input-shell select-shell"><i class="fa-solid fa-print"></i><select asp-for="Print180.ProfileId" data-qr180-profile-select>
                    @foreach (var profile in Model.PrinterProfiles)
                    {
                        <option value="@profile.Id" data-name="@profile.ProfileName" data-offset-x="@profile.OffsetX.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-offset-y="@profile.OffsetY.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-pitch-x="@profile.PitchX.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-pitch-y="@profile.PitchY.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-qr-size="@profile.QrSize.ToString(System.Globalization.CultureInfo.InvariantCulture)">@profile.ProfileName</option>
                    }
                    <option value="">Tạo cấu hình mới</option>
                </select><span class="select-indicator"><i class="fa-solid fa-chevron-down"></i></span></span></label>
                <label class="login-field"><span>Tên cấu hình</span><span class="login-input-shell"><i class="fa-solid fa-tag"></i><input type="text" maxlength="100" data-qr180-profile-name value="@(Model.PrinterProfiles.FirstOrDefault()?.ProfileName ?? "Mặc định")" /></span></label>
            </div>

            <div class="qr-180-calibration-title"><strong>Hiệu chỉnh</strong><span>Đơn vị mm, nhập theo bước 0,05.</span></div>
            <div class="account-form-grid qr-180-calibration-grid">
                <label class="login-field"><span>Dịch trái / phải <i class="fa-regular fa-circle-question" title="Dùng khi toàn bộ QR bị lệch sang trái hoặc phải."></i></span><span class="login-input-shell"><input asp-for="Print180.OffsetX" type="number" min="-10" max="10" step="0.05" data-qr180-value="offsetX" /><em>mm</em></span><span asp-validation-for="Print180.OffsetX" class="login-field-error"></span></label>
                <label class="login-field"><span>Dịch lên / xuống <i class="fa-regular fa-circle-question" title="Số âm dịch lên trên; số dương dịch xuống dưới."></i></span><span class="login-input-shell"><input asp-for="Print180.OffsetY" type="number" min="-10" max="10" step="0.05" data-qr180-value="offsetY" /><em>mm</em></span><span asp-validation-for="Print180.OffsetY" class="login-field-error"></span></label>
                <label class="login-field"><span>Bước ngang <i class="fa-regular fa-circle-question" title="Dùng khi cột đầu đúng nhưng các cột cuối lệch dần."></i></span><span class="login-input-shell"><input asp-for="Print180.PitchX" type="number" min="18" max="22" step="0.05" data-qr180-value="pitchX" /><em>mm</em></span><span asp-validation-for="Print180.PitchX" class="login-field-error"></span></label>
                <label class="login-field"><span>Bước dọc <i class="fa-regular fa-circle-question" title="Dùng khi dòng đầu đúng nhưng các dòng cuối lệch dần."></i></span><span class="login-input-shell"><input asp-for="Print180.PitchY" type="number" min="13" max="17" step="0.05" data-qr180-value="pitchY" /><em>mm</em></span><span asp-validation-for="Print180.PitchY" class="login-field-error"></span></label>
                <label class="login-field"><span>Kích thước QR <i class="fa-regular fa-circle-question" title="Điều chỉnh kích thước mã QR trong từng tem."></i></span><span class="login-input-shell"><input asp-for="Print180.QrSize" type="number" min="10" max="18" step="0.05" data-qr180-value="qrSize" /><em>mm</em></span><span asp-validation-for="Print180.QrSize" class="login-field-error"></span></label>
            </div>
            <div class="page-alert info qr-180-print-guide"><i class="fa-solid fa-circle-info"></i><div><strong>Khi in:</strong> chọn A4, Portrait, Scale 100% / Actual size; không chọn Fit to page hoặc Shrink oversized pages.</div></div>
            <div class="qr-generator-form-actions">
                <button type="submit" class="secondary-button" formaction="@Url.Action("PrintCalibration180", "QrCode")" formtarget="_blank"><i class="fa-solid fa-crosshairs"></i><span>In thử căn chỉnh</span></button>
                <button type="button" class="secondary-button" data-qr180-save><i class="fa-regular fa-floppy-disk"></i><span>Lưu cấu hình</span></button>
                <button type="submit" class="primary-button" formaction="@Url.Action("Print180", "QrCode")" formtarget="_blank"><span class="button-content"><i class="fa-solid fa-print"></i><span>In 180 QR</span></span></button>
            </div>
        </form>
        <form method="post" asp-action="Save180Profile" hidden data-qr180-save-form>
            @Html.AntiForgeryToken()
            <input name="Profile.Id" data-save-field="id" /><input name="Profile.ProfileName" data-save-field="name" />
            <input name="Profile.OffsetX" data-save-field="offsetX" /><input name="Profile.OffsetY" data-save-field="offsetY" />
            <input name="Profile.PitchX" data-save-field="pitchX" /><input name="Profile.PitchY" data-save-field="pitchY" /><input name="Profile.QrSize" data-save-field="qrSize" />
        </form>
    </article>

    @if (Model.HasGeneratedItems)
    {
        <article class="panel master-data-panel qr-generator-panel qr-screen-only" data-qr-export-source>
            <div class="panel-header">
                <div>
                    <h3>Bản xem trước</h3>
                    <p>
                        Đã tạo <strong>@Model.Items.Count</strong> mã.
                        Dải số <strong>@Model.FirstSequence</strong> đến <strong>@Model.LastSequence</strong>.
                        Thời điểm tạo <strong>@Model.GeneratedAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</strong>.
                    </p>
                </div>
            </div>

            <div class="qr-batch-sheet qr-batch-preview @(Model.Request.ShowDashedLines ? "has-guides" : null)" style="@printStyle">
                <div class="qr-batch-grid">
                    @for (var index = 0; index < Model.Items.Count; index++)
                    {
                        var item = Model.Items[index];
                        <article class="qr-batch-item @GetSeparatorClasses(index)">
                            <div class="qr-batch-code">
                                <div class="qr-batch-code-graphic">@Html.Raw(item.SvgMarkup)</div>
                            </div>
                        </article>
                    }
                </div>
            </div>
        </article>

        <section class="qr-print-layout">
            <div class="qr-print-meta">
                <div>Tạo lúc: @Model.GeneratedAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</div>
                <div>Số lượng: @Model.Items.Count</div>
            </div>

            <div class="qr-batch-sheet @(Model.Request.ShowDashedLines ? "has-guides" : null)" style="@printStyle">
                <div class="qr-batch-grid">
                    @for (var index = 0; index < Model.Items.Count; index++)
                    {
                        var item = Model.Items[index];
                        <article class="qr-batch-item @GetSeparatorClasses(index)">
                            <div class="qr-batch-code">
                                <div class="qr-batch-code-graphic">@Html.Raw(item.SvgMarkup)</div>
                            </div>
                        </article>
                    }
                </div>
            </div>
        </section>
    }
</section>

<div class="crud-modal-shell" data-qr-assignment-shell hidden>
    <div class="crud-modal-backdrop" aria-hidden="true"></div>

    <section class="crud-modal qr-assignment-modal" id="qrAssignmentModal" role="dialog" aria-modal="true" aria-labelledby="qr-assignment-title">
        <div class="crud-modal-header">
            <div class="crud-modal-heading">
                <h2 id="qr-assignment-title">Đánh mã QR cho vật tư</h2>
                <p class="crud-modal-subtitle">Quét QR hợp lệ để gán trực tiếp cho vật tư trong danh sách. Sau mỗi lần thành công, vật tư sẽ được loại khỏi danh sách chờ.</p>
                <div class="qr-assignment-alert" data-qr-assignment-alert role="alert" hidden></div>
                <div class="qr-assignment-header-progress" data-qr-assignment-header-progress>Còn 0 / 0 vật tư</div>
            </div>

            <button type="button"
                    class="menu-nav-button crud-close-button"
                    data-qr-assignment-close
                    aria-label="Đóng popup đánh mã QR">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>

        <div class="qr-assignment-modal-body"
             data-qr-assignment-root
             data-search-url="@Url.Action("SearchAssignmentTargets", "QrCode")"
             data-assign-url="@Url.Action("AssignToVatTu", "QrCode")">
            <form class="qr-assignment-search-form" data-qr-assignment-search-form>
                @Html.AntiForgeryToken()

                <div class="qr-scanner-shell qr-assignment-scanner">
                    <div class="qr-scanner-layout">
                        <div class="qr-scanner-main">
                            <div class="qr-display-card is-empty qr-assignment-display-card">
                                <div class="qr-display-default" data-qr-assignment-default>
                                    <div class="qr-display-icon">
                                        <i class="fa-solid fa-qrcode" aria-hidden="true"></i>
                                    </div>
                                </div>
                                <div class="qr-scanner-panel" data-qr-assignment-panel hidden>
                                    <div class="qr-scanner-reader" data-qr-assignment-reader></div>
                                    <div class="qr-scanner-frame" aria-hidden="true"></div>
                                </div>
                            </div>

                            <input type="hidden" data-qr-assignment-result />
                            <span class="login-input-shell readonly-shell qr-result-shell is-hidden"
                                  data-qr-assignment-result-shell>
                                <i class="fa-solid fa-qrcode" aria-hidden="true"></i>
                                <span data-qr-assignment-result-display></span>
                            </span>
                            <div class="qr-scanner-status" data-qr-assignment-status>
                                Tìm danh sách vật tư trước, sau đó quét QR bằng camera hoặc ảnh.
                            </div>
                        </div>

                        <div class="qr-scanner-side">
                            <div class="qr-scanner-actions">
                                <button type="button" class="secondary-button qr-scanner-button" data-qr-assignment-start>
                                    <i class="fa-solid fa-camera" aria-hidden="true"></i>
                                    <span>Quét camera</span>
                                </button>

                                <label class="secondary-button qr-scanner-button qr-file-button" for="qrAssignmentImageFile">
                                    <i class="fa-regular fa-image" aria-hidden="true"></i>
                                    <span>Quét từ ảnh</span>
                                </label>

                                <button type="button" class="secondary-button qr-scanner-button" data-qr-assignment-stop hidden>
                                    <i class="fa-solid fa-stop" aria-hidden="true"></i>
                                    <span>Dừng quét</span>
                                </button>

                                <div class="qr-camera-select-shell" data-qr-assignment-camera-shell hidden>
                                    <span class="login-input-shell select-shell">
                                        <i class="fa-solid fa-camera-rotate" aria-hidden="true"></i>
                                        <select data-qr-assignment-camera></select>
                                        <span class="select-indicator"><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></span>
                                    </span>
                                </div>

                                <input type="file"
                                       id="qrAssignmentImageFile"
                                       accept="image/*"
                                       hidden
                                       data-qr-assignment-file />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="page-alert info qr-assignment-active-card" data-qr-assignment-active-card>
                    <i class="fa-solid fa-box-open" aria-hidden="true"></i>
                    <div class="qr-assignment-active-copy">
                        <strong data-qr-assignment-active-title>Chưa có vật tư mục tiêu</strong>
                        <span data-qr-assignment-active-meta>Tìm kiếm để nạp danh sách vật tư cần đánh mã QR.</span>
                    </div>
                </div>

                <div class="account-form-grid qr-assignment-filter-grid">
                    <label class="login-field">
                        <span>Hàng hóa</span>
                        <span class="login-input-shell select-shell">
                            <i class="fa-solid fa-boxes-stacked" aria-hidden="true"></i>
                            <select name="HangHoaId">
                                <option value="">Tất cả hàng hóa</option>
                                @foreach (var option in Model.Assignment.HangHoaOptions)
                                {
                                    <option value="@option.Id">@option.Label</option>
                                }
                            </select>
                            <span class="select-indicator"><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></span>
                        </span>
                    </label>

                    <label class="login-field">
                        <span>Tên chi tiết</span>
                        <span class="login-input-shell">
                            <i class="fa-solid fa-cubes" aria-hidden="true"></i>
                            <input type="search" name="TenChiTiet" autocomplete="off" />
                        </span>
                    </label>

                    <label class="login-field">
                        <span>Kho</span>
                        <span class="login-input-shell select-shell">
                            <i class="fa-solid fa-warehouse" aria-hidden="true"></i>
                            <select name="KhoId">
                                <option value="">Tất cả kho</option>
                                @foreach (var option in Model.Assignment.KhoOptions)
                                {
                                    <option value="@option.Id">@option.Label</option>
                                }
                            </select>
                            <span class="select-indicator"><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></span>
                        </span>
                    </label>

                    <label class="login-field">
                        <span>Vị trí kho</span>
                        <span class="login-input-shell">
                            <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
                            <input type="search" name="ViTriLuuKho" autocomplete="off" />
                        </span>
                    </label>

                    <label class="login-field">
                        <span>Mã số lô</span>
                        <span class="login-input-shell">
                            <i class="fa-solid fa-barcode" aria-hidden="true"></i>
                            <input type="search" name="MaSoLo" autocomplete="off" />
                        </span>
                    </label>

                    <label class="login-field">
                        <span>Mã phiếu nhập</span>
                        <span class="login-input-shell">
                            <i class="fa-solid fa-file-import" aria-hidden="true"></i>
                            <input type="search" name="MaPhieuNhap" autocomplete="off" />
                        </span>
                    </label>

                    <label class="login-field">
                        <span>Trạng thái QR</span>
                        <span class="login-input-shell select-shell">
                            <i class="fa-solid fa-qrcode" aria-hidden="true"></i>
                            <select name="QrStatus">
                                @foreach (var option in qrStatusOptions)
                                {
                                    <option value="@option.Value">@option.Label</option>
                                }
                            </select>
                            <span class="select-indicator"><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></span>
                        </span>
                    </label>
                </div>

                <div class="qr-assignment-search-actions">
                    <button type="submit"
                            class="primary-button"
                            data-qr-assignment-search-button>
                        <span class="button-content">
                            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                            <span>Tìm vật tư</span>
                        </span>
                    </button>

                    <button type="button"
                            class="secondary-button"
                            data-qr-assignment-reset>
                        Làm mới bộ lọc
                    </button>
                </div>
            </form>

            <div class="master-data-summary qr-assignment-summary">
                <div><strong data-qr-assignment-count>0</strong> vật tư chờ đánh mã</div>
                <div data-qr-assignment-hint>Danh sách sẽ hiển thị sau khi tìm kiếm.</div>
            </div>

            <div class="qr-assignment-result-list" data-qr-assignment-results>
                <div class="master-data-empty qr-assignment-empty">
                    Chưa có danh sách vật tư để đánh mã QR.
                </div>
            </div>
        </div>
    </section>
</div>

<script>
document.addEventListener("DOMContentLoaded", () => {
    const panel = document.querySelector("[data-qr180-panel]");
    if (!panel) return;
    const select = panel.querySelector("[data-qr180-profile-select]");
    const profileName = panel.querySelector("[data-qr180-profile-name]");
    const values = Object.fromEntries([...panel.querySelectorAll("[data-qr180-value]")].map(input => [input.dataset.qr180Value, input]));
    const applyProfile = () => {
        const option = select.options[select.selectedIndex];
        if (!option || !option.value) { profileName.value = ""; return; }
        profileName.value = option.dataset.name || option.textContent.trim();
        for (const key of Object.keys(values)) values[key].value = option.dataset[key] || values[key].value;
    };
    select.addEventListener("change", applyProfile);
    panel.querySelector("[data-qr180-save]").addEventListener("click", () => {
        const form = panel.querySelector("[data-qr180-save-form]");
        form.querySelector('[data-save-field="id"]').value = select.value;
        form.querySelector('[data-save-field="name"]').value = profileName.value.trim();
        for (const key of Object.keys(values)) form.querySelector(`[data-save-field="${key}"]`).value = values[key].value;
        form.submit();
    });
});
</script>
