@using System.Globalization
@using System.Text.Json
@model YeuCauDetailViewModel
@{
    ViewData["Title"] = Model.PageTitle;
    ViewData["Breadcrumb"] = $"Trang chủ / Kỹ thuật / Quản lý yêu cầu / {Model.PageTitle}";

    var maYeuCauHasError = ViewData.ModelState.TryGetValue("Form.MaYeuCau", out var maYeuCauState) && maYeuCauState.Errors.Count > 0;
    var ngayYeuCauHasError = ViewData.ModelState.TryGetValue("Form.NgayYeuCau", out var ngayYeuCauState) && ngayYeuCauState.Errors.Count > 0;
    var ngayThucHienHasError = ViewData.ModelState.TryGetValue("Form.NgayThucHien", out var ngayThucHienState) && ngayThucHienState.Errors.Count > 0;
    var ngayHetHanHasError = ViewData.ModelState.TryGetValue("Form.NgayHetHan", out var ngayHetHanState) && ngayHetHanState.Errors.Count > 0;
    var ngayHoanThanhHasError = ViewData.ModelState.TryGetValue("Form.NgayHoanThanh", out var ngayHoanThanhState) && ngayHoanThanhState.Errors.Count > 0;
    var ngayHenTiepTheoHasError = ViewData.ModelState.TryGetValue("Form.NgayHenTiepTheo", out var ngayHenTiepTheoState) && ngayHenTiepTheoState.Errors.Count > 0;
    var idDiaDiemHasError = ViewData.ModelState.TryGetValue("Form.IDDiaDiem", out var diaDiemState) && diaDiemState.Errors.Count > 0;
    var trangThaiHasError = ViewData.ModelState.TryGetValue("Form.TrangThaiYeuCau", out var trangThaiState) && trangThaiState.Errors.Count > 0;
    var ghiChuHasError = ViewData.ModelState.TryGetValue("Form.GhiChu", out var ghiChuState) && ghiChuState.Errors.Count > 0;
    var summaryErrors = ViewData.ModelState.TryGetValue(string.Empty, out var summaryState)
        ? summaryState.Errors.Select(error => error.ErrorMessage).Where(message => !string.IsNullOrWhiteSpace(message)).ToArray()
        : [];
    var selectedLocation = Model.SelectedLocation;
    var selectedLocationLabel = selectedLocation?.DisplayLabel ?? string.Empty;
    var invariantCulture = CultureInfo.InvariantCulture;
    var viCulture = CultureInfo.GetCultureInfo("vi-VN");
    var selectedLongValue = selectedLocation?.LongAddress?.ToString(invariantCulture) ?? string.Empty;
    var selectedLatValue = selectedLocation?.LatAddress?.ToString(invariantCulture) ?? string.Empty;
    var activeTab = string.IsNullOrWhiteSpace(Model.Form.ActiveTab) || Model.Form.ActiveTab == "khach-hang" ? "thong-tin" : Model.Form.ActiveTab;
    var phoneHref = string.IsNullOrWhiteSpace(selectedLocation?.DienThoai)
        ? string.Empty
        : new string(selectedLocation.DienThoai.Where(character => char.IsDigit(character) || character == '+').ToArray());
    var works = Model.Form.CongViecs.ToList();
    var completedWorkCount = works.Count(work => YeuCauCongViecTrangThaiCatalog.IsCompleted(work.TrangThaiCongViec));
    var hasIncompleteWork = works.Any(work => !YeuCauCongViecTrangThaiCatalog.IsCompleted(work.TrangThaiCongViec));
    var workCompletionPercent = works.Count == 0 ? 0 : (int)Math.Round(completedWorkCount * 100m / works.Count);
    var assignedCheckinEmployees = works
        .SelectMany(work => work.NhanViens)
        .Where(employee => employee.NhanVienId.HasValue && employee.NhanVienId.Value > 0)
        .GroupBy(employee => employee.NhanVienId!.Value)
        .Select(group => group.First())
        .OrderBy(employee => employee.HoTen)
        .ToList();
    var checkinGroups = Model.Checkins
        .Where(item => item.ThoiDiem.HasValue)
        .GroupBy(item => item.ThoiDiem!.Value.Date)
        .OrderByDescending(group => group.Key)
        .ToList();
    var currentEmployeeIdValue = Model.CurrentEmployeeId?.ToString(invariantCulture) ?? string.Empty;
    var currentAuditUser = (User.FindFirst("display_name")?.Value ?? User.Identity?.Name ?? User.FindFirst("http://schemas.xmlsoap.org/ws/2005/05/identity/claims/name")?.Value ?? "system").Trim();
    var checkinDistanceLimitValue = Model.CheckinDistanceLimitMeters?.ToString(invariantCulture) ?? string.Empty;
    var hasCheckinDistanceLimit = Model.CheckinDistanceLimitMeters.HasValue && Model.CheckinDistanceLimitMeters.Value > 0;
    var canToggleCheckinDistanceConstraint = Model.CanToggleCheckinDistanceConstraint;
    var canManageCheckinProxy = Model.CanManageCheckinProxy;
    var checkinByDistanceValue = (hasCheckinDistanceLimit && Model.Form.CheckinTheoKhoangCach).ToString().ToLowerInvariant();
    var defaultCheckinEmployeeId = Model.CurrentEmployeeId.HasValue && assignedCheckinEmployees.Any(employee => employee.NhanVienId == Model.CurrentEmployeeId)
        ? Model.CurrentEmployeeId
        : assignedCheckinEmployees.FirstOrDefault()?.NhanVienId;
    var pendingCheckout = Model.Checkins
        .Where(item => item.IsOpen)
        .Where(item => canManageCheckinProxy || (Model.CurrentEmployeeId.HasValue && item.IDNhanVien == Model.CurrentEmployeeId))
        .OrderByDescending(item => item.ThoiDiem)
        .ThenByDescending(item => item.Id)
        .FirstOrDefault();
    var canUpdateLocationCoordinates = Model.IsEditMode &&
        (canManageCheckinProxy || (Model.CurrentEmployeeId.HasValue && assignedCheckinEmployees.Any(employee => employee.NhanVienId == Model.CurrentEmployeeId)));
    var selectedLocationHasCoordinates = selectedLocation?.LatAddress.HasValue == true && selectedLocation?.LongAddress.HasValue == true;
    var workOptionsJson = JsonSerializer.Serialize(Model.WorkOptions.Select(option => new
    {
        id = option.Id,
        tenCongViec = option.TenCongViec,
        soLuongAnhCheckIn = option.SoLuongAnhCheckIn,
        soLuongAnhCheckOut = option.SoLuongAnhCheckOut,
        checklists = option.Checklists.Select(checklist => new
        {
            checklistId = checklist.ChecklistId,
            tenChecklist = checklist.TenChecklist,
            viTri = checklist.ViTri
        })
    }));
}

<section class="master-data-page yeu-cau-detail-page">
    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="floating-status-toast @Model.StatusType"
             data-status-toast
             role="status"
             aria-live="polite">
            <div class="floating-status-toast-icon" aria-hidden="true">
                <i class="fa-solid @(Model.StatusType == "success" ? "fa-circle-check" : Model.StatusType == "error" ? "fa-circle-exclamation" : "fa-circle-info")"></i>
            </div>
            <div class="floating-status-toast-body">
                <strong>@(Model.StatusType == "success" ? "Thành công" : Model.StatusType == "error" ? "Có lỗi xảy ra" : "Thông báo")</strong>
                <span>@Model.StatusMessage</span>
            </div>
            <button type="button" class="floating-status-toast-close" data-status-toast-close aria-label="Đóng thông báo">
                <span aria-hidden="true">×</span>
            </button>
        </div>
    }

    <form method="post"
          asp-action="@Model.SubmitAction"
          class="account-form yeu-cau-detail-form"
          data-yeu-cau-form
          data-search-url="@Url.Action("SearchLocations", "YeuCau")"
          data-customer-search-url="@Url.Action("SearchCustomers", "YeuCau")"
          data-location-create-url="@Url.Action("CreateLocation", "YeuCau")"
          data-code-url="@Url.Action("PreviewCode", "YeuCau")"
          data-checkin-url="@Url.Action("CreateCheckin", "YeuCau")"
          data-checkout-url="@Url.Action("CreateCheckout", "YeuCau")"
          data-work-image-url="@Url.Action("UploadWorkImage", "YeuCau")"
          data-work-image-delete-url="@Url.Action("DeleteWorkImage", "YeuCau")"
          data-work-checklist-add-url="@Url.Action("AddWorkChecklist", "YeuCau")"
          data-service-works-url="@Url.Action("GetWorks", "DanhMucDichVu")"
          data-location-coordinate-url="@Url.Action("UpdateLocationCoordinates", "YeuCau")"
          data-location-coordinate-draft-url="@Url.Action("UpdateDraftLocationCoordinates", "YeuCau")"
          data-checkin-delete-url="@Url.Action("DeleteCheckin", "YeuCau")"
          data-zalo-request-id="@Model.Form.Id"
          data-zalo-request-link-url="/api/zalo/request-links"
          data-zalo-request-status-base="/api/zalo/request-links"
          data-current-employee-id="@currentEmployeeIdValue"
          data-current-user="@currentAuditUser"
          data-checkin-distance-limit="@checkinDistanceLimitValue"
          data-checkin-by-distance="@checkinByDistanceValue"
          data-is-admin="@Model.CurrentUserIsAdmin.ToString().ToLowerInvariant()"
          data-can-manage-checkin-proxy="@canManageCheckinProxy.ToString().ToLowerInvariant()">
        @Html.AntiForgeryToken()

        <input asp-for="Form.Id" type="hidden" />
        <input asp-for="Form.Keyword" type="hidden" />
        <input asp-for="Form.StatusFilter" type="hidden" />
        <input asp-for="Form.WorkStatusFilter" type="hidden" />
        <input asp-for="Form.Page" type="hidden" />
        <input asp-for="Form.IDKhachHang" type="hidden" data-selected-customer-id />
        <input asp-for="Form.IDDiaDiem" type="hidden" data-selected-location-id />
        <input asp-for="Form.NhanVienThucHienText" type="hidden" />
        <input type="hidden" name="Form.WorkEmployeesJson" data-work-employees-json />
        <span data-can-add-work-employee asp-permission-code="YeuCau_WorkEmployee_Insert" hidden></span>
        <span data-can-delete-work-employee asp-permission-code="YeuCau_WorkEmployee_Delete" hidden></span>
        <select asp-for="Form.NhanVienThucHienId" data-employee-select hidden>
            <option value=""></option>
            @foreach (var nhanVien in Model.NhanVienOptions)
            {
                <option value="@nhanVien.Id"
                        data-employee-name="@nhanVien.HoTen"
                        data-employee-role="@nhanVien.ChucVu"
                        data-employee-avatar="@nhanVien.Avatar">
                    @nhanVien.DisplayText
                </option>
            }
        </select>
        <input asp-for="Form.ActiveTab" type="hidden" data-active-tab-input />
        <script type="application/json" data-work-options-json>@Html.Raw(workOptionsJson)</script>

        <article class="panel khach-hang-detail-hero">
            <div class="khach-hang-detail-hero-copy">
                <div class="khach-hang-detail-eyebrow">Yêu cầu</div>
                <h2>@Model.PageTitle</h2>
                <p>@Model.PageDescription</p>
            </div>

            <div class="khach-hang-detail-hero-actions">
                <a class="secondary-button"
                   asp-action="Index"
                   asp-route-keyword="@Model.Filter.Keyword"
                   asp-route-statusFilter="@Model.Filter.StatusFilter"
                   asp-route-page="@Model.Filter.Page">
                    <span class="yeu-cau-back-desktop">Quay lại danh sách</span>
                    <span class="yeu-cau-back-mobile">Về danh sách</span>
                </a>

                @if (Model.IsEditMode)
                {
                    <button type="button"
                            class="secondary-button"
                            data-zalo-qr-open>
                        <i class="fa-solid fa-qrcode" aria-hidden="true"></i>
                        <span>Gửi lịch Zalo</span>
                    </button>
                }

                <button type="submit" class="primary-button" asp-permission-action="@(Model.IsEditMode ? "update" : "insert")" data-processing-button data-processing-text="Đang lưu">
                    <span class="button-content">
                        <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i>
                        <span>@(Model.IsEditMode ? "Lưu cập nhật" : "Thêm mới")</span>
                    </span>
                    <span class="button-processing" aria-hidden="true">
                        <span class="button-processing-dot"></span>
                        <span class="button-processing-text">Đang lưu</span>
                    </span>
                </button>
            </div>
        </article>

        @if (summaryErrors.Length > 0)
        {
            <div class="page-alert error validation-summary">
                <i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i>
                <div>
                    @foreach (var message in summaryErrors)
                    {
                        <div>@message</div>
                    }
                </div>
            </div>
        }

        @if (Model.IsEditMode)
        {
            var rating = Model.CustomerRating;
            var zaloProfile = Model.CustomerZaloProfile;
            <article class="panel yeu-cau-zalo-rating-panel">
                <div class="yeu-cau-zalo-rating-card @(rating?.HasRating == true && rating.RatingScore <= 2 ? "is-warning" : null)">
                    <div class="yeu-cau-zalo-rating-heading">
                        <span class="yeu-cau-zalo-rating-icon"><i class="fa-solid fa-star" aria-hidden="true"></i></span>
                        <div>
                            <h3>Danh gia cua khach hang</h3>
                            <p>@(rating?.HasRating == true ? "Khach hang da gui danh gia chat luong cong viec." : "Khach hang chua danh gia phieu nay.")</p>
                        </div>
                    </div>
                    @if (rating?.HasRating == true)
                    {
                        <div class="yeu-cau-rating-score" aria-label="Diem danh gia">
                            @for (var score = 1; score <= 5; score++)
                            {
                                <i class="fa-solid fa-star @(score <= rating.RatingScore ? "is-active" : null)" aria-hidden="true"></i>
                            }
                            <strong>@rating.RatingScore/5</strong>
                        </div>
                        <dl class="yeu-cau-zalo-rating-meta">
                            <div><dt>Thoi gian</dt><dd>@(rating.SubmittedAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm", viCulture) ?? "-")</dd></div>
                            <div><dt>Nguon</dt><dd>@(string.IsNullOrWhiteSpace(rating.Source) ? "ZaloQr" : rating.Source)</dd></div>
                            <div><dt>Ghi chu</dt><dd>@(string.IsNullOrWhiteSpace(rating.Note) ? "-" : rating.Note)</dd></div>
                            <div><dt>Nhan xet</dt><dd>@(string.IsNullOrWhiteSpace(rating.CustomerComment) ? "-" : rating.CustomerComment)</dd></div>
                        </dl>
                        @if (rating.Items.Count > 0)
                        {
                            <div class="yeu-cau-rating-item-list">
                                @foreach (var item in rating.Items)
                                {
                                    <div class="yeu-cau-rating-item">
                                        <strong>@item.WorkName</strong>
                                        <span>@item.RatingScore/5</span>
                                        <small>@(string.IsNullOrWhiteSpace(item.Note) ? "-" : item.Note)</small>
                                    </div>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <button type="button" class="secondary-button" data-zalo-qr-open>
                            <i class="fa-solid fa-qrcode" aria-hidden="true"></i>
                            <span>Gui QR danh gia Zalo</span>
                        </button>
                    }
                </div>

                <div class="yeu-cau-zalo-rating-card">
                    <div class="yeu-cau-zalo-rating-heading">
                        <span class="yeu-cau-zalo-rating-icon"><i class="fa-solid fa-comments" aria-hidden="true"></i></span>
                        <div>
                            <h3>Thong tin Zalo</h3>
                            <p>@(zaloProfile?.Connected == true ? "Da ket noi Zalo OA." : "Chua ket noi Zalo OA.")</p>
                        </div>
                    </div>
                    <span class="status-pill @(zaloProfile?.Connected == true ? "completed" : "pending")">
                        @(zaloProfile?.Connected == true ? "Da ket noi Zalo OA" : "Chua ket noi Zalo")
                    </span>
                    @if (zaloProfile?.Connected == true)
                    {
                        <dl class="yeu-cau-zalo-rating-meta">
                            <div><dt>Zalo User ID</dt><dd>@zaloProfile.ZaloUserId</dd></div>
                            <div><dt>Ten Zalo</dt><dd>@(string.IsNullOrWhiteSpace(zaloProfile.ZaloDisplayName) ? "-" : zaloProfile.ZaloDisplayName)</dd></div>
                            <div><dt>So dien thoai Zalo</dt><dd>@(string.IsNullOrWhiteSpace(zaloProfile.ZaloPhoneNumber) ? "-" : zaloProfile.ZaloPhoneNumber)</dd></div>
                            <div><dt>Lan tuong tac gan nhat</dt><dd>@(zaloProfile.LastInteractionAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm", viCulture) ?? "-")</dd></div>
                        </dl>
                    }
                    else
                    {
                        <p class="yeu-cau-zalo-rating-hint">Gui QR Zalo de khach ket noi va danh gia. Neu khach da co Zalo ID, QR se vao thang trang danh gia.</p>
                    }
                </div>
            </article>
        }

        <article class="panel khach-hang-detail-panel">
            <div class="crud-tabs khach-hang-detail-tabs" data-tab-group>
                <div class="crud-tab-list" role="tablist" aria-label="Nhóm thông tin yêu cầu">
                    <button type="button"
                            class="crud-tab-button @(activeTab == "thong-tin" ? "is-active" : "")"
                            data-tab-button
                            data-tab="thong-tin"
                            role="tab"
                            aria-selected="@(activeTab == "thong-tin" ? "true" : "false")">
                        <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
                        <span>Thông tin</span>
                    </button>

                    <button type="button"
                            class="crud-tab-button @(activeTab == "cong-viec" ? "is-active" : "")"
                            data-tab-button
                            data-tab="cong-viec"
                            role="tab"
                            aria-selected="@(activeTab == "cong-viec" ? "true" : "false")">
                        <i class="fa-solid fa-list-check" aria-hidden="true"></i>
                        <span>Công việc</span>
                    </button>

                    <button type="button"
                            class="crud-tab-button @(activeTab == "checkin" ? "is-active" : "")"
                            data-tab-button
                            data-tab="checkin"
                            role="tab"
                            aria-selected="@(activeTab == "checkin" ? "true" : "false")">
                        <i class="fa-solid fa-calendar-check" aria-hidden="true"></i>
                        <span>Checkin</span>
                    </button>
                </div>

                <div class="crud-tab-panel @(activeTab == "thong-tin" ? "is-active" : "")"
                     data-tab-panel
                     data-tab="thong-tin"
                     role="tabpanel"
                     @(activeTab == "thong-tin" ? null : "hidden")>
                    <section class="yeu-cau-collapse-panel yeu-cau-location-collapse-panel" data-collapse-root>
                        <button type="button"
                                class="yeu-cau-collapse-toggle"
                                data-collapse-toggle
                                aria-expanded="true">
                            <span class="yeu-cau-collapse-copy">
                                <strong>Địa điểm làm việc</strong>
                                <small>Chọn địa điểm khách hàng và xem bản đồ thực hiện.</small>
                            </span>
                            <i class="fa-solid fa-chevron-up" aria-hidden="true" data-collapse-icon></i>
                        </button>

                        <div class="yeu-cau-collapse-body" data-collapse-body>
                            <div class="yeu-cau-map-summary-layout" data-request-location-card>
                                <div class="yeu-cau-location-selection">
                                    <label class="login-field @(idDiaDiemHasError ? "has-error" : "")">
                                        <span>Địa điểm làm việc</span>
                                        <span class="login-input-shell">
                                            <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
                                            <input type="search"
                                                   value="@selectedLocationLabel"
                                                   autocomplete="off"
                                                   placeholder="Tìm địa điểm khách hàng trong hệ thống..."
                                                   data-location-search-input />
                                            <button type="button" class="login-input-action yeu-cau-location-create-button" data-location-create-open aria-label="Thêm địa điểm khách hàng">
                                                <i class="fa-solid fa-plus" aria-hidden="true"></i>
                                            </button>
                                        </span>
                                        <small class="yeu-cau-location-picker-hint">Chỉ được chọn từ danh sách địa điểm khách hàng đang có trong hệ thống.</small>
                                        <span asp-validation-for="Form.IDDiaDiem" class="login-field-error"></span>
                                        <div class="yeu-cau-location-suggestion-list" data-location-suggestions hidden></div>
                                    </label>
                                </div>

                                <div
                                        class="khach-hang-location-map-preview yeu-cau-map-preview"
                                        aria-label="Xem bản đồ địa điểm khách hàng">
                                    <button type="button"
                                            class="yeu-cau-map-preview-open"
                                            data-request-location-map-preview
                                            aria-label="Xem bản đồ địa điểm khách hàng"></button>
                                    <div class="khach-hang-location-map-preview-canvas yeu-cau-map-preview-canvas" data-request-location-preview-map></div>
                                    <div class="khach-hang-location-map-preview-copy">
                                        <span data-request-location-preview-title>@(selectedLocation?.LatAddress.HasValue == true && selectedLocation?.LongAddress.HasValue == true ? "Xem bản đồ" : "Chưa có ghim")</span>
                                        <small>Nhấn để mở bản đồ</small>
                                        <button type="button"
                                                class="secondary-button yeu-cau-location-coordinate-button @(selectedLocation is null || selectedLocationHasCoordinates ? "is-hidden" : null)"
                                                data-location-coordinate-capture
                                                data-can-update-location-coordinate="@canUpdateLocationCoordinates.ToString().ToLowerInvariant()">
                                            <i class="fa-solid fa-location-crosshairs" aria-hidden="true"></i>
                                            <span>Lấy tọa độ điểm khách hàng</span>
                                        </button>
                                    </div>
                                </div>

                                <div class="yeu-cau-location-preview">
                                    <div class="yeu-cau-location-preview-card">
                                        <span class="yeu-cau-preview-label">Khách hàng</span>
                                        <strong data-preview-customer>@(selectedLocation?.TenKhachHangDisplay ?? "Chưa chọn")</strong>
                                    </div>

                                    <div class="yeu-cau-location-preview-card">
                                        <span class="yeu-cau-preview-label">Địa điểm</span>
                                        <strong data-preview-address>@(selectedLocation?.DiaChiDisplay ?? "Chưa chọn")</strong>
                                    </div>

                                    <div class="yeu-cau-location-preview-card">
                                        <span class="yeu-cau-preview-label">Người liên hệ</span>
                                        <strong data-preview-contact>@(string.IsNullOrWhiteSpace(selectedLocation?.NguoiLienHe) ? "Chưa có" : selectedLocation!.NguoiLienHe)</strong>
                                    </div>

                                    <div class="yeu-cau-location-preview-card">
                                        <span class="yeu-cau-preview-label">Số điện thoại</span>
                                        <strong data-preview-phone>
                                            @if (string.IsNullOrWhiteSpace(selectedLocation?.DienThoai))
                                            {
                                                @:Chưa có
                                            }
                                            else
                                            {
                                                <a href="tel:@phoneHref">@selectedLocation!.DienThoai</a>
                                            }
                                        </strong>
                                    </div>

                                    <div class="yeu-cau-location-preview-card">
                                        <span class="yeu-cau-preview-label">Tọa độ</span>
                                        <strong data-preview-coordinates>@(selectedLocation?.CoordinateDisplay ?? "Chưa có tọa độ")</strong>
                                    </div>
                                </div>

                                <input type="hidden" value="@selectedLongValue" data-preview-long />
                                <input type="hidden" value="@selectedLatValue" data-preview-lat />
                            </div>
                        </div>
                    </section>

                    <section class="yeu-cau-collapse-panel is-collapsed" data-collapse-root>
                        <button type="button"
                                class="yeu-cau-collapse-toggle"
                                data-collapse-toggle
                                aria-expanded="false">
                            <span class="yeu-cau-collapse-copy">
                                <strong>Thông tin yêu cầu</strong>
                                <small>Ngày yêu cầu, trạng thái và ghi chú xử lý.</small>
                            </span>
                            <i class="fa-solid fa-chevron-down" aria-hidden="true" data-collapse-icon></i>
                        </button>

                        <div class="yeu-cau-collapse-body" data-collapse-body hidden>
                            <div class="account-form-grid yeu-cau-request-info-grid">
                                <label class="login-field @(maYeuCauHasError ? "has-error" : "")">
                                    <span>Mã yêu cầu</span>
                                    <span class="login-input-shell">
                                        <i class="fa-solid fa-hashtag" aria-hidden="true"></i>
                                        <input asp-for="Form.MaYeuCau"
                                               value="@Model.MaYeuCauDisplay"
                                               readonly
                                               tabindex="-1"
                                               data-request-code-display />
                                        <button type="button"
                                                class="login-input-action"
                                                data-copy-to-clipboard
                                                data-copy-value="@Model.MaYeuCauDisplay"
                                                data-copy-title="Đã copy mã yêu cầu"
                                                data-copy-message="@Model.MaYeuCauDisplay"
                                                aria-label="Copy mã yêu cầu">
                                            <i class="fa-regular fa-copy" aria-hidden="true"></i>
                                        </button>
                                    </span>
                                    <span asp-validation-for="Form.MaYeuCau" class="login-field-error"></span>
                                </label>

                                <label class="login-field @(trangThaiHasError ? "has-error" : "")">
                                    <span>Trạng thái yêu cầu</span>
                                    <span class="login-input-shell select-shell">
                                        <i class="fa-solid fa-list-check" aria-hidden="true"></i>
                                        <select asp-for="Form.TrangThaiYeuCau">
                                            @foreach (var option in Model.StatusOptions)
                                            {
                                                <option value="@option.Value">@option.Label</option>
                                            }
                                        </select>
                                        <span class="select-indicator"><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></span>
                                    </span>
                                    <span asp-validation-for="Form.TrangThaiYeuCau" class="login-field-error"></span>
                                </label>

                                <label class="login-field">
                                    <span>Kiểm tra khoảng cách khi checkin</span>
                                    <span class="switch-field-shell">
                                        <i class="fa-solid fa-route switch-field-icon" aria-hidden="true"></i>
                                        <span class="status-switch">
                                            <span class="status-switch-labels">
                                                <span>Bật ràng buộc khoảng cách</span>
                                            </span>
                                            <input asp-for="Form.CheckinTheoKhoangCach"
                                                   class="status-switch-input"
                                                   type="checkbox"
                                                   checked="@(hasCheckinDistanceLimit && Model.Form.CheckinTheoKhoangCach ? "checked" : null)"
                                                   disabled="@(!hasCheckinDistanceLimit || !canToggleCheckinDistanceConstraint)" />
                                            <span class="status-switch-track" aria-hidden="true">
                                                <span class="status-switch-thumb"></span>
                                            </span>
                                        </span>
                                    </span>
                                    @if (!hasCheckinDistanceLimit)
                                    {
                                        <span class="login-field-error">Chưa có giá trị KM_limit nên không thể bật ràng buộc khoảng cách.</span>
                                    }
                                    else if (!canToggleCheckinDistanceConstraint)
                                    {
                                        <span class="login-field-error">Ban chua co quyen bat/tat rang buoc khoang cach.</span>
                                    }
                                </label>

                                <label class="login-field @(ngayYeuCauHasError ? "has-error" : "")">
                                    <span>Ngày yêu cầu</span>
                                    <span class="login-input-shell">
                                        <i class="fa-solid fa-calendar-day" aria-hidden="true"></i>
                                        <input asp-for="Form.NgayYeuCau" type="date" data-request-date-input />
                                    </span>
                                    <span asp-validation-for="Form.NgayYeuCau" class="login-field-error"></span>
                                </label>

                                <label class="login-field @(ngayThucHienHasError ? "has-error" : "")">
                                    <span>Ngày thực hiện</span>
                                    <span class="login-input-shell">
                                        <i class="fa-solid fa-calendar-check" aria-hidden="true"></i>
                                        <input asp-for="Form.NgayThucHien" type="date" min="@(Model.Form.NgayYeuCau?.ToString("yyyy-MM-dd"))" data-execution-date-input />
                                    </span>
                                    <span asp-validation-for="Form.NgayThucHien" class="login-field-error"></span>
                                </label>

                                <label class="login-field @(ngayHetHanHasError ? "has-error" : "")">
                                    <span>Ngày hết hạn</span>
                                    <span class="login-input-shell">
                                        <i class="fa-solid fa-calendar-xmark" aria-hidden="true"></i>
                                        <input asp-for="Form.NgayHetHan" type="date" />
                                    </span>
                                    <span asp-validation-for="Form.NgayHetHan" class="login-field-error"></span>
                                </label>

                                <label class="login-field @(ngayHoanThanhHasError ? "has-error" : "")">
                                    <span>Ngày hoàn thành</span>
                                    <span class="login-input-shell">
                                        <i class="fa-solid fa-calendar-check" aria-hidden="true"></i>
                                        <input asp-for="Form.NgayHoanThanh" type="date" />
                                    </span>
                                    <span asp-validation-for="Form.NgayHoanThanh" class="login-field-error"></span>
                                </label>

                                <label class="login-field @(ngayHenTiepTheoHasError ? "has-error" : "")">
                                    <span>Ngày hẹn tiếp theo</span>
                                    <span class="login-input-shell">
                                        <i class="fa-solid fa-calendar-plus" aria-hidden="true"></i>
                                        <input asp-for="Form.NgayHenTiepTheo" type="date" />
                                    </span>
                                    <span asp-validation-for="Form.NgayHenTiepTheo" class="login-field-error"></span>
                                </label>

                                <label class="login-field field-span-3 @(ghiChuHasError ? "has-error" : "")">
                                    <span>Ghi chú</span>
                                    <span class="login-textarea-shell">
                                        <i class="fa-regular fa-note-sticky" aria-hidden="true"></i>
                                        <textarea asp-for="Form.GhiChu" rows="3" placeholder="Nhập ghi chú ngắn cho yêu cầu..."></textarea>
                                    </span>
                                    <span asp-validation-for="Form.GhiChu" class="login-field-error"></span>
                                </label>
                            </div>
                        </div>
                    </section>

                </div>

                <div class="crud-tab-panel @(activeTab == "cong-viec" ? "is-active" : "")"
                     data-tab-panel
                     data-tab="cong-viec"
                     role="tabpanel"
                     @(activeTab == "cong-viec" ? null : "hidden")>
                    <section class="yeu-cau-service-template">
                        <label class="login-field" for="requestServiceCatalog">
                            <span>Danh mục dịch vụ</span>
                            <span class="login-input-shell select-shell">
                                <i class="fa-solid fa-layer-group" aria-hidden="true"></i>
                                <select asp-for="Form.IDDanhMucDichVu" id="requestServiceCatalog" data-service-template-select>
                                    <option value="">-- Chọn dịch vụ --</option>
                                    @foreach (var option in Model.ServiceOptions)
                                    {
                                        <option value="@option.Id" data-work-count="@option.SoCongViec">@option.TenDichVu</option>
                                    }
                                </select>
                                <span class="select-indicator"><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></span>
                            </span>
                        </label>
                        <div class="yeu-cau-service-template-status" data-service-template-status>
                            @if (Model.Form.IDDanhMucDichVu.HasValue && Model.Form.IDDanhMucDichVu.Value > 0)
                            {
                                <span>Dịch vụ đã chọn chỉ là nguồn tham chiếu. Công việc trong phiếu không tự đồng bộ lại.</span>
                            }
                            else
                            {
                                <span>Chọn dịch vụ để nạp nhanh nhóm công việc vào phiếu.</span>
                            }
                        </div>
                    </section>

                    <div class="panel-header">
                        <div>
                            <h3>Công việc</h3>
                        </div>


                        <div class="yeu-cau-work-progress" data-work-progress style="--progress:@workCompletionPercent">
                            <div class="yeu-cau-work-progress-ring" data-work-progress-ring>
                                <span data-work-progress-percent>@workCompletionPercent%</span>
                            </div>
                        </div>
                        <button type="button" class="secondary-button" asp-permission-action="insert" data-work-add>
                            <i class="fa-solid fa-plus" aria-hidden="true"></i>
                            <span>Thêm công việc</span>
                        </button>
                    </div>

                    <div class="yeu-cau-work-list" data-work-list>
                        @if (works.Count == 0)
                        {
                            <div class="yeu-cau-work-empty" data-work-empty>Chưa có công việc nào được liên kết với yêu cầu này.</div>
                        }
                        else
                        {
                            @for (var workIndex = 0; workIndex < works.Count; workIndex++)
                            {
                                var work = works[workIndex];
                                var isWorkCompleted = YeuCauCongViecTrangThaiCatalog.IsCompleted(work.TrangThaiCongViec);
                                var checkInImages = work.Images.Where(image => image.ImageType == YeuCauCongViecImageTypes.CheckIn).ToList();
                                var checkOutImages = work.Images.Where(image => image.ImageType == YeuCauCongViecImageTypes.CheckOut).ToList();

                                <section class="yeu-cau-work-card is-collapsed @work.TrangThaiCongViecCssClass @(isWorkCompleted ? "is-completed" : null)" data-work-item>
                                    <input type="hidden" name="Form.CongViecs[@workIndex].YeuCauCongViecId" value="@work.YeuCauCongViecId" data-work-id />
                                    <input type="hidden" name="Form.CongViecs[@workIndex].TenCongViec" value="@work.TenCongViec" data-work-name />
                                    <div class="yeu-cau-work-header">
                                        <button type="button"
                                                class="yeu-cau-work-toggle"
                                                data-work-toggle
                                                aria-expanded="false">
                                            <span class="yeu-cau-work-toggle-copy">
                                                <strong data-work-title>@work.TenCongViec</strong>
                                                <small data-work-status>@work.TrangThaiCongViecDisplay</small>
                                            </span>
                                            <i class="fa-solid fa-chevron-down" aria-hidden="true" data-work-toggle-icon></i>
                                        </button>

                                        <button type="button" class="table-action-button delete @(isWorkCompleted ? "is-hidden" : null)" asp-permission-action="delete" data-work-remove hidden="@isWorkCompleted">
                                            <i class="fa-solid fa-trash-can" aria-hidden="true"></i>
                                            <span>Xóa</span>
                                        </button>
                                    </div>

                                    <div class="yeu-cau-work-body" data-work-body hidden>
                                        <div class="account-form-grid yeu-cau-work-time-grid">
                                            <label class="login-field">
                                                <span>Công việc</span>
                                                <span class="login-input-shell select-shell">
                                                    <i class="fa-solid fa-briefcase" aria-hidden="true"></i>
                                                    <select name="Form.CongViecs[@workIndex].CongViecId" data-work-option-select>
                                                        <option value="">Chọn công việc</option>
                                                        @foreach (var option in Model.WorkOptions)
                                                        {
                                                            <option value="@option.Id" selected="@(work.CongViecId == option.Id ? "selected" : null)">@option.TenCongViec</option>
                                                        }
                                                    </select>
                                                    <span class="select-indicator"><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></span>
                                                </span>
                                            </label>

                                            <label class="login-field">
                                                <span>Trạng thái công việc</span>
                                                <span class="login-input-shell select-shell">
                                                    <i class="fa-solid fa-list-check" aria-hidden="true"></i>
                                                    <select name="Form.CongViecs[@workIndex].TrangThaiCongViec" data-work-status-select>
                                                        @foreach (var option in Model.WorkStatusOptions)
                                                        {
                                                            <option value="@option.Value" selected="@(work.TrangThaiCongViecDisplay == option.Value ? "selected" : null)">@option.Label</option>
                                                        }
                                                    </select>
                                                    <span class="select-indicator"><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></span>
                                                </span>
                                            </label>

                                            <label class="login-field">
                                                <span>Thời gian bắt đầu</span>
                                                <span class="login-input-shell">
                                                    <i class="fa-solid fa-play" aria-hidden="true"></i>
                                                   <input type="datetime-local"
                                                          name="Form.CongViecs[@workIndex].CheckInTime"
                                                          value="@(work.CheckInTime?.ToString("yyyy-MM-ddTHH:mm"))"
                                                          @(isWorkCompleted ? "readonly" : null) />
                                                </span>
                                            </label>

                                            <label class="login-field">
                                                <span>Thời gian kết thúc</span>
                                                <span class="login-input-shell">
                                                    <i class="fa-solid fa-flag-checkered" aria-hidden="true"></i>
                                                    <input type="datetime-local"
                                                           name="Form.CongViecs[@workIndex].CheckOutTime"
                                                           value="@(work.CheckOutTime?.ToString("yyyy-MM-ddTHH:mm"))" />
                                                </span>
                                            </label>
                                        </div>

                                        <label class="login-field yeu-cau-work-note-field">
                                            <span>Ghi chú công việc</span>
                                            <span class="login-textarea-shell">
                                                <i class="fa-solid fa-note-sticky" aria-hidden="true"></i>
                                                <textarea name="Form.CongViecs[@workIndex].GhiChu" rows="2" maxlength="500" placeholder="Nhập ghi chú cho công việc..." data-work-note>@work.GhiChu</textarea>
                                            </span>
                                        </label>

                                        <div class="yeu-cau-work-split">
                                            <section class="yeu-cau-work-assignees">
                                                <div class="yeu-cau-work-column-title">
                                                    <button type="button" class="secondary-button yeu-cau-work-employee-add @(isWorkCompleted ? "is-hidden" : null)" asp-permission-code="YeuCau_WorkEmployee_Insert" data-work-employee-add>
                                                        <i class="fa-solid fa-user-plus" aria-hidden="true"></i>
                                                        <span>Thêm nhân viên</span>
                                                    </button>
                                                </div>
                                                <div class="yeu-cau-work-employee-list" data-work-employee-list>
                                                    @if (work.NhanViens.Count == 0)
                                                    {
                                                        <div class="yeu-cau-work-checklist-empty">Chưa có nhân viên thực hiện nào trong công việc này.</div>
                                                    }
                                                    else
                                                    {
                                                        @for (var linkedIndex = 0; linkedIndex < work.NhanViens.Count; linkedIndex++)
                                                        {
                                                            var linked = work.NhanViens[linkedIndex];
                                                            var employeeAvatarUrl = string.IsNullOrWhiteSpace(linked.Avatar) ? "/images/default-avatar.svg" : linked.Avatar;

                                                            <div class="yeu-cau-work-employee-choice" data-work-employee-choice>
                                                                <input type="hidden"
                                                                       name="Form.CongViecs[@workIndex].NhanViens[@linkedIndex].NhanVienId"
                                                                       value="@linked.NhanVienId"
                                                                       data-work-employee-id />
                                                                <input type="checkbox"
                                                                       value="@linked.NhanVienId"
                                                                       data-work-employee-checkbox
                                                                       tabindex="-1"
                                                                       aria-hidden="true"
                                                                       checked />
                                                                <input type="hidden" name="Form.CongViecs[@workIndex].NhanViens[@linkedIndex].HoTen" value="@linked.HoTen" data-work-employee-name />
                                                                <input type="hidden" name="Form.CongViecs[@workIndex].NhanViens[@linkedIndex].ChucVu" value="@linked.ChucVu" data-work-employee-role />
                                                                <input type="hidden" name="Form.CongViecs[@workIndex].NhanViens[@linkedIndex].Avatar" value="@linked.Avatar" data-work-employee-avatar />
                                                                <span class="employee-avatar">
                                                                    <img src="@employeeAvatarUrl"
                                                                         alt="Avatar @linked.HoTen"
                                                                         onerror="this.onerror=null;this.src='/images/default-avatar.svg';" />
                                                                </span>
                                                                <span class="yeu-cau-linked-employee-copy">
                                                                    <strong>@linked.HoTen</strong>
                                                                    <span>@(string.IsNullOrWhiteSpace(linked.ChucVu) ? "Chưa có vị trí công việc" : linked.ChucVu)</span>
                                                                </span>
                                                                <button type="button" class="table-action-button delete yeu-cau-work-employee-remove @(isWorkCompleted ? "is-hidden" : null)" asp-permission-code="YeuCau_WorkEmployee_Delete" data-work-employee-remove aria-label="Xóa nhân viên @linked.HoTen">
                                                                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                                                                    <span>Xóa</span>
                                                                </button>
                                                            </div>
                                                        }
                                                    }
                                                </div>
                                            </section>

                                            <div class="yeu-cau-work-checklist">
                                                <div class="yeu-cau-work-column-title">Checklist công việc</div>
                                                <div class="yeu-cau-work-checklist-add" data-work-checklist-add-shell>
                                                    <input type="text" class="login-input" placeholder="Them checklist..." maxlength="250" data-work-checklist-add-input />
                                                    <button type="button" class="secondary-button" data-work-checklist-add>
                                                        <i class="fa-solid fa-plus" aria-hidden="true"></i>
                                                        <span>Them</span>
                                                    </button>
                                                </div>
                                                <div class="yeu-cau-work-checklist-empty @(work.Checklists.Count > 0 ? "is-hidden" : null)" data-work-checklist-empty>Công việc này chưa có checklist.</div>

                                                <div class="yeu-cau-work-checklist-list" data-work-checklist-list>
                                            @for (var checklistIndex = 0; checklistIndex < work.Checklists.Count; checklistIndex++)
                                            {
                                                var checklist = work.Checklists[checklistIndex];

                                                <label class="yeu-cau-work-checklist-item @(checklist.IsCompleted ? "is-completed" : null)" data-work-checklist-item>
                                                    <input type="hidden" name="Form.CongViecs[@workIndex].Checklists[@checklistIndex].ChecklistId" value="@checklist.ChecklistId" data-work-checklist-id />
                                                    <input type="hidden" name="Form.CongViecs[@workIndex].Checklists[@checklistIndex].TenChecklist" value="@checklist.TenChecklist" data-work-checklist-name />
                                                    <input type="hidden" name="Form.CongViecs[@workIndex].Checklists[@checklistIndex].ViTri" value="@checklist.ViTri" data-work-checklist-order />
                                                    <input type="hidden" name="Form.CongViecs[@workIndex].Checklists[@checklistIndex].CreatedDate" value="@(checklist.CreatedDate?.ToString("yyyy-MM-ddTHH:mm:ss"))" data-work-checklist-created-date />
                                                    <input type="hidden" name="Form.CongViecs[@workIndex].Checklists[@checklistIndex].CreatedBy" value="@checklist.CreatedBy" data-work-checklist-created-by />
                                                    <input type="hidden" name="Form.CongViecs[@workIndex].Checklists[@checklistIndex].FinishDate" value="@(checklist.FinishDate?.ToString("yyyy-MM-ddTHH:mm:ss"))" data-work-checklist-finish-date />
                                                    <input type="hidden" name="Form.CongViecs[@workIndex].Checklists[@checklistIndex].FinishBy" value="@checklist.FinishBy" data-work-checklist-finish-by />
                                                    <input type="checkbox"
                                                           name="Form.CongViecs[@workIndex].Checklists[@checklistIndex].IsCompleted"
                                                           value="true"
                                                           data-work-checklist-completed
                                                           @(checklist.IsCompleted ? "checked" : null) />
                                                    <span class="yeu-cau-work-checklist-copy">
                                                        <strong data-work-checklist-title>@checklist.TenChecklist</strong>
                                                        <small data-work-checklist-subtext @(checklist.IsCompleted && checklist.FinishDate.HasValue ? null : "hidden")>
                                                            @if (checklist.IsCompleted && checklist.FinishDate.HasValue)
                                                            {
                                                                @($"{checklist.FinishDate.Value:dd/MM/yyyy HH:mm} - {(string.IsNullOrWhiteSpace(checklist.FinishBy) ? "system" : checklist.FinishBy)}")
                                                            }
                                                        </small>
                                                    </span>
                                                </label>
                                            }
                                                </div>
                                            </div>
                                        </div>

                                        <div class="yeu-cau-work-images" data-work-images>
                                            <section class="yeu-cau-work-image-group @(work.SoLuongAnhCheckIn > 0 && checkInImages.Count < work.SoLuongAnhCheckIn ? "is-missing" : null)" data-work-image-group data-image-type="CheckIn" data-required-count="@work.SoLuongAnhCheckIn">
                                                <div class="yeu-cau-work-image-header">
                                                    <strong>Ảnh trước thực hiện</strong>
                                                    @if (work.SoLuongAnhCheckIn > 0)
                                                    {
                                                        <span class="yeu-cau-work-image-count @(checkInImages.Count >= work.SoLuongAnhCheckIn ? "is-complete" : "is-missing")" data-work-image-count>@checkInImages.Count / @work.SoLuongAnhCheckIn</span>
                                                    }
                                                </div>
                                                <div class="yeu-cau-work-image-actions @(isWorkCompleted ? "is-hidden" : null)">
                                                    <button type="button" class="secondary-button" data-work-image-upload>
                                                        <i class="fa-solid fa-upload" aria-hidden="true"></i>
                                                        <span>Upload ảnh</span>
                                                    </button>
                                                    <button type="button" class="secondary-button" data-work-image-camera>
                                                        <i class="fa-solid fa-camera" aria-hidden="true"></i>
                                                        <span>Chụp ảnh</span>
                                                    </button>
                                                </div>
                                                <input type="file" accept="image/*" data-work-image-file hidden />
                                                <input type="file" accept="image/*" capture="environment" data-work-image-camera-file hidden />
                                                <div class="yeu-cau-work-image-list" data-work-image-list>
                                                    @foreach (var image in checkInImages)
                                                    {
                                                        <span class="yeu-cau-work-image-item" data-work-image-item data-work-image-id="@image.Id">
                                                            <button type="button" class="yeu-cau-work-image-thumb" data-checkin-image-open data-checkin-image="@image.ImagePath" data-checkin-employee="@work.TenCongViec" data-checkin-address="Ảnh trước thực hiện">
                                                                <img src="@image.ImagePath" alt="Ảnh trước thực hiện @work.TenCongViec" />
                                                            </button>
                                                            @if (image.CanDelete)
                                                            {
                                                                <button type="button" class="table-action-button delete yeu-cau-work-image-delete" data-work-image-delete aria-label="Xóa ảnh">
                                                                    <i class="fa-solid fa-trash" aria-hidden="true"></i>
                                                                    <span>Xóa</span>
                                                                </button>
                                                            }
                                                        </span>
                                                    }
                                                </div>
                                            </section>

                                            <section class="yeu-cau-work-image-group @(work.SoLuongAnhCheckOut > 0 && checkOutImages.Count < work.SoLuongAnhCheckOut ? "is-missing" : null)" data-work-image-group data-image-type="CheckOut" data-required-count="@work.SoLuongAnhCheckOut">
                                                <div class="yeu-cau-work-image-header">
                                                    <strong>Ảnh sau thực hiện</strong>
                                                    @if (work.SoLuongAnhCheckOut > 0)
                                                    {
                                                        <span class="yeu-cau-work-image-count @(checkOutImages.Count >= work.SoLuongAnhCheckOut ? "is-complete" : "is-missing")" data-work-image-count>@checkOutImages.Count / @work.SoLuongAnhCheckOut</span>
                                                    }
                                                </div>
                                                <div class="yeu-cau-work-image-actions @(isWorkCompleted ? "is-hidden" : null)">
                                                    <button type="button" class="secondary-button" data-work-image-upload>
                                                        <i class="fa-solid fa-upload" aria-hidden="true"></i>
                                                        <span>Upload ảnh</span>
                                                    </button>
                                                    <button type="button" class="secondary-button" data-work-image-camera>
                                                        <i class="fa-solid fa-camera" aria-hidden="true"></i>
                                                        <span>Chụp ảnh</span>
                                                    </button>
                                                </div>
                                                <input type="file" accept="image/*" data-work-image-file hidden />
                                                <input type="file" accept="image/*" capture="environment" data-work-image-camera-file hidden />
                                                <div class="yeu-cau-work-image-list" data-work-image-list>
                                                    @foreach (var image in checkOutImages)
                                                    {
                                                        <span class="yeu-cau-work-image-item" data-work-image-item data-work-image-id="@image.Id">
                                                            <button type="button" class="yeu-cau-work-image-thumb" data-checkin-image-open data-checkin-image="@image.ImagePath" data-checkin-employee="@work.TenCongViec" data-checkin-address="Ảnh sau thực hiện">
                                                                <img src="@image.ImagePath" alt="Ảnh sau thực hiện @work.TenCongViec" />
                                                            </button>
                                                            @if (image.CanDelete)
                                                            {
