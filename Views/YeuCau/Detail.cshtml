            const zaloQrMessage = zaloQrShell?.querySelector("[data-zalo-qr-message]");
            let zaloQrPollTimer = 0;
            let zaloQrToken = "";

            const setZaloQrMessage = (message, isError = false) => {
                if (!(zaloQrMessage instanceof HTMLElement)) {
                    return;
                }

                zaloQrMessage.textContent = message;
                zaloQrMessage.classList.toggle("error", isError);
            };

            const zaloStatusLabels = {
                Created: "Chưa quét",
                Opened: "Đã quét",
                ZaloConnected: "Đã kết nối Zalo",
                Rated: "Đã đánh giá",
                Expired: "Đã hết hạn"
            };

            const updateZaloQrStatus = (status) => {
                if (zaloQrStatus instanceof HTMLElement) {
                    zaloQrStatus.textContent = zaloStatusLabels[status] || status || "Chưa quét";
                }
            };

            const stopZaloQrPolling = () => {
                if (zaloQrPollTimer) {
                    window.clearInterval(zaloQrPollTimer);
                    zaloQrPollTimer = 0;
                }
            };

            const pollZaloQrStatus = async () => {
                if (!zaloQrToken) {
                    return;
                }

                try {
                    const response = await fetch(`${root.dataset.zaloRequestStatusBase}/${encodeURIComponent(zaloQrToken)}/status`, {
                        headers: { "Accept": "application/json" }
                    });
                    if (!response.ok) {
                        return;
                    }

                    const data = await response.json();
                    updateZaloQrStatus(data.status);
                    if (data.rated || data.status === "Expired") {
                        stopZaloQrPolling();
                    }
                } catch {
                    // Polling will retry automatically.
                }
            };

            const closeZaloQr = () => {
                stopZaloQrPolling();
                if (zaloQrShell instanceof HTMLElement) {
                    zaloQrShell.hidden = true;
                }
            };

            const openZaloQr = async () => {
                if (!(zaloQrShell instanceof HTMLElement)) {
                    return;
                }

                zaloQrShell.hidden = false;
                zaloQrToken = "";
                updateZaloQrStatus("Created");
                setZaloQrMessage("");
                if (zaloQrLoading instanceof HTMLElement) {
                    zaloQrLoading.hidden = false;
                }
                if (zaloQrImage instanceof HTMLImageElement) {
                    zaloQrImage.hidden = true;
                    zaloQrImage.removeAttribute("src");
                }

                try {
                    const requestId = Number(root.dataset.zaloRequestId || 0);
                    const response = await fetch(root.dataset.zaloRequestLinkUrl, {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                            "Accept": "application/json"
                        },
                        body: JSON.stringify({ requestId })
                    });
                    const data = await response.json();
                    if (!response.ok || !data.success) {
                        throw new Error(data.message || "Không thể tạo mã QR.");
                    }

                    zaloQrToken = data.token;
                    if (zaloQrImage instanceof HTMLImageElement) {
                        zaloQrImage.src = data.qrImageBase64;
                        zaloQrImage.hidden = false;
                    }
                    if (zaloQrLoading instanceof HTMLElement) {
                        zaloQrLoading.hidden = true;
                    }
                    if (zaloQrUrl instanceof HTMLInputElement) {
                        zaloQrUrl.value = data.qrUrl;
                    }
                    if (zaloQrOpenLink instanceof HTMLAnchorElement) {
                        zaloQrOpenLink.href = data.qrUrl;
                    }
                    updateZaloQrStatus(data.status);
                    if (data.zaloConnected) {
                        setZaloQrMessage("Khach hang da ket noi Zalo OA. Khi quet QR se vao thang trang danh gia.");
                    } else {
                        setZaloQrMessage("Khach hang chua ket noi Zalo OA. QR se hien buoc huong dan ket noi truoc khi danh gia.");
                    }
                    zaloQrPollTimer = window.setInterval(pollZaloQrStatus, 4000);
