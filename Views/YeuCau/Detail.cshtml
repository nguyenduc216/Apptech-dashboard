                <div class="crud-tab-panel @(activeTab == "checkin" ? "is-active" : "")"
                     data-tab-panel
                     data-tab="checkin"
                     role="tabpanel"
                     @(activeTab == "checkin" ? null : "hidden")>
                    <div class="panel-header">
                        <div>
                            <h3>Checkin</h3>
                        </div>

                        @if (Model.IsEditMode && hasIncompleteWork)
                        {
                            <button type="button"
                                    class="secondary-button"
                                    data-checkin-open
                                    data-checkin-mode="@(pendingCheckout is null ? "checkin" : "checkout")"
                                    data-checkin-id="@(pendingCheckout?.Id.ToString(invariantCulture) ?? "")"
                                    data-checkin-employee-id="@(pendingCheckout?.IDNhanVien?.ToString(invariantCulture) ?? "")">
                                <i class="fa-solid @(pendingCheckout is null ? "fa-camera" : "fa-right-from-bracket")" aria-hidden="true"></i>
                                <span>@(pendingCheckout is null ? "Chụp ảnh checkin" : "Chụp ảnh checkout")</span>
                            </button>
                        }
                    </div>

                    @if (!Model.IsEditMode)
                    {
                        <div class="yeu-cau-work-empty">L&#432;u y&#234;u c&#7847;u tr&#432;&#7899;c khi t&#7841;o checkin.</div>
                    }
                    else if (Model.Checkins.Count == 0)
                    {
                        <div class="yeu-cau-work-empty">Ch&#432;a c&#243; l&#7847;n checkin n&#224;o cho y&#234;u c&#7847;u n&#224;y.</div>
                    }
                    else
                    {
                        <div class="yeu-cau-checkin-groups">
                            @foreach (var group in checkinGroups)
                            {
                                var groupId = $"checkin-group-{group.Key:yyyyMMdd}";
                                <section class="yeu-cau-checkin-group">
                                    <button type="button"
                                            class="yeu-cau-checkin-group-toggle"
                                            aria-expanded="true"
                                            aria-controls="@groupId"
                                            data-checkin-group-toggle>
                                        <span>@group.Key.ToString("dd/MM/yyyy")</span>
                                        <small>@group.Count() l&#432;&#7907;t</small>
                                        <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
                                    </button>
                                    <div class="yeu-cau-checkin-list" id="@groupId" data-checkin-group-content>
                                        @foreach (var checkin in group)
                                        {
                                            var checkoutCoordinate = checkin.LatAddressCheckOut.HasValue && checkin.LongAddressCheckOut.HasValue
                                                ? $"{checkin.LatAddressCheckOut.Value:0.00000}, {checkin.LongAddressCheckOut.Value:0.00000}"
                                                : "Chua co toa do checkout";
                                            <article class="yeu-cau-checkin-card @(checkin.IsOpen ? "is-pending" : "is-complete")">
                                                <span class="yeu-cau-checkin-dot" aria-hidden="true"></span>
                                                <div class="yeu-cau-checkin-copy">
                                                    <div class="yeu-cau-checkin-title">
                                                        <strong>@checkin.EmployeeDisplay</strong>
                                                        <span>@(checkin.ThoiDiem?.ToString("HH:mm") ?? "--:--")</span>
                                                    </div>
                                                    <section class="yeu-cau-checkin-line is-checkin">
                                                        <button type="button"
                                                                class="yeu-cau-checkin-photo"
                                                                data-checkin-image-open
                                                                data-checkin-image="@checkin.ImgPath"
                                                                data-checkin-time="@(checkin.ThoiDiem?.ToString("dd/MM/yyyy HH:mm") ?? "")"
                                                                data-checkin-address="@checkin.CoordinateDisplay"
                                                                data-checkin-lat="@(checkin.LatAddress?.ToString(invariantCulture) ?? "")"
                                                                data-checkin-long="@(checkin.LongAddress?.ToString(invariantCulture) ?? "")"
                                                                data-checkin-employee="@checkin.EmployeeDisplay"
                                                                @(string.IsNullOrWhiteSpace(checkin.ImgPath) ? "disabled" : null)>
                                                            @if (!string.IsNullOrWhiteSpace(checkin.ImgPath))
                                                            {
                                                                <img src="@checkin.ImgPath" alt="&#7842;nh checkin @checkin.EmployeeDisplay" />
                                                            }
                                                            else
                                                            {
                                                                <i class="fa-regular fa-image" aria-hidden="true"></i>
                                                            }
                                                        </button>
                                                        <div class="yeu-cau-checkin-line-copy">
                                                            <strong><i class="fa-solid fa-right-to-bracket" aria-hidden="true"></i>@(checkin.ThoiDiem?.ToString("dd/MM/yyyy HH:mm") ?? "--:--")</strong>
                                                            <span><i class="fa-solid fa-user" aria-hidden="true"></i>@checkin.CustomerDisplay</span>
                                                            <span><i class="fa-solid fa-location-crosshairs" aria-hidden="true"></i>@checkin.CoordinateDisplay</span>
                                                            @if (!string.IsNullOrWhiteSpace(checkin.GhiChuNhanVien))
                                                            {
                                                                <p>@checkin.GhiChuNhanVien</p>
                                                            }
                                                            @if (!string.IsNullOrWhiteSpace(checkin.ProxyCheckInBy))
                                                            {
                                                                <span class="yeu-cau-checkin-proxy"><i class="fa-solid fa-user-shield" aria-hidden="true"></i>Lam ho boi @checkin.ProxyCheckInBy luc @(checkin.ProxyCheckInAt?.ToString("dd/MM/yyyy HH:mm") ?? "--:--")</span>
                                                            }
                                                        </div>
                                                    </section>
                                                    <section class="yeu-cau-checkin-line @(checkin.ThoiDiemCheckOut.HasValue ? "is-checkout-complete" : "is-checkout-pending")">
                                                        @if (!string.IsNullOrWhiteSpace(checkin.ImgPathCheckOut))
                                                        {
                                                            <button type="button"
                                                                    class="yeu-cau-checkin-photo"
                                                                    data-checkin-image-open
                                                                    data-checkin-image="@checkin.ImgPathCheckOut"
                                                                    data-checkin-time="@(checkin.ThoiDiemCheckOut?.ToString("dd/MM/yyyy HH:mm") ?? "")"
                                                                    data-checkin-address="@checkoutCoordinate"
                                                                    data-checkin-lat="@(checkin.LatAddressCheckOut?.ToString(invariantCulture) ?? "")"
                                                                    data-checkin-long="@(checkin.LongAddressCheckOut?.ToString(invariantCulture) ?? "")"
                                                                    data-checkin-employee="@checkin.EmployeeDisplay">
                                                                <img src="@checkin.ImgPathCheckOut" alt="&#7842;nh checkout @checkin.EmployeeDisplay" />
                                                            </button>
                                                        }
                                                        else
                                                        {
                                                            <div class="yeu-cau-checkin-photo is-empty">
                                                                <i class="fa-regular fa-image" aria-hidden="true"></i>
                                                            </div>
                                                        }
                                                        <div class="yeu-cau-checkin-line-copy">
                                                            @if (checkin.ThoiDiemCheckOut.HasValue)
                                                            {
                                                                <strong><i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i>@(checkin.ThoiDiemCheckOut?.ToString("dd/MM/yyyy HH:mm") ?? "--:--")</strong>
                                                                <span><i class="fa-solid fa-location-dot" aria-hidden="true"></i>@checkoutCoordinate</span>
                                                            }
                                                            else
                                                            {
                                                                <strong><i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i>Ch&#432;a checkout</strong>
                                                                @if (canManageCheckinProxy)
                                                                {
                                                                    <button type="button"
                                                                            class="secondary-button"
                                                                            data-checkout-open
                                                                            data-checkin-id="@checkin.Id"
                                                                            data-checkin-employee-id="@(checkin.IDNhanVien?.ToString(invariantCulture) ?? "")">
                                                                        <i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i>
                                                                        <span>Checkout lam ho</span>
                                                                    </button>
                                                                }
                                                            }
                                                            @if (!string.IsNullOrWhiteSpace(checkin.GhiChuCheckOut))
                                                            {
                                                                <p>@checkin.GhiChuCheckOut</p>
                                                            }
                                                            @if (!string.IsNullOrWhiteSpace(checkin.ProxyCheckOutBy))
                                                            {
                                                                <span class="yeu-cau-checkin-proxy"><i class="fa-solid fa-user-shield" aria-hidden="true"></i>Checkout lam ho boi @checkin.ProxyCheckOutBy luc @(checkin.ProxyCheckOutAt?.ToString("dd/MM/yyyy HH:mm") ?? "--:--")</span>
                                                            }
                                                        </div>
                                                    </section>
                                                    @if (Model.CurrentUserIsAdmin)
                                                    {
                                                        <button type="button"
                                                                class="table-action-button delete yeu-cau-checkin-delete" asp-permission-action="delete"
                                                                data-checkin-delete
                                                                data-checkin-id="@checkin.Id"
                                                                data-checkin-request-id="@Model.Form.Id">
                                                            <i class="fa-solid fa-trash-can" aria-hidden="true"></i>
                                                            <span>X&#243;a checkin</span>
                                                        </button>
                                                    }
                                                </div>
                                            </article>
                                        }
                                    </div>
                                </section>
                            }
                        </div>
                    }
                </div>
            </div>
        </article>

        <div class="crud-modal-shell" data-work-picker-shell hidden>
