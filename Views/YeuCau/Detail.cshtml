                    checkinDistancePanel.dataset.state = type;
                }
            };

            const setCheckinDistanceTitle = (message, type = "info") => {
                if (checkinDistanceTitle instanceof HTMLElement) {
                    checkinDistanceTitle.textContent = message;
                }

                if (checkinDistancePanel instanceof HTMLElement) {
                    checkinDistancePanel.dataset.state = type;
                }
            };

            const getCheckinDistanceLimitText = () => Number.isFinite(checkinDistanceLimitMeters) && checkinDistanceLimitMeters > 0
                ? `${checkinDistanceLimitMeters.toLocaleString("vi-VN", { maximumFractionDigits: 2 })} mét`
                : "";

            const getCheckinDistanceLimitMessage = () => `Khoảng cách checkin không được quá ${getCheckinDistanceLimitText()}`;

            const syncCheckinSaveAvailability = () => {
                return;
            };

            const updateCheckinGpsDebug = async (stage, detail = {}) => {
                if (!(checkinGpsDebug instanceof HTMLElement)) {
                    return;
                }

                let permissionState = "unsupported";
                try {
                    if (navigator.permissions?.query) {
                        const permission = await navigator.permissions.query({ name: "geolocation" });
                        permissionState = permission.state;
                    }
                } catch (error) {
                    permissionState = `query-error: ${error instanceof Error ? error.message : error}`;
                }

                const debugPayload = {
                    stage,
                    time: new Date().toLocaleString("vi-VN"),
                    href: window.location.href,
                    protocol: window.location.protocol,
                    host: window.location.host,
                    isSecureContext: window.isSecureContext,
                    hasGeolocation: !!navigator.geolocation,
                    permissionState,
                    lat: checkinLatInput instanceof HTMLInputElement ? checkinLatInput.value : "",
                    lng: checkinLongInput instanceof HTMLInputElement ? checkinLongInput.value : "",
                    detail
                };

                checkinGpsDebug.hidden = false;
                checkinGpsDebug.textContent = JSON.stringify(debugPayload, null, 2);
            };

            const getCheckinCustomerPoint = () => {
                const lat = readCoordinate(previewLatInput);
                const lng = readCoordinate(previewLongInput);
                return Number.isFinite(lat) && Number.isFinite(lng) ? { lat, lng } : null;
            };

            const calculateStraightDistanceMeters = (start, end) => {
                const earthRadiusMeters = 6371000;
                const toRadians = (value) => value * Math.PI / 180;
                const deltaLat = toRadians(end.lat - start.lat);
                const deltaLng = toRadians(end.lng - start.lng);
                const startLat = toRadians(start.lat);
                const endLat = toRadians(end.lat);
                const haversine =
                    Math.sin(deltaLat / 2) ** 2 +
                    Math.cos(startLat) * Math.cos(endLat) * Math.sin(deltaLng / 2) ** 2;
                return 2 * earthRadiusMeters * Math.atan2(Math.sqrt(haversine), Math.sqrt(1 - haversine));
            };

            const formatStraightDistance = (meters) => {
                if (!Number.isFinite(meters)) {
                    return "-";
                }

                return meters >= 1000
                    ? `${(meters / 1000).toFixed(2)} km`
                    : `${Math.round(meters)} m`;
            };

            const ensureCheckinDistanceMap = () => {
                if (!(checkinDistanceMapElement instanceof HTMLElement)) {
                    return false;
                }

                if (!(window.L && typeof window.L.map === "function")) {
                    setCheckinDistanceStatus("Không tải được thư viện bản đồ để hiển thị khoảng cách.", "error");
                    return false;
                }

                if (checkinDistanceMap) {
                    window.setTimeout(() => checkinDistanceMap.invalidateSize(), 120);
                    return true;
                }

                checkinDistanceMap = window.L.map(checkinDistanceMapElement, {
                    zoomControl: false,
                    attributionControl: false,
                    dragging: false,
                    scrollWheelZoom: false,
                    doubleClickZoom: false,
                    boxZoom: false,
                    keyboard: false,
                    tap: false,
                    touchZoom: false
                });

                window.L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
                    maxZoom: 19
                }).addTo(checkinDistanceMap);

                checkinDistanceMap.setView(defaultCenter, defaultZoom);
                window.setTimeout(() => checkinDistanceMap.invalidateSize(), 120);
                return true;
            };

            const syncCheckinDistanceMap = () => {
                if (!ensureCheckinDistanceMap()) {
                    return;
                }

                const customerPoint = getCheckinCustomerPoint();
                const currentLat = checkinLatInput instanceof HTMLInputElement ? Number.parseFloat(checkinLatInput.value) : Number.NaN;
                const currentLng = checkinLongInput instanceof HTMLInputElement ? Number.parseFloat(checkinLongInput.value) : Number.NaN;
                const currentPoint = Number.isFinite(currentLat) && Number.isFinite(currentLng)
                    ? { lat: currentLat, lng: currentLng }
                    : null;
                checkinDistanceMeters = Number.NaN;
                checkinDistanceExceeded = false;

                if (customerPoint) {
                    if (!checkinCustomerMarker) {
                        checkinCustomerMarker = window.L.circleMarker([customerPoint.lat, customerPoint.lng], {
                            radius: 7,
                            color: "#0b4f9c",
                            weight: 2,
                            fillColor: "#3b82f6",
                            fillOpacity: 0.95
                        }).addTo(checkinDistanceMap);
                        checkinCustomerMarker.bindTooltip("Địa điểm khách hàng");
                    } else {
                        checkinCustomerMarker.setLatLng([customerPoint.lat, customerPoint.lng]);
                    }
                } else if (checkinCustomerMarker) {
                    checkinDistanceMap.removeLayer(checkinCustomerMarker);
                    checkinCustomerMarker = null;
                }

                if (currentPoint) {
                    if (!checkinCurrentMarker) {
                        checkinCurrentMarker = window.L.circleMarker([currentPoint.lat, currentPoint.lng], {
                            radius: 7,
                            color: "#0a7b5f",
                            weight: 2,
                            fillColor: "#20c997",
                            fillOpacity: 0.95
                        }).addTo(checkinDistanceMap);
                        checkinCurrentMarker.bindTooltip("Vị trí hiện tại");
                    } else {
                        checkinCurrentMarker.setLatLng([currentPoint.lat, currentPoint.lng]);
                    }
                } else if (checkinCurrentMarker) {
                    checkinDistanceMap.removeLayer(checkinCurrentMarker);
                    checkinCurrentMarker = null;
                }

                if (customerPoint && currentPoint) {
                    const points = [
                        [customerPoint.lat, customerPoint.lng],
                        [currentPoint.lat, currentPoint.lng]
                    ];

                    if (!checkinDistanceLine) {
                        checkinDistanceLine = window.L.polyline(points, {
                            color: "#0aa17d",
                            weight: 3,
                            opacity: 0.88,
                            dashArray: "8 8"
                        }).addTo(checkinDistanceMap);
                    } else {
                        checkinDistanceLine.setLatLngs(points);
                    }

                    const bounds = window.L.latLngBounds(points);
                    checkinDistanceMap.fitBounds(bounds.pad(0.35), { maxZoom: 16 });
                    const distance = calculateStraightDistanceMeters(customerPoint, currentPoint);
                    checkinDistanceMeters = distance;
                    checkinDistanceExceeded = checkinByDistance &&
                        Number.isFinite(checkinDistanceLimitMeters) &&
                        checkinDistanceLimitMeters > 0 &&
                        distance > checkinDistanceLimitMeters;
                    const state = checkinDistanceExceeded ? "error" : "success";
                    setCheckinDistanceTitle(`Khoảng cách từ điểm hiện tại tới địa điểm khách hàng: ${formatStraightDistance(distance)}`, state);
                    setCheckinDistanceStatus(
                        checkinDistanceExceeded
                            ? `${getCheckinDistanceLimitMessage()}. Khoảng cách hiện tại: ${formatStraightDistance(distance)}.`
                            : `Khoảng cách đường chim bay: ${formatStraightDistance(distance)}.`,
                        state);
                } else {
                    if (checkinDistanceLine) {
                        checkinDistanceMap.removeLayer(checkinDistanceLine);
                        checkinDistanceLine = null;
                    }

                    if (customerPoint) {
                        checkinDistanceMap.setView([customerPoint.lat, customerPoint.lng], focusZoom);
                        setCheckinDistanceTitle("Khoảng cách: đang chờ GPS hiện tại", "warning");
                        setCheckinDistanceStatus("Đã có địa điểm khách hàng. Đang chờ GPS hiện tại để tính khoảng cách.", "warning");
                    } else if (currentPoint) {
                        checkinDistanceMap.setView([currentPoint.lat, currentPoint.lng], focusZoom);
                        setCheckinDistanceTitle("Khoảng cách: phiếu chưa có tọa độ khách hàng", "warning");
                        setCheckinDistanceStatus("Phiếu chưa có tọa độ địa điểm khách hàng để tính khoảng cách.", "warning");
                    } else {
                        checkinDistanceMap.setView(defaultCenter, defaultZoom);
                        setCheckinDistanceTitle("Khoảng cách: đang chờ GPS", "info");
                        setCheckinDistanceStatus("Đang chờ vị trí GPS để tính khoảng cách.", "info");
                    }
                }

                syncCheckinSaveAvailability();
                window.setTimeout(() => {
                    if (checkinDistanceContent instanceof HTMLElement && !checkinDistanceContent.hidden) {
                        fitCheckinDistanceMap();
                    } else {
                        checkinDistanceMap.invalidateSize();
                    }
                }, 120);
            };

            const fitCheckinDistanceMap = () => {
                if (!checkinDistanceMap) {
                    return;
                }

                const customerPoint = getCheckinCustomerPoint();
                const currentLat = checkinLatInput instanceof HTMLInputElement ? Number.parseFloat(checkinLatInput.value) : Number.NaN;
                const currentLng = checkinLongInput instanceof HTMLInputElement ? Number.parseFloat(checkinLongInput.value) : Number.NaN;
                const currentPoint = Number.isFinite(currentLat) && Number.isFinite(currentLng)
                    ? { lat: currentLat, lng: currentLng }
                    : null;

                checkinDistanceMap.invalidateSize();
                if (customerPoint && currentPoint) {
                    checkinDistanceMap.fitBounds(
                        window.L.latLngBounds([
                            [customerPoint.lat, customerPoint.lng],
                            [currentPoint.lat, currentPoint.lng]
                        ]).pad(0.35),
                        { maxZoom: 16 }
                    );
                } else if (customerPoint) {
                    checkinDistanceMap.setView([customerPoint.lat, customerPoint.lng], focusZoom);
                } else if (currentPoint) {
                    checkinDistanceMap.setView([currentPoint.lat, currentPoint.lng], focusZoom);
                } else {
                    checkinDistanceMap.setView(defaultCenter, defaultZoom);
                }
            };

            const setCheckinDistanceExpanded = (expanded) => {
                if (!(checkinDistanceToggle instanceof HTMLButtonElement) ||
                    !(checkinDistanceContent instanceof HTMLElement)) {
                    return;
                }

                checkinDistanceToggle.setAttribute("aria-expanded", expanded ? "true" : "false");
                checkinDistanceContent.hidden = !expanded;
                if (expanded && checkinDistanceMap) {
                    window.setTimeout(fitCheckinDistanceMap, 120);
                }
            };

            const stopCheckinCamera = () => {
                if (checkinStream) {
                    checkinStream.getTracks().forEach((track) => track.stop());
                    checkinStream = null;
                }
            };

            const waitForCheckinVideoFrame = async () => {
                if (!(checkinVideo instanceof HTMLVideoElement)) {
                    return false;
                }

                if (checkinVideo.readyState < HTMLMediaElement.HAVE_CURRENT_DATA ||
                    checkinVideo.videoWidth <= 0 ||
                    checkinVideo.videoHeight <= 0) {
                    await new Promise((resolve, reject) => {
                        const timeout = window.setTimeout(() => {
                            cleanup();
                            reject(new Error("Camera frame timeout."));
                        }, 5000);
                        const cleanup = () => {
                            window.clearTimeout(timeout);
                            checkinVideo.removeEventListener("loadedmetadata", handleReady);
                            checkinVideo.removeEventListener("canplay", handleReady);
                        };
                        const handleReady = () => {
                            if (checkinVideo.videoWidth > 0 && checkinVideo.videoHeight > 0) {
                                cleanup();
                                resolve();
                            }
                        };

                        checkinVideo.addEventListener("loadedmetadata", handleReady);
                        checkinVideo.addEventListener("canplay", handleReady);
                        handleReady();
                    });
                }

                await new Promise((resolve) => {
                    if (typeof checkinVideo.requestVideoFrameCallback === "function") {
                        checkinVideo.requestVideoFrameCallback(() => resolve());
                    } else {
                        window.requestAnimationFrame(() => window.requestAnimationFrame(resolve));
                    }
                });

                return checkinVideo.videoWidth > 0 && checkinVideo.videoHeight > 0;
            };

            const isCanvasFrameTooDark = (context, width, height) => {
                const sampleWidth = Math.min(80, width);
                const sampleHeight = Math.min(60, height);
                const startX = Math.max(0, Math.floor((width - sampleWidth) / 2));
                const startY = Math.max(0, Math.floor((height - sampleHeight) / 2));
                const imageData = context.getImageData(startX, startY, sampleWidth, sampleHeight).data;
                let totalBrightness = 0;
                let brightPixels = 0;
                const totalPixels = sampleWidth * sampleHeight;

                for (let index = 0; index < imageData.length; index += 4) {
                    const brightness = (imageData[index] + imageData[index + 1] + imageData[index + 2]) / 3;
                    totalBrightness += brightness;
                    if (brightness > 24) {
                        brightPixels++;
                    }
                }

                return (totalBrightness / totalPixels) < 10 || brightPixels / totalPixels < 0.02;
            };

            const drawCurrentCheckinFrame = async (context) => {
                if (!(checkinVideo instanceof HTMLVideoElement)) {
                    return null;
                }

                const track = checkinStream?.getVideoTracks?.()[0] || null;
                if (track && typeof window.ImageCapture === "function") {
                    try {
                        const imageCapture = new window.ImageCapture(track);
                        const bitmap = await imageCapture.grabFrame();
                        checkinCanvas.width = bitmap.width;
                        checkinCanvas.height = bitmap.height;
                        context.drawImage(bitmap, 0, 0, bitmap.width, bitmap.height);
                        bitmap.close?.();
                        return { width: checkinCanvas.width, height: checkinCanvas.height };
                    } catch {
                        // Fall back to drawing from the video element.
                    }
                }

                const width = checkinVideo.videoWidth;
                const height = checkinVideo.videoHeight;
                if (!width || !height) {
                    return null;
                }

                checkinCanvas.width = width;
                checkinCanvas.height = height;
                context.drawImage(checkinVideo, 0, 0, width, height);
                return { width, height };
            };

            const loadImageFromFile = (file) => new Promise((resolve, reject) => {
                const image = new Image();
                const objectUrl = URL.createObjectURL(file);
                image.onload = () => {
                    URL.revokeObjectURL(objectUrl);
                    resolve(image);
                };
                image.onerror = () => {
                    URL.revokeObjectURL(objectUrl);
                    reject(new Error("Image load failed."));
                };
                image.src = objectUrl;
            });

            const drawCapturedFileToCanvas = async (file) => {
                if (!(checkinCanvas instanceof HTMLCanvasElement)) {
                    return false;
                }

                const image = await loadImageFromFile(file);
                const maxWidth = 1600;
                const scale = Math.min(1, maxWidth / Math.max(image.naturalWidth || image.width, 1));
                const width = Math.max(1, Math.round((image.naturalWidth || image.width) * scale));
                const height = Math.max(1, Math.round((image.naturalHeight || image.height) * scale));
                checkinCanvas.width = width;
                checkinCanvas.height = height;

                const context = checkinCanvas.getContext("2d");
                if (!context) {
                    return false;
                }

                context.drawImage(image, 0, 0, width, height);

                const capturedAt = new Date();
                checkinCapturedAt = capturedAt;
                if (checkinTimeInput instanceof HTMLInputElement) {
                    checkinTimeInput.value = formatDateTimeLocal(capturedAt);
                }

                const lines = [
                    `${capturedAt.toLocaleDateString("vi-VN")} ${capturedAt.toLocaleTimeString("vi-VN", { hour: "2-digit", minute: "2-digit" })}`,
                    checkinResolvedAddress || "\u0043\u0068\u01b0\u0061 \u0078\u00e1\u0063 \u0111\u1ecb\u006e\u0068 \u0111\u1ecb\u0061 \u0111\u0069\u1ec3\u006d \u0047\u0050\u0053"
                ];
                const padding = Math.max(18, Math.round(width * 0.018));
                const lineHeight = Math.max(26, Math.round(width * 0.026));
                context.fillStyle = "rgba(0, 0, 0, 0.58)";
                context.fillRect(0, height - padding * 2 - lineHeight * lines.length, width, padding * 2 + lineHeight * lines.length);
                context.fillStyle = "#ffffff";
                context.font = `${Math.max(18, Math.round(width * 0.02))}px Arial, sans-serif`;
                lines.forEach((line, index) => {
                    context.fillText(line.slice(0, 160), padding, height - padding - lineHeight * (lines.length - 1 - index));
                });

                checkinImageBlob = await new Promise((resolve) => checkinCanvas.toBlob(resolve, "image/jpeg", 0.88));
                if (!checkinImageBlob) {
                    return false;
                }

                const stampedFile = new File([checkinImageBlob], `checkin-${Date.now()}.jpg`, { type: "image/jpeg" });
                const transfer = new DataTransfer();
                transfer.items.add(stampedFile);
                if (checkinFileInput instanceof HTMLInputElement) {
                    checkinFileInput.files = transfer.files;
                }

                if (checkinPreview instanceof HTMLImageElement) {
                    checkinPreview.src = checkinCanvas.toDataURL("image/jpeg", 0.88);
                    checkinPreview.hidden = false;
                }
                if (checkinPlaceholder instanceof HTMLElement) {
                    checkinPlaceholder.hidden = true;
                }
                if (checkinCameraShell instanceof HTMLElement) {
                    checkinCameraShell.classList.remove("is-awaiting-photo");
                }
                return true;
            };

            const getCameraLabel = (device, index) => {
                const label = (device?.label || "").trim();
                return label || `Camera ${index + 1}`;
            };

            const syncCameraSelect = (select, shell, devices, selectedCameraId) => {
                if (!(select instanceof HTMLSelectElement)) {
                    return selectedCameraId || "";
                }

                select.innerHTML = "";
                devices.forEach((device, index) => {
                    const option = document.createElement("option");
                    option.value = device.deviceId;
                    option.textContent = getCameraLabel(device, index);
                    select.appendChild(option);
                });

                let nextSelected = selectedCameraId || "";
                if (!nextSelected && devices.length > 0) {
                    const backCamera = devices.find((device) => /back|rear|environment|sau/i.test(device.label || ""));
                    nextSelected = (backCamera || devices[0]).deviceId;
                }

                if (nextSelected) {
                    select.value = nextSelected;
                }

                if (shell instanceof HTMLElement) {
                    shell.hidden = devices.length <= 1;
                }

                return nextSelected;
            };

            const loadCameraDevices = async () => {
                if (!navigator.mediaDevices?.enumerateDevices) {
                    return;
                }

                try {
                    const devices = (await navigator.mediaDevices.enumerateDevices())
                        .filter((device) => device.kind === "videoinput" && device.deviceId);
                    checkinCameraDevices = devices;
                    workCameraDevices = devices;
                    selectedCheckinCameraId = syncCameraSelect(checkinCameraSelect, checkinCameraSelectShell, checkinCameraDevices, selectedCheckinCameraId);
                    selectedWorkCameraId = syncCameraSelect(workCameraSelect, workCameraSelectShell, workCameraDevices, selectedWorkCameraId);
                } catch {
                }
            };

            const buildCameraConstraints = (cameraId) => cameraId
                ? { deviceId: { exact: cameraId } }
                : { facingMode: { ideal: "environment" } };

            const startCheckinCamera = async () => {
                if (!(checkinVideo instanceof HTMLVideoElement) || !navigator.mediaDevices?.getUserMedia) {
                    setCheckinStatus("\u0054\u0072\u00ec\u006e\u0068 \u0064\u0075\u0079\u1ec7\u0074 \u006b\u0068\u00f4\u006e\u0067 \u0068\u1ed7 \u0074\u0072\u1ee3 \u0063\u0061\u006d\u0065\u0072\u0061.", "error");
                    return;
                }

                stopCheckinCamera();
                if (checkinCaptureButton instanceof HTMLButtonElement) {
                    checkinCaptureButton.disabled = true;
                }
                checkinStream = await navigator.mediaDevices.getUserMedia({
                    video: buildCameraConstraints(selectedCheckinCameraId),
                    audio: false
                });
                checkinVideo.srcObject = checkinStream;
                checkinVideo.hidden = false;
                if (checkinPreview instanceof HTMLImageElement) {
                    checkinPreview.hidden = true;
                }
                await checkinVideo.play();
                await waitForCheckinVideoFrame();
                if (checkinCaptureButton instanceof HTMLButtonElement) {
                    checkinCaptureButton.disabled = false;
                }
                await loadCameraDevices();
            };

            const resolveCheckinPosition = async () => {
                const hasRequiredInputs = checkinLatInput instanceof HTMLInputElement &&
                    checkinLongInput instanceof HTMLInputElement &&
                    checkinAddress instanceof HTMLElement;
                await updateCheckinGpsDebug("start", { hasRequiredInputs });

                if (!(checkinLatInput instanceof HTMLInputElement) ||
                    !(checkinLongInput instanceof HTMLInputElement) ||
                    !(checkinAddress instanceof HTMLElement)) {
                    await updateCheckinGpsDebug("missing-required-elements", {
                        hasLatInput: checkinLatInput instanceof HTMLInputElement,
                        hasLongInput: checkinLongInput instanceof HTMLInputElement,
                        hasAddressElement: checkinAddress instanceof HTMLElement
                    });
                    return;
                }

                if (!navigator.geolocation) {
                    checkinAddress.textContent = "\u0054\u0072\u00ec\u006e\u0068 \u0064\u0075\u0079\u1ec7\u0074 \u006b\u0068\u00f4\u006e\u0067 \u0068\u1ed7 \u0074\u0072\u1ee3 \u0047\u0050\u0053.";
                    setCheckinStatus("\u0054\u0072\u00ec\u006e\u0068 \u0064\u0075\u0079\u1ec7\u0074 \u006b\u0068\u00f4\u006e\u0067 \u0068\u1ed7 \u0074\u0072\u1ee3 \u0047\u0050\u0053.", "warning");
                    await updateCheckinGpsDebug("unsupported");
                    return false;
                }

                if (false && window.isSecureContext === false) {
                    const message = "Trình duyệt chỉ cho phép lấy GPS trên HTTPS hoặc localhost. Vui lòng mở hệ thống bằng HTTPS.";
                    checkinAddress.textContent = message;
                    setCheckinStatus(message, "error");
                    return;
                }

                checkinAddress.textContent = "\u0110\u0061\u006e\u0067 \u006c\u1ea5\u0079 \u0076\u1ecb \u0074\u0072\u00ed \u0047\u0050\u0053...";
                checkinAddress.classList.add("is-loading");
                setCheckinStatus("Đang lấy vị trí GPS...", "info");
                if (checkinGpsRetryButton instanceof HTMLButtonElement) {
                    checkinGpsRetryButton.disabled = true;
                }

                let position = null;
                try {
                    position = await getCheckinCurrentPosition();
                } catch (error) {
                    const code = typeof error === "object" && error !== null && "code" in error
                        ? Number(error.code)
                        : 0;
                    const errorMessage = typeof error === "object" && error !== null && "message" in error
                        ? `${error.message}`
                        : `${error}`;
                    const message = code === 1
                        ? "Trình duyệt đang chặn quyền GPS. Vui lòng cho phép Location/Vị trí cho website này rồi bấm Lấy GPS."
                        : code === 2
                            ? "Trình duyệt chưa xác định được vị trí GPS. Hãy bật định vị trên thiết bị rồi bấm Lấy GPS."
                            : code === 3
                                ? "Lấy vị trí GPS quá thời gian chờ. Vui lòng bấm Lấy GPS để thử lại."
                                : "Không thể lấy vị trí GPS. Vui lòng kiểm tra quyền Location/Vị trí của trình duyệt.";
                    checkinAddress.textContent = message;
                    checkinAddress.classList.remove("is-loading");
                    setCheckinStatus(message, "error");
                    await updateCheckinGpsDebug("error", {
                        code,
                        errorMessage,
                        mappedMessage: message
                    });
                    return false;
                } finally {
                    if (checkinGpsRetryButton instanceof HTMLButtonElement) {
                        checkinGpsRetryButton.disabled = false;
                    }
                }

                const lat = position.coords.latitude;
                const lng = position.coords.longitude;
                checkinLatInput.value = `${lat}`;
                checkinLongInput.value = `${lng}`;
                checkinResolvedAddress = `${lat.toFixed(5)}, ${lng.toFixed(5)}`;
                checkinAddress.textContent = checkinResolvedAddress;
                checkinAddress.classList.remove("is-loading");
                setCheckinStatus("Đã lấy vị trí GPS.", "success");

                syncCheckinDistanceMap();
                await updateCheckinGpsDebug("success", {
                    accuracy: position.coords.accuracy,
                    altitude: position.coords.altitude,
                    altitudeAccuracy: position.coords.altitudeAccuracy,
                    heading: position.coords.heading,
                    speed: position.coords.speed,
                    timestamp: position.timestamp
                });
                await resolveCheckinAddressFromCoordinates(lat, lng);
                return true;
            };

            const getCheckinCurrentPosition = async () => {
                return await new Promise((resolve, reject) => {
                    navigator.geolocation.getCurrentPosition(resolve, reject, {
                        enableHighAccuracy: true,
                        timeout: 10000,
                        maximumAge: 60000
                    });
                });
            };

            const resolveCheckinAddressFromCoordinates = async (lat, lng) => {
                const coordinateText = `${lat.toFixed(5)}, ${lng.toFixed(5)}`;
                const reverseLookupController = new AbortController();
                const reverseLookupTimeout = window.setTimeout(() => reverseLookupController.abort(), 4500);

                try {
                    const response = await fetch(`https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=${encodeURIComponent(lat)}&lon=${encodeURIComponent(lng)}&zoom=18&addressdetails=1&accept-language=vi`, {
                        headers: { Accept: "application/json" },
                        signal: reverseLookupController.signal
                    });

                    if (!response.ok) {
                        throw new Error("Reverse lookup failed.");
                    }

                    const payload = await response.json();
                    const resolvedAddress = typeof payload.display_name === "string"
                        ? payload.display_name.trim()
                        : "";
                    const resolvedName = typeof payload.name === "string"
                        ? payload.name.trim()
                        : "";
                    const resolvedLocation = resolvedName && resolvedAddress && !resolvedAddress.toLowerCase().startsWith(resolvedName.toLowerCase())
                        ? `${resolvedName}, ${resolvedAddress}`
                        : resolvedAddress || resolvedName;

                    if (resolvedLocation) {
                        checkinResolvedAddress = resolvedLocation;
                        checkinAddress.textContent = checkinResolvedAddress;
                        setCheckinStatus("Đã lấy GPS và tên địa điểm.", "success");
                        return;
                    }
                } catch {
                    // Coordinates are enough for saving when reverse lookup is unavailable.
                } finally {
                    window.clearTimeout(reverseLookupTimeout);
                }

                checkinResolvedAddress = coordinateText;
                checkinAddress.textContent = checkinResolvedAddress;
                setCheckinStatus("Đã lấy GPS, chưa lấy được tên địa điểm từ bản đồ.", "warning");
            };

            const resetCheckinPhoto = () => {
                checkinImageBlob = null;
                checkinCapturedAt = null;
                if (checkinFileInput instanceof HTMLInputElement) {
                    checkinFileInput.value = "";
                }
                if (checkinRetakeButton instanceof HTMLButtonElement) {
                    checkinRetakeButton.disabled = true;
                }
                if (checkinCaptureButton instanceof HTMLButtonElement) {
                    checkinCaptureButton.disabled = true;
                }
                if (checkinPreview instanceof HTMLImageElement) {
                    checkinPreview.hidden = true;
                    checkinPreview.removeAttribute("src");
                }
                if (checkinVideo instanceof HTMLVideoElement) {
                    checkinVideo.hidden = true;
                    checkinVideo.removeAttribute("src");
                    checkinVideo.srcObject = null;
                }
                if (checkinPlaceholder instanceof HTMLElement) {
                    checkinPlaceholder.hidden = false;
                }
                if (checkinStamp instanceof HTMLElement) {
                    checkinStamp.hidden = true;
                }
                if (checkinStampTime instanceof HTMLElement) {
                    checkinStampTime.textContent = "";
                }
                if (checkinStampAddress instanceof HTMLElement) {
                    checkinStampAddress.textContent = "";
                }
                if (checkinCameraShell instanceof HTMLElement) {
                    checkinCameraShell.classList.remove("is-captured");
                }
            };

            const openCheckinModal = async (options = {}) => {
                if (!(checkinShell instanceof HTMLElement)) {
                    return;
                }

                checkinMode = options.mode === "checkout" ? "checkout" : "checkin";
                checkoutTarget = checkinMode === "checkout" ? options.target || null : null;
                resetCheckinPhoto();
                setCheckinTimeBounds();
                setCheckinStatus("", "info");
                if (checkinNoteInput instanceof HTMLTextAreaElement) {
                    checkinNoteInput.value = "";
                }
                if (checkinNoteLabel instanceof HTMLElement) {
                    checkinNoteLabel.textContent = checkinMode === "checkout" ? "Ghi chú checkout" : "Ghi chú nhân viên";
                }
                const title = checkinShell.querySelector("#yeu-cau-checkin-title");
                if (title instanceof HTMLElement) {
                    title.textContent = checkinMode === "checkout" ? "Checkout" : "Checkin";
                }
                if (checkinSaveButton instanceof HTMLButtonElement) {
                    const label = checkinSaveButton.querySelector(".button-content span:last-child");
                    if (label instanceof HTMLElement) {
                        label.textContent = checkinMode === "checkout" ? "Luu checkout" : "Luu checkin";
                    }
                }
                checkinShell.hidden = false;
                setCheckinDistanceExpanded(false);
                syncCheckinDistanceMap();
                await updateCheckinGpsDebug("modal-open");

                try {
                    if (checkinCaptureButton instanceof HTMLButtonElement) {
                        checkinCaptureButton.disabled = true;
                    }
                    await resolveCheckinPosition();
                    await startCheckinCamera();
                    window.setTimeout(() => {
                        setCheckinStatus("\u0043\u0061\u006d\u0065\u0072\u0061 \u0111\u00e3 \u0073\u1eb5\u006e \u0073\u00e0\u006e\u0067. \u0047\u0050\u0053 \u0111\u00e3 \u0111\u01b0\u1ee3\u0063 \u006b\u0069\u1ec3\u006d \u0074\u0072\u0061.", "success");
                    }, 0);
                } catch {
                    setCheckinStatus("Không thể bật camera. Hãy cấp quyền camera rồi thử lại.", "error");
                }
            };

            const closeCheckinModal = () => {
                if (checkinShell instanceof HTMLElement) {
                    checkinShell.hidden = true;
                }
                stopCheckinCamera();
            };

            const setCheckinImageMapStatus = (message, type = "info") => {
                if (!(checkinImageMapStatus instanceof HTMLElement)) {
                    return;
                }

                checkinImageMapStatus.textContent = message;
                checkinImageMapStatus.dataset.state = type;
                checkinImageMapStatus.hidden = !message;
            };

            const ensureCheckinImageMap = () => {
                if (!(checkinImageMapElement instanceof HTMLElement)) {
                    return false;
                }

                if (!(window.L && typeof window.L.map === "function")) {
                    setCheckinImageMapStatus("Không tải được thư viện bản đồ.", "error");
                    return false;
                }

                if (checkinImageMap) {
                    window.setTimeout(() => checkinImageMap.invalidateSize(), 120);
                    return true;
                }

                checkinImageMap = window.L.map(checkinImageMapElement, {
                    zoomControl: true
                });
                window.L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
                    maxZoom: 19,
                    attribution: "&copy; OpenStreetMap contributors"
                }).addTo(checkinImageMap);
                checkinImageMap.setView(defaultCenter, defaultZoom);
                window.setTimeout(() => checkinImageMap.invalidateSize(), 120);
                return true;
            };

            const syncCheckinImageMap = (lat, lng) => {
                if (!ensureCheckinImageMap()) {
                    return;
                }

                if (!Number.isFinite(lat) || !Number.isFinite(lng)) {
                    if (checkinImageMarker) {
                        checkinImageMap.removeLayer(checkinImageMarker);
                        checkinImageMarker = null;
                    }
                    checkinImageMap.setView(defaultCenter, defaultZoom);
                    setCheckinImageMapStatus("Checkin này chưa có tọa độ GPS.", "warning");
                    return;
                }

                setCheckinImageMapStatus("", "info");
                if (!checkinImageMarker) {
                    checkinImageMarker = window.L.marker([lat, lng]).addTo(checkinImageMap);
                } else {
                    checkinImageMarker.setLatLng([lat, lng]);
                }

                checkinImageMap.setView([lat, lng], focusZoom);
                window.setTimeout(() => checkinImageMap.invalidateSize(), 120);
            };

            const updateCheckinImageTransform = () => {
                if (!(checkinImageFull instanceof HTMLImageElement)) {
                    return;
                }

                checkinImageFull.style.transform = `scale(${checkinImageZoom}) rotate(${checkinImageRotation}deg)`;
            };

            const resetCheckinImageTransform = () => {
                checkinImageZoom = 1;
                checkinImageRotation = 0;
                updateCheckinImageTransform();
            };

            const setCheckinImageDownload = (imageUrl) => {
                if (!(checkinImageDownloadLink instanceof HTMLAnchorElement)) {
                    return;
                }

                checkinImageDownloadLink.href = imageUrl || "#";
                checkinImageDownloadLink.download = imageUrl
                    ? imageUrl.split("/").pop() || "checkin-image"
                    : "";
            };

            const openCheckinImageModal = (button) => {
                if (!(button instanceof HTMLElement) ||
                    !(checkinImageShell instanceof HTMLElement) ||
                    !(checkinImageFull instanceof HTMLImageElement)) {
                    return;
                }

                const imageUrl = button.dataset.checkinImage || "";
                if (!imageUrl) {
                    return;
                }

                resetCheckinImageTransform();
                checkinImageFull.src = imageUrl;
                setCheckinImageDownload(imageUrl);
                if (checkinImageTitle instanceof HTMLElement) {
                    checkinImageTitle.textContent = button.dataset.checkinEmployee || "\u1ea2\u006e\u0068 \u0063\u0068\u0065\u0063\u006b\u0069\u006e";
                }
                if (checkinImageSubtitle instanceof HTMLElement) {
                    checkinImageSubtitle.textContent = button.dataset.checkinAddress || "";
                }
                if (checkinImageTime instanceof HTMLElement) {
                    checkinImageTime.textContent = button.dataset.checkinTime || "";
                }
                if (checkinImageAddress instanceof HTMLElement) {
                    checkinImageAddress.textContent = button.dataset.checkinAddress || "";
                }

                checkinImageShell.hidden = false;
            };

            const closeCheckinImageModal = () => {
                if (checkinImageShell instanceof HTMLElement) {
                    checkinImageShell.hidden = true;
                }
                if (checkinImageFull instanceof HTMLImageElement) {
                    checkinImageFull.removeAttribute("src");
                    checkinImageFull.removeAttribute("style");
                }
                setCheckinImageDownload("");
                resetCheckinImageTransform();
            };

            const deleteCheckin = async (button) => {
                if (!checkinDeleteUrl || !(button instanceof HTMLElement)) {
                    return;
                }

                const checkinId = button.dataset.checkinId || "";
                const requestId = button.dataset.checkinRequestId || "";
                if (!checkinId || !requestId) {
                    return;
                }

                if (!window.confirm("X\u00f3a th\u00f4ng tin checkin n\u00e0y?")) {
                    return;
                }

                const token = root.querySelector("input[name='__RequestVerificationToken']");
                const payload = new FormData();
                payload.append("id", checkinId);
                payload.append("yeuCauId", requestId);

                button.setAttribute("disabled", "disabled");
                try {
                    const response = await fetch(checkinDeleteUrl, {
                        method: "POST",
                        headers: token instanceof HTMLInputElement ? { RequestVerificationToken: token.value } : {},
                        body: payload
                    });
                    const result = await response.json().catch(() => ({}));
                    if (!response.ok || !result.succeeded) {
                        throw new Error(result.message || "Kh\u00f4ng th\u1ec3 x\u00f3a checkin.");
                    }

                    window.location.reload();
                } catch (error) {
                    window.alert(error instanceof Error ? error.message : "Kh\u00f4ng th\u1ec3 x\u00f3a checkin.");
                    button.removeAttribute("disabled");
                }
            };

            const captureCheckinPhoto = async () => {
                if (!(checkinVideo instanceof HTMLVideoElement)) {
                    return;
                }

                const capturedAt = new Date();
                checkinCapturedAt = capturedAt;
                if (checkinTimeInput instanceof HTMLInputElement) {
                    checkinTimeInput.value = formatDateTimeLocal(capturedAt);
                }

                if (checkinStampTime instanceof HTMLElement) {
                    checkinStampTime.textContent = `${capturedAt.toLocaleDateString("vi-VN")} ${capturedAt.toLocaleTimeString("vi-VN", { hour: "2-digit", minute: "2-digit" })}`;
                }
                if (checkinStampAddress instanceof HTMLElement) {
                    checkinStampAddress.textContent = checkinResolvedAddress || "\u0043\u0068\u01b0\u0061 \u0078\u00e1\u0063 \u0111\u1ecb\u006e\u0068 \u0111\u1ecb\u0061 \u0111\u0069\u1ec3\u006d \u0047\u0050\u0053";
                }
                if (checkinStamp instanceof HTMLElement) {
                    checkinStamp.hidden = false;
                }
                if (checkinPlaceholder instanceof HTMLElement) {
                    checkinPlaceholder.hidden = true;
                }
                if (checkinCameraShell instanceof HTMLElement) {
                    checkinCameraShell.classList.add("is-captured");
                }

                const track = checkinStream?.getVideoTracks?.()[0] || null;
                checkinImageBlob = null;
                if (track && typeof window.ImageCapture === "function") {
                    try {
                        const imageCapture = new window.ImageCapture(track);
                        checkinImageBlob = await imageCapture.takePhoto();
                    } catch {
                        checkinImageBlob = null;
                    }
                }

                checkinVideo.pause();

                if (checkinImageBlob && checkinFileInput instanceof HTMLInputElement) {
                    const file = new File([checkinImageBlob], `checkin-${Date.now()}.jpg`, { type: checkinImageBlob.type || "image/jpeg" });
                    const transfer = new DataTransfer();
                    transfer.items.add(file);
                    checkinFileInput.files = transfer.files;
                }

                if (checkinRetakeButton instanceof HTMLButtonElement) {
                    checkinRetakeButton.disabled = false;
                }
                if (checkinCaptureButton instanceof HTMLButtonElement) {
                    checkinCaptureButton.disabled = true;
                }
            };

            const submitCheckin = async () => {
                const submitUrl = checkinMode === "checkout" ? checkoutUrl : checkinUrl;
                if (!submitUrl || !(formIdInput instanceof HTMLInputElement)) {
                    return;
                }

                const token = root.querySelector("input[name='__RequestVerificationToken']");
                const selectedEmployeeId = checkinMode === "checkout" && checkoutTarget?.employeeId
                    ? Number.parseInt(checkoutTarget.employeeId, 10)
                    : (isAdmin && checkinEmployeeSelect instanceof HTMLSelectElement
                        ? Number.parseInt(checkinEmployeeSelect.value, 10)
                        : currentEmployeeId);

                if (isAdmin && (!Number.isFinite(selectedEmployeeId) || selectedEmployeeId <= 0)) {
                    setCheckinStatus("\u0056\u0075\u0069 \u006c\u00f2\u006e\u0067 \u0063\u0068\u1ecd\u006e \u006e\u0068\u00e2\u006e \u0076\u0069\u00ea\u006e \u0063\u0068\u0065\u0063\u006b\u0069\u006e.", "error");
                    return;
                }

                if (checkinMode === "checkout" && (!checkoutTarget || !checkoutTarget.id)) {
                    setCheckinStatus("Khong xac dinh duoc checkin can checkout.", "error");
                    return;
                }

                if (!(checkinFileInput instanceof HTMLInputElement) || !checkinFileInput.files || checkinFileInput.files.length === 0) {
                    setCheckinStatus("\u0110\u00e3 \u0063\u0068\u1ee5\u0070 \u0068\u00ec\u006e\u0068 \u0111\u1ec3 \u0068\u0069\u1ec3\u006e \u0074\u0068\u1ecb, \u006e\u0068\u01b0\u006e\u0067 \u0074\u0072\u00ec\u006e\u0068 \u0064\u0075\u0079\u1ec7\u0074 \u0063\u0068\u01b0\u0061 \u0063\u0068\u006f \u006c\u1ea5\u0079 \u0066\u0069\u006c\u0065 \u1ea3\u006e\u0068 \u0111\u1ec3 \u006c\u01b0\u0075. \u0056\u0075\u0069 \u006c\u00f2\u006e\u0067 \u0074\u0068\u1eed \u0074\u0072\u00ec\u006e\u0068 \u0064\u0075\u0079\u1ec7\u0074 \u006b\u0068\u00e1\u0063 \u0068\u006f\u1eb7\u0063 \u0063\u0068\u006f \u0070\u0068\u00e9\u0070 \u0063\u0061\u006d\u0065\u0072\u0061.", "error");
                    return;
                }

                if (!(checkinLatInput instanceof HTMLInputElement) || !(checkinLongInput instanceof HTMLInputElement) ||
                    !checkinLatInput.value || !checkinLongInput.value) {
                    setCheckinStatus("Chưa có GPS, đang thử lấy lại vị trí...", "info");
                    await resolveCheckinPosition();
                    if (!(checkinLatInput instanceof HTMLInputElement) || !(checkinLongInput instanceof HTMLInputElement) ||
                        !checkinLatInput.value || !checkinLongInput.value) {
                        setCheckinStatus("\u0056\u0075\u0069 \u006c\u00f2\u006e\u0067 \u0063\u1ea5\u0070 \u0071\u0075\u0079\u1ec1\u006e \u0047\u0050\u0053 \u0111\u1ec3 \u006c\u1ea5\u0079 \u0076\u1ecb \u0074\u0072\u00ed \u0063\u0068\u0065\u0063\u006b\u0069\u006e.", "error");
                        return;
                    }
                }

                syncCheckinDistanceMap();
                if (checkinDistanceExceeded) {
                    setCheckinStatus(getCheckinDistanceLimitMessage(), "error");
                    return;
                }

                const payload = new FormData();
                if (checkinMode === "checkout") {
                    payload.append("Id", checkoutTarget.id);
                }
                payload.append("IDYeuCau", formIdInput.value);
                if (Number.isFinite(selectedEmployeeId) && selectedEmployeeId > 0) {
                    payload.append("IDNhanVien", `${selectedEmployeeId}`);
                }
                if (checkinMode === "checkout") {
                    payload.append("ThoiDiemCheckOut", formatDateTimeLocal(checkinCapturedAt || new Date()));
                    payload.append("LongAddressCheckOut", checkinLongInput.value);
                    payload.append("LatAddressCheckOut", checkinLatInput.value);
                    payload.append("GhiChuCheckOut", checkinNoteInput instanceof HTMLTextAreaElement ? checkinNoteInput.value : "");
                } else {
                    payload.append("ThoiDiem", formatDateTimeLocal(checkinCapturedAt || new Date()));
                    payload.append("LongAddress", checkinLongInput.value);
                    payload.append("LatAddress", checkinLatInput.value);
                    payload.append("GhiChuNhanVien", checkinNoteInput instanceof HTMLTextAreaElement ? checkinNoteInput.value : "");
                }
                payload.append("imageFile", checkinFileInput.files[0]);

                if (checkinSaveButton instanceof HTMLButtonElement) {
                    checkinSaveButton.disabled = true;
                }
                setCheckinStatus(checkinMode === "checkout" ? "Dang luu checkout..." : "\u0110\u0061\u006e\u0067 \u006c\u01b0\u0075 \u0063\u0068\u0065\u0063\u006b\u0069\u006e...", "info");

                try {
                    const response = await fetch(submitUrl, {
                        method: "POST",
                        headers: token instanceof HTMLInputElement ? { RequestVerificationToken: token.value } : {},
                        body: payload
                    });
                    const result = await response.json().catch(() => ({}));
                    if (!response.ok || !result.succeeded) {
                        throw new Error(result.message || "\u004b\u0068\u00f4\u006e\u0067 \u0074\u0068\u1ec3 \u006c\u01b0\u0075 \u0063\u0068\u0065\u0063\u006b\u0069\u006e.");
                    }

                    window.location.reload();
                } catch (error) {
                    setCheckinStatus(error instanceof Error ? error.message : "\u004b\u0068\u00f4\u006e\u0067 \u0074\u0068\u1ec3 \u006c\u01b0\u0075 \u0063\u0068\u0065\u0063\u006b\u0069\u006e.", "error");
                } finally {
                    if (checkinSaveButton instanceof HTMLButtonElement) {
                        checkinSaveButton.disabled = false;
                    }
                }
            };

            const setActiveTab = (tabName) => {
                if (tabName === "khach-hang") {
                    tabName = "thong-tin";
                }

                activeTabInput.value = tabName;
                writeViewState({ activeTab: tabName });

                tabButtons.forEach((button) => {
                    const isActive = button instanceof HTMLElement && button.dataset.tab === tabName;
                    button.classList.toggle("is-active", isActive);
                    button.setAttribute("aria-selected", isActive ? "true" : "false");
                });

                tabPanels.forEach((panel) => {
                    const isActive = panel instanceof HTMLElement && panel.dataset.tab === tabName;
                    panel.classList.toggle("is-active", isActive);
                    panel.hidden = !isActive;
                });

                if (tabName === "thong-tin") {
                    syncPreviewMap();
                }
            };

            const setCollapseState = (section, isCollapsed) => {
                if (!(section instanceof HTMLElement)) {
                    return;
                }

                const toggle = section.querySelector("[data-collapse-toggle]");
                const body = section.querySelector("[data-collapse-body]");
                const icon = section.querySelector("[data-collapse-icon]");

                section.classList.toggle("is-collapsed", isCollapsed);
                if (body instanceof HTMLElement) {
                    body.hidden = isCollapsed;
                }

                if (toggle instanceof HTMLButtonElement) {
                    toggle.setAttribute("aria-expanded", isCollapsed ? "false" : "true");
                }

                if (icon instanceof HTMLElement) {
                    icon.className = isCollapsed ? "fa-solid fa-chevron-down" : "fa-solid fa-chevron-up";
                }

                if (!isCollapsed && section.classList.contains("yeu-cau-location-collapse-panel")) {
                    window.setTimeout(syncPreviewMap, 120);
                }

                persistCollapseState();
            };

            const readLocationData = () => ({
                idDiaDiem: locationIdInput.value.trim(),
                idKhachHang: customerIdInput.value.trim(),
                tenKhachHang: previewCustomer.textContent?.trim() || "",
                diaChi: previewAddress.textContent?.trim() || "",
                nguoiLienHe: previewContact.textContent?.trim() || "",
                dienThoai: previewPhone.textContent?.trim() || "",
                longAddress: readCoordinate(previewLongInput),
                latAddress: readCoordinate(previewLatInput)
            });

            const clearSuggestions = () => {
                suggestionList.innerHTML = "";
                suggestionList.hidden = true;
                suggestionButtons = [];
                activeIndex = -1;
            };

            const getWorkItems = () => Array.from(workList.querySelectorAll("[data-work-item]"));

            const parseWorkDate = (input) => input instanceof HTMLInputElement && input.value
                ? new Date(input.value)
                : null;

            const normalizeWorkStatusValue = (value) => `${value || ""}`
                .normalize("NFD")
                .replace(/[\u0111\u0110]/g, "d")
                .replace(/\s+/g, "")
                .trim()
                .toLowerCase();

            const isCompletedWorkStatus = (value) => normalizeWorkStatusValue(value) === "hoanthanh";

            const isValidWorkCompletion = (workItem) => {
                const statusSelect = workItem.querySelector("[data-work-status-select]");
                return statusSelect instanceof HTMLSelectElement && isCompletedWorkStatus(statusSelect.value);
            };

            const syncCompletedWorkActionLock = (workItem, completed) => {
                workItem.classList.toggle("is-action-locked", completed);

                workItem.querySelectorAll("[data-work-image-upload], [data-work-image-camera]").forEach((button) => {
                    if (button instanceof HTMLButtonElement) {
                        button.disabled = completed;
                    }
                });

                workItem.querySelectorAll("[data-work-remove], [data-work-employee-add], [data-work-employee-remove], .yeu-cau-work-image-actions").forEach((element) => {
                    if (element instanceof HTMLElement) {
                        element.hidden = completed;
                        element.classList.toggle("is-hidden", completed);
                    }
                });

                workItem.querySelectorAll("[data-work-image-file], [data-work-image-camera-file]").forEach((input) => {
                    if (input instanceof HTMLInputElement) {
                        input.disabled = completed;
                    }
                });

                workItem.querySelectorAll("input[type='datetime-local'][name*='CheckInTime'], [data-work-checkin]").forEach((input) => {
                    if (input instanceof HTMLInputElement) {
                        input.readOnly = completed;
                    }
                });
            };

            const syncWorkCompletionState = (workItem) => {
                const completed = isValidWorkCompletion(workItem);
                const status = workItem.querySelector("[data-work-status]");
                const statusSelect = workItem.querySelector("[data-work-status-select]");
                const statusValue = statusSelect instanceof HTMLSelectElement && statusSelect.value
                    ? statusSelect.value
                    : "Tạo mới";
                workItem.classList.toggle("is-completed", completed);
                syncCompletedWorkActionLock(workItem, completed);
                workItem.classList.remove("pending", "in-progress", "review", "cancelled");
                if (!completed) {
                    const normalizedStatus = normalizeWorkStatusValue(statusValue);
                    const statusClass = normalizedStatus === "dangthuchien"
                        ? "in-progress"
                        : normalizedStatus === "chodanhgia"
                            ? "review"
                            : normalizedStatus === "huy"
                                ? "cancelled"
                                : "pending";
                    workItem.classList.add(statusClass);
                }
                if (status instanceof HTMLElement) {
                    status.textContent = statusValue;
                }
            };

            const syncWorkProgress = () => {
                const items = getWorkItems();
                const completed = items.filter((item) => item instanceof HTMLElement && isValidWorkCompletion(item)).length;
                const percent = items.length === 0 ? 0 : Math.round(completed * 100 / items.length);
                if (workProgress instanceof HTMLElement) {
                    workProgress.style.setProperty("--progress", `${percent}`);
                }
                if (workProgressPercent instanceof HTMLElement) {
                    workProgressPercent.textContent = `${percent}%`;
                }
            };

            const getEmployeeOptions = () => Array.from(employeeSelect.options)
                .filter((option) => option.value)
                .map((option) => ({
                    id: Number.parseInt(option.value, 10),
                    hoTen: option.dataset.employeeName || option.textContent?.trim() || "Nhân viên",
                    chucVu: option.dataset.employeeRole || "",
                    avatar: option.dataset.employeeAvatar || ""
                }))
                .filter((employee) => Number.isFinite(employee.id) && employee.id > 0);

            const getWorkEmployeeIdInputs = (container) => {
                const hiddenInputs = Array.from(container.querySelectorAll("[data-work-employee-id]"));
                return hiddenInputs.length > 0
                    ? hiddenInputs
                    : Array.from(container.querySelectorAll("[data-work-employee-checkbox]:checked"));
            };

            const getWorkEmployeeIds = (workItem) => getWorkEmployeeIdInputs(workItem)
                .map((input) => input instanceof HTMLInputElement ? Number.parseInt(input.value, 10) : Number.NaN)
                .filter((id) => Number.isFinite(id) && id > 0);

            const renderLinkedEmployeePicker = () => {
                const selectedIds = activeEmployeeWorkItem instanceof HTMLElement
                    ? new Set(getWorkEmployeeIds(activeEmployeeWorkItem))
                    : new Set();
                const availableEmployees = getEmployeeOptions()
                    .filter((employee) => !selectedIds.has(employee.id));

                linkedEmployeePickerList.innerHTML = "";
                linkedEmployeePickerEmpty.classList.toggle("is-hidden", availableEmployees.length > 0);

                if (availableEmployees.length === 0) {
                    return;
                }

                const fragment = document.createDocumentFragment();
                availableEmployees.forEach((employee) => {
                    const label = document.createElement("label");
                    label.className = "yeu-cau-linked-employee-picker-item";
                    label.innerHTML = `
                        <input type="checkbox" value="${employee.id}" data-linked-employee-picker-checkbox />
                        <span class="employee-avatar">
                            <img src="${employee.avatar || "/images/default-avatar.svg"}"
                                 alt="Avatar ${employee.hoTen}"
                                 onerror="this.onerror=null;this.src='/images/default-avatar.svg';" />
                        </span>
                        <span class="yeu-cau-linked-employee-copy">
                            <strong>${employee.hoTen}</strong>
                            <span>${employee.chucVu || "Chưa có vị trí công việc"}</span>
                        </span>
                    `;

                    const checkbox = label.querySelector("input");
                    if (checkbox instanceof HTMLInputElement) {
                        checkbox.dataset.employeeName = employee.hoTen;
                        checkbox.dataset.employeeRole = employee.chucVu;
                        checkbox.dataset.employeeAvatar = employee.avatar;
                    }

                    fragment.appendChild(label);
                });

                linkedEmployeePickerList.appendChild(fragment);
            };

            const openLinkedEmployeePicker = () => {
                if (!(activeEmployeeWorkItem instanceof HTMLElement)) {
                    return;
                }

                renderLinkedEmployeePicker();
                linkedEmployeePickerShell.hidden = false;
            };

            const closeLinkedEmployeePicker = () => {
                linkedEmployeePickerShell.hidden = true;
            };

            const openWorkPicker = () => {
                workPickerShell.hidden = false;
            };

            const closeWorkPicker = () => {
                workPickerShell.hidden = true;
            };

            const findWorkOption = (workId) => {
                return workOptions.find((option) => Number(option.id) === Number(workId)) || null;
            };

            const findPreviousWorkEmployees = (currentWorkItem, workId) => {
                const candidates = getWorkItems().filter((item) => item !== currentWorkItem);
                for (let index = candidates.length - 1; index >= 0; index--) {
                    const candidate = candidates[index];
                    const select = candidate.querySelector("[data-work-option-select]");
                    if (!(select instanceof HTMLSelectElement) || Number.parseInt(select.value, 10) !== workId) {
                        continue;
                    }

                    return Array.from(candidate.querySelectorAll("[data-work-employee-choice]"))
                        .map((choice) => {
                            const idInput = choice.querySelector("[data-work-employee-id]");
                            const checkbox = choice.querySelector("[data-work-employee-checkbox]");
                            const nameInput = choice.querySelector("[data-work-employee-name]");
                            const roleInput = choice.querySelector("[data-work-employee-role]");
                            const avatarInput = choice.querySelector("[data-work-employee-avatar]");
                            const employeeIdSource = idInput instanceof HTMLInputElement ? idInput : checkbox;
                            if (!(employeeIdSource instanceof HTMLInputElement)) {
                                return null;
                            }

                            return {
                                id: Number.parseInt(employeeIdSource.value, 10),
                                hoTen: nameInput instanceof HTMLInputElement ? nameInput.value : "",
                                chucVu: roleInput instanceof HTMLInputElement ? roleInput.value : "",
                                avatar: avatarInput instanceof HTMLInputElement ? avatarInput.value : ""
                            };
                        })
                        .filter((item) => item && Number.isFinite(item.id) && item.id > 0);
                }

                return [];
            };

            const syncWorkEmptyState = () => {
                const emptyState = workList.querySelector("[data-work-empty]");
                if (emptyState instanceof HTMLElement) {
                    emptyState.classList.toggle("is-hidden", getWorkItems().length > 0);
                }
            };

            const syncWorkChecklistItemState = (item) => {
                const checkbox = item.querySelector("[data-work-checklist-completed]");
                const finishDateInput = item.querySelector("[data-work-checklist-finish-date]");
                const finishByInput = item.querySelector("[data-work-checklist-finish-by]");
                const subtext = item.querySelector("[data-work-checklist-subtext]");
                const isCompleted = checkbox instanceof HTMLInputElement && checkbox.checked;

                item.classList.toggle("is-completed", isCompleted);
                if (!(subtext instanceof HTMLElement)) {
                    return;
                }

                if (!isCompleted) {
                    subtext.hidden = true;
                    subtext.textContent = "";
                    return;
                }

                const finishDate = finishDateInput instanceof HTMLInputElement ? finishDateInput.value : "";
                const finishBy = finishByInput instanceof HTMLInputElement ? finishByInput.value : "";
                if (!finishDate) {
                    subtext.hidden = true;
                    subtext.textContent = "";
                    return;
                }

                const date = new Date(finishDate);
                const formatted = Number.isNaN(date.getTime())
                    ? finishDate
                    : `${`${date.getDate()}`.padStart(2, "0")}/${`${date.getMonth() + 1}`.padStart(2, "0")}/${date.getFullYear()} ${`${date.getHours()}`.padStart(2, "0")}:${`${date.getMinutes()}`.padStart(2, "0")}`;
                subtext.textContent = `${formatted} - ${finishBy || "system"}`;
                subtext.hidden = false;
            };

            const bindWorkChecklistItem = (item) => {
                const checkbox = item.querySelector("[data-work-checklist-completed]");
                const finishDateInput = item.querySelector("[data-work-checklist-finish-date]");
                const finishByInput = item.querySelector("[data-work-checklist-finish-by]");
                if (!(checkbox instanceof HTMLInputElement)) {
                    return;
                }

                checkbox.addEventListener("change", () => {
                    const now = new Date();
                    if (checkbox.checked) {
                        if (finishDateInput instanceof HTMLInputElement && !finishDateInput.value) {
                            finishDateInput.value = now.toISOString().slice(0, 19);
                        }
                        if (finishByInput instanceof HTMLInputElement && !finishByInput.value) {
                            finishByInput.value = currentAuditUser;
                        }
                    } else {
                        if (finishDateInput instanceof HTMLInputElement) {
                            finishDateInput.value = "";
                        }
                        if (finishByInput instanceof HTMLInputElement) {
                            finishByInput.value = "";
                        }
                    }

                    syncWorkChecklistItemState(item);
                });

                syncWorkChecklistItemState(item);
            };

            const renderWorkEmployees = (workItem, preselectedEmployees = []) => {
                const employeeList = workItem.querySelector("[data-work-employee-list]");
                if (!(employeeList instanceof HTMLElement)) {
                    return;
                }

                const selectedIds = preselectedEmployees.length > 0
                    ? preselectedEmployees.map((employee) => employee.id)
                    : getWorkEmployeeIdInputs(employeeList)
                        .map((input) => input instanceof HTMLInputElement ? Number.parseInt(input.value, 10) : Number.NaN)
                        .filter((value) => Number.isFinite(value) && value > 0);

                employeeList.innerHTML = "";
                if (selectedIds.length === 0) {
                    employeeList.innerHTML = `<div class="yeu-cau-work-checklist-empty">Chưa có nhân viên thực hiện nào trong công việc này.</div>`;
                    return;
                }

                const selectedEmployees = selectedIds
                    .map((employeeId) => {
                        const employee = getEmployeeOptions().find((option) => option.id === employeeId);
                        return employee || preselectedEmployees.find((item) => item.id === employeeId) || null;
                    })
                    .filter((employee) => employee);

                selectedEmployees.forEach((employee) => {
                    const employeeId = employee.id;
                    const employeeName = employee.hoTen || "Nhân viên";
                    const employeeRole = employee.chucVu || "";
                    const employeeAvatar = employee.avatar || "";

                    const wrapper = document.createElement("div");
                    wrapper.className = "yeu-cau-work-employee-choice";
                    wrapper.innerHTML = `
                        <input type="hidden"
                               value="${Number.isFinite(employeeId) ? employeeId : ""}"
                               data-work-employee-id />
                        <input type="checkbox"
                               value="${Number.isFinite(employeeId) ? employeeId : ""}"
                               data-work-employee-checkbox
                               tabindex="-1"
                               aria-hidden="true"
                               checked />
                        <input type="hidden" value="${employeeName}" data-work-employee-name />
                        <input type="hidden" value="${employeeRole}" data-work-employee-role />
                        <input type="hidden" value="${employeeAvatar}" data-work-employee-avatar />
                        <span class="employee-avatar">
                            <img src="${employeeAvatar || "/images/default-avatar.svg"}"
                                 alt="Avatar ${employeeName}"
                                 onerror="this.onerror=null;this.src='/images/default-avatar.svg';" />
                        </span>
                        <span class="yeu-cau-linked-employee-copy">
                            <strong>${employeeName}</strong>
                            <span>${employeeRole || "Chưa có vị trí công việc"}</span>
                        </span>
                    `;

                    if (canDeleteWorkEmployee) {
                        const removeButton = document.createElement("button");
                        removeButton.type = "button";
                        removeButton.className = "table-action-button delete yeu-cau-work-employee-remove";
                        removeButton.setAttribute("data-work-employee-remove", "");
                        removeButton.setAttribute("aria-label", `Xóa nhân viên ${employeeName}`);
                        removeButton.innerHTML = `<i class="fa-solid fa-xmark" aria-hidden="true"></i><span>Xóa</span>`;
                        wrapper.appendChild(removeButton);
                    }

                    employeeList.appendChild(wrapper);
                });
            };

            const renderWorkChecklists = (workItem, checklistItems) => {
                const checklistList = workItem.querySelector("[data-work-checklist-list]");
                const checklistEmpty = workItem.querySelector("[data-work-checklist-empty]");
                if (!(checklistList instanceof HTMLElement) || !(checklistEmpty instanceof HTMLElement)) {
                    return;
                }

                checklistList.innerHTML = "";
                if (!Array.isArray(checklistItems) || checklistItems.length === 0) {
                    checklistEmpty.classList.remove("is-hidden");
                    return;
                }

                checklistEmpty.classList.add("is-hidden");
                checklistItems.forEach((checklist) => {
                    const fragment = workChecklistTemplate.content.cloneNode(true);
                    const item = fragment.querySelector("[data-work-checklist-item]");
                    if (!(item instanceof HTMLElement)) {
                        return;
                    }

                    const idInput = item.querySelector("[data-work-checklist-id]");
                    const nameInput = item.querySelector("[data-work-checklist-name]");
                    const orderInput = item.querySelector("[data-work-checklist-order]");
                    const createdDateInput = item.querySelector("[data-work-checklist-created-date]");
                    const createdByInput = item.querySelector("[data-work-checklist-created-by]");
                    const finishDateInput = item.querySelector("[data-work-checklist-finish-date]");
                    const finishByInput = item.querySelector("[data-work-checklist-finish-by]");
                    const completedInput = item.querySelector("[data-work-checklist-completed]");
                    const title = item.querySelector("[data-work-checklist-title]");

                    if (idInput instanceof HTMLInputElement) {
                        idInput.value = `${checklist.checklistId ?? checklist.ChecklistId ?? ""}`;
                    }
                    if (nameInput instanceof HTMLInputElement) {
                        nameInput.value = checklist.tenChecklist ?? checklist.TenChecklist ?? "";
                    }
                    if (orderInput instanceof HTMLInputElement) {
                        orderInput.value = `${checklist.viTri ?? checklist.ViTri ?? 0}`;
                    }
                    if (createdDateInput instanceof HTMLInputElement) {
                        createdDateInput.value = checklist.createdDate || "";
                    }
                    if (createdByInput instanceof HTMLInputElement) {
                        createdByInput.value = checklist.createdBy || "";
                    }
                    if (finishDateInput instanceof HTMLInputElement) {
                        finishDateInput.value = checklist.finishDate || checklist.createdDate || "";
                    }
                    if (finishByInput instanceof HTMLInputElement) {
                        finishByInput.value = checklist.finishBy || checklist.createdBy || "";
                    }
                    if (completedInput instanceof HTMLInputElement) {
                        completedInput.checked = Boolean(checklist.isCompleted);
                    }
                    if (title instanceof HTMLElement) {
                        title.textContent = checklist.tenChecklist ?? checklist.TenChecklist ?? "Checklist";
                    }

                    checklistList.appendChild(fragment);
                    bindWorkChecklistItem(item);
                });
            };

            const getWorkIdFromItem = (workItem) => {
                const select = workItem.querySelector("[data-work-option-select]");
                const idInput = workItem.querySelector("[data-work-id]");
                const rawValue = select instanceof HTMLSelectElement && select.value
                    ? select.value
                    : idInput instanceof HTMLInputElement
                        ? idInput.value
                        : "";
                const parsed = Number.parseInt(rawValue, 10);
                return Number.isFinite(parsed) && parsed > 0 ? parsed : 0;
            };

            const addChecklistToWork = async (workItem) => {
                if (!workChecklistAddUrl) {
                    return;
                }

                const input = workItem.querySelector("[data-work-checklist-add-input]");
                const button = workItem.querySelector("[data-work-checklist-add]");
                if (!(input instanceof HTMLInputElement)) {
                    return;
                }

                const checklistName = input.value.trim();
                if (!checklistName) {
                    input.focus();
                    return;
                }

                const workId = getWorkIdFromItem(workItem);
                if (workId <= 0) {
                    window.alert("Vui long chon cong viec truoc khi them checklist.");
                    return;
                }

                const token = root.querySelector("input[name='__RequestVerificationToken']");
                const payload = new FormData();
                payload.append("CongViecId", `${workId}`);
                payload.append("TenChecklist", checklistName);

                if (button instanceof HTMLButtonElement) {
                    button.disabled = true;
                }

                try {
                    const response = await fetch(workChecklistAddUrl, {
                        method: "POST",
                        headers: token instanceof HTMLInputElement ? { RequestVerificationToken: token.value } : {},
                        body: payload
                    });
                    const result = await response.json().catch(() => ({}));
                    if (!response.ok || !result.succeeded || !result.checklist) {
                        throw new Error(result.message || "Khong the them checklist cong viec.");
                    }

                    const option = findWorkOption(workId);
                    if (option) {
                        option.checklists = Array.isArray(option.checklists) ? option.checklists : [];
                        option.checklists.push(result.checklist);
                    }

                    const currentItems = Array.from(workItem.querySelectorAll("[data-work-checklist-item]")).map((item) => {
                        const idInput = item.querySelector("[data-work-checklist-id]");
                        const nameInput = item.querySelector("[data-work-checklist-name]");
                        const orderInput = item.querySelector("[data-work-checklist-order]");
                        const completedInput = item.querySelector("[data-work-checklist-completed]");
                        return {
                            checklistId: idInput instanceof HTMLInputElement ? Number.parseInt(idInput.value, 10) : 0,
                            tenChecklist: nameInput instanceof HTMLInputElement ? nameInput.value : "",
                            viTri: orderInput instanceof HTMLInputElement ? Number.parseInt(orderInput.value, 10) : 0,
                            isCompleted: completedInput instanceof HTMLInputElement && completedInput.checked
                        };
                    });
                    currentItems.push(result.checklist);
                    renderWorkChecklists(workItem, currentItems);
                    updateWorkIndexes();
                    input.value = "";
                    input.focus();
                } catch (error) {
                    window.alert(error instanceof Error ? error.message : "Khong the them checklist cong viec.");
                } finally {
                    if (button instanceof HTMLButtonElement) {
                        button.disabled = false;
                    }
                }
            };

            const applyWorkOption = (workItem, workId, options = {}) => {
                const shouldRefreshDetails = options.refreshDetails !== false;
                const option = findWorkOption(workId);
                const title = workItem.querySelector("[data-work-title]");
                const nameInput = workItem.querySelector("[data-work-name]");
                const select = workItem.querySelector("[data-work-option-select]");

                if (select instanceof HTMLSelectElement) {
                    select.value = workId ? `${workId}` : "";
                }
                if (title instanceof HTMLElement) {
                    title.textContent = option?.tenCongViec || "Công việc";
                }
                if (nameInput instanceof HTMLInputElement) {
                    nameInput.value = option?.tenCongViec || "";
                }
                syncWorkImageRequirements(workItem, option);

                if (!shouldRefreshDetails) {
                    return;
                }

                const previousEmployees = workId ? findPreviousWorkEmployees(workItem, workId) : [];
                renderWorkChecklists(workItem, option?.checklists || []);
                renderWorkEmployees(workItem, previousEmployees);
            };

            const syncWorkImageCounts = (workItem) => {
                workItem.querySelectorAll("[data-work-image-group]").forEach((group) => {
                    if (!(group instanceof HTMLElement)) {
                        return;
                    }

                    const requiredCount = Number.parseInt(group.dataset.requiredCount || "0", 10);
                    const countNode = group.querySelector("[data-work-image-count]");
                    const imageCount = group.querySelectorAll("[data-work-image-list] [data-checkin-image-open]").length;
                    if (!(countNode instanceof HTMLElement)) {
                        return;
                    }

                    if (!Number.isFinite(requiredCount) || requiredCount <= 0) {
                        countNode.hidden = true;
                        countNode.textContent = "";
                        countNode.classList.remove("is-missing", "is-complete");
                        group.classList.remove("is-missing", "is-complete");
                        return;
                    }

                    const isComplete = imageCount >= requiredCount;
                    countNode.hidden = false;
                    countNode.textContent = `${imageCount} / ${requiredCount}`;
                    countNode.classList.toggle("is-missing", !isComplete);
                    countNode.classList.toggle("is-complete", isComplete);
                    group.classList.toggle("is-missing", !isComplete);
                    group.classList.toggle("is-complete", isComplete);
                });
            };

            const syncWorkImageRequirements = (workItem, option) => {
                const requirements = {
                    CheckIn: Number(option?.soLuongAnhCheckIn ?? 0),
                    CheckOut: Number(option?.soLuongAnhCheckOut ?? 0)
                };

                workItem.querySelectorAll("[data-work-image-group]").forEach((group) => {
                    if (!(group instanceof HTMLElement)) {
                        return;
                    }

                    const imageType = group.dataset.imageType === "CheckOut" ? "CheckOut" : "CheckIn";
                    group.dataset.requiredCount = `${Math.max(0, requirements[imageType] || 0)}`;
                });
                syncWorkImageCounts(workItem);
            };

            const appendWorkImageThumb = (group, imagePath, title, imageId = 0, canDelete = false) => {
                const list = group.querySelector("[data-work-image-list]");
                if (!(list instanceof HTMLElement) || !imagePath) {
                    return;
                }

                const wrapper = document.createElement("span");
                wrapper.className = "yeu-cau-work-image-item";
                wrapper.setAttribute("data-work-image-item", "");
                if (Number.isFinite(Number(imageId)) && Number(imageId) > 0) {
                    wrapper.dataset.workImageId = `${imageId}`;
                }

                const button = document.createElement("button");
                button.type = "button";
                button.className = "yeu-cau-work-image-thumb";
                button.setAttribute("data-checkin-image-open", "");
                button.dataset.checkinImage = imagePath;
                button.dataset.checkinEmployee = title || "Ảnh công việc";
                button.dataset.checkinAddress = group.dataset.imageType === "CheckOut" ? "Ảnh sau thực hiện" : "Ảnh trước thực hiện";
                button.innerHTML = `<img src="${imagePath}" alt="${button.dataset.checkinAddress || "Ảnh công việc"}" />`;
                button.addEventListener("click", () => openCheckinImageModal(button));
                wrapper.appendChild(button);

                if (canDelete && Number.isFinite(Number(imageId)) && Number(imageId) > 0) {
                    const deleteButton = document.createElement("button");
                    deleteButton.type = "button";
                    deleteButton.className = "table-action-button delete yeu-cau-work-image-delete";
                    deleteButton.setAttribute("data-work-image-delete", "");
                    deleteButton.setAttribute("aria-label", "Xoa anh");
                    deleteButton.innerHTML = `<i class="fa-solid fa-trash" aria-hidden="true"></i><span>Xoa</span>`;
                    wrapper.appendChild(deleteButton);
                }

                list.appendChild(wrapper);
            };

            const deleteWorkImage = async (button) => {
                if (!workImageDeleteUrl || !(button instanceof HTMLButtonElement)) {
                    return;
                }

                const item = button.closest("[data-work-image-item]");
                const group = button.closest("[data-work-image-group]");
                const workItem = button.closest("[data-work-item]");
                const imageId = Number.parseInt(item?.dataset.workImageId || "", 10);
                if (!(item instanceof HTMLElement) || !Number.isFinite(imageId) || imageId <= 0) {
                    return;
                }

                const token = root.querySelector("input[name='__RequestVerificationToken']");
                const payload = new FormData();
                payload.append("ImageId", `${imageId}`);

                button.disabled = true;
                try {
                    const response = await fetch(workImageDeleteUrl, {
                        method: "POST",
                        headers: token instanceof HTMLInputElement ? { RequestVerificationToken: token.value } : {},
                        body: payload
                    });
                    const result = await response.json().catch(() => ({}));
                    if (!response.ok || !result.succeeded) {
                        throw new Error(result.message || "Khong the xoa anh cong viec.");
                    }

                    item.remove();
                    if (workItem instanceof HTMLElement) {
                        syncWorkImageCounts(workItem);
                    } else if (group instanceof HTMLElement) {
                        const ownerWorkItem = group.closest("[data-work-item]");
                        if (ownerWorkItem instanceof HTMLElement) {
                            syncWorkImageCounts(ownerWorkItem);
                        }
                    }
                } catch (error) {
                    window.alert(error instanceof Error ? error.message : "Khong the xoa anh cong viec.");
                    button.disabled = false;
                }
            };

            const uploadWorkImage = async (workItem, group, file) => {
                if (!workImageUrl || !(file instanceof File)) {
                    return false;
                }

                if (isValidWorkCompletion(workItem)) {
                    window.alert("Công việc đã hoàn thành nên không thể thêm hình ảnh.");
                    return false;
                }

                const workIdInput = workItem.querySelector("[data-work-id]");
                const workId = workIdInput instanceof HTMLInputElement ? Number.parseInt(workIdInput.value, 10) : Number.NaN;
                if (!Number.isFinite(workId) || workId <= 0) {
                    window.alert("Vui lòng lưu yêu cầu trước khi lưu ảnh công việc.");
                    return false;
                }

                const token = root.querySelector("input[name='__RequestVerificationToken']");
                const payload = new FormData();
                payload.append("IDCongViec", `${workId}`);
                payload.append("ImageType", group.dataset.imageType === "CheckOut" ? "CheckOut" : "CheckIn");
                payload.append("imageFile", file);

                group.classList.add("is-uploading");
                try {
                    const response = await fetch(workImageUrl, {
                        method: "POST",
                        headers: token instanceof HTMLInputElement ? { RequestVerificationToken: token.value } : {},
                        body: payload
                    });
                    const result = await response.json().catch(() => ({}));
                    if (!response.ok || !result.succeeded) {
                        throw new Error(result.message || "Không thể lưu ảnh công việc.");
                    }

                    const title = workItem.querySelector("[data-work-title]");
                    appendWorkImageThumb(
                        group,
                        result.imagePath || "",
                        title instanceof HTMLElement ? title.textContent?.trim() : "",
                        Number.parseInt(`${result.id || 0}`, 10),
                        Boolean(result.canDelete));
                    syncWorkImageCounts(workItem);
                    return true;
                } catch (error) {
                    window.alert(error instanceof Error ? error.message : "Không thể lưu ảnh công việc.");
                    return false;
                } finally {
                    group.classList.remove("is-uploading");
                }
            };

            const setWorkCameraStatus = (message, type = "info") => {
                if (!(workCameraStatus instanceof HTMLElement)) {
                    return;
                }

                workCameraStatus.textContent = message;
                workCameraStatus.className = `page-alert ${type} yeu-cau-checkin-status`;
                workCameraStatus.hidden = !message;
            };

            const syncWorkCameraCount = () => {
                if (!(activeWorkCamera?.workItem instanceof HTMLElement) ||
                    !(activeWorkCamera?.group instanceof HTMLElement) ||
                    !(workCameraCount instanceof HTMLElement)) {
                    return;
                }

                const requiredCount = Number.parseInt(activeWorkCamera.group.dataset.requiredCount || "0", 10);
                const imageCount = activeWorkCamera.group.querySelectorAll("[data-work-image-list] [data-checkin-image-open]").length;
                if (!Number.isFinite(requiredCount) || requiredCount <= 0) {
                    workCameraCount.hidden = true;
                    workCameraCount.textContent = "";
                    workCameraCount.classList.remove("is-missing", "is-complete");
                    return;
                }

                workCameraCount.hidden = false;
                workCameraCount.textContent = `${imageCount} / ${requiredCount}`;
                workCameraCount.classList.toggle("is-missing", imageCount < requiredCount);
                workCameraCount.classList.toggle("is-complete", imageCount >= requiredCount);
            };

            const stopWorkCamera = () => {
                if (workCameraStream) {
                    workCameraStream.getTracks().forEach((track) => track.stop());
                    workCameraStream = null;
                }

                if (workCameraVideo instanceof HTMLVideoElement) {
                    workCameraVideo.pause();
                    workCameraVideo.srcObject = null;
                    workCameraVideo.hidden = true;
                }
            };

            const resetWorkCameraPhoto = async (restartCamera = false) => {
                workCameraBlob = null;
                if (workCameraPreview instanceof HTMLImageElement) {
                    workCameraPreview.hidden = true;
                    workCameraPreview.removeAttribute("src");
                }
                if (workCameraPlaceholder instanceof HTMLElement) {
                    workCameraPlaceholder.hidden = false;
                }
                if (workCameraDiscardButton instanceof HTMLButtonElement) {
                    workCameraDiscardButton.disabled = true;
                }
                if (workCameraSaveButton instanceof HTMLButtonElement) {
                    workCameraSaveButton.disabled = true;
                }
                if (workCameraCaptureButton instanceof HTMLButtonElement) {
                    workCameraCaptureButton.disabled = false;
                }

                if (restartCamera) {
                    await startWorkCamera();
                }
            };

            const startWorkCamera = async () => {
                if (!(workCameraVideo instanceof HTMLVideoElement) || !navigator.mediaDevices?.getUserMedia) {
                    setWorkCameraStatus("Trinh duyet khong ho tro camera.", "error");
                    return;
                }

                stopWorkCamera();
                workCameraStream = await navigator.mediaDevices.getUserMedia({
                    video: buildCameraConstraints(selectedWorkCameraId),
                    audio: false
                });
                workCameraVideo.srcObject = workCameraStream;
                workCameraVideo.hidden = false;
                await workCameraVideo.play();
                await loadCameraDevices();
            };

            const openWorkCameraModal = async (workItem, group) => {
                if (!(workCameraShell instanceof HTMLElement)) {
                    return;
                }

                if (isValidWorkCompletion(workItem)) {
                    window.alert("Công việc đã hoàn thành nên không thể chụp ảnh.");
                    return;
                }

                const workIdInput = workItem.querySelector("[data-work-id]");
                const workId = workIdInput instanceof HTMLInputElement ? Number.parseInt(workIdInput.value, 10) : Number.NaN;
                if (!Number.isFinite(workId) || workId <= 0) {
                    window.alert("Vui lòng lưu yêu cầu trước khi chụp ảnh công việc.");
                    return;
                }

                activeWorkCamera = { workItem, group };
                const title = workItem.querySelector("[data-work-title]");
                const imageTypeText = group.dataset.imageType === "CheckOut" ? "sau thực hiện" : "trước thực hiện";
                if (workCameraTitle instanceof HTMLElement) {
                    workCameraTitle.textContent = `Chụp ảnh ${imageTypeText} - ${title instanceof HTMLElement ? title.textContent?.trim() || "Công việc" : "Công việc"}`;
                }

                setWorkCameraStatus("", "info");
                await resetWorkCameraPhoto(false);
                syncWorkCameraCount();
                workCameraShell.hidden = false;
                try {
                    await startWorkCamera();
                } catch {
                    setWorkCameraStatus("Khong the bat camera. Vui long cap quyen camera hoac dung upload anh.", "error");
                }
            };

            const closeWorkCameraModal = () => {
                if (workCameraShell instanceof HTMLElement) {
                    workCameraShell.hidden = true;
                }
                stopWorkCamera();
                activeWorkCamera = null;
                workCameraBlob = null;
            };

            const captureWorkCameraPhoto = async () => {
                if (!(workCameraVideo instanceof HTMLVideoElement) ||
                    !(workCameraCanvas instanceof HTMLCanvasElement)) {
                    return;
                }

                const width = workCameraVideo.videoWidth;
                const height = workCameraVideo.videoHeight;
                if (!width || !height) {
                    setWorkCameraStatus("Camera chua san sang, vui long thu lai.", "warning");
                    return;
                }

                workCameraCanvas.width = width;
                workCameraCanvas.height = height;
                const context = workCameraCanvas.getContext("2d");
                if (!context) {
                    return;
                }

                context.drawImage(workCameraVideo, 0, 0, width, height);
                workCameraBlob = await new Promise((resolve) => workCameraCanvas.toBlob(resolve, "image/jpeg", 0.88));
                if (!workCameraBlob) {
                    setWorkCameraStatus("Khong tao duoc anh tu camera.", "error");
                    return;
                }

                if (workCameraPreview instanceof HTMLImageElement) {
                    workCameraPreview.src = workCameraCanvas.toDataURL("image/jpeg", 0.88);
                    workCameraPreview.hidden = false;
                }
                if (workCameraPlaceholder instanceof HTMLElement) {
                    workCameraPlaceholder.hidden = true;
                }
                if (workCameraSaveButton instanceof HTMLButtonElement) {
                    workCameraSaveButton.disabled = false;
                }
                if (workCameraDiscardButton instanceof HTMLButtonElement) {
                    workCameraDiscardButton.disabled = false;
                }
                if (workCameraCaptureButton instanceof HTMLButtonElement) {
                    workCameraCaptureButton.disabled = true;
                }
                workCameraVideo.pause();
                setWorkCameraStatus("Ảnh đã chụp, bấm Lưu ảnh nếu đạt yêu cầu.", "success");
            };

            const saveWorkCameraPhoto = async () => {
                if (!(activeWorkCamera?.workItem instanceof HTMLElement) ||
                    !(activeWorkCamera?.group instanceof HTMLElement) ||
                    !workCameraBlob) {
                    return;
                }

                const imageType = activeWorkCamera.group.dataset.imageType === "CheckOut" ? "checkout" : "checkin";
                const file = new File([workCameraBlob], `${imageType}-${Date.now()}.jpg`, { type: "image/jpeg" });
                if (workCameraSaveButton instanceof HTMLButtonElement) {
                    workCameraSaveButton.disabled = true;
                }
                setWorkCameraStatus("Đang lưu ảnh...", "info");
                const saved = await uploadWorkImage(activeWorkCamera.workItem, activeWorkCamera.group, file);
                if (!saved) {
                    setWorkCameraStatus("Chưa lưu được ảnh, vui lòng thử lại.", "error");
                    if (workCameraSaveButton instanceof HTMLButtonElement) {
                        workCameraSaveButton.disabled = false;
                    }
                    return;
                }
                syncWorkCameraCount();
                setWorkCameraStatus("Đã lưu ảnh. Có thể chụp ảnh tiếp theo.", "success");
                await resetWorkCameraPhoto(true);
            };

            const bindWorkImageGroup = (workItem, group) => {
                const uploadButton = group.querySelector("[data-work-image-upload]");
                const cameraButton = group.querySelector("[data-work-image-camera]");
                const uploadInput = group.querySelector("[data-work-image-file]");
                const cameraInput = group.querySelector("[data-work-image-camera-file]");
                const imageList = group.querySelector("[data-work-image-list]");

                if (uploadButton instanceof HTMLButtonElement && uploadInput instanceof HTMLInputElement) {
                    uploadButton.addEventListener("click", () => {
                        if (isValidWorkCompletion(workItem)) {
                            window.alert("Công việc đã hoàn thành nên không thể upload hình ảnh.");
                            return;
                        }

                        uploadInput.click();
                    });
                    uploadInput.addEventListener("change", () => {
                        const file = uploadInput.files?.[0] || null;
                        uploadInput.value = "";
                        if (file) {
                            void uploadWorkImage(workItem, group, file);
                        }
                    });
                }

                if (cameraButton instanceof HTMLButtonElement && cameraInput instanceof HTMLInputElement) {
                    cameraButton.addEventListener("click", () => {
                        if (isValidWorkCompletion(workItem)) {
                            window.alert("Công việc đã hoàn thành nên không thể chụp ảnh.");
                            return;
                        }

                        void openWorkCameraModal(workItem, group);
                    });
                    cameraInput.addEventListener("change", () => {
                        const file = cameraInput.files?.[0] || null;
                        cameraInput.value = "";
                        if (file) {
                            void uploadWorkImage(workItem, group, file);
                        }
                    });
                }

                if (imageList instanceof HTMLElement && !imageList.dataset.deleteBound) {
                    imageList.dataset.deleteBound = "true";
                    imageList.addEventListener("click", (event) => {
                        const target = event.target instanceof HTMLElement
                            ? event.target.closest("[data-work-image-delete]")
                            : null;
                        if (!(target instanceof HTMLButtonElement)) {
                            return;
                        }

                        event.preventDefault();
                        event.stopPropagation();
                        void deleteWorkImage(target);
                    });
                }
            };

            const bindWorkItem = (workItem) => {
                const toggle = workItem.querySelector("[data-work-toggle]");
                const body = workItem.querySelector("[data-work-body]");
                const icon = workItem.querySelector("[data-work-toggle-icon]");
                const removeButton = workItem.querySelector("[data-work-remove]");
                const employeeAddButton = workItem.querySelector("[data-work-employee-add]");
                const employeeList = workItem.querySelector("[data-work-employee-list]");
                const workSelect = workItem.querySelector("[data-work-option-select]");
                const workIdInput = workItem.querySelector("[data-work-id]");
                const statusSelect = workItem.querySelector("[data-work-status-select]");
                const checklistAddButton = workItem.querySelector("[data-work-checklist-add]");
                const checklistAddInput = workItem.querySelector("[data-work-checklist-add-input]");

                if (toggle instanceof HTMLButtonElement && body instanceof HTMLElement) {
                    toggle.addEventListener("click", (event) => {
                        if ((event.target instanceof HTMLElement) && event.target.closest("[data-work-remove]")) {
                            return;
                        }

                        const isCollapsed = workItem.classList.contains("is-collapsed");
                        workItem.classList.toggle("is-collapsed", !isCollapsed);
                        body.hidden = !body.hidden;
                        toggle.setAttribute("aria-expanded", isCollapsed ? "true" : "false");
                        if (icon instanceof HTMLElement) {
                            icon.className = isCollapsed ? "fa-solid fa-chevron-up" : "fa-solid fa-chevron-down";
                        }
                    });
                }

                if (removeButton instanceof HTMLButtonElement) {
                    removeButton.addEventListener("click", (event) => {
                        event.stopPropagation();
                        if (isValidWorkCompletion(workItem)) {
                            return;
                        }

                        workItem.remove();
                        updateWorkIndexes();
                        syncWorkEmptyState();
                        syncWorkProgress();
                    });
                }

                if (employeeAddButton instanceof HTMLButtonElement) {
                    employeeAddButton.addEventListener("click", () => {
                        if (isValidWorkCompletion(workItem)) {
                            return;
                        }

                        activeEmployeeWorkItem = workItem;
                        openLinkedEmployeePicker();
                    });
                }

                if (employeeList instanceof HTMLElement) {
                    employeeList.addEventListener("click", (event) => {
                        const target = event.target instanceof HTMLElement
                            ? event.target.closest("[data-work-employee-remove]")
                            : null;
                        if (!(target instanceof HTMLButtonElement)) {
                            return;
                        }

                        event.preventDefault();
                        event.stopPropagation();
                        if (isValidWorkCompletion(workItem)) {
                            return;
                        }

                        target.closest("[data-work-employee-choice]")?.remove();
                        renderWorkEmployees(workItem);
                        updateWorkIndexes();
                    });
                }

                if (workSelect instanceof HTMLSelectElement) {
                    workSelect.addEventListener("change", () => {
                        applyWorkOption(workItem, Number.parseInt(workSelect.value, 10));
                        updateWorkIndexes();
                        const overlapResult = findWorkOverlapMessage();
                        if (overlapResult) {
                            setActiveTab("cong-viec");
                            showWorkOverlapWarning(overlapResult);
                        }
                    });
                }

                if (statusSelect instanceof HTMLSelectElement) {
                    statusSelect.addEventListener("change", () => {
                        syncWorkCompletionState(workItem);
                        syncWorkProgress();
                    });
                }

                if (checklistAddButton instanceof HTMLButtonElement) {
                    checklistAddButton.addEventListener("click", () => {
                        void addChecklistToWork(workItem);
                    });
                }

                if (checklistAddInput instanceof HTMLInputElement) {
                    checklistAddInput.addEventListener("keydown", (event) => {
                        if (event.key !== "Enter") {
                            return;
                        }

                        event.preventDefault();
                        void addChecklistToWork(workItem);
                    });
                }

                const checkInField = workItem.querySelector("input[type='datetime-local'][name*='CheckInTime'], [data-work-checkin]");
                const checkOutField = workItem.querySelector("input[type='datetime-local'][name*='CheckOutTime'], [data-work-checkout]");
                if (checkInField instanceof HTMLInputElement && checkOutField instanceof HTMLInputElement && checkInField.value) {
                    checkOutField.min = checkInField.value;
                }
                [checkInField, checkOutField].forEach((field) => {
                    if (field instanceof HTMLInputElement) {
                        field.addEventListener("change", () => {
                            if (checkInField instanceof HTMLInputElement && checkOutField instanceof HTMLInputElement) {
                                checkOutField.min = checkInField.value || "";
                            }
                            syncWorkCompletionState(workItem);
                            syncWorkProgress();
                            const timeRangeResult = findWorkTimeRangeMessage();
                            if (timeRangeResult) {
                                setActiveTab("cong-viec");
                                showWorkOverlapWarning(timeRangeResult);
                                return;
                            }
                            const overlapResult = findWorkOverlapMessage();
                            if (overlapResult) {
                                setActiveTab("cong-viec");
                                showWorkOverlapWarning(overlapResult);
                            }
                        });
                    }
                });
                workItem.querySelectorAll("[data-work-checklist-item]").forEach((item) => {
                    if (item instanceof HTMLElement) {
                        bindWorkChecklistItem(item);
                    }
                });

                workItem.querySelectorAll("[data-work-image-group]").forEach((group) => {
                    if (group instanceof HTMLElement) {
                        bindWorkImageGroup(workItem, group);
                    }
                });

                const existingWorkId = workSelect instanceof HTMLSelectElement
                    ? Number.parseInt(workSelect.value, 10)
                    : workIdInput instanceof HTMLInputElement
                        ? Number.parseInt(workIdInput.value, 10)
                        : Number.NaN;
                if (Number.isFinite(existingWorkId) && existingWorkId > 0) {
                    applyWorkOption(workItem, existingWorkId, { refreshDetails: false });
                } else {
                    renderWorkEmployees(workItem);
                }

                syncWorkCompletionState(workItem);
            };

            const createWorkItem = () => {
                const fragment = workTemplate.content.cloneNode(true);
                const workItem = fragment.querySelector("[data-work-item]");
                if (!(workItem instanceof HTMLElement)) {
                    return null;
                }

                workList.appendChild(fragment);
                bindWorkItem(workItem);
                updateWorkIndexes();
                syncWorkEmptyState();
                return workItem;
            };

            const getCurrentCongViecIds = () => new Set(getWorkItems()
                .map((workItem) => {
                    const select = workItem.querySelector("[data-work-option-select]");
                    const parsed = select instanceof HTMLSelectElement
                        ? Number.parseInt(select.value, 10)
                        : Number.NaN;
                    return Number.isFinite(parsed) && parsed > 0 ? `${parsed}` : "";
                })
                .filter(Boolean));

            const setServiceTemplateStatus = (message, type = "info") => {
                if (!(serviceTemplateStatus instanceof HTMLElement)) {
                    return;
                }

                serviceTemplateStatus.className = `yeu-cau-service-template-status ${type}`;
                serviceTemplateStatus.innerHTML = `<span>${message}</span>`;
            };

            const mergeServiceWorks = async () => {
                if (!(serviceTemplateSelect instanceof HTMLSelectElement) || !serviceWorksUrl) {
                    return;
                }

                const serviceId = Number.parseInt(serviceTemplateSelect.value || "", 10);
                if (!Number.isFinite(serviceId) || serviceId <= 0) {
                    setServiceTemplateStatus("Chọn dịch vụ để nạp nhanh nhóm công việc vào phiếu.");
                    return;
                }

                serviceTemplateSelect.disabled = true;
                setServiceTemplateStatus("Đang nạp công việc từ dịch vụ...", "info");
                try {
                    const url = new URL(serviceWorksUrl, window.location.origin);
                    url.searchParams.set("id", `${serviceId}`);
                    const response = await fetch(url.toString(), {
                        headers: { Accept: "application/json" }
                    });
                    const result = await response.json().catch(() => ({}));
                    if (!response.ok || !Array.isArray(result.works)) {
                        throw new Error(result.message || "Không thể nạp công việc từ dịch vụ.");
                    }

                    const currentIds = getCurrentCongViecIds();
                    let addedCount = 0;
                    let duplicateCount = 0;
                    result.works.forEach((work) => {
                        const workId = Number.parseInt(`${work.idCongViec ?? work.id ?? ""}`, 10);
                        if (!Number.isFinite(workId) || workId <= 0) {
                            return;
                        }

                        if (currentIds.has(`${workId}`)) {
                            duplicateCount++;
                            return;
                        }

                        if (!findWorkOption(workId)) {
                            workOptions.push({
                                id: workId,
                                tenCongViec: work.tenCongViec || `Công việc #${workId}`,
                                soLuongAnhCheckIn: Number(work.soLuongAnhCheckIn || 0),
                                soLuongAnhCheckOut: Number(work.soLuongAnhCheckOut || 0),
                                checklists: Array.isArray(work.checklists) ? work.checklists : []
                            });
                        }

                        const workItem = createWorkItem();
                        if (!(workItem instanceof HTMLElement)) {
                            return;
                        }

                        setWorkStartTimeNow(workItem);
                        applyWorkOption(workItem, workId);
                        currentIds.add(`${workId}`);
                        addedCount++;
                    });

                    updateWorkIndexes();
                    syncWorkEmptyState();
                    syncWorkProgress();
                    setActiveTab("cong-viec");
                    setServiceTemplateStatus(
                        `Đã thêm ${addedCount} công việc từ dịch vụ. ${duplicateCount} công việc đã có trong phiếu.`,
                        "success");
                } catch (error) {
                    setServiceTemplateStatus(error instanceof Error ? error.message : "Không thể nạp công việc từ dịch vụ.", "error");
                } finally {
                    serviceTemplateSelect.disabled = false;
                }
            };

            const updateWorkIndexes = () => {
                getWorkItems().forEach((workItem, workIndex) => {
                    const workIdInput = workItem.querySelector("[data-work-id]");
                    const workNameInput = workItem.querySelector("[data-work-name]");
                    const workSelect = workItem.querySelector("[data-work-option-select]");
                    const statusSelect = workItem.querySelector("[data-work-status-select]");
                    const noteInput = workItem.querySelector("[data-work-note]");
                    const checkInInput = workItem.querySelector("input[type='datetime-local'][name*='CheckInTime'], [data-work-checkin]");
                    const checkOutInput = workItem.querySelector("input[type='datetime-local'][name*='CheckOutTime'], [data-work-checkout]");

                    if (workIdInput instanceof HTMLInputElement) {
                        workIdInput.name = `Form.CongViecs[${workIndex}].YeuCauCongViecId`;
                    }
                    if (workNameInput instanceof HTMLInputElement) {
                        workNameInput.name = `Form.CongViecs[${workIndex}].TenCongViec`;
                    }
                    if (workSelect instanceof HTMLSelectElement) {
                        workSelect.name = `Form.CongViecs[${workIndex}].CongViecId`;
                    }
                    if (statusSelect instanceof HTMLSelectElement) {
                        statusSelect.name = `Form.CongViecs[${workIndex}].TrangThaiCongViec`;
                    }
                    if (noteInput instanceof HTMLTextAreaElement) {
                        noteInput.name = `Form.CongViecs[${workIndex}].GhiChu`;
                    }
                    if (checkInInput instanceof HTMLInputElement) {
                        checkInInput.name = `Form.CongViecs[${workIndex}].CheckInTime`;
                    }
                    if (checkOutInput instanceof HTMLInputElement) {
                        checkOutInput.name = `Form.CongViecs[${workIndex}].CheckOutTime`;
                    }

                    Array.from(workItem.querySelectorAll("[data-work-employee-choice]")).forEach((choice, employeeIndex) => {
                        const idInput = choice.querySelector("[data-work-employee-id]");
                        const checkbox = choice.querySelector("[data-work-employee-checkbox]");
                        const nameInput = choice.querySelector("[data-work-employee-name]");
                        const roleInput = choice.querySelector("[data-work-employee-role]");
                        const avatarInput = choice.querySelector("[data-work-employee-avatar]");

                        if (idInput instanceof HTMLInputElement) {
                            idInput.name = `Form.CongViecs[${workIndex}].NhanViens[${employeeIndex}].NhanVienId`;
                        }
                        if (checkbox instanceof HTMLInputElement) {
                            checkbox.removeAttribute("name");
                        }
                        if (nameInput instanceof HTMLInputElement) {
                            nameInput.name = `Form.CongViecs[${workIndex}].NhanViens[${employeeIndex}].HoTen`;
                        }
                        if (roleInput instanceof HTMLInputElement) {
                            roleInput.name = `Form.CongViecs[${workIndex}].NhanViens[${employeeIndex}].ChucVu`;
                        }
                        if (avatarInput instanceof HTMLInputElement) {
                            avatarInput.name = `Form.CongViecs[${workIndex}].NhanViens[${employeeIndex}].Avatar`;
                        }
                    });

                    Array.from(workItem.querySelectorAll("[data-work-checklist-item]")).forEach((item, checklistIndex) => {
                        const idInput = item.querySelector("[data-work-checklist-id]");
                        const nameInput = item.querySelector("[data-work-checklist-name]");
                        const orderInput = item.querySelector("[data-work-checklist-order]");
                        const createdDateInput = item.querySelector("[data-work-checklist-created-date]");
                        const createdByInput = item.querySelector("[data-work-checklist-created-by]");
                        const finishDateInput = item.querySelector("[data-work-checklist-finish-date]");
                        const finishByInput = item.querySelector("[data-work-checklist-finish-by]");
                        const completedInput = item.querySelector("[data-work-checklist-completed]");

                        if (idInput instanceof HTMLInputElement) {
                            idInput.name = `Form.CongViecs[${workIndex}].Checklists[${checklistIndex}].ChecklistId`;
                        }
                        if (nameInput instanceof HTMLInputElement) {
                            nameInput.name = `Form.CongViecs[${workIndex}].Checklists[${checklistIndex}].TenChecklist`;
                        }
                        if (orderInput instanceof HTMLInputElement) {
                            orderInput.name = `Form.CongViecs[${workIndex}].Checklists[${checklistIndex}].ViTri`;
                        }
                        if (createdDateInput instanceof HTMLInputElement) {
                            createdDateInput.name = `Form.CongViecs[${workIndex}].Checklists[${checklistIndex}].CreatedDate`;
                        }
                        if (createdByInput instanceof HTMLInputElement) {
                            createdByInput.name = `Form.CongViecs[${workIndex}].Checklists[${checklistIndex}].CreatedBy`;
                        }
                        if (finishDateInput instanceof HTMLInputElement) {
                            finishDateInput.name = `Form.CongViecs[${workIndex}].Checklists[${checklistIndex}].FinishDate`;
                        }
                        if (finishByInput instanceof HTMLInputElement) {
                            finishByInput.name = `Form.CongViecs[${workIndex}].Checklists[${checklistIndex}].FinishBy`;
                        }
                        if (completedInput instanceof HTMLInputElement) {
                            completedInput.name = `Form.CongViecs[${workIndex}].Checklists[${checklistIndex}].IsCompleted`;
                        }
                    });
                });
            };

            const syncWorkEmployeesJson = () => {
                const payload = getWorkItems().map((workItem, workIndex) => {
                    const workIdInput = workItem.querySelector("[data-work-id]");
                    const workSelect = workItem.querySelector("[data-work-option-select]");
                    const workId = workIdInput instanceof HTMLInputElement
                        ? Number.parseInt(workIdInput.value, 10)
                        : Number.NaN;
                    const congViecId = workSelect instanceof HTMLSelectElement
                        ? Number.parseInt(workSelect.value, 10)
                        : Number.NaN;

                    return {
                        workIndex,
                        yeuCauCongViecId: Number.isFinite(workId) && workId > 0 ? workId : null,
                        congViecId: Number.isFinite(congViecId) && congViecId > 0 ? congViecId : null,
                        employeeIds: getWorkEmployeeIds(workItem)
                    };
                });

                workEmployeesJsonInput.value = JSON.stringify(payload);
            };

            const clearWorkOverlapWarnings = () => {
                getWorkItems().forEach((workItem) => {
                    workItem.classList.remove("has-overlap");
                    const warning = workItem.querySelector("[data-work-overlap-warning]");
                    if (warning instanceof HTMLElement) {
                        warning.remove();
                    }
                });
            };

            const findWorkTimeRangeMessage = () => {
                clearWorkOverlapWarnings();

                const invalidIndexes = [];
                getWorkItems().forEach((workItem, index) => {
                    const checkInInput = workItem.querySelector("input[type='datetime-local'][name*='CheckInTime'], [data-work-checkin]");
                    const checkOutInput = workItem.querySelector("input[type='datetime-local'][name*='CheckOutTime'], [data-work-checkout]");
                    const start = parseWorkDate(checkInInput);
                    const end = parseWorkDate(checkOutInput);

                    if (start instanceof Date &&
                        end instanceof Date &&
                        !Number.isNaN(start.getTime()) &&
                        !Number.isNaN(end.getTime()) &&
                        end <= start) {
                        invalidIndexes.push(index);
                    }
                });

                return invalidIndexes.length === 0
                    ? null
                    : {
                        message: "Thời gian kết thúc công việc phải lớn hơn thời gian bắt đầu.",
                        indexes: invalidIndexes
                    };
            };

            const findWorkOverlapMessage = () => {
                clearWorkOverlapWarnings();

                const workStates = getWorkItems()
                    .map((workItem, index) => {
                        const workSelect = workItem.querySelector("[data-work-option-select]");
                        const checkInInput = workItem.querySelector("input[type='datetime-local'][name*='CheckInTime'], [data-work-checkin]");
                        const checkOutInput = workItem.querySelector("input[type='datetime-local'][name*='CheckOutTime'], [data-work-checkout]");
                        const title = workItem.querySelector("[data-work-title]");

                        const workId = workSelect instanceof HTMLSelectElement ? Number.parseInt(workSelect.value, 10) : Number.NaN;
                        const start = checkInInput instanceof HTMLInputElement && checkInInput.value ? new Date(checkInInput.value) : null;
                        const end = checkOutInput instanceof HTMLInputElement && checkOutInput.value ? new Date(checkOutInput.value) : null;

                        return {
                            index,
                            workId,
                            workName: title instanceof HTMLElement ? title.textContent?.trim() || "Công việc" : "Công việc",
                            start,
                            end
                        };
                    })
                    .filter((item) => Number.isFinite(item.workId) && item.workId > 0 && item.start instanceof Date && item.end instanceof Date && !Number.isNaN(item.start.getTime()) && !Number.isNaN(item.end.getTime()));

                for (let i = 0; i < workStates.length; i++) {
                    for (let j = i + 1; j < workStates.length; j++) {
                        if (workStates[i].workId !== workStates[j].workId) {
                            continue;
                        }

                        const hasOverlap = workStates[i].start < workStates[j].end && workStates[j].start < workStates[i].end;
                        if (hasOverlap) {
                            return {
                                message: `Công việc "${workStates[i].workName}" đang bị trùng khoảng thời gian thực hiện. Công việc trước phải kết thúc trước khi thêm lại.`,
                                indexes: [workStates[i].index, workStates[j].index]
                            };
                        }
                    }
                }

                return null;
            };

            const showWorkOverlapWarning = (result) => {
                if (!result || !Array.isArray(result.indexes)) {
                    return;
                }

                result.indexes.forEach((index) => {
                    const workItem = getWorkItems()[index];
                    if (!(workItem instanceof HTMLElement)) {
                        return;
                    }

                    workItem.classList.add("has-overlap");

                    const body = workItem.querySelector("[data-work-body]");
                    const toggle = workItem.querySelector("[data-work-toggle]");
                    const icon = workItem.querySelector("[data-work-toggle-icon]");
                    if (body instanceof HTMLElement) {
                        body.hidden = false;
                    }
                    workItem.classList.remove("is-collapsed");
                    if (toggle instanceof HTMLButtonElement) {
                        toggle.setAttribute("aria-expanded", "true");
                    }
                    if (icon instanceof HTMLElement) {
                        icon.className = "fa-solid fa-chevron-up";
                    }

                    const warning = document.createElement("div");
                    warning.className = "page-alert error yeu-cau-work-overlap-warning";
                    warning.setAttribute("data-work-overlap-warning", "");
                    warning.innerHTML = `
                        <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
                        <span>${result.message}</span>
                    `;
                    workItem.appendChild(warning);
                });
            };

            const syncLocationCoordinateButton = (item) => {
                if (!(locationCoordinateButton instanceof HTMLElement)) {
                    return;
                }

                const resolvedItem = item ?? {};
                const hasLocation = !!resolvedItem.idDiaDiem;
                const lat = Number.isFinite(resolvedItem.latAddress) ? resolvedItem.latAddress : null;
                const lng = Number.isFinite(resolvedItem.longAddress) ? resolvedItem.longAddress : null;
                const hasCoordinates = Number.isFinite(lat) && Number.isFinite(lng);
                locationCoordinateButton.hidden = false;
                locationCoordinateButton.classList.toggle("is-hidden", !hasLocation || hasCoordinates);
                locationCoordinateButton.disabled = false;
            };

            const updatePreview = (item) => {
                const resolvedItem = item ?? {};

                previewCustomer.textContent = resolvedItem.tenKhachHang || "Chưa chọn";
                previewAddress.textContent = resolvedItem.diaChi || "Chưa chọn";
                previewContact.textContent = resolvedItem.nguoiLienHe || "Chưa có";
                previewPhone.replaceChildren();
                if (resolvedItem.dienThoai) {
                    const phoneHref = `${resolvedItem.dienThoai}`.replace(/[^\d+]/g, "");
                    const phoneLink = document.createElement("a");
                    phoneLink.href = `tel:${phoneHref}`;
                    phoneLink.textContent = resolvedItem.dienThoai;
                    previewPhone.appendChild(phoneLink);
                } else {
                    previewPhone.textContent = "Chưa có";
                }

                const lat = Number.isFinite(resolvedItem.latAddress) ? resolvedItem.latAddress : null;
                const lng = Number.isFinite(resolvedItem.longAddress) ? resolvedItem.longAddress : null;
                previewCoordinates.textContent = Number.isFinite(lat) && Number.isFinite(lng)
                    ? `${formatCoordinate(lat)}, ${formatCoordinate(lng)}`
                    : "Chưa có tọa độ";

                previewLongInput.value = Number.isFinite(lng) ? `${lng}` : "";
                previewLatInput.value = Number.isFinite(lat) ? `${lat}` : "";

                syncLocationCoordinateButton(item);
                syncPreviewMap();
            };

            const clearSelectedLocation = () => {
                customerIdInput.value = "";
                locationIdInput.value = "";
                previewLongInput.value = "";
                previewLatInput.value = "";
                selectedLocationLabel = "";
            };

            const selectLocation = (item) => {
                locationInput.value = item.displayLabel || "";
                customerIdInput.value = item.idKhachHang || "";
                locationIdInput.value = item.idDiaDiem || "";
                selectedLocationLabel = item.displayLabel || "";
                updatePreview(item);
                clearSuggestions();
            };

            const setLocationCreateStatus = (message, type = "info") => {
                if (!(locationCreateStatus instanceof HTMLElement)) {
                    return;
                }

                locationCreateStatus.textContent = message;
                locationCreateStatus.className = `page-alert ${type} yeu-cau-checkin-status`;
                locationCreateStatus.hidden = !message;
            };

            const syncLocationCreateCustomerFields = () => {
                if (!(locationCreateCustomerSelect instanceof HTMLSelectElement) ||
                    !(locationCreateNewCustomerFields instanceof HTMLElement)) {
                    return;
                }

                const isNewCustomer = !locationCreateCustomerSelect.value;
                locationCreateNewCustomerFields.hidden = !isNewCustomer;
                if (locationCreateCustomerShell instanceof HTMLElement) {
                    locationCreateCustomerShell.classList.toggle("is-new-customer", isNewCustomer);
                }
                if (locationCreateExistingLocationFields instanceof HTMLElement) {
                    locationCreateExistingLocationFields.hidden = isNewCustomer;
                }
            };

            const resetLocationCreateForm = () => {
                if (locationCreateCustomerSelect instanceof HTMLSelectElement) {
                    locationCreateCustomerSelect.value = "";
                }

                [
                    locationCreateCustomerNameInput,
                    locationCreateCustomerPhoneInput,
                    locationCreateCustomerAddressInput,
                    locationCreateAddressInput,
                    locationCreateContactInput,
                    locationCreatePhoneInput
                ].forEach((input) => {
                    if (input instanceof HTMLInputElement) {
                        input.value = "";
                    }
                });

                syncLocationCreateCustomerFields();
                setLocationCreateStatus("", "info");
            };

            const loadLocationCreateCustomers = async () => {
                if (!customerSearchUrl || !(locationCreateCustomerSelect instanceof HTMLSelectElement)) {
                    return;
                }

                const currentValue = locationCreateCustomerSelect.value;
                try {
                    const response = await fetch(customerSearchUrl, {
                        headers: {
                            Accept: "application/json"
                        }
                    });

                    if (!response.ok) {
                        throw new Error("Không thể tải danh sách khách hàng.");
                    }

                    const customers = await response.json();
                    locationCreateCustomerSelect.replaceChildren();

                    const createOption = document.createElement("option");
                    createOption.value = "";
                    createOption.textContent = "Tạo khách mới";
                    locationCreateCustomerSelect.appendChild(createOption);

                    if (Array.isArray(customers)) {
                        customers.forEach((customer) => {
                            const option = document.createElement("option");
                            option.value = `${customer.id || ""}`;
                            option.textContent = customer.tenKhachHang || `Khách hàng #${customer.id}`;
                            option.dataset.phone = customer.soDienThoai || "";
                            option.dataset.address = customer.diaChi || "";
                            locationCreateCustomerSelect.appendChild(option);
                        });
                    }

                    locationCreateCustomerSelect.value = currentValue &&
                        Array.from(locationCreateCustomerSelect.options).some((option) => option.value === currentValue)
                        ? currentValue
                        : "";
                    syncLocationCreateCustomerFields();
                } catch (error) {
                    setLocationCreateStatus(error instanceof Error ? error.message : "Không thể tải danh sách khách hàng.", "error");
                }
            };

            const openLocationCreateModal = async () => {
                if (!(locationCreateShell instanceof HTMLElement)) {
                    return;
                }

                resetLocationCreateForm();
                locationCreateShell.hidden = false;
                await loadLocationCreateCustomers();
                if (locationCreateCustomerSelect instanceof HTMLSelectElement) {
                    locationCreateCustomerSelect.focus();
                }
            };

            const closeLocationCreateModal = () => {
                if (locationCreateShell instanceof HTMLElement) {
                    locationCreateShell.hidden = true;
                }
            };

            const saveLocationCreateForm = async () => {
                if (!locationCreateUrl ||
                    !(locationCreateCustomerSelect instanceof HTMLSelectElement) ||
                    !(locationCreateSaveButton instanceof HTMLButtonElement)) {
                    return;
                }

                const customerId = Number.parseInt(locationCreateCustomerSelect.value || "", 10);
                const isNewCustomer = !(Number.isFinite(customerId) && customerId > 0);
                const customerName = locationCreateCustomerNameInput instanceof HTMLInputElement ? locationCreateCustomerNameInput.value.trim() : "";
                const customerPhone = locationCreateCustomerPhoneInput instanceof HTMLInputElement ? locationCreateCustomerPhoneInput.value.trim() : "";
                const customerAddress = locationCreateCustomerAddressInput instanceof HTMLInputElement ? locationCreateCustomerAddressInput.value.trim() : "";
                const locationAddress = locationCreateAddressInput instanceof HTMLInputElement ? locationCreateAddressInput.value.trim() : "";
                const locationContact = locationCreateContactInput instanceof HTMLInputElement ? locationCreateContactInput.value.trim() : "";
                const locationPhone = locationCreatePhoneInput instanceof HTMLInputElement ? locationCreatePhoneInput.value.trim() : "";
                const payload = {
                    idKhachHang: isNewCustomer ? null : customerId,
                    tenKhachHang: customerName,
                    soDienThoai: customerPhone,
                    diaChiKhachHang: customerAddress,
                    diaChi: isNewCustomer ? customerAddress : locationAddress,
                    nguoiLienHe: isNewCustomer ? customerName : locationContact,
                    dienThoai: isNewCustomer ? customerPhone : locationPhone
                };

                if (isNewCustomer && !payload.tenKhachHang) {
                    setLocationCreateStatus("Vui lòng nhập tên khách hàng mới.", "error");
                    if (locationCreateCustomerNameInput instanceof HTMLInputElement) {
                        locationCreateCustomerNameInput.focus();
                    }
                    return;
                }

                if (isNewCustomer && !payload.diaChiKhachHang) {
                    setLocationCreateStatus("Vui lòng nhập địa chỉ khách hàng.", "error");
                    if (locationCreateCustomerAddressInput instanceof HTMLInputElement) {
                        locationCreateCustomerAddressInput.focus();
                    }
                    return;
                }

                if (!isNewCustomer && !payload.diaChi) {
                    setLocationCreateStatus("Vui lòng nhập địa chỉ địa điểm.", "error");
                    if (locationCreateAddressInput instanceof HTMLInputElement) {
                        locationCreateAddressInput.focus();
                    }
                    return;
                }

                const token = root.querySelector("input[name='__RequestVerificationToken']");
                locationCreateSaveButton.disabled = true;
                setLocationCreateStatus("Đang lưu địa điểm...", "info");

                try {
                    const response = await fetch(locationCreateUrl, {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                            Accept: "application/json",
                            ...(token instanceof HTMLInputElement ? { RequestVerificationToken: token.value } : {})
                        },
                        body: JSON.stringify(payload)
                    });

                    if (!response.ok) {
                        throw new Error("Không thể lưu địa điểm khách hàng.");
                    }

                    const data = await response.json();
                    if (!data.succeeded || !data.item) {
                        throw new Error(data.errorMessage || "Không thể lưu địa điểm khách hàng.");
                    }

                    selectLocation(data.item);
                    syncLocationCoordinateButton(data.item);
                    closeLocationCreateModal();
                } catch (error) {
                    setLocationCreateStatus(error instanceof Error ? error.message : "Không thể lưu địa điểm khách hàng.", "error");
                } finally {
                    locationCreateSaveButton.disabled = false;
                }
            };

            const highlightSuggestion = (index) => {
                if (suggestionButtons.length === 0) {
                    return;
                }

                activeIndex = index;
                suggestionButtons.forEach((button, buttonIndex) => {
                    button.classList.toggle("is-active", buttonIndex === index);
                });
            };

            const renderSuggestions = (items) => {
                if (!Array.isArray(items) || items.length === 0) {
                    suggestionList.innerHTML = "<div class=\"yeu-cau-location-suggestion-empty\">Không tìm thấy địa điểm phù hợp.</div>";
                    suggestionList.hidden = false;
                    suggestionButtons = [];
                    activeIndex = -1;
                    return;
                }

                suggestionList.innerHTML = "";
                suggestionButtons = items.map((item, index) => {
                    const hasCoordinates = Number.isFinite(item.latAddress) && Number.isFinite(item.longAddress);
                    const button = document.createElement("button");
                    button.type = "button";
                    button.className = "yeu-cau-location-suggestion-item";
                    button.innerHTML = `
                        <span class="yeu-cau-location-coordinate-state ${hasCoordinates ? "has-coordinate" : "missing-coordinate"}" title="${hasCoordinates ? "Đã có định vị" : "Chưa có định vị"}" aria-label="${hasCoordinates ? "Đã có định vị" : "Chưa có định vị"}">
                            <i class="fa-solid ${hasCoordinates ? "fa-check" : "fa-xmark"}" aria-hidden="true"></i>
                        </span>
                        <span class="yeu-cau-location-suggestion-copy">
                            <strong>${item.tenKhachHang || "Khách hàng chưa xác định"}</strong>
                            <span><b>Địa chỉ:</b> ${item.diaChi || "Chưa có địa điểm"}</span>
                            <small><b>Điện thoại:</b> ${item.dienThoai || "-"}</small>
                            <small><b>Người liên hệ:</b> ${item.nguoiLienHe || "-"}</small>
                        </span>
                    `;
                    button.addEventListener("mouseenter", () => {
                        highlightSuggestion(index);
                    });
                    button.addEventListener("mousedown", (event) => {
                        event.preventDefault();
                        selectLocation(item);
                    });
                    suggestionList.appendChild(button);
                    return button;
                });

                suggestionList.hidden = false;
                activeIndex = -1;
            };

            const fetchSuggestions = async (keyword) => {
                if (!searchUrl) {
                    return;
                }

                if (abortController) {
                    abortController.abort();
                }

                abortController = new AbortController();

                try {
                    const response = await fetch(`${searchUrl}?keyword=${encodeURIComponent(keyword)}`, {
                        headers: {
                            Accept: "application/json"
                        },
                        signal: abortController.signal
                    });

                    if (!response.ok) {
                        throw new Error("Lookup failed.");
                    }

                    const items = await response.json();
                    renderSuggestions(items);
                } catch (error) {
                    if (error && error.name === "AbortError") {
                        return;
                    }

                    clearSuggestions();
                }
            };

            const queueSuggestionLookup = () => {
                const keyword = locationInput.value.trim();
                window.clearTimeout(debounceTimer);

                if (keyword.length < 2) {
                    clearSuggestions();
                    return;
                }

                debounceTimer = window.setTimeout(() => {
                    void fetchSuggestions(keyword);
                }, 220);
            };

            const syncExecutionMinDate = () => {
                executionDateInput.min = requestDateInput.value || "";

                if (executionDateInput.value && requestDateInput.value && executionDateInput.value < requestDateInput.value) {
                    executionDateInput.value = requestDateInput.value;
                }
            };

            const syncEmployeeText = () => {
                const selectedOption = employeeSelect.selectedOptions[0];
                employeeTextInput.value = selectedOption?.dataset.employeeName || "";
            };

            const refreshGeneratedCode = async () => {
                if (isEditMode || !codeUrl) {
                    return;
                }

                const query = requestDateInput.value ? `?ngayYeuCau=${encodeURIComponent(requestDateInput.value)}` : "";

                try {
                    const response = await fetch(`${codeUrl}${query}`, {
                        headers: {
                            Accept: "application/json"
                        }
                    });

                    if (!response.ok) {
                        throw new Error("Code preview failed.");
                    }

                    const payload = await response.json();
                    if (payload && typeof payload.code === "string" && payload.code.trim()) {
                        requestCodeDisplay.value = payload.code.trim();
                    }
                } catch {
                    // Keep current display value when preview fails.
                }
            };

            const ensurePreviewMap = () => {
                if (!(window.L && typeof window.L.map === "function")) {
                    return false;
                }

                if (previewMap) {
                    window.setTimeout(() => previewMap.invalidateSize(), 120);
                    return true;
                }

                previewMap = window.L.map(previewMapElement, {
                    zoomControl: false,
                    attributionControl: false,
                    dragging: false,
                    scrollWheelZoom: false,
                    doubleClickZoom: false,
                    boxZoom: false,
                    keyboard: false,
                    tap: false,
                    touchZoom: false
                });

                window.L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
                    maxZoom: 19
                }).addTo(previewMap);

                window.setTimeout(() => previewMap.invalidateSize(), 120);
                return true;
            };

            const syncPreviewMap = () => {
                if (!ensurePreviewMap()) {
                    return;
                }

                const data = readLocationData();

                if (Number.isFinite(data.latAddress) && Number.isFinite(data.longAddress)) {
                    if (!previewMarker) {
                        previewMarker = window.L.marker([data.latAddress, data.longAddress]).addTo(previewMap);
                    } else {
                        previewMarker.setLatLng([data.latAddress, data.longAddress]);
                    }

                    previewMap.setView([data.latAddress, data.longAddress], 15);
                    previewTitle.textContent = "Xem bản đồ";
                } else {
                    if (previewMarker) {
                        previewMap.removeLayer(previewMarker);
                        previewMarker = null;
                    }

                    previewMap.setView(defaultCenter, defaultZoom);
                    previewTitle.textContent = "Chưa có ghim";
                }

                syncLocationCoordinateButton(data);
                window.setTimeout(() => previewMap.invalidateSize(), 100);
            };

            const captureCustomerCoordinates = async () => {
                if (!(locationCoordinateButton instanceof HTMLButtonElement)) {
                    return;
                }

                if (!locationIdInput.value) {
                    window.alert("Vui lòng chọn địa điểm khách hàng trước.");
                    return;
                }

                const requestId = formIdInput instanceof HTMLInputElement ? formIdInput.value.trim() : "";
                const isSavedRequest = !!requestId;
                if (isSavedRequest && locationCoordinateButton.dataset.canUpdateLocationCoordinate !== "true") {
                    window.alert("Bạn chưa có quyền cập nhật tọa độ địa điểm cho phiếu này.");
                    return;
                }

                const submitUrl = isSavedRequest ? locationCoordinateUrl : locationCoordinateDraftUrl;
                if (!submitUrl) {
                    window.alert("Không tìm thấy đường dẫn cập nhật tọa độ địa điểm.");
                    return;
                }

                if (!navigator.geolocation) {
                    window.alert("Trình duyệt không hỗ trợ GPS.");
                    return;
                }

                locationCoordinateButton.disabled = true;
                const originalText = locationCoordinateButton.querySelector("span")?.textContent || "";
                const label = locationCoordinateButton.querySelector("span");
                if (label instanceof HTMLElement) {
                    label.textContent = "Đang lấy GPS...";
                }

                try {
                    const position = await new Promise((resolve, reject) => {
                        navigator.geolocation.getCurrentPosition(resolve, reject, {
                            enableHighAccuracy: true,
                            timeout: 10000,
                            maximumAge: 60000
                        });
                    });

                    const payload = new FormData();
                    if (isSavedRequest) {
                        payload.append("IDYeuCau", requestId);
                    }
                    payload.append("IDDiaDiem", locationIdInput.value);
                    payload.append("LongAddress", `${position.coords.longitude}`);
                    payload.append("LatAddress", `${position.coords.latitude}`);

                    const token = root.querySelector("input[name='__RequestVerificationToken']");
                    const response = await fetch(submitUrl, {
                        method: "POST",
                        headers: token instanceof HTMLInputElement ? { RequestVerificationToken: token.value } : {},
                        body: payload
                    });
                    const result = await response.json().catch(() => ({}));
                    if (!response.ok || !result.succeeded) {
                        throw new Error(result.message || "Không thể cập nhật tọa độ điểm khách hàng.");
                    }

                    previewLongInput.value = `${result.longAddress ?? position.coords.longitude}`;
                    previewLatInput.value = `${result.latAddress ?? position.coords.latitude}`;
                    previewCoordinates.textContent = result.coordinateDisplay || `${formatCoordinate(position.coords.latitude)}, ${formatCoordinate(position.coords.longitude)}`;
                    locationCoordinateButton.hidden = true;
                    locationCoordinateButton.classList.add("is-hidden");
                    syncPreviewMap();
                    window.alert("Đã cập nhật tọa độ điểm khách hàng.");
                } catch (error) {
                    window.alert(error instanceof Error ? error.message : "Không thể cập nhật tọa độ điểm khách hàng.");
                } finally {
                    locationCoordinateButton.disabled = false;
                    if (label instanceof HTMLElement) {
                        label.textContent = originalText;
                    }
                }
            };

            const updateViewRouteStatus = (message, type = "info") => {
                viewRouteStatus.textContent = message;
                viewRouteStatus.dataset.state = type;
                viewRouteStatus.hidden = false;
            };

            const clearViewRoute = () => {
                if (viewMap && viewRouteLayer) {
                    viewMap.removeLayer(viewRouteLayer);
                    viewRouteLayer = null;
                }

                if (viewMap && viewCurrentMarker) {
                    viewMap.removeLayer(viewCurrentMarker);
                    viewCurrentMarker = null;
                }

                viewRouteStatus.hidden = true;
                viewRouteStatus.textContent = "";
                delete viewRouteStatus.dataset.state;
            };

            const ensureViewMap = () => {
                if (!(window.L && typeof window.L.map === "function")) {
                    updateViewRouteStatus("Không tải được thư viện bản đồ.", "error");
                    return false;
                }

                if (viewMap) {
                    window.setTimeout(() => viewMap.invalidateSize(), 120);
                    return true;
                }

                viewMap = window.L.map(viewMapElement, {
                    zoomControl: true
                });

                window.L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
                    maxZoom: 19,
                    attribution: "&copy; OpenStreetMap contributors"
                }).addTo(viewMap);

                viewMap.setView(defaultCenter, defaultZoom);
                window.setTimeout(() => viewMap.invalidateSize(), 120);
                return true;
            };

            const openMapViewer = () => {
                const data = readLocationData();
                viewTitle.textContent = data.tenKhachHang ? `Bản đồ ${data.tenKhachHang}` : "Bản đồ địa điểm khách hàng";
                viewAddress.textContent = data.diaChi || "Chưa có địa chỉ.";

                if (Number.isFinite(data.latAddress) && Number.isFinite(data.longAddress)) {
                    viewRouteButton.disabled = false;
                    viewExternalLink.href = `https://www.google.com/maps/dir/?api=1&destination=${data.latAddress},${data.longAddress}&travelmode=driving`;
                    viewExternalLink.removeAttribute("aria-disabled");
                    viewExternalLink.classList.remove("disabled");
                } else if (data.diaChi) {
                    viewRouteButton.disabled = true;
                    viewExternalLink.href = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(data.diaChi)}`;
                    viewExternalLink.removeAttribute("aria-disabled");
                    viewExternalLink.classList.remove("disabled");
                } else {
                    viewRouteButton.disabled = true;
                    viewExternalLink.href = "#";
                    viewExternalLink.setAttribute("aria-disabled", "true");
                    viewExternalLink.classList.add("disabled");
                }

                clearViewRoute();
                viewShell.hidden = false;

                if (ensureViewMap()) {
                    if (Number.isFinite(data.latAddress) && Number.isFinite(data.longAddress)) {
                        if (!viewMarker) {
                            viewMarker = window.L.marker([data.latAddress, data.longAddress]).addTo(viewMap);
                        } else {
                            viewMarker.setLatLng([data.latAddress, data.longAddress]);
                        }

                        viewMap.setView([data.latAddress, data.longAddress], focusZoom);
                    } else {
                        if (viewMarker) {
                            viewMap.removeLayer(viewMarker);
                            viewMarker = null;
                        }

                        viewMap.setView(defaultCenter, defaultZoom);
                    }
                }
            };

            const closeMapViewer = () => {
                clearViewRoute();
                viewShell.hidden = true;
            };

            const requestDirections = async () => {
                const data = readLocationData();
                if (!Number.isFinite(data.latAddress) || !Number.isFinite(data.longAddress)) {
                    updateViewRouteStatus("Địa điểm chưa có tọa độ để chỉ đường.", "warning");
                    return;
                }

                if (!navigator.geolocation) {
                    updateViewRouteStatus("Trình duyệt không hỗ trợ lấy vị trí hiện tại. Bạn có thể dùng nút Google Maps.", "warning");
                    return;
                }

                updateViewRouteStatus("Đang lấy vị trí hiện tại...", "info");

                navigator.geolocation.getCurrentPosition(async (position) => {
                    const startLat = position.coords.latitude;
                    const startLng = position.coords.longitude;

                    updateViewRouteStatus("Đang tính lộ trình...", "info");

                    try {
                        const response = await fetch(`https://router.project-osrm.org/route/v1/driving/${startLng},${startLat};${data.longAddress},${data.latAddress}?overview=full&geometries=geojson`);
                        if (!response.ok) {
                            throw new Error("Route lookup failed.");
                        }

                        const payload = await response.json();
                        const route = Array.isArray(payload.routes) ? payload.routes[0] : null;
                        if (!route || !route.geometry) {
                            updateViewRouteStatus("Không lấy được dữ liệu chỉ đường. Bạn có thể mở Google Maps để tiếp tục.", "warning");
                            return;
                        }

                        clearViewRoute();

                        viewRouteLayer = window.L.geoJSON(route.geometry, {
                            style: {
                                color: "#0aa17d",
                                weight: 5,
                                opacity: 0.9
                            }
                        }).addTo(viewMap);

                        viewCurrentMarker = window.L.circleMarker([startLat, startLng], {
                            radius: 7,
                            color: "#0b4f9c",
                            weight: 2,
                            fillColor: "#3b82f6",
                            fillOpacity: 0.95
                        }).addTo(viewMap);

                        const routeBounds = viewRouteLayer.getBounds();
                        if (routeBounds.isValid()) {
                            viewMap.fitBounds(routeBounds.pad(0.15));
                        }

                        const distanceKm = (route.distance / 1000).toFixed(1);
                        const durationMinutes = Math.round(route.duration / 60);
                        updateViewRouteStatus(`Đã tìm thấy lộ trình khoảng ${distanceKm} km, thời gian dự kiến ${durationMinutes} phút.`, "success");
                    } catch {
                        updateViewRouteStatus("Không thể tính lộ trình lúc này. Bạn có thể dùng nút Google Maps để tiếp tục.", "error");
                    }
                }, () => {
                    updateViewRouteStatus("Không lấy được vị trí hiện tại. Hãy cấp quyền vị trí hoặc dùng Google Maps.", "warning");
                }, {
                    enableHighAccuracy: true,
                    timeout: 10000,
                    maximumAge: 60000
                });
            };

            locationInput.addEventListener("input", () => {
                const currentValue = locationInput.value.trim();
                if (!currentValue) {
                    clearSelectedLocation();
                    updatePreview(null);
                }
                queueSuggestionLookup();
            });

            locationInput.addEventListener("focus", queueSuggestionLookup);
            locationInput.addEventListener("blur", () => {
                window.setTimeout(() => {
                    if (locationInput.value.trim() !== selectedLocationLabel) {
                        locationInput.value = selectedLocationLabel;
                    }
                    clearSuggestions();
                }, 120);
            });

            locationInput.addEventListener("keydown", (event) => {
                if (suggestionButtons.length === 0) {
                    return;
                }

                if (event.key === "ArrowDown") {
                    event.preventDefault();
                    const nextIndex = activeIndex >= suggestionButtons.length - 1 ? 0 : activeIndex + 1;
                    highlightSuggestion(nextIndex);
                } else if (event.key === "ArrowUp") {
                    event.preventDefault();
                    const nextIndex = activeIndex <= 0 ? suggestionButtons.length - 1 : activeIndex - 1;
                    highlightSuggestion(nextIndex);
                } else if (event.key === "Enter" && activeIndex >= 0) {
                    event.preventDefault();
                    suggestionButtons[activeIndex]?.dispatchEvent(new MouseEvent("mousedown", { bubbles: true }));
                } else if (event.key === "Escape") {
                    locationInput.value = selectedLocationLabel;
                    clearSuggestions();
                }
            });

            if (locationCreateOpenButton instanceof HTMLButtonElement) {
                locationCreateOpenButton.addEventListener("click", () => {
                    void openLocationCreateModal();
                });
            }

            locationCreateCloseButtons.forEach((button) => {
                button.addEventListener("click", closeLocationCreateModal);
            });

            if (locationCreateCustomerSelect instanceof HTMLSelectElement) {
                locationCreateCustomerSelect.addEventListener("change", () => {
                    syncLocationCreateCustomerFields();
                    if (locationCreateCustomerSelect.value) {
                        const selectedOption = locationCreateCustomerSelect.selectedOptions[0];
                        if (locationCreatePhoneInput instanceof HTMLInputElement && !locationCreatePhoneInput.value) {
                            locationCreatePhoneInput.value = selectedOption?.dataset.phone || "";
                        }
                        if (locationCreateAddressInput instanceof HTMLInputElement && !locationCreateAddressInput.value) {
                            locationCreateAddressInput.value = selectedOption?.dataset.address || "";
                        }
                    }
                });
            }

            if (locationCreateSaveButton instanceof HTMLButtonElement) {
                locationCreateSaveButton.addEventListener("click", () => {
                    void saveLocationCreateForm();
                });
            }

            tabButtons.forEach((button) => {
                button.addEventListener("click", () => {
                    if (!(button instanceof HTMLElement) || !button.dataset.tab) {
                        return;
                    }

                    setActiveTab(button.dataset.tab);
                });
            });

            collapseSections.forEach((section) => {
                const toggle = section.querySelector("[data-collapse-toggle]");
                const body = section.querySelector("[data-collapse-body]");
                if (!(toggle instanceof HTMLButtonElement) || !(body instanceof HTMLElement)) {
                    return;
                }

                toggle.addEventListener("click", () => {
                    const willCollapse = !body.hidden;
                    setCollapseState(section, willCollapse);
                });
            });

            requestDateInput.addEventListener("change", () => {
                syncExecutionMinDate();
                void refreshGeneratedCode();
            });

            employeeSelect.addEventListener("change", syncEmployeeText);

            if (linkedEmployeePickerSubmit instanceof HTMLButtonElement) {
                linkedEmployeePickerSubmit.addEventListener("click", () => {
                const checkedItems = Array.from(linkedEmployeePickerList.querySelectorAll("[data-linked-employee-picker-checkbox]:checked"));
                if (checkedItems.length === 0) {
                    window.alert("Vui lòng chọn ít nhất một nhân viên để thêm.");
                    return;
                }

                const selectedEmployees = [];
                checkedItems.forEach((checkbox) => {
                    if (!(checkbox instanceof HTMLInputElement)) {
                        return;
                    }

                    const employeeId = Number.parseInt(checkbox.value, 10);
                    if (!Number.isFinite(employeeId) || employeeId <= 0) {
                        return;
                    }

                    selectedEmployees.push({
                        id: employeeId,
                        hoTen: checkbox.dataset.employeeName || "Nhân viên",
                        chucVu: checkbox.dataset.employeeRole || "",
                        avatar: checkbox.dataset.employeeAvatar || ""
                    });
                });

                if (activeEmployeeWorkItem instanceof HTMLElement) {
                    if (isValidWorkCompletion(activeEmployeeWorkItem)) {
                        closeLinkedEmployeePicker();
                        return;
                    }

                    const existingIds = getWorkEmployeeIds(activeEmployeeWorkItem);
                    const mergedEmployees = [
                        ...existingIds.map((employeeId) => getEmployeeOptions().find((option) => option.id === employeeId)).filter((employee) => employee),
                        ...selectedEmployees
                    ];
                    renderWorkEmployees(activeEmployeeWorkItem, mergedEmployees);
                    updateWorkIndexes();
                }

                closeLinkedEmployeePicker();
                setActiveTab("cong-viec");
            });
            }

            linkedEmployeePickerCloseButtons.forEach((button) => {
                button.addEventListener("click", closeLinkedEmployeePicker);
            });

            workAddButton.addEventListener("click", () => {
                openWorkPicker();
            });

            if (serviceTemplateSelect instanceof HTMLSelectElement) {
                serviceTemplateSelect.addEventListener("change", () => {
                    void mergeServiceWorks();
                });
            }

            workPickerSubmit.addEventListener("click", () => {
                const checkedItems = Array.from(workPickerList.querySelectorAll("[data-work-picker-checkbox]:checked"));
                if (checkedItems.length === 0) {
                    window.alert("Vui lòng chọn ít nhất một công việc để thêm.");
                    return;
                }

                checkedItems.forEach((checkbox) => {
                    if (!(checkbox instanceof HTMLInputElement)) {
                        return;
                    }

                    const workId = Number.parseInt(checkbox.value, 10);
                    if (!Number.isFinite(workId) || workId <= 0) {
                        return;
                    }

                    const workItem = createWorkItem();
                    if (!(workItem instanceof HTMLElement)) {
                        return;
                    }

                    setWorkStartTimeNow(workItem);
                    applyWorkOption(workItem, workId);
                });

                updateWorkIndexes();
                syncWorkEmptyState();
                syncWorkProgress();
                closeWorkPicker();
                setActiveTab("cong-viec");
            });

            workPickerCloseButtons.forEach((button) => {
                button.addEventListener("click", closeWorkPicker);
            });

            if (checkinOpenButton instanceof HTMLButtonElement) {
                checkinOpenButton.addEventListener("click", () => {
                    const mode = checkinOpenButton.dataset.checkinMode === "checkout" ? "checkout" : "checkin";
                    void openCheckinModal({
                        mode,
                        target: mode === "checkout"
                            ? {
                                id: checkinOpenButton.dataset.checkinId || "",
                                employeeId: checkinOpenButton.dataset.checkinEmployeeId || ""
                            }
                            : null
                    });
                });
            }

            checkinCloseButtons.forEach((button) => {
                button.addEventListener("click", closeCheckinModal);
            });

            if (checkinCaptureButton instanceof HTMLButtonElement) {
                checkinCaptureButton.addEventListener("click", () => {
                    void captureCheckinPhoto();
                });
            }

            if (checkinRetakeButton instanceof HTMLButtonElement) {
                checkinRetakeButton.addEventListener("click", () => {
                    resetCheckinPhoto();
                    void startCheckinCamera();
                });
            }

            checkinCameraSelect?.addEventListener("change", () => {
                if (checkinCameraSelect instanceof HTMLSelectElement) {
                    selectedCheckinCameraId = checkinCameraSelect.value;
                }
                if (checkinStream && checkinShell instanceof HTMLElement && !checkinShell.hidden) {
                    void startCheckinCamera().catch(() => {
                        setCheckinStatus("Khong the doi camera.", "error");
                    });
                }
            });

            if (checkinGpsRetryButton instanceof HTMLButtonElement) {
                checkinGpsRetryButton.addEventListener("click", async () => {
                    setCheckinStatus("Đang yêu cầu quyền GPS từ trình duyệt...", "info");
                    await updateCheckinGpsDebug("manual-click");
                    await resolveCheckinPosition();
                });
            }

            if (checkinDistanceToggle instanceof HTMLButtonElement) {
                checkinDistanceToggle.addEventListener("click", () => {
                    const expanded = checkinDistanceToggle.getAttribute("aria-expanded") === "true";
                    setCheckinDistanceExpanded(!expanded);
                });
            }

            if (checkinSaveButton instanceof HTMLButtonElement) {
                checkinSaveButton.addEventListener("click", () => {
                    void submitCheckin();
                });
            }

            root.querySelectorAll("[data-checkin-image-open]").forEach((button) => {
                button.addEventListener("click", () => {
                    openCheckinImageModal(button);
                });
            });

            root.querySelectorAll("[data-checkin-delete]").forEach((button) => {
                button.addEventListener("click", () => {
                    void deleteCheckin(button);
                });
            });
            root.querySelectorAll("[data-checkout-open]").forEach((button) => {
                button.addEventListener("click", () => {
                    if (!(button instanceof HTMLElement)) {
                        return;
                    }

                    void openCheckinModal({
                        mode: "checkout",
                        target: {
                            id: button.dataset.checkinId || "",
                            employeeId: button.dataset.checkinEmployeeId || ""
                        }
                    });
                });
            });
            root.querySelectorAll("[data-checkin-group-toggle]").forEach((button) => {
                button.addEventListener("click", () => {
                    if (!(button instanceof HTMLButtonElement)) {
                        return;
                    }

                    const contentId = button.getAttribute("aria-controls") || "";
                    const content = contentId ? document.getElementById(contentId) : null;
                    const expanded = button.getAttribute("aria-expanded") === "true";
                    button.setAttribute("aria-expanded", expanded ? "false" : "true");
                    if (content instanceof HTMLElement) {
                        content.hidden = expanded;
                    }
                });
            });

            checkinImageCloseButtons.forEach((button) => {
                button.addEventListener("click", closeCheckinImageModal);
            });

            if (checkinImageZoomOutButton instanceof HTMLButtonElement) {
                checkinImageZoomOutButton.addEventListener("click", () => {
                    checkinImageZoom = Math.max(0.25, Number((checkinImageZoom - 0.25).toFixed(2)));
                    updateCheckinImageTransform();
                });
            }

            if (checkinImageZoomInButton instanceof HTMLButtonElement) {
                checkinImageZoomInButton.addEventListener("click", () => {
                    checkinImageZoom = Math.min(4, Number((checkinImageZoom + 0.25).toFixed(2)));
                    updateCheckinImageTransform();
                });
            }

            if (checkinImageRotateButton instanceof HTMLButtonElement) {
                checkinImageRotateButton.addEventListener("click", () => {
                    checkinImageRotation = (checkinImageRotation + 90) % 360;
                    updateCheckinImageTransform();
                });
            }

            workCameraCloseButtons.forEach((button) => {
                button.addEventListener("click", closeWorkCameraModal);
            });

            if (workCameraCaptureButton instanceof HTMLButtonElement) {
                workCameraCaptureButton.addEventListener("click", () => {
                    void captureWorkCameraPhoto();
                });
            }

            if (workCameraDiscardButton instanceof HTMLButtonElement) {
                workCameraDiscardButton.addEventListener("click", () => {
                    void resetWorkCameraPhoto(true);
                    setWorkCameraStatus("Đã bỏ ảnh, có thể chụp lại.", "info");
                });
            }

            workCameraSelect?.addEventListener("change", () => {
                if (workCameraSelect instanceof HTMLSelectElement) {
                    selectedWorkCameraId = workCameraSelect.value;
                }
                if (workCameraStream && workCameraShell instanceof HTMLElement && !workCameraShell.hidden) {
                    void startWorkCamera().catch(() => {
                        setWorkCameraStatus("Khong the doi camera.", "error");
                    });
                }
            });

            if (workCameraSaveButton instanceof HTMLButtonElement) {
                workCameraSaveButton.addEventListener("click", () => {
                    void saveWorkCameraPhoto();
                });
            }


            previewMapButton.addEventListener("click", openMapViewer);
            if (locationCoordinateButton instanceof HTMLButtonElement) {
                locationCoordinateButton.addEventListener("click", (event) => {
                    event.stopPropagation();
                    void captureCustomerCoordinates();
                });
            }
            viewRouteButton.addEventListener("click", () => {
                void requestDirections();
            });

            viewExternalLink.addEventListener("click", (event) => {
                if (viewExternalLink.classList.contains("disabled")) {
                    event.preventDefault();
                }
            });

            viewCloseButtons.forEach((button) => {
                button.addEventListener("click", closeMapViewer);
            });

            document.addEventListener("keydown", (event) => {
                if (event.key === "Escape" && !workPickerShell.hidden) {
                    closeWorkPicker();
                    return;
                }

                if (event.key === "Escape" && !linkedEmployeePickerShell.hidden) {
                    closeLinkedEmployeePicker();
                    return;
                }

                if (event.key === "Escape" && !viewShell.hidden) {
                    closeMapViewer();
                    return;
                }

                if (event.key === "Escape" && checkinShell instanceof HTMLElement && !checkinShell.hidden) {
                    closeCheckinModal();
                    return;
                }

                if (event.key === "Escape" && checkinImageShell instanceof HTMLElement && !checkinImageShell.hidden) {
                    closeCheckinImageModal();
                    return;
                }

                if (event.key === "Escape" && workCameraShell instanceof HTMLElement && !workCameraShell.hidden) {
                    closeWorkCameraModal();
                }
            });

            syncEmployeeText();
            syncExecutionMinDate();
            syncPreviewMap();
            const savedViewState = readViewState();
            setActiveTab(savedViewState.activeTab || activeTabInput.value || "thong-tin");
            collapseSections.forEach((section) => {
                const sectionIndex = collapseSections.indexOf(section);
                const savedCollapsed = Array.isArray(savedViewState.collapsed)
                    ? savedViewState.collapsed[sectionIndex]
                    : undefined;
                setCollapseState(section, typeof savedCollapsed === "boolean" ? savedCollapsed : section.classList.contains("is-collapsed"));
            });
            getWorkItems().forEach(bindWorkItem);
            updateWorkIndexes();
            syncWorkEmptyState();
            syncWorkProgress();

            root.addEventListener("submit", (event) => {
                updateWorkIndexes();
                syncWorkEmployeesJson();
                persistCollapseState();

                const timeRangeResult = findWorkTimeRangeMessage();
                if (timeRangeResult) {
                    event.preventDefault();
                    setActiveTab("cong-viec");
                    showWorkOverlapWarning(timeRangeResult);
                    return;
                }

                const overlapResult = findWorkOverlapMessage();
                if (overlapResult) {
                    event.preventDefault();
                    setActiveTab("cong-viec");
                    showWorkOverlapWarning(overlapResult);
                    return;
                }

                if (!locationIdInput.value || locationInput.value.trim() !== selectedLocationLabel) {
                    event.preventDefault();
                    clearSuggestions();
                    setActiveTab("thong-tin");
                    locationInput.focus();
                    window.alert("Vui lòng chọn địa điểm khách hàng từ danh sách có sẵn trong hệ thống.");
                }
            });
        })();
    </script>
}


