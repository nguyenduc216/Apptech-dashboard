                            <input type="hidden" value="" data-work-checklist-name />
                            <input type="hidden" value="" data-work-checklist-order />
                            <input type="hidden" value="" data-work-checklist-created-date />
                            <input type="hidden" value="" data-work-checklist-created-by />
                            <input type="hidden" value="" data-work-checklist-finish-date />
                            <input type="hidden" value="" data-work-checklist-finish-by />
                            <input type="checkbox" value="true" data-work-checklist-completed />
                            <span class="yeu-cau-work-checklist-copy">
                                <strong data-work-checklist-title>Checklist</strong>
                                <small data-work-checklist-subtext hidden></small>
                            </span>
                        </label>
                    </template>
