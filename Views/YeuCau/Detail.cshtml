                                    </section>

                                    <section class="yeu-cau-work-image-group" data-work-image-group data-image-type="CheckOut" data-required-count="0">
                                        <div class="yeu-cau-work-image-header">
                                            <strong>Ảnh sau thực hiện</strong>
                                            <span class="yeu-cau-work-image-count" data-work-image-count hidden>0 / 0</span>
                                        </div>
                                        <div class="yeu-cau-work-image-actions">
                                            <button type="button" class="secondary-button" data-work-image-upload><i class="fa-solid fa-upload" aria-hidden="true"></i><span>Upload ảnh</span></button>
                                            <button type="button" class="secondary-button" data-work-image-camera><i class="fa-solid fa-camera" aria-hidden="true"></i><span>Chụp ảnh</span></button>
                                        </div>
                                        <input type="file" accept="image/*" data-work-image-file hidden />
                                        <input type="file" accept="image/*" capture="environment" data-work-image-camera-file hidden />
