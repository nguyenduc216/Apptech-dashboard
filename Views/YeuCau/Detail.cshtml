@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
          integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
          crossorigin="" />
    <style>
        .zalo-qr-modal { width: min(720px, calc(100% - 24px)); }
        .zalo-qr-body { display: grid; grid-template-columns: 280px minmax(0, 1fr); gap: 22px; padding: 22px; }
        .zalo-qr-image-shell { display: grid; place-items: center; aspect-ratio: 1; border: 1px solid #cfe5df; border-radius: 8px; background: #f3faf8; overflow: hidden; }
        .zalo-qr-image-shell img { display: block; width: 100%; height: 100%; object-fit: contain; padding: 10px; background: #fff; }
        .zalo-qr-loading { display: grid; justify-items: center; gap: 10px; color: #397068; font-weight: 700; }
        .zalo-qr-loading i { font-size: 28px; color: #0b8c74; }
        .zalo-qr-details { display: grid; align-content: start; gap: 15px; }
        .zalo-qr-status { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 13px; border: 1px solid #cfe5df; border-radius: 7px; background: #f5fbf9; }
        .zalo-qr-status span { color: #607b76; }
        .zalo-qr-status strong { color: #08735f; }
        .zalo-qr-details label { display: grid; gap: 7px; color: #244f49; font-weight: 700; }
        .zalo-qr-details input { width: 100%; min-height: 44px; padding: 0 11px; border: 1px solid #c9ddd8; border-radius: 7px; background: #fff; color: #164b44; font: inherit; }
        .zalo-qr-actions { display: flex; flex-wrap: wrap; gap: 9px; }
        .zalo-qr-message { min-height: 22px; color: #08735f; font-weight: 700; font-size: 13px; }
        .zalo-qr-message.error { color: #b53737; }
        .yeu-cau-zalo-rating-panel { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; padding: 16px; }
        .yeu-cau-zalo-rating-card { display: grid; align-content: start; gap: 13px; padding: 16px; border: 1px solid #cfe5df; border-radius: 8px; background: #f8fcfb; }
        .yeu-cau-zalo-rating-card.is-warning { border-color: #f1b5a8; background: #fff8f5; }
        .yeu-cau-zalo-rating-heading { display: flex; gap: 12px; align-items: flex-start; }
