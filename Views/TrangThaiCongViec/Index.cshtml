@model IReadOnlyList<WorkStatus>
@{ ViewData["Title"]="Trạng thái công việc"; ViewData["Breadcrumb"]="Danh mục / Trạng thái công việc"; }
<link rel="stylesheet" href="~/css/work-progress.css" asp-append-version="true" />
<section class="wp-page" aria-label="Danh mục trạng thái công việc">
<div class="wp-page-heading">
 <p>Đặt tên, màu và thứ tự hiển thị. Mã và loại nghiệp vụ được giữ cố định sau khi tạo.</p>
 @if((bool)ViewBag.CanCreate && !(bool)ViewBag.ShowCreate) { <a class="wp-action-button" asp-action="Index" asp-route-create="true">+ Thêm trạng thái</a> }
</div>
@if(TempData["WorkStatusError"] is string error) { <p role="alert" class="wp-error">@error</p> }
@if(TempData["WorkStatusSuccess"] is string success) { <p role="status">@success</p> }
@if((bool)ViewBag.ShowCreate)
{
 var newStatus = new WorkStatus { SortOrder = Model.Count == 0 ? 10 : Model.Max(s => s.SortOrder) + 10 };
 <section class="wp-status-editor wp-status-create">
  <div class="wp-status-editor-heading"><strong>Thêm trạng thái mới</strong><a class="wp-secondary-button" asp-action="Index">Hủy</a></div>
  <partial name="_WorkStatusForm" model="newStatus" />
 </section>
}
@foreach(var s in Model)
{
 <section class="wp-status-editor">
 <partial name="_WorkStatusForm" model="s" />
 @if(s.Id!=0 && (bool)ViewBag.CanToggle) { <form method="post" asp-action="Toggle"><input type="hidden" name="id" value="@s.Id" /><input type="hidden" name="version" value="@s.Version" /><button type="submit">@(s.Active?"Vô hiệu hóa":"Kích hoạt")</button></form> }
 @if(s.Id!=0) { <small>ID: @s.Id · Tạo: @s.CreatedAt?.ToString("dd/MM/yyyy HH:mm") · Cập nhật: @s.UpdatedAt?.ToString("dd/MM/yyyy HH:mm")</small> }
 </section>
}
</section>
<script src="~/js/work-status.js" asp-append-version="true"></script>
