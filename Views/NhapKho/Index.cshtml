}

@section Scripts {
    <script>
        (() => {
            const root = document.querySelector("[data-nhap-kho-root]");
            const list = root?.querySelector("[data-nhap-kho-detail-list]");
            const template = document.querySelector("[data-nhap-kho-detail-template]");
            const empty = root?.querySelector("[data-nhap-kho-detail-empty]");
            const addButton = root?.querySelector("[data-nhap-kho-add-detail]");
            const isReadonly = root?.dataset.readonly === "true";

            if (!(root instanceof HTMLElement) ||
                !(list instanceof HTMLElement) ||
                !(template instanceof HTMLTemplateElement)) {
                return;
            }

            const getRows = () => Array.from(list.querySelectorAll("[data-nhap-kho-detail-row]"));
            const reindexRows = () => {
                getRows().forEach((row, index) => {
                    row.querySelectorAll("[name]").forEach((input) => {
                        const currentName = input.getAttribute("name") || "";
                        input.setAttribute("name", currentName.replace(/Form\.Details\[(?:\d+|__index__)\]/u, `Form.Details[${index}]`));
                    });
                });
            };
            const updateEmpty = () => empty?.classList.toggle("is-hidden", getRows().length > 0);
            const syncDetailHeaderOrder = () => {
                const headerRow = root.querySelector(".xuat-kho-detail-table thead tr");
                if (!(headerRow instanceof HTMLTableRowElement)) {
                    return;
                }

                const labels = [
                    "Loại hình nhập",
                    "Số chứng từ",
                    "Hàng hóa",
                    "Đơn vị nhập",
                    "Đơn vị tính",
                    "Số lượng nhập",
                    "Số lượng quy đổi",
                    "Đơn giá nhập",
                    "Đơn giá bán lẻ"
                ];
                const hasActions = headerRow.querySelector(".actions-col") instanceof HTMLElement;
                headerRow.replaceChildren();
                labels.forEach((label) => {
                    const cell = document.createElement("th");
                    cell.textContent = label;
                    headerRow.appendChild(cell);
                });
                if (hasActions) {
                    const cell = document.createElement("th");
                    cell.className = "actions-col";
                    cell.textContent = "Xóa";
                    headerRow.appendChild(cell);
                }
            };
            const getCellBySelector = (row, selector) => {
                const field = row.querySelector(selector);
                return field instanceof HTMLElement ? field.closest("td") : null;
            };
            const ensureDonViTinhSubmitValue = (row) => {
                const donViTinhSelect = row.querySelector("[data-detail-don-vi-tinh-id]");
                if (!(donViTinhSelect instanceof HTMLSelectElement)) {
                    return null;
                }

                donViTinhSelect.disabled = true;
                let hidden = row.querySelector("[data-detail-don-vi-tinh-hidden]");
                if (!(hidden instanceof HTMLInputElement)) {
                    hidden = document.createElement("input");
                    hidden.type = "hidden";
                    hidden.dataset.detailDonViTinhHidden = "";
                    donViTinhSelect.insertAdjacentElement("afterend", hidden);
                }

                hidden.name = donViTinhSelect.name;
                hidden.value = donViTinhSelect.value;
                return hidden;
            };
            const syncDetailRowOrder = (row) => {
                const orderedCells = [
                    getCellBySelector(row, "[data-detail-loai-hinh-nhap]"),
                    getCellBySelector(row, "[data-detail-document-number]"),
                    getCellBySelector(row, "[data-detail-hang-hoa-id]"),
                    getCellBySelector(row, "[data-detail-don-vi-nhap-id]"),
                    getCellBySelector(row, "[data-detail-don-vi-tinh-id]"),
                    getCellBySelector(row, "[data-detail-quantity]"),
                    getCellBySelector(row, "[data-detail-conversion]"),
                    getCellBySelector(row, "[data-detail-import-price]"),
                    getCellBySelector(row, "[data-detail-sale-price]")
                ].filter((cell) => cell instanceof HTMLTableCellElement);

                const maSoLoCell = getCellBySelector(row, "[name$='.MaSoLo']");
                if (maSoLoCell instanceof HTMLElement) {
                    maSoLoCell.hidden = true;
                }

                const actionCell = row.querySelector("td.actions-col");
                orderedCells.forEach((cell) => row.appendChild(cell));
                if (actionCell instanceof HTMLTableCellElement) {
                    row.appendChild(actionCell);
                }

                if (isReadonly) {
                    orderedCells.forEach((cell) => {
                        const value = getReadonlyCellText(cell);
                        cell.replaceChildren();
                        const text = document.createElement("span");
                        text.className = "nhap-kho-readonly-text";
                        text.textContent = value || "-";
                        cell.appendChild(text);
                    });
                    return;
                }

                ensureDonViTinhSubmitValue(row);
            };
            const parseDecimal = (value) => {
                let normalized = String(value || "").trim();
                if (normalized.includes(",")) {
                    normalized = normalized.replace(/\./gu, "").replace(",", ".");
                } else {
                    normalized = normalized.replace(/\./gu, "");
                }

                const parsed = Number.parseFloat(normalized);
                return Number.isFinite(parsed) ? parsed : 0;
            };
            const formatDecimal = (value) => {
                if (!Number.isFinite(value)) {
                    return "0";
                }

                return value.toFixed(2).replace(/\.?0+$/u, "");
            };
            const sanitizeDecimalQuantity = (input, shouldNormalize = false) => {
                const rawValue = input.value || "";
                let value = "";
                let hasSeparator = false;

                for (const character of rawValue) {
                    if (/\d/u.test(character)) {
                        value += character;
                        continue;
                    }

                    if ((character === "." || character === ",") && !hasSeparator) {
                        value += shouldNormalize ? "." : character;
                        hasSeparator = true;
                    }
                }

                if (shouldNormalize) {
                    value = value.replace(",", ".");
                    if (value.startsWith(".")) {
                        value = `0${value}`;
                    }
                    value = value.replace(/\.$/u, "");
                }

                input.value = value;
            };
            const splitLocalizedMoney = (rawValue, allowInvariantDecimal = false) => {
                let value = String(rawValue || "").replace(/[^\d.,]/gu, "");
                if (!value) {
                    return { integer: "", decimal: "", hasDecimal: false };
                }

                const commaIndex = value.lastIndexOf(",");
                if (commaIndex < 0) {
                    const dotIndex = value.lastIndexOf(".");
                    const hasInvariantDecimal = allowInvariantDecimal &&
                        dotIndex >= 0 &&
                        value.indexOf(".") === dotIndex &&
                        value.length - dotIndex - 1 !== 3;

                    if (hasInvariantDecimal) {
                        return {
                            integer: value.slice(0, dotIndex).replace(/[.,]/gu, ""),
                            decimal: value.slice(dotIndex + 1).replace(/[.,]/gu, ""),
                            hasDecimal: true
                        };
                    }

                    return {
                        integer: value.replace(/[.,]/gu, ""),
                        decimal: "",
                        hasDecimal: false
                    };
                }

                return {
                    integer: value.slice(0, commaIndex).replace(/[.,]/gu, ""),
                    decimal: value.slice(commaIndex + 1).replace(/[.,]/gu, ""),
                    hasDecimal: true
                };
            };
            const formatIntegerGroup = (value) => {
                const digits = String(value || "").replace(/\D/gu, "").replace(/^0+(?=\d)/u, "");
                return digits ? digits.replace(/\B(?=(\d{3})+(?!\d))/gu, ".") : "0";
            };
            const formatMoneyInput = (input, allowInvariantDecimal = false) => {
                const parts = splitLocalizedMoney(input.value, allowInvariantDecimal);
                if (!parts.integer && !parts.decimal) {
                    input.value = "";
                    return;
                }

                const decimal = parts.decimal.replace(/0+$/u, "");
                input.value = `${formatIntegerGroup(parts.integer)}${parts.hasDecimal && decimal ? `,${decimal}` : ""}`;
            };
            const formatMoneyText = (value) => {
                const parts = splitLocalizedMoney(value, true);
                if (!parts.integer && !parts.decimal) {
                    return "";
                }

                const decimal = parts.decimal.replace(/0+$/u, "");
                return `${formatIntegerGroup(parts.integer)}${parts.hasDecimal && decimal ? `,${decimal}` : ""}`;
            };
            const getReadonlyCellText = (cell) => {
                const select = cell.querySelector("select");
                if (select instanceof HTMLSelectElement) {
                    return select.selectedOptions[0]?.textContent?.trim() || "";
                }

                const input = cell.querySelector("input:not([type='hidden'])");
                if (!(input instanceof HTMLInputElement)) {
                    return cell.textContent?.trim() || "";
                }

                if (input.matches("[data-detail-import-price], [data-detail-sale-price]")) {
                    return formatMoneyText(input.value);
                }

                return input.value?.trim() || "";
            };
            const normalizeMoneyInput = (input) => {
                const parts = splitLocalizedMoney(input.value);
                if (!parts.integer && !parts.decimal) {
                    input.value = "0";
                    return;
                }

                input.value = `${parts.integer || "0"}${parts.hasDecimal && parts.decimal ? `.${parts.decimal}` : ""}`;
            };
            const updateSalePrice = (row) => {
                const conversionInput = row.querySelector("[data-detail-conversion]");
                const importPriceInput = row.querySelector("[data-detail-import-price]");
                const salePriceInput = row.querySelector("[data-detail-sale-price]");
                if (!(conversionInput instanceof HTMLInputElement) ||
                    !(importPriceInput instanceof HTMLInputElement) ||
                    !(salePriceInput instanceof HTMLInputElement)) {
                    return;
                }

                const denominator = parseDecimal(conversionInput.value);
                const importPrice = parseDecimal(importPriceInput.value);
                salePriceInput.value = denominator > 0 ? formatDecimal(importPrice / denominator).replace(".", ",") : "0";
                formatMoneyInput(salePriceInput);
            };
            const clearFieldError = (field) => {
                const cell = field.closest(".detail-field-cell");
                if (!(cell instanceof HTMLElement)) {
                    return;
                }

                cell.classList.remove("has-error");
                field.classList.remove("input-validation-error");
                field.removeAttribute("aria-invalid");
                cell.querySelectorAll(".detail-field-error").forEach((error) => error.remove());
            };
            const attachRow = (row) => {
                syncDetailRowOrder(row);
                row.querySelectorAll("input, select").forEach((field) => {
                    if (!(field instanceof HTMLInputElement) && !(field instanceof HTMLSelectElement)) {
                        return;
                    }

                    if (field instanceof HTMLInputElement && field.type === "hidden") {
                        return;
                    }

                    field.addEventListener("change", () => clearFieldError(field));
                    if (field instanceof HTMLInputElement) {
                        field.addEventListener("input", () => clearFieldError(field));
                    }
                });

                const hangHoaSelect = row.querySelector("[data-detail-hang-hoa-id]");
                const donViTinhSelect = row.querySelector("[data-detail-don-vi-tinh-id]");
                const donViNhapSelect = row.querySelector("[data-detail-don-vi-nhap-id]");
                if (hangHoaSelect instanceof HTMLSelectElement && donViTinhSelect instanceof HTMLSelectElement) {
                    const syncDonViTinh = () => {
                        const selected = hangHoaSelect.selectedOptions[0];
                        const donViTinhId = selected?.dataset.donViTinhId;
                        if (donViTinhId && !donViTinhSelect.value) {
                            donViTinhSelect.value = donViTinhId;
                            ensureDonViTinhSubmitValue(row);
                            window.ApptechLiveSelect?.refresh(donViTinhSelect);
                        }
                        if (donViTinhId && donViNhapSelect instanceof HTMLSelectElement && !donViNhapSelect.value) {
                            donViNhapSelect.value = donViTinhId;
                            window.ApptechLiveSelect?.refresh(donViNhapSelect);
                        }
                    };
                    hangHoaSelect.addEventListener("change", () => {
                        const selected = hangHoaSelect.selectedOptions[0];
                        const donViTinhId = selected?.dataset.donViTinhId;
                        donViTinhSelect.value = donViTinhId || "";
                        ensureDonViTinhSubmitValue(row);
                        window.ApptechLiveSelect?.refresh(donViTinhSelect);
                        if (donViNhapSelect instanceof HTMLSelectElement) {
                            donViNhapSelect.value = donViTinhId || "";
                            window.ApptechLiveSelect?.refresh(donViNhapSelect);
                        }
                    });
                    syncDonViTinh();
                }

                const removeButton = row.querySelector("[data-nhap-kho-remove-detail]");
                if (removeButton instanceof HTMLButtonElement) {
                    removeButton.addEventListener("click", () => {
                        row.remove();
                        reindexRows();
                        updateEmpty();
                    });
                }

                const quantityInput = row.querySelector("[data-detail-quantity]");
                if (quantityInput instanceof HTMLInputElement) {
                    quantityInput.addEventListener("input", () => sanitizeDecimalQuantity(quantityInput));
                    quantityInput.addEventListener("blur", () => sanitizeDecimalQuantity(quantityInput, true));
                }

                const conversionInput = row.querySelector("[data-detail-conversion]");
                if (conversionInput instanceof HTMLInputElement) {
                    conversionInput.addEventListener("input", () => {
                        sanitizeDecimalQuantity(conversionInput);
                        updateSalePrice(row);
                    });
                    conversionInput.addEventListener("blur", () => {
                        sanitizeDecimalQuantity(conversionInput, true);
                        updateSalePrice(row);
                    });
                }

                const importPriceInput = row.querySelector("[data-detail-import-price]");
                if (importPriceInput instanceof HTMLInputElement) {
                    formatMoneyInput(importPriceInput, true);
                    importPriceInput.addEventListener("input", () => {
                        formatMoneyInput(importPriceInput);
                        updateSalePrice(row);
                    });
                    importPriceInput.addEventListener("blur", () => {
                        formatMoneyInput(importPriceInput);
                        updateSalePrice(row);
                    });
                }

                row.querySelectorAll("[data-detail-sale-price]").forEach((input) => {
                    if (!(input instanceof HTMLInputElement)) {
                        return;
                    }

                    input.addEventListener("input", () => {
                        formatMoneyInput(input);
                    });
                    input.addEventListener("blur", () => {
                        formatMoneyInput(input);
                    });
                });
                const salePriceInput = row.querySelector("[data-detail-sale-price]");
                if (salePriceInput instanceof HTMLInputElement) {
                    formatMoneyInput(salePriceInput, true);
                }
            };

            syncDetailHeaderOrder();
            getRows().forEach(attachRow);
            updateEmpty();

            if (addButton instanceof HTMLButtonElement) {
                addButton.addEventListener("click", () => {
                    const fragment = template.content.cloneNode(true);
                    const row = fragment.firstElementChild;
                    if (!(row instanceof HTMLElement)) {
                        return;
                    }

                    list.appendChild(row);
                    attachRow(row);
                    reindexRows();
                    updateEmpty();
                });
            }

            root.closest("form")?.addEventListener("submit", () => {
                getRows().forEach((row) => {
                    const quantityInput = row.querySelector("[data-detail-quantity]");
                    if (quantityInput instanceof HTMLInputElement) {
                        sanitizeDecimalQuantity(quantityInput, true);
                    }
                    const conversionInput = row.querySelector("[data-detail-conversion]");
                    if (conversionInput instanceof HTMLInputElement) {
                        sanitizeDecimalQuantity(conversionInput, true);
                    }
                    const importPriceInput = row.querySelector("[data-detail-import-price]");
                    if (importPriceInput instanceof HTMLInputElement) {
                        normalizeMoneyInput(importPriceInput);
                    }
                    const salePriceInput = row.querySelector("[data-detail-sale-price]");
                    if (salePriceInput instanceof HTMLInputElement) {
                        normalizeMoneyInput(salePriceInput);
                    }
                });
            });
        })();
    </script>
}
