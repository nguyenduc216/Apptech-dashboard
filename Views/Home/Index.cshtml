                if (!(mapFullscreenRouteStatus instanceof HTMLElement)) {
                    return;
                }
                mapFullscreenRouteStatus.hidden = !message;
                mapFullscreenRouteStatus.dataset.state = type;
                mapFullscreenRouteStatus.textContent = message || "";
            };

            const setMapCollapsed = (collapsed) => {
                if (mapContent instanceof HTMLElement) {
                    mapContent.hidden = collapsed;
                }
                if (mapToggle instanceof HTMLButtonElement) {
                    mapToggle.setAttribute("aria-expanded", collapsed ? "false" : "true");
                    mapToggle.dataset.state = mapToggle.dataset.state || "info";
                    const icon = mapToggle.querySelector("i");
                    icon?.classList.toggle("fa-chevron-down", collapsed);
                    icon?.classList.toggle("fa-chevron-up", !collapsed);
                }
                if (!collapsed && attendanceMap) {
                    syncAttendanceMap(activeGps);
                }
            };

            const setMapTitle = (message, type = "info") => {
                if (mapTitle) {
                    mapTitle.textContent = message;
                }
                if (mapToggle instanceof HTMLButtonElement) {
                    mapToggle.dataset.state = type;
                }
            };

            const isPurchaseMode = () => activeMode === "purchase-checkin" || activeMode === "purchase-checkout";
            const isPurchaseCheckoutMode = () => activeMode === "purchase-checkout";
            const isPurchaseCheckinMode = () => activeMode === "purchase-checkin";

            const getSelectedLocation = () => {
                if (!(locationSelect instanceof HTMLSelectElement)) {
                    return null;
                }
                const option = locationSelect.selectedOptions[0];
                if (!option || !locationSelect.value) {
                    return null;
                }
                return {
                    id: locationSelect.value,
                    lat: Number.parseFloat(option.dataset.lat || ""),
                    long: Number.parseFloat(option.dataset.long || "")
                };
            };

            const getNavigationPoints = () => {
                const location = getSelectedLocation();
                const hasLocation = !isPurchaseMode() && location && Number.isFinite(location.lat) && Number.isFinite(location.long);
                const hasGps = activeGps && Number.isFinite(activeGps.lat) && Number.isFinite(activeGps.long);
                return {
                    location,
                    customerPoint: hasLocation ? [location.lat, location.long] : null,
                    currentPoint: hasGps ? [activeGps.lat, activeGps.long] : null
                };
            };

            const syncMapExternalLink = () => {
                if (!(mapFullscreenExternalLink instanceof HTMLAnchorElement)) {
                    return;
                }
                const { customerPoint, currentPoint } = getNavigationPoints();
                if (customerPoint && currentPoint) {
                    mapFullscreenExternalLink.href = `https://www.google.com/maps/dir/?api=1&origin=${currentPoint[0]},${currentPoint[1]}&destination=${customerPoint[0]},${customerPoint[1]}`;
                    mapFullscreenExternalLink.classList.remove("disabled");
                    return;
                }
                if (customerPoint) {
                    mapFullscreenExternalLink.href = `https://www.google.com/maps/search/?api=1&query=${customerPoint[0]},${customerPoint[1]}`;
                    mapFullscreenExternalLink.classList.remove("disabled");
                    return;
                }
                mapFullscreenExternalLink.href = "#";
                mapFullscreenExternalLink.classList.add("disabled");
            };

            const distanceMeters = (startLat, startLong, endLat, endLong) => {
                const toRad = (value) => value * Math.PI / 180;
                const earthRadius = 6371000;
                const deltaLat = toRad(endLat - startLat);
                const deltaLong = toRad(endLong - startLong);
                const lat1 = toRad(startLat);
                const lat2 = toRad(endLat);
                const haversine = Math.sin(deltaLat / 2) ** 2 +
                    Math.cos(lat1) * Math.cos(lat2) * Math.sin(deltaLong / 2) ** 2;
                return 2 * earthRadius * Math.atan2(Math.sqrt(haversine), Math.sqrt(1 - haversine));
            };

            const getDistanceState = (distance) => Number.isFinite(distanceLimit) && distanceLimit > 0 && distance > distanceLimit
                ? "error"
                : "success";

            const validateDistance = (gps) => {
                if (isPurchaseMode()) {
                    return;
                }

                const location = getSelectedLocation();
                if (!location || !Number.isFinite(location.lat) || !Number.isFinite(location.long)) {
                    throw new Error("Địa điểm chấm công chưa có tọa độ nên không thể kiểm tra khoảng cách.");
                }
                if (Number.isFinite(distanceLimit) && distanceLimit > 0) {
                    const distance = distanceMeters(location.lat, location.long, gps.lat, gps.long);
                    if (distance > distanceLimit) {
                        throw new Error(`Khoảng cách chấm công không được quá ${distanceLimit.toLocaleString("vi-VN")} mét.`);
                    }
                }
            };

            const createAttendanceTileLayer = () => {
                const tileLayer = window.L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
                    maxZoom: 19,
                    attribution: "&copy; OpenStreetMap contributors"
                });
                tileLayer.on("tileerror", (event) => {
                    const map = event?.target?._map;
                    if (map === fullscreenMap) {
                        setFullscreenRouteStatus("Không tải được một phần bản đồ. Vui lòng bấm làm mới bản đồ.", "warning");
                    }
                });
                return tileLayer;
            };

            const ensureAttendanceMap = () => {
                if (mapContent instanceof HTMLElement && mapContent.hidden) {
                    return false;
                }
                if (!(mapElement instanceof HTMLElement) || !(window.L && typeof window.L.map === "function")) {
                    return false;
                }
                if (attendanceMap) {
                    window.setTimeout(() => attendanceMap.invalidateSize(), 120);
                    return true;
                }

                attendanceMap = window.L.map(mapElement, {
                    zoomControl: false,
                    attributionControl: false,
                    dragging: false,
                    scrollWheelZoom: false,
                    doubleClickZoom: false,
                    boxZoom: false,
                    keyboard: false,
                    tap: false,
                    touchZoom: false
                });
                createAttendanceTileLayer().addTo(attendanceMap);
                attendanceMap.setView(defaultCenter, defaultZoom);
                window.setTimeout(() => attendanceMap.invalidateSize(), 120);
                return true;
            };

            const fitAttendanceMap = (customerPoint, currentPoint = null) => {
                if (!attendanceMap) {
                    return;
                }

                attendanceMap.invalidateSize();
                if (customerPoint && currentPoint) {
                    attendanceMap.fitBounds(window.L.latLngBounds([customerPoint, currentPoint]).pad(0.35), { maxZoom: 16 });
                } else if (customerPoint) {
                    attendanceMap.setView(customerPoint, focusZoom);
                } else if (currentPoint) {
                    attendanceMap.setView(currentPoint, focusZoom);
                } else {
                    attendanceMap.setView(defaultCenter, defaultZoom);
                }

                customerMarker?.bringToFront();
                currentMarker?.bringToFront();
            };

            const scheduleFitAttendanceMap = (customerPoint, currentPoint = null) => {
                window.requestAnimationFrame(() => fitAttendanceMap(customerPoint, currentPoint));
                window.setTimeout(() => fitAttendanceMap(customerPoint, currentPoint), 160);
                window.setTimeout(() => fitAttendanceMap(customerPoint, currentPoint), 420);
            };

            const ensureFullscreenMap = () => {
                if (!(mapFullscreenElement instanceof HTMLElement) || !(window.L && typeof window.L.map === "function")) {
                    return false;
                }
                if (fullscreenMap) {
                    window.setTimeout(() => fullscreenMap.invalidateSize(), 120);
                    return true;
                }

                fullscreenMap = window.L.map(mapFullscreenElement, {
                    zoomControl: true,
                    attributionControl: false
                });
                createAttendanceTileLayer().addTo(fullscreenMap);
                fullscreenMap.setView(defaultCenter, defaultZoom);
                window.setTimeout(() => fullscreenMap.invalidateSize(), 120);
                return true;
            };

            const fitFullscreenMap = (customerPoint, currentPoint = null) => {
                if (!fullscreenMap) {
                    return;
                }

                fullscreenMap.invalidateSize();
                if (customerPoint && currentPoint) {
                    fullscreenMap.fitBounds(window.L.latLngBounds([customerPoint, currentPoint]).pad(0.35), { maxZoom: 16 });
                } else if (customerPoint) {
                    fullscreenMap.setView(customerPoint, focusZoom);
                } else if (currentPoint) {
                    fullscreenMap.setView(currentPoint, focusZoom);
                } else {
                    fullscreenMap.setView(defaultCenter, defaultZoom);
                }
            };

            const refreshFullscreenMap = () => {
                if (!fullscreenMap) {
                    return;
                }
                const { customerPoint, currentPoint } = getNavigationPoints();
                fullscreenMap.invalidateSize(true);
                fitFullscreenMap(customerPoint, currentPoint);
                window.setTimeout(() => {
                    fullscreenMap.invalidateSize(true);
                    fitFullscreenMap(customerPoint, currentPoint);
                }, 180);
            };

            const syncFullscreenMap = () => {
                const { location, customerPoint, currentPoint } = getNavigationPoints();

                if (!ensureFullscreenMap()) {
                    return;
                }

                if (customerPoint) {
                    if (!fullscreenCustomerMarker) {
                        fullscreenCustomerMarker = window.L.circleMarker(customerPoint, {
                            radius: 9,
                            color: "#0a6aa1",
                            weight: 3,
                            fillColor: "#1f8fd1",
                            fillOpacity: 0.95
                        }).addTo(fullscreenMap).bindTooltip("Điểm khách hàng");
                    } else {
                        fullscreenCustomerMarker.setLatLng(customerPoint);
                    }
                }

                if (currentPoint) {
                    if (!fullscreenCurrentMarker) {
                        fullscreenCurrentMarker = window.L.circleMarker(currentPoint, {
                            radius: 9,
                            color: "#0aa17d",
                            weight: 3,
                            fillColor: "#11c59b",
                            fillOpacity: 0.92
                        }).addTo(fullscreenMap).bindTooltip("Vị trí hiện tại");
                    } else {
                        fullscreenCurrentMarker.setLatLng(currentPoint);
                    }
                }

                if (customerPoint && currentPoint) {
                    if (fullscreenRouteLayer) {
                        fullscreenMap.removeLayer(fullscreenRouteLayer);
                        fullscreenRouteLayer = null;
                    }
                    if (!fullscreenDistanceLine) {
                        fullscreenDistanceLine = window.L.polyline([customerPoint, currentPoint], {
                            color: "#0a6aa1",
                            weight: 4,
                            opacity: 0.88,
                            dashArray: "8 8"
                        }).addTo(fullscreenMap);
                    } else {
                        fullscreenDistanceLine.setLatLngs([customerPoint, currentPoint]);
                    }

                    const distance = distanceMeters(location.lat, location.long, activeGps.lat, activeGps.long);
                    if (mapFullscreenSubtitle) {
                        mapFullscreenSubtitle.textContent = `Khoảng cách hiện tại: ${Math.round(distance).toLocaleString("vi-VN")} m.`;
                    }
                }

                syncMapExternalLink();
                window.setTimeout(() => fitFullscreenMap(customerPoint, currentPoint), 250);
            };

            const loadFullscreenRoute = async () => {
                const { location, customerPoint, currentPoint } = getNavigationPoints();
                if (!fullscreenMap || !customerPoint || !currentPoint || !location || !activeGps) {
                    setFullscreenRouteStatus("Chưa đủ tọa độ để chỉ đường.", "warning");
                    return;
                }

                try {
                    if (mapFullscreenRouteButton instanceof HTMLButtonElement) {
                        mapFullscreenRouteButton.disabled = true;
                    }
                    setFullscreenRouteStatus("Đang tải tuyến đường...", "info");
                    const response = await fetch(`https://router.project-osrm.org/route/v1/driving/${activeGps.long},${activeGps.lat};${location.long},${location.lat}?overview=full&geometries=geojson`);
                    const payload = await response.json();
                    const route = Array.isArray(payload.routes) ? payload.routes[0] : null;
                    if (!response.ok || !route?.geometry) {
                        throw new Error("Không tìm thấy tuyến đường phù hợp.");
                    }

                    if (fullscreenRouteLayer) {
                        fullscreenMap.removeLayer(fullscreenRouteLayer);
                    }
                    if (fullscreenDistanceLine) {
                        fullscreenMap.removeLayer(fullscreenDistanceLine);
                        fullscreenDistanceLine = null;
                    }
                    fullscreenRouteLayer = window.L.geoJSON(route.geometry, {
                        style: {
                            color: "#0b4f9c",
                            weight: 5,
                            opacity: 0.82
                        }
                    }).addTo(fullscreenMap);
                    const routeBounds = fullscreenRouteLayer.getBounds();
                    if (routeBounds.isValid()) {
                        fullscreenMap.fitBounds(routeBounds.pad(0.15));
                    }
                    const distanceKm = (route.distance / 1000).toFixed(1);
                    const durationMinutes = Math.round(route.duration / 60);
                    setFullscreenRouteStatus(`Tuyến đường khoảng ${distanceKm} km, ${durationMinutes} phút.`, "success");
                } catch (error) {
                    setFullscreenRouteStatus(error instanceof Error ? error.message : "Không thể tải tuyến đường.", "error");
                } finally {
                    if (mapFullscreenRouteButton instanceof HTMLButtonElement) {
                        mapFullscreenRouteButton.disabled = false;
                    }
                }
            };

            const openFullscreenMap = () => {
                if (mapFullscreenShell instanceof HTMLElement) {
                    mapFullscreenShell.hidden = false;
                    document.body.classList.add("modal-open");
                }
                window.requestAnimationFrame(syncFullscreenMap);
                window.setTimeout(syncFullscreenMap, 220);
                window.setTimeout(refreshFullscreenMap, 520);
                window.setTimeout(refreshFullscreenMap, 1100);
            };

            const closeFullscreenMap = () => {
                if (mapFullscreenShell instanceof HTMLElement) {
                    mapFullscreenShell.hidden = true;
                }
                if (!(cameraShell instanceof HTMLElement) || cameraShell.hidden) {
                    document.body.classList.remove("modal-open");
                }
            };

            const syncAttendanceMap = (gps = activeGps) => {
                if (isPurchaseMode()) {
                    const hasGps = gps && Number.isFinite(gps.lat) && Number.isFinite(gps.long);
                    const currentPoint = hasGps ? [gps.lat, gps.long] : null;
                    setMapTitle(hasGps ? "Vị trí hiện tại đã sẵn sàng" : "Vị trí hiện tại: đang chờ GPS", hasGps ? "success" : "info");
                    setStatus(
                        mapStatus,
                        hasGps ? `GPS hiện tại: ${gps.lat.toFixed(5)}, ${gps.long.toFixed(5)}.` : "Đang chờ GPS hiện tại.",
                        hasGps ? "success" : "info");
                    if (!ensureAttendanceMap()) {
                        return;
                    }
                    if (customerMarker) {
                        attendanceMap.removeLayer(customerMarker);
                        customerMarker = null;
                    }
                    if (distanceLine) {
                        attendanceMap.removeLayer(distanceLine);
                        distanceLine = null;
                    }
                    if (hasGps) {
                        if (!currentMarker) {
                            currentMarker = window.L.circleMarker(currentPoint, {
                                radius: 8,
                                color: "#0aa17d",
                                weight: 2,
                                fillColor: "#11c59b",
                                fillOpacity: 0.9
                            }).addTo(attendanceMap);
                        } else {
                            currentMarker.setLatLng(currentPoint);
                        }
                        scheduleFitAttendanceMap(null, currentPoint);
                    } else {
                        scheduleFitAttendanceMap(null, null);
                    }
                    if (mapFullscreenShell instanceof HTMLElement && !mapFullscreenShell.hidden) {
                        syncFullscreenMap();
                    }
                    return;
                }

                const location = getSelectedLocation();
                if (!location || !Number.isFinite(location.lat) || !Number.isFinite(location.long)) {
                    setMapTitle("Khoảng cách: địa điểm chưa có tọa độ", "warning");
                    setStatus(mapStatus, "Địa điểm chấm công chưa có tọa độ.", "warning");
                    if (!ensureAttendanceMap()) {
                        return;
                    }
                    if (gps && Number.isFinite(gps.lat) && Number.isFinite(gps.long)) {
                        attendanceMap.setView([gps.lat, gps.long], 16);
                    }
                    return;
                }

                const customerPoint = [location.lat, location.long];
                const hasGps = gps && Number.isFinite(gps.lat) && Number.isFinite(gps.long);
                const currentPoint = hasGps ? [gps.lat, gps.long] : null;
                let distance = null;
                let state = "info";

                if (hasGps) {
                    distance = distanceMeters(location.lat, location.long, gps.lat, gps.long);
                    state = getDistanceState(distance);
                    const roundedDistance = Math.round(distance).toLocaleString("vi-VN");
                    const limitText = Number.isFinite(distanceLimit) && distanceLimit > 0
                        ? ` Giới hạn: ${distanceLimit.toLocaleString("vi-VN")} m.`
                        : "";
                    setMapTitle(`Khoảng cách từ điểm hiện tại tới địa điểm khách hàng: ${roundedDistance} m`, state);
                    setStatus(
                        mapStatus,
                        state === "error"
                            ? `Khoảng cách hiện tại: ${roundedDistance} m. Vượt quá giới hạn chấm công.${limitText}`
                            : `Khoảng cách đường chim bay: ${roundedDistance} m.${limitText}`,
                        state);
                } else {
                    setMapTitle("Khoảng cách: đang chờ GPS hiện tại", "warning");
                    setStatus(mapStatus, "Đang chờ GPS hiện tại.", "info");
                }

                if (!ensureAttendanceMap()) {
                    return;
                }

                if (!customerMarker) {
                    customerMarker = window.L.circleMarker(customerPoint, {
                        radius: 8,
                        color: "#0a6aa1",
                        weight: 3,
                        fillColor: "#1f8fd1",
                        fillOpacity: 0.95
                    }).addTo(attendanceMap);
                } else {
                    customerMarker.setLatLng(customerPoint);
                }

                if (hasGps) {
                    if (!currentMarker) {
                        currentMarker = window.L.circleMarker(currentPoint, {
                            radius: 8,
                            color: "#0aa17d",
                            weight: 2,
                            fillColor: "#11c59b",
                            fillOpacity: 0.9
                        }).addTo(attendanceMap);
                    } else {
                        currentMarker.setLatLng(currentPoint);
                    }

                    if (!distanceLine) {
                        distanceLine = window.L.polyline([customerPoint, currentPoint], {
                            color: "#0a6aa1",
                            weight: 3,
                            dashArray: "6 6"
                        }).addTo(attendanceMap);
                    } else {
                        distanceLine.setLatLngs([customerPoint, currentPoint]);
                    }

                    scheduleFitAttendanceMap(customerPoint, currentPoint);
                } else {
                    scheduleFitAttendanceMap(customerPoint);
                }
                if (mapFullscreenShell instanceof HTMLElement && !mapFullscreenShell.hidden) {
                    syncFullscreenMap();
                }
            };

            const getCurrentPosition = () => new Promise((resolve, reject) => {
                if (!navigator.geolocation) {
                    reject(new Error("Trình duyệt không hỗ trợ GPS."));
                    return;
                }
                navigator.geolocation.getCurrentPosition(resolve, reject, {
                    enableHighAccuracy: true,
                    timeout: 15000,
                    maximumAge: 0
                });
            });

            const resolveGps = async () => {
                setStatus(cameraStatus, "Đang lấy vị trí GPS...", "info");
                const position = await getCurrentPosition();
                const gps = {
                    lat: position.coords.latitude,
                    long: position.coords.longitude
                };
                return gps;
            };

            const refreshGps = async () => {
                if (refreshGpsButton instanceof HTMLButtonElement) {
                    refreshGpsButton.disabled = true;
                }

                try {
                    activeGps = await resolveGps();
                    if (cameraSubtitle) {
                        cameraSubtitle.textContent = `GPS hiện tại: ${activeGps.lat.toFixed(5)}, ${activeGps.long.toFixed(5)}`;
                    }
                    syncAttendanceMap(activeGps);
                    setStatus(cameraStatus, "Đã cập nhật lại GPS hiện tại.", "success");
                } catch (error) {
                    setStatus(cameraStatus, error instanceof Error ? error.message : "Không thể lấy lại GPS.", "error");
                } finally {
                    if (refreshGpsButton instanceof HTMLButtonElement) {
                        refreshGpsButton.disabled = false;
                    }
                }
            };

            const getCameraLabel = (device, index) => {
                const label = (device?.label || "").trim();
                return label || `Camera ${index + 1}`;
            };

            const syncAttendanceCameraSelect = () => {
                if (!(cameraSelect instanceof HTMLSelectElement)) {
                    return;
                }

                cameraSelect.innerHTML = "";
                attendanceCameraDevices.forEach((device, index) => {
                    const option = document.createElement("option");
                    option.value = device.deviceId;
                    option.textContent = getCameraLabel(device, index);
                    cameraSelect.appendChild(option);
                });

                if (!selectedAttendanceCameraId && attendanceCameraDevices.length > 0) {
                    const backCamera = attendanceCameraDevices.find((device) => /back|rear|environment|sau/i.test(device.label || ""));
                    selectedAttendanceCameraId = (backCamera || attendanceCameraDevices[0]).deviceId;
                }

                if (selectedAttendanceCameraId) {
                    cameraSelect.value = selectedAttendanceCameraId;
                }

                if (cameraSelectShell instanceof HTMLElement) {
                    cameraSelectShell.hidden = attendanceCameraDevices.length <= 1;
                }
            };

            const loadAttendanceCameraDevices = async () => {
                if (!navigator.mediaDevices?.enumerateDevices) {
                    return;
                }

                try {
                    attendanceCameraDevices = (await navigator.mediaDevices.enumerateDevices())
                        .filter((device) => device.kind === "videoinput" && device.deviceId);
                    syncAttendanceCameraSelect();
                } catch {
                }
            };

            const buildAttendanceCameraConstraints = () => selectedAttendanceCameraId
                ? { deviceId: { exact: selectedAttendanceCameraId } }
                : { facingMode: { ideal: "environment" } };

            const startCamera = async () => {
                if (!navigator.mediaDevices?.getUserMedia) {
                    throw new Error("Trình duyệt không hỗ trợ camera.");
                }
                stopCamera();
                cameraStream = await navigator.mediaDevices.getUserMedia({
                    video: buildAttendanceCameraConstraints(),
                    audio: false
                });
                if (video instanceof HTMLVideoElement) {
                    video.srcObject = cameraStream;
                    await video.play();
                }
                if (placeholder instanceof HTMLElement) {
                    placeholder.hidden = true;
                }
                await loadAttendanceCameraDevices();
            };

            const stopCamera = () => {
                cameraStream?.getTracks().forEach((track) => track.stop());
                cameraStream = null;
                if (video instanceof HTMLVideoElement) {
                    video.srcObject = null;
                }
            };

            const resetPhoto = () => {
                capturedBlob = null;
                if (preview instanceof HTMLImageElement) {
                    preview.hidden = true;
                    preview.removeAttribute("src");
                }
                if (video instanceof HTMLVideoElement) {
                    video.hidden = false;
                }
                if (retakeButton instanceof HTMLButtonElement) {
                    retakeButton.disabled = true;
                }
            };

            const formatDateTimeLocalValue = (date = new Date()) => {
                const pad = (value) => `${value}`.padStart(2, "0");
                return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}T${pad(date.getHours())}:${pad(date.getMinutes())}`;
            };

            const getSelectedActionEmployeeId = () => {
                const selected = Array.from(employeeCheckboxes)
                    .filter((checkbox) => checkbox instanceof HTMLInputElement && checkbox.checked && checkbox.value)
                    .map((checkbox) => Number.parseInt(checkbox.value, 10))
                    .find((value) => Number.isFinite(value) && value > 0);
                return selected || Number.parseInt(root.dataset.actionEmployeeId || "", 10) || null;
            };

            const getPurchaseActionEmployeeId = () => {
                if (root.dataset.canAdminManageAttendance === "true") {
                    const selected = purchaseEmployeeSelect instanceof HTMLSelectElement
                        ? Number.parseInt(purchaseEmployeeSelect.value || "", 10)
                        : NaN;
                    return Number.isFinite(selected) && selected > 0 ? selected : null;
                }

                return Number.parseInt(root.dataset.currentEmployeeId || "", 10) || getSelectedActionEmployeeId();
            };

            const getPurchaseCheckinTimeValue = () => {
                if (root.dataset.canAdminManageAttendance === "true" && purchaseTimeInput instanceof HTMLInputElement) {
                    return purchaseTimeInput.value;
                }

                return "";
            };

            const getSelectedDateValue = () => dateInput instanceof HTMLInputElement && dateInput.value
                ? dateInput.value
                : root.dataset.todayDate || "";

            const getSelectedDateWithCurrentTime = () => {
                const selectedDate = getSelectedDateValue();
                const match = selectedDate.match(/^(\d{4})-(\d{2})-(\d{2})$/);
                const now = new Date();
                return match
                    ? new Date(Number(match[1]), Number(match[2]) - 1, Number(match[3]), now.getHours(), now.getMinutes())
                    : now;
            };

            const shiftSelectedDate = (dayDelta) => {
                if (!(dateInput instanceof HTMLInputElement) || !Number.isFinite(dayDelta) || dayDelta === 0) {
                    return false;
                }

                const match = getSelectedDateValue().match(/^(\d{4})-(\d{2})-(\d{2})$/);
                if (!match) {
                    return false;
                }

                const date = new Date(Number(match[1]), Number(match[2]) - 1, Number(match[3]));
                date.setDate(date.getDate() + dayDelta);
                const pad = (value) => `${value}`.padStart(2, "0");
                dateInput.value = `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}`;
                dateInput.dispatchEvent(new Event("change", { bubbles: true }));
                return true;
            };

            const canUseAttendanceAction = () => {
                const selectedDate = getSelectedDateValue();
                const today = root.dataset.todayDate || selectedDate;
                if (selectedDate > today) {
                    return false;
                }

                const isPast = selectedDate < today;
                if (!isPast) {
                    return true;
                }

                const canSelectEmployees = root.dataset.canSelectEmployees === "true";
                if (!canSelectEmployees) {
                    return false;
                }

                const canAdminManageAttendance = root.dataset.canAdminManageAttendance === "true";
                const currentEmployeeId = Number.parseInt(root.dataset.currentEmployeeId || "", 10) || 0;
                const actionEmployeeId = getSelectedActionEmployeeId() || 0;
                return canAdminManageAttendance || actionEmployeeId === currentEmployeeId;
            };

            const capturePhoto = async () => {
                if (!(video instanceof HTMLVideoElement) || !(canvas instanceof HTMLCanvasElement)) {
                    return;
                }
                const width = video.videoWidth || 1280;
                const height = video.videoHeight || 720;
                canvas.width = width;
                canvas.height = height;
                const context = canvas.getContext("2d");
                context?.drawImage(video, 0, 0, width, height);
                capturedBlob = await new Promise((resolve) => canvas.toBlob(resolve, "image/jpeg", 0.88));
                if (preview instanceof HTMLImageElement && capturedBlob) {
                    preview.src = URL.createObjectURL(capturedBlob);
                    preview.hidden = false;
                    video.hidden = true;
                }
                if (retakeButton instanceof HTMLButtonElement) {
                    retakeButton.disabled = !capturedBlob;
                }
                setStatus(cameraStatus, "Đã chụp ảnh. Bấm Lưu để hoàn tất.", "success");
            };

            const stopPurchaseSpeech = () => {
                if (speechRecognition) {
                    try {
                        speechRecognition.stop();
                    } catch {
                    }
                }
                isListeningToPurchaseNote = false;
                purchaseSpeechButton?.classList.remove("is-listening");
                if (purchaseSpeechLabel instanceof HTMLElement) {
                    purchaseSpeechLabel.textContent = "Nói để nhập nhanh ghi chú";
                }
            };

            const appendPurchaseNoteText = (text) => {
                if (!(noteInput instanceof HTMLTextAreaElement)) {
                    return;
                }
                const current = noteInput.value.trim();
                const addition = `${text || ""}`.trim();
                if (!addition) {
                    return;
                }
                noteInput.value = current ? `${current} ${addition}` : addition;
                noteInput.focus();
            };

            const initPurchaseSpeech = () => {
                const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
                if (!SpeechRecognition || !(purchaseSpeechButton instanceof HTMLButtonElement)) {
                    isPurchaseSpeechSupported = false;
                    if (purchaseSpeechButton instanceof HTMLButtonElement) {
                        purchaseSpeechButton.hidden = true;
                    }
                    return;
                }

                isPurchaseSpeechSupported = true;
                speechRecognition = new SpeechRecognition();
                speechRecognition.lang = "vi-VN";
                speechRecognition.interimResults = false;
                speechRecognition.continuous = false;
                speechRecognition.onresult = (event) => {
                    const text = Array.from(event.results || [])
                        .map((result) => result?.[0]?.transcript || "")
                        .join(" ")
                        .trim();
                    appendPurchaseNoteText(text);
                };
                speechRecognition.onerror = (event) => {
                    const message = event?.error === "not-allowed"
                        ? "Bạn đã từ chối micro. Vẫn có thể nhập ghi chú thủ công."
                        : "Không thể nhận giọng nói lúc này. Vui lòng nhập ghi chú thủ công.";
                    setStatus(cameraStatus, message, "warning");
                };
                speechRecognition.onend = () => {
                    isListeningToPurchaseNote = false;
                    purchaseSpeechButton.classList.remove("is-listening");
                    if (purchaseSpeechLabel instanceof HTMLElement) {
                        purchaseSpeechLabel.textContent = "Nói để nhập nhanh ghi chú";
                    }
                };
            };

            const togglePurchaseSpeech = () => {
                if (!speechRecognition || !(purchaseSpeechButton instanceof HTMLButtonElement)) {
                    return;
                }
                if (isListeningToPurchaseNote) {
                    stopPurchaseSpeech();
                    return;
                }
                try {
                    isListeningToPurchaseNote = true;
                    purchaseSpeechButton.classList.add("is-listening");
                    if (purchaseSpeechLabel instanceof HTMLElement) {
                        purchaseSpeechLabel.textContent = "Đang nghe...";
                    }
                    speechRecognition.start();
                } catch {
                    stopPurchaseSpeech();
                    setStatus(cameraStatus, "Không thể bật micro lúc này.", "warning");
                }
            };

            const getSelectedPurchaseWork = () => Array.from(purchaseWorkOptions)
                .filter((checkbox) => checkbox instanceof HTMLInputElement && checkbox.checked)
                .map((checkbox) => checkbox.value.trim())
                .filter(Boolean)
                .join("; ");

            const getPurchaseNote = () => noteInput instanceof HTMLTextAreaElement ? noteInput.value.trim() : "";

            const validatePurchaseContent = () => {
                if (root.dataset.canAdminManageAttendance === "true" && !getPurchaseActionEmployeeId()) {
                    throw new Error("Vui lòng chọn nhân viên đi mua hàng.");
                }
                if (!getSelectedPurchaseWork()) {
                    throw new Error("Vui lòng chọn ít nhất một nội dung đi ra ngoài.");
                }
                if (!getPurchaseNote()) {
                    throw new Error("Vui lòng nhập ghi chú cho lượt đi ra ngoài.");
                }
            };

            const openCameraModal = async (mode) => {
                activeMode = mode;
                activeGps = null;
                resetPhoto();
                stopPurchaseSpeech();
                if (noteInput instanceof HTMLTextAreaElement) {
                    noteInput.value = "";
                    noteInput.placeholder = isPurchaseMode()
                        ? "Mua 02 bộ nguồn 12V và dây điện cho công trình ABC..."
                        : "";
                }
                if (purchaseFields instanceof HTMLElement) {
                    purchaseFields.hidden = !isPurchaseCheckinMode();
                }
                purchaseWorkOptions.forEach((checkbox) => {
                    if (checkbox instanceof HTMLInputElement) {
                        checkbox.checked = false;
                    }
                });
                if (purchaseQuickInput instanceof HTMLInputElement) {
                    purchaseQuickInput.checked = true;
                }
                if (purchaseEmployeeSelect instanceof HTMLSelectElement) {
                    purchaseEmployeeSelect.value = "";
                    purchaseEmployeeSelect.disabled = !isPurchaseCheckinMode();
                }
                if (purchaseTimeInput instanceof HTMLInputElement) {
                    purchaseTimeInput.value = formatDateTimeLocalValue(new Date());
                    purchaseTimeInput.disabled = !isPurchaseCheckinMode();
                }
                if (purchaseSpeechButton instanceof HTMLButtonElement) {
                    purchaseSpeechButton.hidden = !isPurchaseCheckinMode() || !isPurchaseSpeechSupported;
                }
                if (noteLabel instanceof HTMLElement) {
                    noteLabel.textContent = isPurchaseMode()
                        ? "Ghi chú chi tiết"
                        : mode === "checkout" ? "Ghi chú checkout" : "Ghi chú checkin";
                }
                if (timeInput instanceof HTMLInputElement) {
                    timeInput.value = formatDateTimeLocalValue(getSelectedDateWithCurrentTime());
                }
                if (timeField instanceof HTMLElement) {
                    timeField.hidden = isPurchaseCheckinMode() || (isPurchaseMode() && root.dataset.canAdminManageAttendance !== "true");
                }
                if (timeLabel instanceof HTMLElement) {
                    timeLabel.textContent = isPurchaseCheckoutMode()
                        ? "Thời gian checkout mua hàng"
                        : isPurchaseCheckinMode()
                            ? "Thời gian ghi nhận"
                            : mode === "checkout" ? "Thời gian checkout" : "Thời gian checkin";
                }
                if (cameraTitle) {
                    cameraTitle.textContent = isPurchaseMode()
                        ? "Đi mua hàng / Đi ra ngoài"
                        : mode === "checkout" ? "Chụp ảnh checkout" : "Chụp ảnh checkin";
                }
                if (cameraSubtitle) {
                    cameraSubtitle.textContent = isPurchaseMode()
                        ? "Đang chờ lấy vị trí GPS hiện tại."
                        : "Đang kiểm tra GPS và khoảng cách.";
                }
                if (cameraShell instanceof HTMLElement) {
                    cameraShell.hidden = false;
                    document.body.classList.add("modal-open");
                }
                setMapCollapsed(true);
                syncAttendanceMap(null);
                try {
                    activeGps = await resolveGps();
                    if (cameraSubtitle) {
                        cameraSubtitle.textContent = `GPS hiện tại: ${activeGps.lat.toFixed(5)}, ${activeGps.long.toFixed(5)}`;
                    }
                    syncAttendanceMap(activeGps);
                    await startCamera();
                    setStatus(cameraStatus, isPurchaseMode()
                        ? "Camera đã sẵn sàng. Vui lòng chụp ảnh để ghi nhận đi mua hàng."
                        : "Camera đã sẵn sàng. Vui lòng chụp ảnh chấm công.", "success");
                } catch (error) {
                    setStatus(cameraStatus, error instanceof Error ? error.message : "Không thể mở camera.", "error");
                }
            };

            const closeCameraModal = () => {
                stopCamera();
                stopPurchaseSpeech();
                resetPhoto();
                closeFullscreenMap();
                if (cameraShell instanceof HTMLElement) {
                    cameraShell.hidden = true;
                    document.body.classList.remove("modal-open");
                }
            };

            const postForm = async (url, values, imageBlob) => {
                const payload = new FormData();
                if (tokenInput instanceof HTMLInputElement) {
                    payload.append("__RequestVerificationToken", tokenInput.value);
                }
                Object.entries(values).forEach(([key, value]) => payload.append(key, `${value}`));
                if (imageBlob instanceof Blob) {
                    payload.append("imageFile", new File([imageBlob], `chamcong-${Date.now()}.jpg`, { type: "image/jpeg" }));
                }

                const response = await fetch(url, {
                    method: "POST",
                    body: payload,
                    headers: { "X-Requested-With": "XMLHttpRequest" }
                });
                const data = await response.json().catch(() => ({}));
                if (!response.ok || data.succeeded === false) {
                    throw new Error(data.message || "Không thể lưu chấm công.");
                }
                return data;
            };

            const getAttendanceEntryCount = (scope) => {
                if (Array.isArray(scope)) {
                    return scope.length;
                }
                if (scope instanceof HTMLElement) {
                    return scope.querySelectorAll(".cham-cong-attendance-line").length;
                }
                return 0;
            };

            const groupRenderedHistoryCards = () => {
                if (!(historyElement instanceof HTMLElement)) {
                    return;
                }
                const cards = Array.from(historyElement.querySelectorAll(".cham-cong-timeline-item"));
                const employeeCards = new Map();
                cards.forEach((card) => {
                    const employeeName = card.querySelector(".cham-cong-employee-name")?.textContent?.trim() || "";
                    const employeeId = card.dataset.employeeId || "";
                    const key = employeeId ? `id:${employeeId}` : employeeName.toLocaleLowerCase("vi-VN");
                    const currentSplit = card.querySelector(".cham-cong-split");
                    if (!key || !(currentSplit instanceof HTMLElement)) {
                        return;
                    }
                    const existingCard = employeeCards.get(key);
                    if (!existingCard) {
                        employeeCards.set(key, card);
                        return;
                    }

                    const existingSplit = existingCard.querySelector(".cham-cong-split");
                    if (!(existingSplit instanceof HTMLElement)) {
                        return;
                    }
                    currentSplit.querySelectorAll(".cham-cong-attendance-line").forEach((line) => {
                        existingSplit.appendChild(line);
                    });
                    if (card.classList.contains("is-pending") || card.classList.contains("is-open")) {
                        existingCard.classList.remove("is-complete");
                        existingCard.classList.add("is-pending", "is-open");
                    }
                    card.remove();
                });

                Array.from(historyElement.querySelectorAll(".cham-cong-timeline-item")).forEach((card, index) => {
                    card.style.order = `${index}`;
                });
            };

            const renderHistory = (items) => {
                if (!historyElement) {
                    return;
                }
                const sortedItems = [...items].sort((left, right) => {
                    const leftTime = Number.parseInt(left.checkinSortKey || "", 10) || parseHistoryDate(left.thoiDiem);
                    const rightTime = Number.parseInt(right.checkinSortKey || "", 10) || parseHistoryDate(right.thoiDiem);
                    return leftTime - rightTime || (Number(left.id) || 0) - (Number(right.id) || 0);
                });
                if (historyCount) {
                    historyCount.textContent = `${sortedItems.length} lượt`;
                }
                if (sortedItems.length === 0) {
                    historyElement.innerHTML = '<div class="cham-cong-empty">Chưa có dữ liệu chấm công trong ngày đã chọn.</div>';
                    updateHistoryCounter();
                    return;
                }

                const groupedItems = [];
                const groupedByEmployee = new Map();
                sortedItems.forEach((item) => {
                    const key = item.idNhanVien ? `id:${item.idNhanVien}` : `name:${item.hoTenNhanVien || "unknown"}`;
                    if (!groupedByEmployee.has(key)) {
                        const group = {
                            employeeId: item.idNhanVien || "",
                            employeeName: item.hoTenNhanVien || "Nhân viên",
                            items: []
                        };
                        groupedByEmployee.set(key, group);
                        groupedItems.push(group);
                    }
                    groupedByEmployee.get(key).items.push(item);
                });

                const buildEventSortKey = (value) => {
                    const parsed = parseHistoryDate(value);
                    return parsed === Number.MAX_SAFE_INTEGER ? Number.MAX_SAFE_INTEGER : parsed;
                };

                const buildPurchaseDetailAttributes = (item, employeeName) => {
                    if (!(item?.attendanceType === "MuaHang" || item?.isPurchase === true)) {
                        return "";
                    }
                    const workContent = Array.isArray(item.noiDungDiRaNgoai)
                        ? item.noiDungDiRaNgoai.join("||")
                        : "";
                    const attr = {
                        "data-purchase-detail-open": "",
                        "data-purchase-id": item.id || "",
                        "data-purchase-employee-name": employeeName || item.hoTenNhanVien || "",
                        "data-purchase-checkin-time": item.checkInTime || item.thoiDiem || "",
                        "data-purchase-checkout-time": item.checkoutTime || item.thoiDiemCheckOut || "",
                        "data-purchase-checkin-lat": item.checkInLat ?? item.latAddress ?? "",
                        "data-purchase-checkin-lng": item.checkInLng ?? item.longAddress ?? "",
                        "data-purchase-checkout-lat": item.checkoutLat ?? item.latAddressCheckOut ?? "",
                        "data-purchase-checkout-lng": item.checkoutLng ?? item.longAddressCheckOut ?? "",
                        "data-purchase-checkin-image": item.checkInImage || item.imgPath || "",
                        "data-purchase-checkout-image": item.checkoutImage || item.imgPathCheckOut || "",
                        "data-purchase-work-content": workContent,
                        "data-purchase-note": item.ghiChu || "",
                        "data-purchase-legacy": item.isLegacyPurchaseData === true ? "true" : "false",
                        "data-purchase-quick": item.isQuickPurchase === true ? "true" : "false",
                        "data-purchase-open": item.isOpen === true ? "true" : "false",
                        "data-purchase-can-delete": item.canDelete === true ? "true" : "false"
                    };
                    return Object.entries(attr)
                        .map(([name, value]) => name === "data-purchase-detail-open"
                            ? name
                            : `${name}="${escapeHtml(value)}"`)
                        .join(" ");
                };

                const renderEventLine = (event, employeeName) => {
                    const item = event.item;
                    const isCustomerCheckin = item.attendanceType === "KhachHang";
                    const isPurchaseCheckin = item.attendanceType === "MuaHang" || item.isPurchase === true;
                    const summary = item.requestSummary || {};
                    const workText = Array.isArray(summary.congViecs) ? summary.congViecs.join("||") : "";
                    const metaHtml = isCustomerCheckin
                        ? `<button type="button"
                                   class="cham-cong-request-chip"
                                   data-request-summary-open
                                   data-request-code="${escapeHtml(item.maYeuCau || "Phiếu yêu cầu")}"
                                   data-request-url="${escapeHtml(item.requestDetailUrl || "#")}"
                                   data-request-customer="${escapeHtml(summary.tenKhachHang || item.tenKhachHang || "Khách hàng chưa xác định")}"
                                   data-request-address="${escapeHtml(summary.diaChi || item.locationDisplayText || item.diaChi || "Chưa có địa chỉ")}"
                                   data-request-contact="${escapeHtml(summary.nguoiLienHe || "")}"
                                   data-request-phone="${escapeHtml(summary.dienThoai || "")}"
                                   data-request-works="${escapeHtml(workText)}">${escapeHtml(item.maYeuCau || "Phiếu yêu cầu")}</button>`
                        : isPurchaseCheckin
                            ? `<span class="cham-cong-entry-meta">${item.isQuickPurchase ? "Mua hàng · Nhanh" : "Mua hàng"}</span>${item.isQuickPurchase ? "" : `<span class="purchase-attendance-status">${item.isOpen ? "Đang đi" : "Hoàn tất"}</span>`}`
                            : '<span class="cham-cong-entry-meta">AppTech</span>';
                    const imagePath = event.isCheckout ? item.imgPathCheckOut : item.imgPath;
                    const isViolation = !isCustomerCheckin && !isPurchaseCheckin && (event.isCheckout ? item.isCheckoutViolation : item.isCheckinViolation);
                    const lineClass = event.isCheckout ? "is-checkout-complete" : "is-checkin";
                    const iconClass = isPurchaseCheckin ? "fa-cart-shopping" : event.isCheckout ? "fa-right-from-bracket" : "fa-right-to-bracket";
                    const label = isPurchaseCheckin
                        ? item.isQuickPurchase ? "mua hàng nhanh" : event.isCheckout ? "checkout mua hàng" : "check-in mua hàng"
                        : event.isCheckout ? "checkout" : "checkin";
                    const photo = imagePath
                        ? `<button type="button" class="cham-cong-entry-image-button" ${isPurchaseCheckin ? "data-purchase-detail-open" : `data-cham-cong-image-open data-image-src="${escapeHtml(imagePath)}" data-image-title="Ảnh ${label} ${escapeHtml(employeeName)}"`}><img src="${escapeHtml(imagePath)}" alt="Ảnh ${label}" /></button>`
                        : '<i class="fa-solid fa-image" aria-hidden="true"></i>';
                    return `
                        <section class="cham-cong-attendance-line ${lineClass} ${isViolation ? "is-attendance-violation" : ""} ${isPurchaseCheckin ? "is-purchase-event" : isCustomerCheckin ? "is-customer-event" : "is-company-event"}" ${buildPurchaseDetailAttributes(item, employeeName)}>
                            <div class="cham-cong-entry-photo">${photo}</div>
                            <div class="cham-cong-entry-content">
                                <strong><i class="fa-solid ${iconClass}" aria-hidden="true"></i>${escapeHtml(event.timeText || "--:--")}</strong>
                                ${metaHtml}
                            </div>
                        </section>`;
                };

                historyElement.innerHTML = groupedItems.map((group, index) => {
                    const events = [];
                    group.items.forEach((item) => {
                        if (item.thoiDiem) {
                            events.push({ item, isCheckout: false, sort: buildEventSortKey(item.thoiDiem), timeText: item.thoiDiem || item.checkinTime });
                        }
                        if (item.thoiDiemCheckOut && !item.isQuickPurchase && !(item.attendanceType === "MuaHang" || item.isPurchase === true)) {
                            events.push({ item, isCheckout: true, sort: buildEventSortKey(item.thoiDiemCheckOut), timeText: item.thoiDiemCheckOut || item.checkoutTime });
                        }
                    });
                    events.sort((left, right) => left.sort - right.sort || (Number(left.item.id) || 0) - (Number(right.item.id) || 0) || (left.isCheckout ? 1 : 0) - (right.isCheckout ? 1 : 0));
                    const hasOpen = group.items.some((item) => item.isOpen);
                    const hasCustomerCheckin = group.items.some((item) => item.attendanceType === "KhachHang");
                    const hasPurchaseCheckin = group.items.some((item) => item.attendanceType === "MuaHang" || item.isPurchase === true);
                    return `
                        <div class="cham-cong-timeline-item ${hasOpen ? "is-pending is-open" : "is-complete"} ${hasPurchaseCheckin ? "has-purchase-checkin" : hasCustomerCheckin ? "has-customer-checkin" : "has-company-checkin"}" data-employee-id="${escapeHtml(group.employeeId)}" style="order:${index};">
                            <div class="cham-cong-dot"></div>
                            <div class="cham-cong-split">
                                <strong class="cham-cong-employee-name">${escapeHtml(group.employeeName)}</strong>
                                ${events.map((event) => renderEventLine(event, group.employeeName)).join("")}
                            </div>
                        </div>`;
                }).join("");
                historyElement.scrollLeft = 0;
                updateHistoryCounter();
            };

            const escapeHtml = (value) => `${value ?? ""}`.replace(/[&<>"']/g, (character) => ({
                "&": "&amp;",
                "<": "&lt;",
                ">": "&gt;",
                '"': "&quot;",
                "'": "&#039;"
            }[character]));

            const parsePurchaseCoordinate = (value) => {
                const parsed = Number.parseFloat(`${value ?? ""}`);
                return Number.isFinite(parsed) ? parsed : null;
            };

            const isSamePurchasePoint = (left, right) => left && right
                && Math.abs(left.lat - right.lat) < 0.000001
                && Math.abs(left.lng - right.lng) < 0.000001;

            const getPurchaseDetailFromTrigger = (trigger) => {
                const source = trigger?.closest?.("[data-purchase-id]") || trigger;
                if (!(source instanceof HTMLElement)) {
                    return null;
                }
                const checkinPoint = {
                    lat: parsePurchaseCoordinate(source.dataset.purchaseCheckinLat),
                    lng: parsePurchaseCoordinate(source.dataset.purchaseCheckinLng)
                };
                const checkoutPoint = {
                    lat: parsePurchaseCoordinate(source.dataset.purchaseCheckoutLat),
                    lng: parsePurchaseCoordinate(source.dataset.purchaseCheckoutLng)
                };
                const hasCheckinPoint = checkinPoint.lat !== null && checkinPoint.lng !== null;
                const hasCheckoutPoint = checkoutPoint.lat !== null && checkoutPoint.lng !== null;
                return {
                    id: Number.parseInt(source.dataset.purchaseId || "", 10) || 0,
                    employeeName: source.dataset.purchaseEmployeeName || "Nhân viên",
                    checkinTime: source.dataset.purchaseCheckinTime || "",
                    checkoutTime: source.dataset.purchaseCheckoutTime || "",
                    checkinPoint: hasCheckinPoint ? checkinPoint : null,
                    checkoutPoint: hasCheckoutPoint ? checkoutPoint : null,
                    checkinImage: source.dataset.purchaseCheckinImage || "",
                    checkoutImage: source.dataset.purchaseCheckoutImage || "",
                    workContent: (source.dataset.purchaseWorkContent || "").split("||").map((item) => item.trim()).filter(Boolean),
                    note: source.dataset.purchaseNote || "",
                    isLegacy: source.dataset.purchaseLegacy === "true",
                    isQuick: source.dataset.purchaseQuick === "true",
                    isOpen: source.dataset.purchaseOpen === "true",
                    canDelete: source.dataset.purchaseCanDelete === "true"
                };
            };

            const getPurchaseStatusText = (detail) => detail?.isQuick
                ? "Nhanh"
                : detail?.isOpen ? "Đang đi" : "Hoàn tất";

            const setPurchaseDetailTab = (name) => {
                purchaseDetailTabs.forEach((tab) => {
                    if (tab instanceof HTMLButtonElement) {
                        const selected = tab.dataset.purchaseDetailTab === name;
                        tab.setAttribute("aria-selected", selected ? "true" : "false");
                    }
                });
                purchaseDetailPanels.forEach((panel) => {
                    if (panel instanceof HTMLElement) {
                        panel.hidden = panel.dataset.purchaseDetailPanel !== name;
                    }
                });
                if (name === "location") {
                    syncPurchaseDetailMap();
                    window.setTimeout(() => {
                        purchaseDetailMap?.invalidateSize(true);
                        syncPurchaseDetailMap();
                    }, 120);
                    window.setTimeout(() => {
                        purchaseDetailMap?.invalidateSize(true);
                        syncPurchaseDetailMap();
                    }, 420);
                }
            };

            const renderPurchaseDetailImages = (detail) => {
                if (!(purchaseDetailImages instanceof HTMLElement)) {
                    return;
                }
                const images = [];
                if (detail.checkinImage) {
                    images.push({ label: "Ảnh check-in", src: detail.checkinImage });
                }
                if (detail.checkoutImage && detail.checkoutImage !== detail.checkinImage) {
                    images.push({ label: "Ảnh checkout", src: detail.checkoutImage });
                }
                purchaseDetailImages.innerHTML = images.length
                    ? images.map((image) => `
                        <button type="button" class="purchase-detail-image" data-cham-cong-image-open data-image-src="${escapeHtml(image.src)}" data-image-title="${escapeHtml(image.label)} ${escapeHtml(detail.employeeName)}">
                            <span>${escapeHtml(image.label)}</span>
                            <img src="${escapeHtml(image.src)}" alt="${escapeHtml(image.label)}" />
                        </button>`).join("")
                    : '<div class="cham-cong-empty">Chưa có hình ảnh.</div>';
            };

            const formatPurchasePoint = (point) => point
                ? `${point.lat.toFixed(6)}, ${point.lng.toFixed(6)}`
                : "";

            const getGoogleMapsSearchUrl = (point) => `https://www.google.com/maps/search/?api=1&query=${point.lat},${point.lng}`;

            const getGoogleMapsDirectionsUrl = (point) => `https://www.google.com/maps/dir/?api=1&destination=${point.lat},${point.lng}`;

            const syncPurchaseDetailMap = () => {
                const detail = purchaseDetailCurrent;
                if (!detail || !(purchaseDetailMapElement instanceof HTMLElement)) {
                    return;
                }
                if (purchaseDetailMap) {
                    purchaseDetailMap.remove();
                    purchaseDetailMap = null;
                }
                purchaseDetailMarkers = [];
                const primaryPoint = detail.checkinPoint || detail.checkoutPoint;
                if (!primaryPoint) {
                    purchaseDetailMapElement.innerHTML = '<div class="cham-cong-empty">Chưa có tọa độ GPS.</div>';
                    return;
                }
                const query = encodeURIComponent(`${primaryPoint.lat},${primaryPoint.lng}`);
                purchaseDetailMapElement.innerHTML = `
                    <iframe
                        src="https://www.google.com/maps?q=${query}&z=17&output=embed"
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade"
                        title="Bản đồ vị trí đi mua hàng"></iframe>`;
            };

            const renderPurchaseDetailLocation = (detail) => {
                if (!(purchaseDetailDirections instanceof HTMLElement)) {
                    return;
                }
                const links = [];
                if (detail.checkinPoint) {
                    links.push({ label: "Check-in", actionLabel: "Chỉ đường tới vị trí check-in", time: detail.checkinTime, point: detail.checkinPoint });
                }
                if (detail.checkoutPoint && !isSamePurchasePoint(detail.checkinPoint, detail.checkoutPoint)) {
                    links.push({ label: "Checkout", actionLabel: "Chỉ đường tới vị trí checkout", time: detail.checkoutTime, point: detail.checkoutPoint });
                }
                if (purchaseDetailLocationList instanceof HTMLElement) {
                    purchaseDetailLocationList.innerHTML = links.length
                        ? links.map((link) => `
                            <div class="purchase-detail-location-card">
                                <strong>${escapeHtml(link.label)}</strong>
                                <span>${escapeHtml(link.time || "Chưa xác định")}</span>
                                <code>${escapeHtml(formatPurchasePoint(link.point))}</code>
                                <a href="${getGoogleMapsSearchUrl(link.point)}" target="_blank" rel="noopener noreferrer">
                                    <i class="fa-solid fa-map-location-dot" aria-hidden="true"></i>
                                    <span>Xem vị trí / địa chỉ trên Google Maps</span>
                                </a>
                            </div>`).join("")
                        : "";
                }
                purchaseDetailDirections.innerHTML = links.length
                    ? links.map((link) => `<a class="secondary-button" href="${getGoogleMapsDirectionsUrl(link.point)}" target="_blank" rel="noopener noreferrer"><i class="fa-solid fa-route" aria-hidden="true"></i><span>${escapeHtml(link.actionLabel)}</span></a>`).join("")
                    : '<div class="cham-cong-empty">Chưa có tọa độ GPS.</div>';
                syncPurchaseDetailMap();
            };

            const renderPurchaseDetailInfo = (detail) => {
                if (!(purchaseDetailInfo instanceof HTMLElement)) {
                    return;
                }
                const workHtml = detail.workContent.length > 0
                    ? `<ul>${detail.workContent.map((item) => `<li>${escapeHtml(item)}</li>`).join("")}</ul>`
                    : detail.isLegacy ? "Không xác định / Dữ liệu cũ" : "Chưa có dữ liệu";
                const checkoutHtml = detail.isQuick
                    ? ""
                    : `<div><dt>Checkout</dt><dd>${escapeHtml(detail.checkoutTime || "Chưa checkout")}</dd></div>`;
                purchaseDetailInfo.innerHTML = `
                    <div><dt>Nhân viên</dt><dd>${escapeHtml(detail.employeeName)}</dd></div>
                    <div><dt>Check-in</dt><dd>${escapeHtml(detail.checkinTime || "Chưa xác định")}</dd></div>
                    ${checkoutHtml}
                    <div><dt>Loại</dt><dd>${escapeHtml(detail.isQuick ? "Check-in nhanh" : getPurchaseStatusText(detail))}</dd></div>
                    <div><dt>Nội dung đi ra ngoài</dt><dd>${workHtml}</dd></div>
                    <div><dt>Ghi chú</dt><dd>${escapeHtml(detail.note || "Không có ghi chú")}</dd></div>`;
            };

            const openPurchaseDetail = (detail) => {
                if (!detail || !(purchaseDetailShell instanceof HTMLElement)) {
                    return;
                }
                purchaseDetailCurrent = detail;
                if (purchaseDetailSubtitle instanceof HTMLElement) {
                    purchaseDetailSubtitle.textContent = `${detail.employeeName} · ${detail.checkinTime || "Chưa xác định"}`;
                }
                if (purchaseDetailBadge instanceof HTMLElement) {
                    purchaseDetailBadge.textContent = getPurchaseStatusText(detail);
                }
                if (purchaseDetailDeleteButton instanceof HTMLButtonElement) {
                    purchaseDetailDeleteButton.hidden = !detail.canDelete;
                    purchaseDetailDeleteButton.dataset.purchaseDeleteId = `${detail.id}`;
                }
                renderPurchaseDetailImages(detail);
                renderPurchaseDetailLocation(detail);
                renderPurchaseDetailInfo(detail);
                setPurchaseDetailTab("images");
                purchaseDetailShell.hidden = false;
                document.body.classList.add("modal-open");
            };

            const closePurchaseDetail = () => {
                if (purchaseDetailShell instanceof HTMLElement) {
                    purchaseDetailShell.hidden = true;
                }
                purchaseDetailCurrent = null;
                if (!(imageViewerShell instanceof HTMLElement) || imageViewerShell.hidden) {
                    document.body.classList.remove("modal-open");
                }
            };

            const parseHistoryDate = (value) => {
                const match = `${value ?? ""}`.match(/^(\d{2})\/(\d{2})\/(\d{4})\s+(\d{2}):(\d{2})$/);
                if (!match) {
                    return Number.MAX_SAFE_INTEGER;
                }
                const [, day, month, year, hour, minute] = match;
                return new Date(Number(year), Number(month) - 1, Number(day), Number(hour), Number(minute)).getTime();
            };

            let historyScrollFrame = 0;
            const updateHistoryCounter = () => {
                if (!(historyCount instanceof HTMLElement) || !(historyElement instanceof HTMLElement)) {
                    return;
                }
                const items = Array.from(historyElement.querySelectorAll(".cham-cong-timeline-item"));
                if (items.length === 0) {
                    historyCount.textContent = mobileHistoryMedia.matches ? "0 / 0" : "0 lượt";
                    return;
                }
                if (!mobileHistoryMedia.matches) {
                    historyCount.textContent = `${getAttendanceEntryCount(historyElement)} lượt`;
                    return;
                }
                const nearestIndex = items.reduce((bestIndex, item, index) => {
                    const bestItem = items[bestIndex];
                    const bestDistance = Math.abs(bestItem.offsetLeft - historyElement.scrollLeft);
                    const itemDistance = Math.abs(item.offsetLeft - historyElement.scrollLeft);
                    return itemDistance < bestDistance ? index : bestIndex;
                }, 0);
                historyCount.textContent = `${nearestIndex + 1} / ${items.length}`;
            };

            const scheduleHistoryCounterUpdate = () => {
                window.cancelAnimationFrame(historyScrollFrame);
                historyScrollFrame = window.requestAnimationFrame(updateHistoryCounter);
            };

            const loadHistory = async () => {
                const url = new URL(root.dataset.historyUrl || "", window.location.origin);
                if (dateInput instanceof HTMLInputElement && dateInput.value) {
                    url.searchParams.set("date", dateInput.value);
                }
                employeeCheckboxes.forEach((checkbox) => {
                    if (checkbox instanceof HTMLInputElement && checkbox.checked && checkbox.value) {
                        url.searchParams.append("employeeIds", checkbox.value);
                    }
                });
                const response = await fetch(url, { headers: { "X-Requested-With": "XMLHttpRequest" } });
                const data = await response.json();
                if (!response.ok || data.succeeded === false) {
                    throw new Error(data.message || "Không thể tải lịch sử chấm công.");
                }
                root.dataset.openCheckinId = data.openCheckinId ? `${data.openCheckinId}` : "";
                root.dataset.openPurchaseCheckinId = data.openPurchaseCheckinId ? `${data.openPurchaseCheckinId}` : "";
                root.dataset.openPurchaseStartedAt = data.openPurchaseCheckin?.thoiDiem || "";
                root.dataset.openPurchaseNote = data.openPurchaseCheckin?.ghiChuNhanVien || "";
                root.dataset.actionEmployeeId = data.actionEmployeeId ? `${data.actionEmployeeId}` : "";
                renderHistory(Array.isArray(data.history) ? data.history : []);
                syncButtons();
            };

            const buildOpenPurchaseMessage = () => {
                const startedAt = (root.dataset.openPurchaseStartedAt || "").trim();
                const note = (root.dataset.openPurchaseNote || "").trim();
                const startedText = startedAt || "thời gian chưa xác định";
                if (note) {
                    return `${note} · bắt đầu lúc ${startedText}.`;
                }
                return `Đang có lượt đi mua hàng chưa hoàn tất từ ${startedText}.`;
            };

            const syncButtons = () => {
                const hasOpen = Boolean(root.dataset.openCheckinId);
                const hasOpenPurchase = Boolean(root.dataset.openPurchaseCheckinId);
                const canAct = canUseAttendanceAction();
                if (checkinButton instanceof HTMLButtonElement) {
                    checkinButton.hidden = hasOpen || !canAct;
                }
                if (checkoutButton instanceof HTMLButtonElement) {
                    checkoutButton.hidden = !hasOpen || !canAct;
                }
                if (purchaseCheckinButton instanceof HTMLButtonElement) {
                    purchaseCheckinButton.hidden = hasOpenPurchase || !canAct;
                }
                if (purchaseCheckoutButton instanceof HTMLButtonElement) {
                    purchaseCheckoutButton.hidden = !hasOpenPurchase || !canAct;
                }
                if (locationSelect instanceof HTMLSelectElement) {
                    locationSelect.disabled = hasOpen || !canAct;
                    const validOptions = Array.from(locationSelect.options).filter((option) => option.value);
                    const locationField = locationSelect.closest(".master-data-filter-field");
                    if (locationField instanceof HTMLElement) {
                        locationField.hidden = validOptions.length <= 1;
                        locationField.classList.toggle("cham-cong-location-hidden", validOptions.length <= 1);
                    }
                }
                if (hasOpenPurchase) {
                    setStatus(statusElement, buildOpenPurchaseMessage(), "info");
                }
            };

            const syncEmployeeSummary = () => {
                if (!(employeeSummary instanceof HTMLElement)) {
                    return;
                }
                const selectedNames = Array.from(employeeCheckboxes)
                    .filter((checkbox) => checkbox instanceof HTMLInputElement && checkbox.checked)
                    .map((checkbox) => checkbox.closest("label")?.textContent?.trim())
                    .filter(Boolean);
                employeeSummary.textContent = selectedNames.length === 0
                    ? "Chọn nhân viên"
                    : selectedNames.length === 1
                        ? selectedNames[0]
                        : `${selectedNames.length} nhân viên`;
                if (employeeAllCheckbox instanceof HTMLInputElement) {
                    employeeAllCheckbox.checked = selectedNames.length > 0 && selectedNames.length === employeeCheckboxes.length;
                    employeeAllCheckbox.indeterminate = selectedNames.length > 0 && selectedNames.length < employeeCheckboxes.length;
                }
            };

            const closeEmployeeMenu = () => {
                if (employeeMenu instanceof HTMLElement) {
                    employeeMenu.hidden = true;
                }
                employeeToggle?.setAttribute("aria-expanded", "false");
            };

            const syncImageViewerTransform = () => {
                if (imageViewerImg instanceof HTMLImageElement) {
                    imageViewerImg.style.transform = `scale(${imageZoom}) rotate(${imageRotation}deg)`;
                }
            };

            const openImageViewer = (src, title = "Ảnh chấm công") => {
                if (!src || !(imageViewerShell instanceof HTMLElement) || !(imageViewerImg instanceof HTMLImageElement)) {
                    return;
                }
                imageZoom = 1;
                imageRotation = 0;
                imageViewerImg.src = src;
                if (imageViewerTitle instanceof HTMLElement) {
                    imageViewerTitle.textContent = title || "Ảnh chấm công";
                }
                if (imageDownloadLink instanceof HTMLAnchorElement) {
                    imageDownloadLink.href = src;
                }
                syncImageViewerTransform();
                imageViewerShell.hidden = false;
                document.body.classList.add("modal-open");
            };

            const closeImageViewer = () => {
                if (imageViewerShell instanceof HTMLElement) {
                    imageViewerShell.hidden = true;
                }
                if (imageViewerImg instanceof HTMLImageElement) {
                    imageViewerImg.removeAttribute("src");
                }
                if (!(purchaseDetailShell instanceof HTMLElement) || purchaseDetailShell.hidden) {
                    document.body.classList.remove("modal-open");
                }
            };

            const setText = (element, value, fallback = "Chưa có thông tin") => {
                if (element instanceof HTMLElement) {
                    element.textContent = value && `${value}`.trim() ? value : fallback;
                }
            };

            const openRequestSummary = (button) => {
                if (!(requestSummaryShell instanceof HTMLElement)) {
                    return;
                }
                const code = button.dataset.requestCode || "Phiếu yêu cầu";
                setText(requestSummaryTitle, code, "Phiếu yêu cầu");
                setText(requestSummarySubtitle, "Thông tin cơ bản", "");
                setText(requestSummaryCustomer, button.dataset.requestCustomer, "Khách hàng chưa xác định");
                setText(requestSummaryAddress, button.dataset.requestAddress, "Chưa có địa chỉ");
                setText(requestSummaryContact, button.dataset.requestContact);
                setText(requestSummaryPhone, button.dataset.requestPhone);

                if (requestSummaryWorks instanceof HTMLElement) {
                    const works = (button.dataset.requestWorks || "")
                        .split("||")
                        .map((item) => item.trim())
                        .filter(Boolean);
                    requestSummaryWorks.innerHTML = works.length > 0
                        ? works.map((item) => `<li>${escapeHtml(item)}</li>`).join("")
                        : "<li>Chưa có công việc</li>";
                }

                if (requestSummaryDetail instanceof HTMLAnchorElement) {
                    requestSummaryDetail.href = button.dataset.requestUrl || "#";
                    requestSummaryDetail.classList.toggle("disabled", !button.dataset.requestUrl);
                }

                requestSummaryShell.hidden = false;
                document.body.classList.add("modal-open");
            };

            const closeRequestSummary = () => {
                if (requestSummaryShell instanceof HTMLElement) {
                    requestSummaryShell.hidden = true;
                }
                document.body.classList.remove("modal-open");
            };

            const saveAttendance = async () => {
                if (!activeGps) {
                    setStatus(cameraStatus, "Vui lòng cấp quyền GPS để lấy vị trí.", "error");
                    return;
                }
                if (!capturedBlob) {
                    setStatus(cameraStatus, isPurchaseMode() ? "Vui lòng chụp ảnh khi ghi nhận đi mua hàng." : "Vui lòng chụp ảnh trước khi lưu.", "error");
                    return;
                }
                try {
                    if (saveButton instanceof HTMLButtonElement) {
                        saveButton.disabled = true;
                    }
                    if (activeMode === "purchase-checkout") {
                        const openId = root.dataset.openPurchaseCheckinId;
                        if (!openId) {
                            throw new Error("Không có lượt đi mua hàng đang mở để checkout.");
                        }
                        await postForm(root.dataset.purchaseCheckoutUrl || "", {
                            Id: openId,
                            IDNhanVien: getSelectedActionEmployeeId() || "",
                            ThoiDiemCheckOut: timeInput instanceof HTMLInputElement ? timeInput.value : "",
                            LongAddressCheckOut: activeGps.long,
                            LatAddressCheckOut: activeGps.lat,
                            GhiChuCheckOut: noteInput instanceof HTMLTextAreaElement ? noteInput.value : ""
                        }, capturedBlob);
                        root.dataset.openPurchaseCheckinId = "";
                        setStatus(statusElement, "Đã lưu checkout mua hàng.", "success");
                    } else if (activeMode === "checkout") {
                        const openId = root.dataset.openCheckinId;
                        if (!openId) {
                            throw new Error("Không có lượt checkin đang mở để checkout.");
                        }
                        await postForm(root.dataset.checkoutUrl || "", {
                            Id: openId,
                            IDNhanVien: getSelectedActionEmployeeId() || "",
                            ThoiDiemCheckOut: timeInput instanceof HTMLInputElement ? timeInput.value : "",
                            LongAddressCheckOut: activeGps.long,
                            LatAddressCheckOut: activeGps.lat,
                            GhiChuCheckOut: noteInput instanceof HTMLTextAreaElement ? noteInput.value : ""
                        }, capturedBlob);
                        root.dataset.openCheckinId = "";
                        setStatus(statusElement, "Đã lưu checkout chấm công.", "success");
                    } else if (activeMode === "purchase-checkin") {
                        validatePurchaseContent();
                        await postForm(root.dataset.purchaseCheckinUrl || "", {
                            IDNhanVien: getPurchaseActionEmployeeId() || "",
                            ThoiDiem: getPurchaseCheckinTimeValue(),
                            LongAddress: activeGps.long,
                            LatAddress: activeGps.lat,
                            NoiDungCongViec: getSelectedPurchaseWork(),
                            GhiChuNhanVien: getPurchaseNote(),
                            QuickCheckin: purchaseQuickInput instanceof HTMLInputElement ? purchaseQuickInput.checked : true
                        }, capturedBlob);
                        setStatus(statusElement, "Đã lưu lượt đi mua hàng.", "success");
                    } else {
                        const location = getSelectedLocation();
                        if (!location) {
                            throw new Error("Vui lòng chọn địa điểm chấm công.");
                        }
                        validateDistance(activeGps);
                        await postForm(root.dataset.checkinUrl || "", {
                            IDDiaDiem: location.id,
                            IDNhanVien: getSelectedActionEmployeeId() || "",
                            ThoiDiem: timeInput instanceof HTMLInputElement ? timeInput.value : "",
                            LongAddress: activeGps.long,
                            LatAddress: activeGps.lat,
                            GhiChuNhanVien: noteInput instanceof HTMLTextAreaElement ? noteInput.value : ""
                        }, capturedBlob);
                        setStatus(statusElement, "Đã lưu checkin chấm công.", "success");
                    }
                    closeCameraModal();
                    await loadHistory();
                } catch (error) {
                    setStatus(cameraStatus, error instanceof Error ? error.message : "Không thể lưu chấm công.", "error");
                } finally {
                    if (saveButton instanceof HTMLButtonElement) {
                        saveButton.disabled = false;
                    }
                }
            };

            const deletePurchaseAttendance = async (button) => {
                if (!(button instanceof HTMLButtonElement)) {
                    return;
                }

                const id = Number.parseInt(button.dataset.purchaseDeleteId || "", 10);
                if (!Number.isFinite(id) || id <= 0) {
                    setStatus(statusElement, "Không xác định được lượt đi mua hàng cần xóa.", "error");
                    return;
                }

                if (!window.confirm("Bạn có chắc muốn xóa lượt đi mua hàng này?")) {
                    return;
                }

                try {
                    button.disabled = true;
                    await postForm(root.dataset.purchaseDeleteUrl || "", { Id: id });
                    setStatus(statusElement, "Đã xóa lượt đi mua hàng.", "success");
                    closePurchaseDetail();
                    await loadHistory();
                } catch (error) {
                    setStatus(statusElement, error instanceof Error ? error.message : "Không thể xóa lượt đi mua hàng.", "error");
                } finally {
                    button.disabled = false;
                }
            };

            checkinButton?.addEventListener("click", () => void openCameraModal("checkin"));
            checkoutButton?.addEventListener("click", () => void openCameraModal("checkout"));
            purchaseCheckinButton?.addEventListener("click", () => void openCameraModal("purchase-checkin"));
            purchaseCheckoutButton?.addEventListener("click", () => void openCameraModal("purchase-checkout"));
            purchaseSpeechButton?.addEventListener("click", togglePurchaseSpeech);
            purchaseDetailTabs.forEach((tab) => tab.addEventListener("click", () => {
                if (tab instanceof HTMLButtonElement) {
                    setPurchaseDetailTab(tab.dataset.purchaseDetailTab || "images");
                }
            }));
            purchaseDetailCloseButtons.forEach((button) => button.addEventListener("click", closePurchaseDetail));
            purchaseDetailDeleteButton?.addEventListener("click", () => void deletePurchaseAttendance(purchaseDetailDeleteButton));
            purchaseDetailImages?.addEventListener("click", (event) => {
                const trigger = event.target instanceof Element
                    ? event.target.closest("[data-cham-cong-image-open]")
                    : null;
                if (!(trigger instanceof HTMLElement)) {
                    return;
                }
                const src = trigger.dataset.imageSrc || trigger.querySelector("img")?.getAttribute("src") || "";
                const title = trigger.dataset.imageTitle || trigger.querySelector("img")?.getAttribute("alt") || "Ảnh đi mua hàng";
                openImageViewer(src, title);
            });
            historyElement?.addEventListener("click", (event) => {
                const button = event.target instanceof Element
                    ? event.target.closest("[data-purchase-delete]")
                    : null;
                if (button instanceof HTMLButtonElement) {
                    void deletePurchaseAttendance(button);
                }
            });
            mapToggle?.addEventListener("click", () => {
                const expanded = mapToggle.getAttribute("aria-expanded") === "true";
                setMapCollapsed(expanded);
                if (expanded) {
                    return;
                }
                syncAttendanceMap(activeGps);
            });
            captureButton?.addEventListener("click", () => void capturePhoto());
            retakeButton?.addEventListener("click", () => resetPhoto());
            saveButton?.addEventListener("click", () => void saveAttendance());
            mapFullscreenOpen?.addEventListener("click", openFullscreenMap);
            refreshGpsButton?.addEventListener("click", () => void refreshGps());
            cameraSelect?.addEventListener("change", () => {
                if (cameraSelect instanceof HTMLSelectElement) {
                    selectedAttendanceCameraId = cameraSelect.value;
                }
                if (cameraStream && cameraShell instanceof HTMLElement && !cameraShell.hidden) {
                    void startCamera().catch((error) => {
                        setStatus(cameraStatus, error instanceof Error ? error.message : "Khong the doi camera.", "error");
                    });
                }
            });
            mapFullscreenRefreshButton?.addEventListener("click", refreshFullscreenMap);
            mapFullscreenRouteButton?.addEventListener("click", () => void loadFullscreenRoute());
            mapFullscreenCloseButtons.forEach((button) => button.addEventListener("click", closeFullscreenMap));
            cameraCloseButtons.forEach((button) => button.addEventListener("click", closeCameraModal));
            imageViewerCloseButtons.forEach((button) => button.addEventListener("click", closeImageViewer));
            requestSummaryCloseButtons.forEach((button) => button.addEventListener("click", closeRequestSummary));
            imageZoomInButton?.addEventListener("click", () => {
                imageZoom = Math.min(4, Number((imageZoom + 0.25).toFixed(2)));
                syncImageViewerTransform();
            });
            imageZoomOutButton?.addEventListener("click", () => {
                imageZoom = Math.max(0.25, Number((imageZoom - 0.25).toFixed(2)));
                syncImageViewerTransform();
            });
            imageRotateButton?.addEventListener("click", () => {
                imageRotation = (imageRotation + 90) % 360;
                syncImageViewerTransform();
            });
            document.addEventListener("keydown", (event) => {
                if (event.key === "Escape"
                    && imageViewerShell instanceof HTMLElement
                    && !imageViewerShell.hidden) {
                    closeImageViewer();
                }
                if (event.key === "Escape"
                    && requestSummaryShell instanceof HTMLElement
                    && !requestSummaryShell.hidden) {
                    closeRequestSummary();
                }
                if (event.key === "Escape"
                    && purchaseDetailShell instanceof HTMLElement
                    && !purchaseDetailShell.hidden) {
                    closePurchaseDetail();
                }
            });
            historyElement?.addEventListener("click", (event) => {
                const purchaseTrigger = event.target instanceof Element
                    ? event.target.closest("[data-purchase-detail-open]")
                    : null;
                if (purchaseTrigger instanceof HTMLElement) {
                    event.preventDefault();
                    event.stopImmediatePropagation();
                    openPurchaseDetail(getPurchaseDetailFromTrigger(purchaseTrigger));
                    return;
                }

                const requestTrigger = event.target instanceof Element
                    ? event.target.closest("[data-request-summary-open]")
                    : null;
                if (requestTrigger instanceof HTMLElement) {
                    openRequestSummary(requestTrigger);
                    return;
                }

                const trigger = event.target instanceof Element
                    ? event.target.closest("[data-cham-cong-image-open], .cham-cong-entry-photo img")
                    : null;
                if (!trigger) {
                    return;
                }
                const button = trigger.closest("[data-cham-cong-image-open]");
                const img = trigger instanceof HTMLImageElement ? trigger : trigger.querySelector("img");
                const src = button?.dataset.imageSrc || img?.getAttribute("src") || "";
                const title = button?.dataset.imageTitle || img?.getAttribute("alt") || "Ảnh chấm công";
                openImageViewer(src, title);
            });
            dateStepButtons.forEach((button) => {
                button.addEventListener("click", () => {
                    const dayDelta = Number.parseInt(button.dataset.chamCongDateStep || "", 10);
                    shiftSelectedDate(dayDelta);
                });
            });
            dateInput?.addEventListener("change", async () => {
                try {
                    setStatus(statusElement, "Đang tải lịch sử chấm công...", "info");
                    await loadHistory();
                    setStatus(statusElement, "Đã tải lịch sử chấm công.", "success");
                } catch (error) {
                    setStatus(statusElement, error instanceof Error ? error.message : "Không thể tải lịch sử chấm công.", "error");
                }
            });
            employeeToggle?.addEventListener("click", () => {
                if (!(employeeMenu instanceof HTMLElement)) {
                    return;
                }
                const willOpen = employeeMenu.hidden;
                employeeMenu.hidden = !willOpen;
                employeeToggle.setAttribute("aria-expanded", willOpen ? "true" : "false");
            });
            employeeAllCheckbox?.addEventListener("change", async () => {
                if (!(employeeAllCheckbox instanceof HTMLInputElement)) {
                    return;
                }
                employeeCheckboxes.forEach((checkbox) => {
                    if (checkbox instanceof HTMLInputElement) {
                        checkbox.checked = employeeAllCheckbox.checked;
                    }
                });
                syncEmployeeSummary();
                try {
                    setStatus(statusElement, "Đang tải lịch sử chấm công...", "info");
                    await loadHistory();
                    setStatus(statusElement, "Đã tải lịch sử chấm công.", "success");
                } catch (error) {
                    setStatus(statusElement, error instanceof Error ? error.message : "Không thể tải lịch sử chấm công.", "error");
                }
            });
            employeeCheckboxes.forEach((checkbox) => checkbox.addEventListener("change", async () => {
                syncEmployeeSummary();
                try {
                    setStatus(statusElement, "Đang tải lịch sử chấm công...", "info");
                    await loadHistory();
                    setStatus(statusElement, "Đã tải lịch sử chấm công.", "success");
                } catch (error) {
                    setStatus(statusElement, error instanceof Error ? error.message : "Không thể tải lịch sử chấm công.", "error");
                }
            }));
            document.addEventListener("click", (event) => {
                if (employeePicker instanceof HTMLElement && !employeePicker.contains(event.target)) {
                    closeEmployeeMenu();
                }
            });
            historyElement?.addEventListener("scroll", scheduleHistoryCounterUpdate, { passive: true });
            window.addEventListener("resize", scheduleHistoryCounterUpdate);
            mobileHistoryMedia.addEventListener?.("change", updateHistoryCounter);

            initPurchaseSpeech();
