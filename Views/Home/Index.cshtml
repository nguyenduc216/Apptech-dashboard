@model DashboardViewModel
@{
    ViewData["Title"] = Model.DashboardTitle;
    var chamCong = Model.ChamCong;
    var invariantCulture = System.Globalization.CultureInfo.InvariantCulture;
    var isolateChamCongDashboard = true;
    var allChamCongEmployeesSelected = chamCong.EmployeeOptions.Count > 0 &&
        chamCong.SelectedEmployeeIds.Count >= chamCong.EmployeeOptions.Count;

    string GetPriorityClass(string priority) => priority switch
    {
        "Cao" => "cao",
        "Trung bình" => "trung-binh",
        "Thấp" => "thap",
        _ => "thap"
    };
}

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
          integrity="sha256-p4NxAoJBhIINfQ8QzPI5Z7nU03RLX10PVtPY3GqB4iI="
          crossorigin="" />
}

@if (!isolateChamCongDashboard)
{
<section class="hero-panel">
    <div>
        <div class="eyebrow">GIÁM SÁT TRUNG TÂM</div>
        <h2>@Model.CompanyName</h2>
        <p>@Model.Subtitle</p>
    </div>
    <div class="hero-stats">
        <div class="hero-pill">
            <span>Khách hàng đang kết nối</span>
            <strong>32 công trình</strong>
        </div>
        <div class="hero-pill">
            <span>Tỷ lệ hệ thống ổn định</span>
            <strong>94.8%</strong>
        </div>
    </div>
</section>

<section class="metrics-grid">
    @foreach (var item in Model.MetricCards)
    {
        <article class="metric-card @item.Variant">
            <div class="metric-title">@item.Title</div>
            <div class="metric-value">@item.Value</div>
            <div class="metric-note">@item.Note</div>
        </article>
    }
</section>
}

<section class="panel cham-cong-panel"
         data-cham-cong
         data-history-url="@Url.Action("ChamCongHistory", "Home")"
         data-checkin-url="@Url.Action("ChamCongCheckin", "Home")"
         data-checkout-url="@Url.Action("ChamCongCheckout", "Home")"
         data-purchase-checkin-url="@Url.Action("MuaHangCheckin", "Home")"
         data-purchase-checkout-url="@Url.Action("MuaHangCheckout", "Home")"
         data-purchase-delete-url="@Url.Action("MuaHangDelete", "Home")"
         data-distance-limit="@(chamCong.CheckinDistanceLimitMeters?.ToString(invariantCulture) ?? "")"
         data-current-employee-id="@(chamCong.CurrentEmployeeId?.ToString(invariantCulture) ?? "")"
         data-action-employee-id="@(chamCong.SelectedEmployeeIds.FirstOrDefault(chamCong.CurrentEmployeeId ?? 0).ToString(invariantCulture))"
         data-can-select-employees="@chamCong.CanSelectEmployees.ToString().ToLowerInvariant()"
         data-can-admin-manage-attendance="@chamCong.CanAdminManageAttendance.ToString().ToLowerInvariant()"
         data-today-date="@DateTime.Today.ToString("yyyy-MM-dd")"
         data-open-checkin-id="@(chamCong.OpenCheckin?.Id.ToString(invariantCulture) ?? "")"
         data-open-purchase-checkin-id="@(chamCong.OpenPurchaseCheckin?.Id.ToString(invariantCulture) ?? "")"
         data-open-purchase-started-at="@(chamCong.OpenPurchaseCheckin?.ThoiDiem?.ToString("dd/MM/yyyy HH:mm") ?? "")"
         data-open-purchase-note="@(chamCong.OpenPurchaseCheckin?.GhiChuNhanVien ?? "")">
    <div class="panel-header">
        <div>
            <h3>Chấm công</h3>
            <p>Checkin tại địa điểm khách hàng AppTech và theo dõi lịch sử trong ngày.</p>
        </div>
        <form class="cham-cong-date-form" method="get" asp-action="Index">
            <label class="master-data-filter-field" for="chamCongDate">
                <span>Ngày xem</span>
                <span class="cham-cong-date-stepper">
                    <button type="button"
                            class="cham-cong-date-step-button"
                            data-cham-cong-date-step="-1"
                            aria-label="Ngày trước"
                            title="Ngày trước">
                        <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
                    </button>
                    <span class="login-input-shell">
                        <i class="fa-solid fa-calendar-day" aria-hidden="true"></i>
                        <input id="chamCongDate"
                               name="chamCongDate"
                               type="date"
                               value="@chamCong.SelectedDate.ToString("yyyy-MM-dd")"
                               data-cham-cong-date />
                    </span>
                    <button type="button"
                            class="cham-cong-date-step-button"
                            data-cham-cong-date-step="1"
                            aria-label="Ngày sau"
                            title="Ngày sau">
                        <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
                    </button>
                </span>
            </label>
            @if (chamCong.CanSelectEmployees)
            {
                <label class="master-data-filter-field" for="chamCongEmployees">
                    <span>Nhân viên</span>
                    <span class="cham-cong-employee-picker" data-cham-cong-employee-picker>
                        <button type="button"
                                class="login-input-shell cham-cong-employee-picker-button"
                                id="chamCongEmployees"
                                data-cham-cong-employee-toggle
                                aria-expanded="false">
                            <i class="fa-solid fa-users" aria-hidden="true"></i>
                            <span data-cham-cong-employee-summary>Chọn nhân viên</span>
                            <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
                        </button>
                        <span class="cham-cong-employee-menu" data-cham-cong-employee-menu hidden>
                            <label class="cham-cong-employee-choice cham-cong-employee-choice-all">
                                <input type="checkbox"
                                       checked="@allChamCongEmployeesSelected"
                                       data-cham-cong-employee-all />
                                <span>Tất cả nhân viên</span>
                            </label>
                            @foreach (var employee in chamCong.EmployeeOptions)
                            {
                                <label class="cham-cong-employee-choice">
                                    <input type="checkbox"
                                           name="employeeIds"
                                           value="@employee.Id"
                                           checked="@chamCong.SelectedEmployeeIds.Contains(employee.Id)"
                                           data-cham-cong-employee-checkbox />
                                    <span>@employee.HoTen</span>
                                </label>
                            }
                        </span>
                    </span>
                </label>
            }
        </form>
    </div>

    @Html.AntiForgeryToken()

    <div class="cham-cong-body">
        <div class="cham-cong-timeline">
            <div class="cham-cong-timeline-head">
                <strong>Lịch sử chấm công</strong>
                <span data-cham-cong-history-count>@chamCong.History.Count lượt</span>
            </div>
            <div class="cham-cong-timeline-list" data-cham-cong-history>
                @if (chamCong.History.Count == 0)
                {
                    <div class="cham-cong-empty">Chưa có dữ liệu chấm công trong ngày đã chọn.</div>
                }
                else
                {
                    var orderedHistory = chamCong.History
                        .OrderBy(item => item.ThoiDiem ?? DateTime.MaxValue)
                        .ThenBy(item => item.Id)
                        .ToList();
                    var groupedHistory = orderedHistory
                        .GroupBy(item => item.IDNhanVien?.ToString(invariantCulture) ?? item.HoTenNhanVien ?? "unknown")
                        .ToList();
                    for (var historyIndex = 0; historyIndex < groupedHistory.Count; historyIndex++)
                    {
                        var group = groupedHistory[historyIndex].ToList();
                        var firstItem = group.First();
                        var hasOpenItem = group.Any(item => item.IsOpen);
                        var hasCustomerCheckin = group.Any(item => string.Equals(item.AttendanceType, "KhachHang", StringComparison.OrdinalIgnoreCase));
                        var hasPurchaseCheckin = group.Any(item => string.Equals(item.AttendanceType, "MuaHang", StringComparison.OrdinalIgnoreCase));
                        var employeeName = firstItem.HoTenNhanVien ?? "Nhân viên";
                        var eventItems = group
                            .SelectMany(item => item.IsPurchase || item.IsQuickPurchase
                                ? new[] { new { Item = item, IsCheckout = false, EventTime = item.ThoiDiem, ImagePath = item.ImgPath, IsViolation = item.IsCheckinViolation } }
                                : new[]
                                {
                                    new { Item = item, IsCheckout = false, EventTime = item.ThoiDiem, ImagePath = item.ImgPath, IsViolation = item.IsCheckinViolation },
                                    new { Item = item, IsCheckout = true, EventTime = item.ThoiDiemCheckOut, ImagePath = item.ImgPathCheckOut, IsViolation = item.IsCheckoutViolation }
                                })
                            .Where(entry => entry.EventTime.HasValue)
                            .OrderBy(entry => entry.EventTime)
                            .ThenBy(entry => entry.Item.Id)
                            .ThenBy(entry => entry.IsCheckout ? 1 : 0)
                            .ToList();
                        <div class="cham-cong-timeline-item @(hasOpenItem ? "is-pending is-open" : "is-complete") @(hasPurchaseCheckin ? "has-purchase-checkin" : hasCustomerCheckin ? "has-customer-checkin" : "has-company-checkin")" data-employee-id="@(firstItem.IDNhanVien?.ToString(invariantCulture) ?? "")" style="order:@historyIndex">
                            <div class="cham-cong-dot"></div>
                            <div class="cham-cong-split">
                                <strong class="cham-cong-employee-name">@employeeName</strong>
                                @foreach (var entry in eventItems)
                                {
                                    var item = entry.Item;
                                    var isCustomerCheckin = string.Equals(item.AttendanceType, "KhachHang", StringComparison.OrdinalIgnoreCase);
                                    var isPurchaseCheckin = string.Equals(item.AttendanceType, "MuaHang", StringComparison.OrdinalIgnoreCase);
                                    var requestDetailUrl = item.IDYeuCau.HasValue
                                        ? Url.Action("Edit", "YeuCau", new { id = item.IDYeuCau.Value })
                                        : null;
                                    var eventClass = entry.IsCheckout ? "is-checkout-complete" : "is-checkin";
                                    var eventIcon = isPurchaseCheckin ? "fa-cart-shopping" : entry.IsCheckout ? "fa-right-from-bracket" : "fa-right-to-bracket";
                                    var eventLabel = isPurchaseCheckin
                                        ? (item.IsQuickPurchase ? "Mua hàng nhanh" : entry.IsCheckout ? "Checkout mua hàng" : "Check-in mua hàng")
                                        : entry.IsCheckout ? "Checkout" : "Checkin";
                                    var metaText = isCustomerCheckin ? item.MaYeuCau : isPurchaseCheckin ? "Mua hàng" : "AppTech";
                                    var purchaseStatus = item.IsQuickPurchase ? "Nhanh" : item.IsOpen ? "Đang đi" : "Hoàn tất";
                                    <section class="cham-cong-attendance-line @eventClass @(!isCustomerCheckin && !isPurchaseCheckin && entry.IsViolation ? "is-attendance-violation" : "") @(isPurchaseCheckin ? "is-purchase-event" : isCustomerCheckin ? "is-customer-event" : "is-company-event")"
                                             @(isPurchaseCheckin ? "data-purchase-detail-open" : null)
                                             data-purchase-id="@(isPurchaseCheckin ? item.Id.ToString(invariantCulture) : null)"
                                             data-purchase-employee-name="@(isPurchaseCheckin ? employeeName : null)"
                                             data-purchase-checkin-time="@(isPurchaseCheckin ? item.ThoiDiem?.ToString("dd/MM/yyyy HH:mm") : null)"
                                             data-purchase-checkout-time="@(isPurchaseCheckin ? item.ThoiDiemCheckOut?.ToString("dd/MM/yyyy HH:mm") : null)"
                                             data-purchase-checkin-lat="@(isPurchaseCheckin ? item.LatAddress?.ToString(invariantCulture) : null)"
                                             data-purchase-checkin-lng="@(isPurchaseCheckin ? item.LongAddress?.ToString(invariantCulture) : null)"
                                             data-purchase-checkout-lat="@(isPurchaseCheckin ? item.LatAddressCheckOut?.ToString(invariantCulture) : null)"
                                             data-purchase-checkout-lng="@(isPurchaseCheckin ? item.LongAddressCheckOut?.ToString(invariantCulture) : null)"
                                             data-purchase-checkin-image="@(isPurchaseCheckin ? item.ImgPath : null)"
                                             data-purchase-checkout-image="@(isPurchaseCheckin ? item.ImgPathCheckOut : null)"
                                             data-purchase-work-content="@(isPurchaseCheckin ? string.Join("||", item.PurchaseWorkContent) : null)"
                                             data-purchase-note="@(isPurchaseCheckin ? item.PurchaseNote : null)"
                                             data-purchase-legacy="@(isPurchaseCheckin ? item.HasLegacyPurchaseNote.ToString().ToLowerInvariant() : null)"
                                             data-purchase-quick="@(isPurchaseCheckin ? item.IsQuickPurchase.ToString().ToLowerInvariant() : null)"
                                             data-purchase-open="@(isPurchaseCheckin ? item.IsOpen.ToString().ToLowerInvariant() : null)"
                                             data-purchase-can-delete="@(isPurchaseCheckin ? chamCong.CanAdminManageAttendance.ToString().ToLowerInvariant() : null)">
                                        <div class="cham-cong-entry-photo">
                                            @if (!string.IsNullOrWhiteSpace(entry.ImagePath))
                                            {
                                                <button type="button" class="cham-cong-entry-image-button" data-cham-cong-image-open data-image-src="@entry.ImagePath" data-image-title="Ảnh @eventLabel.ToLowerInvariant() @employeeName">
                                                    <img src="@entry.ImagePath" alt="Ảnh @eventLabel.ToLowerInvariant()" />
                                                </button>
                                            }
                                            else
                                            {
                                                <i class="fa-solid fa-image" aria-hidden="true"></i>
                                            }
                                        </div>
                                        <div class="cham-cong-entry-content">
                                            <strong><i class="fa-solid @eventIcon" aria-hidden="true"></i>@entry.EventTime?.ToString("dd/MM/yyyy HH:mm")</strong>
                                            @if (isCustomerCheckin && item.IDYeuCau.HasValue)
                                            {
                                                var works = (item.DanhSachCongViec ?? string.Empty)
                                                    .Split("||", StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
                                                <button type="button"
                                                        class="cham-cong-request-chip"
                                                        data-request-summary-open
                                                        data-request-code="@item.MaYeuCau"
                                                        data-request-url="@requestDetailUrl"
                                                        data-request-customer="@item.CustomerDisplayName"
                                                        data-request-address="@item.LocationDisplayText"
                                                        data-request-contact="@item.NguoiLienHe"
                                                        data-request-phone="@item.DienThoai"
                                                        data-request-works="@string.Join("||", works)">
                                                    @(string.IsNullOrWhiteSpace(metaText) ? "Phiếu yêu cầu" : metaText)
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="cham-cong-entry-meta">@(isPurchaseCheckin ? (item.IsQuickPurchase ? "Mua hàng · Nhanh" : metaText) : "AppTech")</span>
                                                @if (isPurchaseCheckin && !item.IsQuickPurchase)
                                                {
                                                    <span class="purchase-attendance-status">@purchaseStatus</span>
                                                }
                                            }
                                        </div>
                                    </section>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        <div class="cham-cong-control">
            <label class="master-data-filter-field @(chamCong.LocationOptions.Count <= 1 ? "cham-cong-location-hidden" : "")" for="chamCongLocation">
                <span>Địa điểm AppTech</span>
                <span class="login-input-shell select-shell">
                    <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
                    <select id="chamCongLocation" data-cham-cong-location @(chamCong.OpenCheckin is not null ? "disabled" : null)>
                        @if (chamCong.LocationOptions.Count == 0)
                        {
                            <option value="">Chưa có địa điểm AppTech</option>
                        }
                        else
                        {
                            @foreach (var location in chamCong.LocationOptions)
                            {
                                <option value="@location.IDDiaDiem"
                                        data-lat="@(location.LatAddress?.ToString(invariantCulture) ?? "")"
                                        data-long="@(location.LongAddress?.ToString(invariantCulture) ?? "")">
                                    @location.DisplayText
                                </option>
                            }
                        }
                    </select>
                    <span class="select-indicator"><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></span>
                </span>
            </label>

            <div class="cham-cong-actions">
                <button type="button"
                        class="primary-button"
                        data-cham-cong-checkin
                        @(chamCong.OpenCheckin is null && chamCong.CanCheckin ? null : "hidden")>
                    <span class="button-content">
                        <i class="fa-solid fa-right-to-bracket" aria-hidden="true"></i>
                        <span>Checkin</span>
                    </span>
                </button>
                <button type="button"
                        class="primary-button"
                        data-cham-cong-checkout
                        @(chamCong.OpenCheckin is not null ? null : "hidden")>
                    <span class="button-content">
                        <i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i>
                        <span>Checkout</span>
                    </span>
                </button>
                <button type="button"
                        class="secondary-button purchase-attendance-button"
                        data-purchase-checkin
                        @(chamCong.OpenPurchaseCheckin is null && (chamCong.CurrentEmployeeId.HasValue || chamCong.CanSelectEmployees) ? null : "hidden")>
                    <i class="fa-solid fa-cart-shopping" aria-hidden="true"></i>
                    <span>Đi mua hàng</span>
                </button>
                <button type="button"
                        class="secondary-button purchase-attendance-button is-active"
                        data-purchase-checkout
                        @(chamCong.OpenPurchaseCheckin is not null ? null : "hidden")>
                    <i class="fa-solid fa-cart-flatbed" aria-hidden="true"></i>
                    <span>Checkout mua hàng</span>
                </button>
            </div>

            <div class="page-alert info cham-cong-status" data-cham-cong-status>
                @if (!chamCong.CurrentEmployeeId.HasValue)
                {
                    <span>Tài khoản chưa liên kết nhân viên nên chưa thể chấm công.</span>
                }
                else if (chamCong.LocationOptions.Count == 0)
                {
                    <span>Chưa có địa điểm khách hàng mã AppTech để chấm công.</span>
                }
                else if (chamCong.OpenCheckin is not null)
                {
                    <span>Đang có lượt checkin chưa checkout.</span>
                }
                else if (chamCong.OpenPurchaseCheckin is not null)
                {
                    <span>Đang có lượt đi mua hàng chưa hoàn tất từ @(chamCong.OpenPurchaseCheckin.ThoiDiem?.ToString("dd/MM/yyyy HH:mm") ?? "thời gian chưa xác định").</span>
                }
                else
                {
                    <span>Sẵn sàng chấm công. Trình duyệt sẽ hỏi quyền GPS và camera khi bấm Checkin hoặc Checkout.</span>
                }
            </div>
        </div>
    </div>

    <div class="crud-modal-shell" data-cham-cong-camera-shell hidden>
        <div class="crud-modal-backdrop" aria-hidden="true"></div>
        <section class="crud-modal yeu-cau-checkin-modal" role="dialog" aria-modal="true" aria-labelledby="cham-cong-camera-title">
            <div class="crud-modal-header">
                <div class="crud-modal-heading">
                    <h2 id="cham-cong-camera-title" data-cham-cong-camera-title>Chụp ảnh chấm công</h2>
                    <p class="crud-modal-subtitle" data-cham-cong-camera-subtitle>Đang chờ lấy vị trí GPS.</p>
                </div>
                <button type="button" class="crud-modal-close" data-cham-cong-camera-close aria-label="Đóng">
                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </button>
            </div>
            <div class="crud-form yeu-cau-checkin-body">
                <input type="file" accept="image/*" data-cham-cong-file hidden />
                <div class="purchase-attendance-fields" data-purchase-fields hidden>
                    <div class="purchase-attendance-work">
                        <span class="purchase-attendance-label">Nội dung đi ra ngoài</span>
                        <div class="purchase-attendance-chip-grid" data-purchase-work-options>
                            @foreach (var option in new[] { "Mua vật tư", "Mua thiết bị", "Mua linh kiện", "Giao hàng", "Nhận hàng", "Làm việc với nhà cung cấp", "Đi ngân hàng", "Đi bảo hành", "Đi kho", "Công việc khác" })
                            {
                                <label class="purchase-attendance-chip">
                                    <input type="checkbox" value="@option" data-purchase-work-option />
                                    <span>@option</span>
                                </label>
                            }
                        </div>
                    </div>
                    @if (chamCong.CanAdminManageAttendance)
                    {
                        <div class="purchase-attendance-admin-grid">
                            <label class="master-data-filter-field" for="purchaseAttendanceEmployee">
                                <span>Nhân viên đi mua hàng</span>
                                <span class="login-input-shell select-shell">
                                    <i class="fa-solid fa-user-check" aria-hidden="true"></i>
                                    <select id="purchaseAttendanceEmployee" data-purchase-employee>
                                        <option value="">Chọn nhân viên</option>
                                        @foreach (var employee in chamCong.EmployeeOptions)
                                        {
                                            <option value="@employee.Id">@employee.HoTen</option>
                                        }
                                    </select>
                                    <span class="select-indicator"><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></span>
                                </span>
                            </label>
                            <label class="master-data-filter-field" for="purchaseAttendanceTime">
                                <span>Thời gian check-in</span>
                                <span class="login-input-shell">
                                    <i class="fa-solid fa-clock" aria-hidden="true"></i>
                                    <input id="purchaseAttendanceTime" type="datetime-local" data-purchase-time />
                                </span>
                            </label>
                        </div>
                    }
                    <label class="purchase-attendance-quick">
                        <input type="checkbox" data-purchase-quick checked />
                        <span>
                            <strong>Check-in nhanh</strong>
                            <small>Hoàn tất chuyến đi ngay sau khi ghi nhận.</small>
                        </span>
                    </label>
                </div>
                <div class="cham-cong-camera-map-shell">
                    <button type="button"
                            class="yeu-cau-checkin-distance-toggle"
                            data-state="info"
                            data-cham-cong-map-toggle
                            aria-expanded="false">
                        <span data-cham-cong-map-title>Khoảng cách: đang chờ GPS</span>
                        <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
                    </button>
                    <div class="yeu-cau-checkin-distance-content cham-cong-map-content" data-cham-cong-map-content hidden>
                        <div class="yeu-cau-checkin-distance-map cham-cong-camera-map" data-cham-cong-map></div>
                        <div class="yeu-cau-checkin-distance-status" data-cham-cong-map-status>
                            Đang chờ GPS để hiển thị vị trí chấm công.
                        </div>
                        <button type="button" class="secondary-button cham-cong-map-expand-button" data-cham-cong-map-fullscreen-open>
                            <i class="fa-solid fa-up-right-and-down-left-from-center" aria-hidden="true"></i>
                            <span>Mở rộng bản đồ</span>
                        </button>
                        <button type="button" class="secondary-button cham-cong-map-refresh-gps-button" data-cham-cong-refresh-gps>
                            <i class="fa-solid fa-location-crosshairs" aria-hidden="true"></i>
                            <span>Lấy lại GPS</span>
                        </button>
                    </div>
                </div>
                <label class="login-field attendance-camera-select-shell" data-cham-cong-camera-select-shell hidden>
                    <span>Camera</span>
                    <span class="login-input-shell select-shell">
                        <i class="fa-solid fa-camera-rotate" aria-hidden="true"></i>
                        <select data-cham-cong-camera-select></select>
                        <span class="select-indicator"><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></span>
                    </span>
                </label>
                <div class="yeu-cau-checkin-camera">
                    <video playsinline autoplay muted data-cham-cong-video></video>
                    <canvas data-cham-cong-canvas hidden></canvas>
                    <img data-cham-cong-preview alt="Ảnh chấm công vừa chụp" hidden />
                    <div class="yeu-cau-checkin-placeholder" data-cham-cong-placeholder>
                        <i class="fa-solid fa-camera" aria-hidden="true"></i>
                        <span>Đang bật camera</span>
                    </div>
                </div>
                <div class="yeu-cau-checkin-actions">
                    <button type="button" class="secondary-button" data-cham-cong-capture>
                        <i class="fa-solid fa-camera" aria-hidden="true"></i>
                        <span>Chụp ảnh</span>
                    </button>
                    <button type="button" class="secondary-button" data-cham-cong-retake disabled>
