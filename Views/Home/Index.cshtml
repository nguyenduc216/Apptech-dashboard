                class="chart-canvas"
                data-series="@string.Join(',', Model.MonthlyEnergy)"></canvas>
        <div class="chart-legend">
            <span><i></i>Điện năng tiêu thụ (kWh)</span>
        </div>
    </article>

    <article class="panel donut-panel">
        <div class="panel-header">
            <div>
                <h3>Phân bổ thiết bị</h3>
                <p>Smart lock, camera, đèn, cảm biến</p>
            </div>
        </div>
        <div id="deviceDonut"
             class="donut-visual"
             data-values="@string.Join(',', Model.DeviceDistribution.Values)">
        </div>
        <div class="donut-list">
            @foreach (var item in Model.DeviceDistribution)
            {
                <div class="donut-item">
                    <span>@item.Key</span>
                    <strong>@item.Value</strong>
                </div>
            }
        </div>
    </article>

    <article class="panel span-2">
        <div class="panel-header">
            <div>
                <h3>Tình trạng khu vực</h3>
                <p>Các công trình và khu vực đang được giám sát</p>
            </div>
        </div>
        <div class="zone-list">
            @foreach (var zone in Model.Zones)
            {
                <div class="zone-item">
                    <div>
                        <div class="zone-title">@zone.Name</div>
                        <div class="zone-subtitle">@zone.Description</div>
                    </div>
                    <div class="zone-status-block">
                        <span class="status-tag">@zone.Status</span>
                        <div class="progress-track">
                            <div class="progress-bar" style="width:@zone.HealthPercent%"></div>
                        </div>
                        <strong>@zone.HealthPercent%</strong>
                    </div>
                </div>
            }
        </div>
    </article>

    <article class="panel">
        <div class="panel-header">
            <div>
                <h3>Kịch bản nhanh</h3>
                <p>Các tác vụ tự động thường dùng</p>
            </div>
        </div>
        <div class="action-list">
            @foreach (var action in Model.QuickActions)
            {
                <div class="action-item">
                    <div class="action-title">@action.Title</div>
                    <div class="action-note">@action.Description</div>
                </div>
            }
        </div>
    </article>

    <article class="panel span-2">
        <div class="panel-header">
            <div>
                <h3>Cảnh báo gần nhất</h3>
                <p>Danh sách sự kiện hệ thống mới phát sinh</p>
            </div>
        </div>
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Thiết bị</th>
                        <th>Nội dung</th>
                        <th>Thời gian</th>
                        <th>Mức độ</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var alert in Model.Alerts)
                    {
                        <tr>
                            <td>@alert.Device</td>
                            <td>@alert.Message</td>
                            <td>@alert.Time</td>
                            <td><span class="priority priority-@GetPriorityClass(alert.Priority)">@alert.Priority</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </article>

    <article class="panel">
        <div class="panel-header">
            <div>
                <h3>Phiếu bảo trì</h3>
                <p>Công việc nội bộ</p>
            </div>
        </div>
        <div class="workorders">
            @foreach (var item in Model.WorkOrders)
            {
                <div class="workorder-item">
                    <div class="workorder-code">@item.Code</div>
                    <div class="workorder-name">@item.Name</div>
                    <div class="workorder-meta">@item.Assignee · @item.Status</div>
                </div>
            }
        </div>
    </article>
</section>
}

