@model AttendanceSettingsViewModel
@{
    ViewData["Title"] = "Cài đặt";
    ViewData["Breadcrumb"] = "Trang chủ / Cài đặt";
}

<section class="settings-page" data-browser-settings>
    <article class="panel settings-panel">
        <div class="panel-header settings-header">
            <div>
                <h3>Cấu hình giờ chấm công</h3>
                <p>Thiết lập 4 mốc giờ làm việc để tính giờ công, đi trễ và về sớm.</p>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
        {
            <div class="settings-status-message @Model.StatusType">@Model.StatusMessage</div>
        }

        <form method="post" asp-action="SaveAttendanceSchedule" class="attendance-settings-form">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="login-field-error"></div>

            <div class="attendance-settings-grid">
                <label class="attendance-time-field">
                    <span>Bắt đầu sáng</span>
                    <input asp-for="Schedule.MorningStart" type="time" />
                    <small asp-validation-for="Schedule.MorningStart"></small>
                </label>
                <label class="attendance-time-field">
                    <span>Kết thúc sáng</span>
                    <input asp-for="Schedule.MorningEnd" type="time" />
                    <small asp-validation-for="Schedule.MorningEnd"></small>
                </label>
                <label class="attendance-time-field">
                    <span>Cho phép trễ sáng (phút)</span>
                    <input asp-for="Schedule.MorningLateGraceMinutes" type="number" min="0" max="240" step="1" inputmode="numeric" />
                    <small asp-validation-for="Schedule.MorningLateGraceMinutes"></small>
                </label>
                <label class="attendance-time-field">
                    <span>Bắt đầu chiều</span>
                    <input asp-for="Schedule.AfternoonStart" type="time" />
                    <small asp-validation-for="Schedule.AfternoonStart"></small>
                </label>
                <label class="attendance-time-field">
                    <span>Kết thúc chiều</span>
                    <input asp-for="Schedule.AfternoonEnd" type="time" />
                    <small asp-validation-for="Schedule.AfternoonEnd"></small>
                </label>
                <label class="attendance-time-field">
                    <span>Cho phép trễ chiều (phút)</span>
                    <input asp-for="Schedule.AfternoonLateGraceMinutes" type="number" min="0" max="240" step="1" inputmode="numeric" />
                    <small asp-validation-for="Schedule.AfternoonLateGraceMinutes"></small>
                </label>
            </div>

            <div class="settings-permission-actions">
                <button type="submit" class="primary-button">
                    <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i>
                    <span>Lưu giờ chấm công</span>
                </button>
            </div>
        </form>
    </article>

    <article class="panel settings-panel">
        <div class="panel-header settings-header">
            <div>
                <h3>Quyền trình duyệt</h3>
                <p>Kiểm tra và cấp lại quyền vị trí, camera cho chấm công, checkin công việc và quét QR.</p>
            </div>
            <button type="button" class="secondary-button" data-permission-refresh>
                <i class="fa-solid fa-rotate" aria-hidden="true"></i>
                <span>Làm mới trạng thái</span>
            </button>
            <button type="button" class="secondary-button" data-hard-reload-page>
                <i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i>
                <span>Reload page / xoá cache</span>
            </button>
        </div>

        <div class="settings-permission-grid">
            <section class="settings-permission-card" data-permission-card="geolocation">
                <div class="settings-permission-head">
                    <span class="settings-permission-icon location">
                        <i class="fa-solid fa-location-crosshairs" aria-hidden="true"></i>
                    </span>
                    <div>
                        <h4>Vị trí</h4>
                        <p data-permission-summary="geolocation">Đang kiểm tra quyền vị trí.</p>
                    </div>
                    <span class="settings-permission-status" data-permission-status="geolocation">Đang kiểm tra</span>
                </div>

                <div class="settings-permission-result" data-location-result>
                    Chưa có tọa độ kiểm tra.
                </div>

                <div class="settings-location-map" data-location-map hidden>
                    <iframe title="Bản đồ vị trí GPS" data-location-map-frame loading="lazy"></iframe>
                    <a href="#" target="_blank" rel="noopener noreferrer" data-location-map-link>
                        <i class="fa-solid fa-up-right-from-square" aria-hidden="true"></i>
                        <span>Mở bản đồ lớn</span>
                    </a>
                </div>

                <div class="settings-permission-actions">
                    <button type="button" class="primary-button" data-location-request>
                        <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
                        <span>Bật / kiểm tra vị trí</span>
                    </button>
                    <button type="button" class="secondary-button" data-open-browser-settings>
                        <i class="fa-solid fa-sliders" aria-hidden="true"></i>
                        <span>Tắt / cấp lại trong browser</span>
                    </button>
                </div>
            </section>

            <section class="settings-permission-card" data-permission-card="camera">
                <div class="settings-permission-head">
                    <span class="settings-permission-icon camera">
                        <i class="fa-solid fa-camera" aria-hidden="true"></i>
                    </span>
                    <div>
                        <h4>Camera</h4>
                        <p data-permission-summary="camera">Đang kiểm tra quyền camera.</p>
                    </div>
                    <span class="settings-permission-status" data-permission-status="camera">Đang kiểm tra</span>
                </div>

                <div class="settings-camera-preview" data-camera-preview>
                    <video data-camera-video playsinline muted hidden></video>
                    <div class="settings-camera-empty" data-camera-empty>
                        <i class="fa-solid fa-video-slash" aria-hidden="true"></i>
                        <span>Camera chưa bật</span>
                    </div>
                </div>

                <label class="settings-camera-select-field" for="settingsCameraSelect">
                    <span>Chọn camera test</span>
                    <span class="login-input-shell select-shell">
                        <i class="fa-solid fa-camera-rotate" aria-hidden="true"></i>
                        <select id="settingsCameraSelect" data-camera-select disabled>
                            <option value="">Tự động chọn camera</option>
                        </select>
                        <span class="select-indicator"><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></span>
                    </span>
                </label>

                <div class="settings-permission-actions">
                    <button type="button" class="primary-button" data-camera-request>
                        <i class="fa-solid fa-camera" aria-hidden="true"></i>
                        <span>Bật / kiểm tra camera</span>
                    </button>
                    <button type="button" class="secondary-button" data-camera-stop>
                        <i class="fa-solid fa-stop" aria-hidden="true"></i>
                        <span>Dừng camera</span>
                    </button>
                    <button type="button" class="secondary-button" data-open-browser-settings>
                        <i class="fa-solid fa-sliders" aria-hidden="true"></i>
                        <span>Tắt / cấp lại trong browser</span>
                    </button>
                </div>
            </section>
        </div>

        <div class="settings-browser-help">
            <div class="settings-browser-help-icon">
                <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
            </div>
            <div>
                <strong>Trình duyệt không cho website tự thu hồi quyền đã cấp.</strong>
                <span>Khi cần tắt quyền hoặc bật lại sau khi đã chặn, dùng nút mở cài đặt browser rồi đổi quyền Location/Camera cho website này.</span>
            </div>
        </div>
    </article>

    <div class="settings-permission-modal-shell" data-browser-settings-modal hidden>
        <div class="settings-permission-modal-backdrop" data-browser-settings-close></div>
        <section class="settings-permission-modal" role="dialog" aria-modal="true" aria-labelledby="browserSettingsTitle">
            <div class="settings-permission-modal-head">
                <div>
                    <h3 id="browserSettingsTitle">Cài đặt quyền trong browser</h3>
                    <p>Chrome/Edge thường chặn website mở trực tiếp trang cài đặt nội bộ, nên có thể cần copy đường dẫn hoặc bấm biểu tượng ổ khóa trên thanh địa chỉ.</p>
                </div>
                <button type="button" class="menu-nav-button" data-browser-settings-close aria-label="Đóng hướng dẫn cài đặt browser">
                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </button>
            </div>

            <div class="settings-browser-url-box">
                <input type="text" readonly data-browser-settings-url aria-label="Đường dẫn cài đặt site trong browser" />
                <button type="button" class="secondary-button" data-copy-browser-settings-url>
                    <i class="fa-solid fa-copy" aria-hidden="true"></i>
                    <span>Copy</span>
                </button>
            </div>

            <ol class="settings-browser-steps">
                <li>Dán đường dẫn trên vào tab mới, hoặc bấm biểu tượng ổ khóa/cài đặt ở bên trái thanh địa chỉ.</li>
                <li>Mở mục Site settings / Quyền của trang.</li>
                <li>Đổi Location và Camera sang Allow hoặc Block theo nhu cầu, sau đó quay lại app và bấm Làm mới trạng thái.</li>
            </ol>

            <div class="settings-permission-actions">
                <button type="button" class="primary-button" data-try-open-browser-settings>
                    <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
                    <span>Thử mở trong tab mới</span>
                </button>
                <button type="button" class="secondary-button" data-browser-settings-close>
                    <i class="fa-solid fa-check" aria-hidden="true"></i>
                    <span>Đã hiểu</span>
                </button>
            </div>
        </section>
    </div>
</section>

@section Scripts {
    <script>
        (() => {
            const root = document.querySelector("[data-browser-settings]");
            if (!root) {
                return;
            }

            const statusText = {
                granted: "Đã bật",
                denied: "Đang chặn",
                prompt: "Chưa cấp",
                unsupported: "Không hỗ trợ",
                checking: "Đang kiểm tra",
                error: "Không kiểm tra được"
            };
            const summaryText = {
                geolocation: {
                    granted: "Website có thể dùng vị trí khi thực hiện chấm công hoặc checkin.",
                    denied: "Browser đang chặn vị trí cho website này.",
                    prompt: "Browser sẽ hỏi quyền khi app cần lấy vị trí.",
                    unsupported: "Browser hiện tại không hỗ trợ Geolocation API.",
                    error: "Không đọc được trạng thái quyền vị trí."
                },
                camera: {
                    granted: "Website có thể dùng camera cho chụp ảnh và quét QR.",
                    denied: "Browser đang chặn camera cho website này.",
                    prompt: "Browser sẽ hỏi quyền khi app cần mở camera.",
                    unsupported: "Browser hiện tại không hỗ trợ MediaDevices API.",
                    error: "Không đọc được trạng thái quyền camera."
                }
            };

            let cameraStream = null;
            let browserSettingsUrl = "";
            let cameraDevicesLoaded = false;

            const setPermissionState = (name, state) => {
                const status = root.querySelector(`[data-permission-status="${name}"]`);
                const summary = root.querySelector(`[data-permission-summary="${name}"]`);
                const card = root.querySelector(`[data-permission-card="${name}"]`);
                const normalized = statusText[state] ? state : "error";

                if (status) {
                    status.textContent = statusText[normalized];
                    status.className = `settings-permission-status ${normalized}`;
                }

                if (summary) {
                    summary.textContent = summaryText[name]?.[normalized] ?? summaryText[name]?.error ?? "";
                }

                if (card) {
                    card.dataset.state = normalized;
                }
            };

            const queryPermission = async (name) => {
                if (name === "geolocation" && !navigator.geolocation) {
                    return "unsupported";
                }

                if (name === "camera" && !navigator.mediaDevices?.getUserMedia) {
                    return "unsupported";
                }

                if (!navigator.permissions?.query) {
                    return "prompt";
                }

                try {
                    const permission = await navigator.permissions.query({ name });
                    permission.onchange = () => setPermissionState(name, permission.state);
                    return permission.state;
                } catch {
                    return "prompt";
                }
            };

            const refreshPermissions = async () => {
                setPermissionState("geolocation", "checking");
                setPermissionState("camera", "checking");
                setPermissionState("geolocation", await queryPermission("geolocation"));
                setPermissionState("camera", await queryPermission("camera"));
            };

            const requestLocation = () => {
                const result = root.querySelector("[data-location-result]");
                const map = root.querySelector("[data-location-map]");
                const frame = root.querySelector("[data-location-map-frame]");
                const mapLink = root.querySelector("[data-location-map-link]");
                if (!navigator.geolocation) {
                    setPermissionState("geolocation", "unsupported");
                    if (result) {
                        result.textContent = "Browser không hỗ trợ lấy vị trí.";
                    }
                    return;
                }

                if (result) {
                    result.textContent = "Đang lấy vị trí hiện tại.";
                }

                navigator.geolocation.getCurrentPosition(
                    async (position) => {
                        const lat = position.coords.latitude.toFixed(6);
                        const lng = position.coords.longitude.toFixed(6);
                        const accuracy = Math.round(position.coords.accuracy);
                        const mapUrl = `https://www.openstreetmap.org/?mlat=${lat}&mlon=${lng}#map=18/${lat}/${lng}`;
                        const embedUrl = `https://www.openstreetmap.org/export/embed.html?bbox=${Number(lng) - 0.003}%2C${Number(lat) - 0.003}%2C${Number(lng) + 0.003}%2C${Number(lat) + 0.003}&layer=mapnik&marker=${lat}%2C${lng}`;

                        if (frame instanceof HTMLIFrameElement) {
                            frame.src = embedUrl;
                        }

                        if (mapLink instanceof HTMLAnchorElement) {
                            mapLink.href = mapUrl;
                        }

                        if (map instanceof HTMLElement) {
                            map.hidden = false;
                        }

                        setPermissionState("geolocation", "granted");
                        if (result) {
                            result.innerHTML = `<strong>Lat:</strong> ${lat}<br><strong>Long:</strong> ${lng}<br><strong>Sai số GPS:</strong> khoảng ${accuracy}m<br><strong>Địa điểm GPS:</strong> Đang dò địa chỉ.`;
                        }

                        try {
                            const response = await fetch(`https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=${lat}&lon=${lng}&zoom=18&addressdetails=1`, {
                                headers: { "Accept": "application/json" }
                            });
                            if (!response.ok) {
                                throw new Error("Reverse geocoding failed");
                            }

                            const data = await response.json();
                            const address = data?.display_name || "Không xác định được địa chỉ từ GPS.";
                            if (result) {
                                result.innerHTML = `<strong>Lat:</strong> ${lat}<br><strong>Long:</strong> ${lng}<br><strong>Sai số GPS:</strong> khoảng ${accuracy}m<br><strong>Địa điểm GPS:</strong> ${escapeHtml(address)}`;
                            }
                        } catch {
                            if (result) {
                                result.innerHTML = `<strong>Lat:</strong> ${lat}<br><strong>Long:</strong> ${lng}<br><strong>Sai số GPS:</strong> khoảng ${accuracy}m<br><strong>Địa điểm GPS:</strong> Không đọc được địa chỉ, xem vị trí trên bản đồ.`;
                            }
                        }
                    },
                    (error) => {
                        setPermissionState("geolocation", error.code === error.PERMISSION_DENIED ? "denied" : "error");
                        if (result) {
                            result.textContent = error.message || "Không lấy được vị trí hiện tại.";
                        }
                    },
                    { enableHighAccuracy: true, timeout: 15000, maximumAge: 0 });
            };

            const escapeHtml = (value) => String(value)
                .replaceAll("&", "&amp;")
                .replaceAll("<", "&lt;")
                .replaceAll(">", "&gt;")
                .replaceAll('"', "&quot;")
                .replaceAll("'", "&#039;");

            const stopCamera = () => {
                if (cameraStream) {
                    cameraStream.getTracks().forEach((track) => track.stop());
                    cameraStream = null;
                }

                const video = root.querySelector("[data-camera-video]");
                const empty = root.querySelector("[data-camera-empty]");
                if (video instanceof HTMLVideoElement) {
                    video.pause();
                    video.srcObject = null;
                    video.hidden = true;
                }

                if (empty instanceof HTMLElement) {
                    empty.hidden = false;
                }
            };

            const loadCameraDevices = async () => {
                const select = root.querySelector("[data-camera-select]");
                if (!(select instanceof HTMLSelectElement) || !navigator.mediaDevices?.enumerateDevices) {
                    return;
                }

                try {
                    const devices = await navigator.mediaDevices.enumerateDevices();
                    const cameras = devices.filter((device) => device.kind === "videoinput");
                    const currentValue = select.value;
                    select.innerHTML = '<option value="">Tự động chọn camera</option>';

                    cameras.forEach((camera, index) => {
                        const option = document.createElement("option");
                        option.value = camera.deviceId;
                        option.textContent = camera.label || `Camera ${index + 1}`;
                        select.appendChild(option);
                    });

                    select.disabled = cameras.length === 0;
                    if (currentValue && cameras.some((camera) => camera.deviceId === currentValue)) {
                        select.value = currentValue;
                    }
                    cameraDevicesLoaded = true;
                } catch {
                    select.disabled = true;
                }
            };

            const requestCamera = async () => {
                if (!navigator.mediaDevices?.getUserMedia) {
                    setPermissionState("camera", "unsupported");
                    return;
                }

                stopCamera();

                try {
                    const select = root.querySelector("[data-camera-select]");
                    const selectedDeviceId = select instanceof HTMLSelectElement ? select.value : "";
                    const videoConstraint = selectedDeviceId
                        ? { deviceId: { exact: selectedDeviceId } }
                        : { facingMode: "environment" };

                    cameraStream = await navigator.mediaDevices.getUserMedia({
                        video: videoConstraint,
                        audio: false
                    });

                    const video = root.querySelector("[data-camera-video]");
                    const empty = root.querySelector("[data-camera-empty]");
                    if (video instanceof HTMLVideoElement) {
                        video.srcObject = cameraStream;
                        video.hidden = false;
                        await video.play();
                    }

                    if (empty instanceof HTMLElement) {
                        empty.hidden = true;
                    }

                    setPermissionState("camera", "granted");
                    await loadCameraDevices();
                } catch (error) {
                    setPermissionState("camera", error?.name === "NotAllowedError" ? "denied" : "error");
                }
            };

            const openBrowserSettings = () => {
                const origin = encodeURIComponent(window.location.origin);
                const userAgent = navigator.userAgent.toLowerCase();
                browserSettingsUrl = userAgent.includes("edg/")
                    ? `edge://settings/content/siteDetails?site=${origin}`
                    : `chrome://settings/content/siteDetails?site=${origin}`;

                const input = root.querySelector("[data-browser-settings-url]");
                const modal = root.querySelector("[data-browser-settings-modal]");
                if (input instanceof HTMLInputElement) {
                    input.value = browserSettingsUrl;
                }

                if (modal instanceof HTMLElement) {
                    modal.hidden = false;
                }
            };

            const closeBrowserSettings = () => {
                const modal = root.querySelector("[data-browser-settings-modal]");
                if (modal instanceof HTMLElement) {
                    modal.hidden = true;
                }
            };

            const copyBrowserSettingsUrl = async () => {
                const input = root.querySelector("[data-browser-settings-url]");
                if (!(input instanceof HTMLInputElement) || !input.value) {
                    return;
                }

                try {
                    await navigator.clipboard.writeText(input.value);
                } catch {
                    input.select();
                    document.execCommand("copy");
                }
            };

            const tryOpenBrowserSettings = () => {
                if (browserSettingsUrl) {
                    window.open(browserSettingsUrl, "_blank");
                }
            };

            const hardReloadPage = async () => {
                stopCamera();

                try {
                    if ("caches" in window) {
                        const keys = await caches.keys();
                        await Promise.all(keys.map((key) => caches.delete(key)));
                    }
                } catch {
                }

                try {
                    if (navigator.serviceWorker?.getRegistrations) {
                        const registrations = await navigator.serviceWorker.getRegistrations();
                        await Promise.all(registrations.map((registration) => registration.unregister()));
                    }
                } catch {
                }

                const url = new URL(window.location.href);
                url.searchParams.set("_reload", `${Date.now()}`);
                window.location.replace(url.toString());
            };

            root.querySelector("[data-permission-refresh]")?.addEventListener("click", refreshPermissions);
            root.querySelector("[data-hard-reload-page]")?.addEventListener("click", () => {
                void hardReloadPage();
            });
            root.querySelector("[data-location-request]")?.addEventListener("click", requestLocation);
            root.querySelector("[data-camera-request]")?.addEventListener("click", requestCamera);
            root.querySelector("[data-camera-stop]")?.addEventListener("click", stopCamera);
            root.querySelector("[data-camera-select]")?.addEventListener("change", () => {
                if (cameraStream) {
                    void requestCamera();
                }
            });
            root.querySelectorAll("[data-open-browser-settings]").forEach((button) => {
                button.addEventListener("click", openBrowserSettings);
            });
            root.querySelectorAll("[data-browser-settings-close]").forEach((button) => {
                button.addEventListener("click", closeBrowserSettings);
            });
            root.querySelector("[data-copy-browser-settings-url]")?.addEventListener("click", copyBrowserSettingsUrl);
            root.querySelector("[data-try-open-browser-settings]")?.addEventListener("click", tryOpenBrowserSettings);
            window.addEventListener("pagehide", stopCamera);

            refreshPermissions();
            if (navigator.mediaDevices?.enumerateDevices && !cameraDevicesLoaded) {
                void loadCameraDevices();
            }
        })();
    </script>
}
