@model KhachHangManagementViewModel
@{
    ViewData["Title"] = "Khách hàng";
    ViewData["Breadcrumb"] = "Trang chủ / Kỹ thuật / Khách hàng";
}

<section class="master-data-page">
    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="floating-status-toast @Model.StatusType"
             data-status-toast
             role="status"
             aria-live="polite">
            <div class="floating-status-toast-icon" aria-hidden="true">
                <i class="fa-solid @(Model.StatusType == "success" ? "fa-circle-check" : Model.StatusType == "error" ? "fa-circle-exclamation" : "fa-circle-info")"></i>
            </div>
            <div class="floating-status-toast-body">
                <strong>@(Model.StatusType == "success" ? "Thành công" : Model.StatusType == "error" ? "Có lỗi xảy ra" : "Thông báo")</strong>
                <span>@Model.StatusMessage</span>
            </div>
            <button type="button" class="floating-status-toast-close" data-status-toast-close aria-label="Đóng thông báo">
                <span aria-hidden="true">×</span>
            </button>
        </div>
    }

    <article class="panel master-data-panel">
        <div class="panel-header master-data-header">
            <div>
                <h3>Danh sách khách hàng</h3>
                <p>Quản lý danh sách khách hàng, thông tin liên hệ và các địa điểm làm việc.</p>
            </div>

            <div class="master-data-header-actions">
                <a class="master-data-add-button"
                   asp-action="Create"
                   asp-route-keyword="@Model.Filter.Keyword"
                   asp-route-page="@Model.CurrentPage">
                    <i class="fa-solid fa-plus" aria-hidden="true"></i>
                    <span>Thêm mới</span>
                </a>
            </div>
        </div>

	        <form method="get" asp-action="Index" class="master-data-filter-form">
	            <label class="master-data-filter-field" for="keyword">
	                <span>Tìm theo tên, mã, điện thoại, đại diện, ngành nghề, Zalo, ghi chú hoặc địa điểm</span>
	                <span class="login-input-shell">
	                    <i class="fa-solid fa-address-book" aria-hidden="true"></i>
	                    <input id="keyword" name="keyword" type="search" value="@Model.Filter.Keyword" placeholder="Nhập từ khóa tìm kiếm..." />
                </span>
            </label>

            <div class="master-data-filter-actions">
                <button type="submit" class="primary-button master-data-filter-button">
                    <span class="button-content">
                        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                        <span>Tìm kiếm</span>
                    </span>
                    <span class="button-processing" aria-hidden="true">
                        <span class="button-processing-dot"></span>
                        <span class="button-processing-text">Đang xử lý</span>
                    </span>
                </button>

                <a class="secondary-button master-data-reset-button" asp-action="Index">Làm mới</a>
            </div>
        </form>

        <div class="master-data-summary">
            <div><strong>@Model.TotalCount</strong> khách hàng</div>
            <div>Trang <strong>@Model.CurrentPage</strong>@(Model.TotalPages > 0 ? $" / {Model.TotalPages}" : "")</div>
        </div>

	        <div class="table-wrap khach-hang-table-wrap">
	            <table class="data-table master-data-table khach-hang-list-table">
	                <colgroup>
	                    <col class="khach-hang-name-col" />
	                    <col class="khach-hang-code-col" />
	                    <col class="khach-hang-contact-col" />
	                    <col class="khach-hang-representative-col" />
	                    <col class="khach-hang-industry-col" />
	                    <col class="khach-hang-actions-col" />
	                </colgroup>
	                <thead>
                    <tr>
                        <th>Tên khách hàng</th>
                        <th>Mã khách hàng</th>
                        <th>Liên hệ</th>
                        <th>Người đại diện</th>
                        <th>Ngành nghề</th>
                        <th class="actions-col">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="master-data-empty">Không có dữ liệu phù hợp.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Items)
                        {
	                            <tr>
	                                <td>
	                                    <a class="master-data-name master-data-name-link"
	                                       asp-action="Edit"
	                                       asp-route-id="@item.Id"
	                                       asp-route-keyword="@Model.Filter.Keyword"
	                                       asp-route-page="@Model.CurrentPage">
	                                        @item.TenKhachHang
	                                    </a>
	                                    <div>@(string.IsNullOrWhiteSpace(item.DiaChi) ? "-" : item.DiaChi)</div>
	                                </td>
                                <td>@(string.IsNullOrWhiteSpace(item.MaKhachHang) ? "-" : item.MaKhachHang)</td>
                                <td>
                                    <div>@(string.IsNullOrWhiteSpace(item.SoDienThoai) ? "-" : item.SoDienThoai)</div>
                                    <div>@(string.IsNullOrWhiteSpace(item.ZaloID) ? "-" : item.ZaloID)</div>
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(item.NguoiDaiDien) ? "-" : item.NguoiDaiDien)</td>
                                <td>@(string.IsNullOrWhiteSpace(item.NganhNghe) ? "-" : item.NganhNghe)</td>
                                <td class="actions-col">
                                    <div class="master-data-actions">
                                        <a class="table-action-button edit"
                                           asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           asp-route-keyword="@Model.Filter.Keyword"
                                           asp-route-page="@Model.CurrentPage">
                                            <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
                                            <span>Sửa</span>
                                        </a>

                                        <form method="post" asp-action="Delete" class="inline-action-form">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="Id" value="@item.Id" />
                                            <input type="hidden" name="Keyword" value="@Model.Filter.Keyword" />
                                            <input type="hidden" name="Page" value="@Model.CurrentPage" />
                                            <button type="submit"
                                                    class="table-action-button delete"
                                                    data-delete-confirm="Bạn có chắc muốn xóa khách hàng này?">
                                                <i class="fa-solid fa-trash-can" aria-hidden="true"></i>
                                                <span>Xóa</span>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="pagination-bar" aria-label="Phân trang khách hàng">
                <a class="pagination-button @(Model.CurrentPage <= 1 ? "disabled" : "")"
                   asp-action="Index"
                   asp-route-keyword="@Model.Filter.Keyword"
                   asp-route-page="@(Model.CurrentPage - 1)">
                    <i class="fa-solid fa-angle-left" aria-hidden="true"></i>
                    <span>Trước</span>
                </a>

                <div class="pagination-pages">
                    @foreach (var pageNumber in Model.VisiblePages)
                    {
                        <a class="pagination-page @(pageNumber == Model.CurrentPage ? "active" : "")"
                           asp-action="Index"
                           asp-route-keyword="@Model.Filter.Keyword"
                           asp-route-page="@pageNumber">
                            @pageNumber
                        </a>
                    }
                </div>

                <a class="pagination-button @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")"
                   asp-action="Index"
                   asp-route-keyword="@Model.Filter.Keyword"
                   asp-route-page="@(Model.CurrentPage + 1)">
                    <span>Sau</span>
                    <i class="fa-solid fa-angle-right" aria-hidden="true"></i>
                </a>
            </nav>
        }
    </article>
</section>
