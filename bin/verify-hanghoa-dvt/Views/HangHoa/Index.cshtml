@model HangHoaManagementViewModel
@{
    ViewData["Title"] = "Hàng hóa";
    ViewData["Breadcrumb"] = "Trang chủ / Danh mục / Hàng hóa";

    var tenHangHoaHasError = ViewData.ModelState.TryGetValue("Form.TenHangHoa", out var tenHangHoaState) && tenHangHoaState.Errors.Count > 0;
    var maHangHoaHasError = ViewData.ModelState.TryGetValue("Form.MaHangHoa", out var maHangHoaState) && maHangHoaState.Errors.Count > 0;
    var donViTinhHasError = ViewData.ModelState.TryGetValue("Form.DonViTinhId", out var donViTinhState) && donViTinhState.Errors.Count > 0;
    var imageHasError = ViewData.ModelState.TryGetValue("Form.ImageFile", out var imageState) && imageState.Errors.Count > 0;
    var trangThaiHasError = ViewData.ModelState.TryGetValue("Form.TrangThaiSuDung", out var trangThaiState) && trangThaiState.Errors.Count > 0;
    var summaryErrors = ViewData.ModelState.TryGetValue(string.Empty, out var summaryState)
        ? summaryState.Errors.Select(error => error.ErrorMessage).Where(message => !string.IsNullOrWhiteSpace(message)).ToArray()
        : [];
    var imagePreviewUrl = string.IsNullOrWhiteSpace(Model.Form.ImageUrl) ? null : Model.Form.ImageUrl;
}

<section class="master-data-page">
    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="floating-status-toast @Model.StatusType"
             data-status-toast
             role="status"
             aria-live="polite">
            <div class="floating-status-toast-icon" aria-hidden="true">
                <i class="fa-solid @(Model.StatusType == "success" ? "fa-circle-check" : Model.StatusType == "error" ? "fa-circle-exclamation" : "fa-circle-info")"></i>
            </div>
            <div class="floating-status-toast-body">
                <strong>@(Model.StatusType == "success" ? "Thành công" : Model.StatusType == "error" ? "Có lỗi xảy ra" : "Thông báo")</strong>
                <span>@Model.StatusMessage</span>
            </div>
            <button type="button" class="floating-status-toast-close" data-status-toast-close aria-label="Đóng thông báo">
                <span aria-hidden="true">×</span>
            </button>
        </div>
    }

    <article class="panel master-data-panel">
        <div class="panel-header master-data-header">
            <div>
                <h3>Danh sách hàng hóa</h3>
                <p>Quản lý danh mục hàng hóa và hình ảnh minh họa.</p>
            </div>

            <div class="master-data-header-actions">
                <div class="data-actions" data-data-actions>
                    <button type="button"
                            class="secondary-button data-actions-trigger"
                            data-data-actions-trigger
                            aria-haspopup="menu"
                            aria-expanded="false">
                        <i class="fa-solid fa-database" aria-hidden="true"></i>
                        <span>Data</span>
                        <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
                    </button>

                    <div class="data-actions-menu" data-data-actions-menu hidden>
                        <button type="button" class="data-actions-item" data-import-trigger>
                            <i class="fa-solid fa-file-arrow-up" aria-hidden="true"></i>
                            <span>Import data</span>
                        </button>
                        <a class="data-actions-item" asp-action="ExportTemplate">
                            <i class="fa-solid fa-file-excel" aria-hidden="true"></i>
                            <span>Export template</span>
                        </a>
                    </div>
                </div>

                <a class="master-data-add-button"
                   asp-action="Index"
                   asp-route-keyword="@Model.Filter.Keyword"
                   asp-route-statusFilter="@Model.Filter.StatusFilter"
                   asp-route-page="@Model.CurrentPage"
                   asp-route-showCreatePopup="true">
                    <i class="fa-solid fa-plus" aria-hidden="true"></i>
                    <span>Thêm mới</span>
                </a>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
        {
            <div class="page-alert @Model.StatusType master-data-status-alert">
                <i class="fa-solid @(Model.StatusType == "success" ? "fa-circle-check" : Model.StatusType == "error" ? "fa-circle-exclamation" : "fa-circle-info")" aria-hidden="true"></i>
                <span>@Model.StatusMessage</span>
            </div>
        }

        <form method="post" asp-action="ImportData" enctype="multipart/form-data" class="data-import-form" data-import-form>
            @Html.AntiForgeryToken()
            <input type="hidden" name="keyword" value="@Model.Filter.Keyword" />
            <input type="hidden" name="statusFilter" value="@Model.Filter.StatusFilter" />
            <input type="hidden" name="page" value="@Model.CurrentPage" />
            <input type="file"
                   name="file"
                   accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
                   data-import-file
                   hidden />
        </form>

        <form method="get" asp-action="Index" class="master-data-filter-form">
            <label class="master-data-filter-field" for="keyword">
                <span>Tìm theo tên hàng hóa / mã hàng hóa</span>
                <span class="login-input-shell">
                    <i class="fa-solid fa-box-open" aria-hidden="true"></i>
                    <input id="keyword" name="keyword" type="search" value="@Model.Filter.Keyword" placeholder="Nhập tên hàng hóa hoặc mã hàng hóa..." />
                </span>
            </label>

            <label class="master-data-filter-field" for="statusFilter">
                <span>Trạng thái kích hoạt</span>
                <span class="login-input-shell select-shell">
                    <i class="fa-solid fa-power-off" aria-hidden="true"></i>
                    <select id="statusFilter" name="statusFilter">
                        @if (Model.Filter.StatusFilter is null)
                        {
                            <option value="" selected>Tất cả trạng thái</option>
                        }
                        else
                        {
                            <option value="">Tất cả trạng thái</option>
                        }

                        @if (Model.Filter.StatusFilter == true)
                        {
                            <option value="true" selected>Kích hoạt</option>
                        }
                        else
                        {
                            <option value="true">Kích hoạt</option>
                        }

                        @if (Model.Filter.StatusFilter == false)
                        {
                            <option value="false" selected>Khóa</option>
                        }
                        else
                        {
                            <option value="false">Khóa</option>
                        }
                    </select>
                    <span class="select-indicator"><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></span>
                </span>
            </label>

            <div class="master-data-filter-actions">
                <button type="submit" class="primary-button master-data-filter-button">
                    <span class="button-content">
                        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                        <span>Tìm kiếm</span>
                    </span>
                    <span class="button-processing" aria-hidden="true">
                        <span class="button-processing-dot"></span>
                        <span class="button-processing-text">Đang xử lý</span>
                    </span>
                </button>

                <a class="secondary-button master-data-reset-button" asp-action="Index">Làm mới</a>
            </div>
        </form>

        <div class="master-data-summary">
            <div><strong>@Model.TotalCount</strong> hàng hóa</div>
            <div>Trang <strong>@Model.CurrentPage</strong>@(Model.TotalPages > 0 ? $" / {Model.TotalPages}" : "")</div>
        </div>

        <div class="table-wrap">
            <table class="data-table master-data-table">
                <thead>
                    <tr>
                        <th class="hang-hoa-image-col">Ảnh</th>
                        <th>Tên hàng hóa</th>
                        <th>Mã hàng hóa</th>
                        <th>Đơn vị tính</th>
                        <th>Trạng thái</th>
                        <th class="actions-col">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="master-data-empty">Không có dữ liệu phù hợp.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="hang-hoa-image-cell">
                                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                    {
                                        <div class="hang-hoa-image-thumb">
                                            <img src="@item.ImageUrl" alt="@item.TenHangHoa" loading="lazy" />
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="hang-hoa-image-thumb is-empty" aria-hidden="true">
                                            <i class="fa-regular fa-image"></i>
                                        </div>
                                    }
                                </td>
                                <td><div class="master-data-name">@item.TenHangHoa</div></td>
                                <td>@(string.IsNullOrWhiteSpace(item.MaHangHoa) ? "-" : item.MaHangHoa)</td>
                                <td>
                                    @if (string.IsNullOrWhiteSpace(item.TenDonViTinh))
                                    {
                                        <span>-</span>
                                    }
                                    else
                                    {
                                        <span>@item.TenDonViTinh@(string.IsNullOrWhiteSpace(item.TenVietTatDonViTinh) ? string.Empty : $" ({item.TenVietTatDonViTinh})")</span>
                                    }
                                </td>
                                <td>
                                    <span class="status-pill @(item.TrangThaiSuDung ? "active" : "locked")">
                                        @(item.TrangThaiSuDung ? "Kích hoạt" : "Khóa")
                                    </span>
                                </td>
                                <td class="actions-col">
                                    <div class="master-data-actions">
                                        <a class="table-action-button edit"
                                           asp-action="Index"
                                           asp-route-keyword="@Model.Filter.Keyword"
                                           asp-route-statusFilter="@Model.Filter.StatusFilter"
                                           asp-route-page="@Model.CurrentPage"
                                           asp-route-editId="@item.Id">
                                            <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
                                            <span>Sửa</span>
                                        </a>

                                        <form method="post" asp-action="Delete" class="inline-action-form">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="Id" value="@item.Id" />
                                            <input type="hidden" name="Keyword" value="@Model.Filter.Keyword" />
                                            <input type="hidden" name="StatusFilter" value="@Model.Filter.StatusFilter" />
                                            <input type="hidden" name="Page" value="@Model.CurrentPage" />
                                            <button type="submit"
                                                    class="table-action-button delete"
                                                    data-delete-confirm="Bạn có chắc muốn xóa hàng hóa này?">
                                                <i class="fa-solid fa-trash-can" aria-hidden="true"></i>
                                                <span>Xóa</span>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="pagination-bar" aria-label="Phân trang hàng hóa">
                <a class="pagination-button @(Model.CurrentPage <= 1 ? "disabled" : "")"
                   asp-action="Index"
                   asp-route-keyword="@Model.Filter.Keyword"
                   asp-route-statusFilter="@Model.Filter.StatusFilter"
                   asp-route-page="@(Model.CurrentPage - 1)">
                    <i class="fa-solid fa-angle-left" aria-hidden="true"></i>
                    <span>Trước</span>
                </a>

                <div class="pagination-pages">
                    @foreach (var pageNumber in Model.VisiblePages)
                    {
                        <a class="pagination-page @(pageNumber == Model.CurrentPage ? "active" : "")"
                           asp-action="Index"
                           asp-route-keyword="@Model.Filter.Keyword"
                           asp-route-statusFilter="@Model.Filter.StatusFilter"
                           asp-route-page="@pageNumber">
                            @pageNumber
                        </a>
                    }
                </div>

                <a class="pagination-button @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")"
                   asp-action="Index"
                   asp-route-keyword="@Model.Filter.Keyword"
                   asp-route-statusFilter="@Model.Filter.StatusFilter"
                   asp-route-page="@(Model.CurrentPage + 1)">
                    <span>Sau</span>
                    <i class="fa-solid fa-angle-right" aria-hidden="true"></i>
                </a>
            </nav>
        }
    </article>
</section>

@if (Model.IsPopupOpen)
{
    <div class="crud-modal-shell" data-crud-modal-shell>
        <div class="crud-modal-backdrop" aria-hidden="true"></div>

        <section class="crud-modal" role="dialog" aria-modal="true" aria-labelledby="hang-hoa-modal-title">
            <div class="crud-modal-header">
                <div class="crud-modal-heading">
                    <h2 id="hang-hoa-modal-title">@Model.PopupTitle</h2>
                    <p class="crud-modal-subtitle">Cập nhật tên hàng hóa, mã hàng hóa, đơn vị tính, ảnh minh họa và trạng thái sử dụng.</p>
                </div>

                <a class="menu-nav-button crud-close-button"
                   data-crud-modal-close
                   aria-label="Đóng popup"
                   asp-action="Index"
                   asp-route-keyword="@Model.Filter.Keyword"
                   asp-route-statusFilter="@Model.Filter.StatusFilter"
                   asp-route-page="@Model.CurrentPage">
                    <span aria-hidden="true">&times;</span>
                </a>
            </div>

            <form method="post" asp-action="@Model.SubmitAction" enctype="multipart/form-data" class="account-form crud-form">
                @Html.AntiForgeryToken()

                <input asp-for="Form.Id" type="hidden" />
                <input asp-for="Form.Keyword" type="hidden" />
                <input asp-for="Form.StatusFilter" type="hidden" />
                <input asp-for="Form.Page" type="hidden" />
                <input asp-for="Form.ImageUrl" type="hidden" />

                @if (summaryErrors.Length > 0)
                {
                    <div class="page-alert error validation-summary">
                        <i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i>
                        <div>
                            @foreach (var message in summaryErrors)
                            {
                                <div>@message</div>
                            }
                        </div>
                    </div>
                }

                <div class="account-form-grid single-column">
                    <div class="login-field @(imageHasError ? "has-error" : "")">
                        <span>Hình ảnh minh họa</span>
                        <div class="image-upload-editor" data-image-upload>
                            <div class="image-upload-preview">
                                <img src="@imagePreviewUrl"
                                     alt="Ảnh minh họa hàng hóa"
                                     class="@(string.IsNullOrWhiteSpace(imagePreviewUrl) ? "is-hidden" : null)"
                                     data-image-preview />
                                <div class="image-upload-fallback @(string.IsNullOrWhiteSpace(imagePreviewUrl) ? null : "is-hidden")" data-image-fallback>
                                    <i class="fa-regular fa-image" aria-hidden="true"></i>
                                    <span>Chưa có ảnh minh họa</span>
                                </div>
                            </div>

                            <div class="image-upload-copy">
                                <strong>Ảnh sẽ được lưu file vật lý</strong>
                                <p>Tải lên JPG, PNG hoặc WEBP, tối đa 5MB. File được lưu riêng trong thư mục `uploads/hang-hoa`.</p>
                                <label asp-for="Form.ImageFile" class="secondary-button image-upload-button">Chọn ảnh</label>
                                <input asp-for="Form.ImageFile"
                                       type="file"
                                       accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                                       class="image-upload-input"
                                       data-image-input />
                            </div>
                        </div>
                        <span asp-validation-for="Form.ImageFile" class="login-field-error"></span>
                    </div>

                    <label class="login-field @(tenHangHoaHasError ? "has-error" : "")">
                        <span>Tên hàng hóa</span>
                        <span class="login-input-shell">
                            <i class="fa-solid fa-box-open" aria-hidden="true"></i>
                            <input asp-for="Form.TenHangHoa" autocomplete="off" autofocus />
                        </span>
                        <span asp-validation-for="Form.TenHangHoa" class="login-field-error"></span>
                    </label>

                    <label class="login-field @(maHangHoaHasError ? "has-error" : "")">
                        <span>Mã hàng hóa</span>
                        <span class="login-input-shell">
                            <i class="fa-solid fa-barcode" aria-hidden="true"></i>
                            <input asp-for="Form.MaHangHoa" autocomplete="off" />
                        </span>
                        <span asp-validation-for="Form.MaHangHoa" class="login-field-error"></span>
                    </label>

                    <label class="login-field @(donViTinhHasError ? "has-error" : "")">
                        <span>Đơn vị tính</span>
                        <span class="login-input-shell select-shell">
                            <i class="fa-solid fa-ruler" aria-hidden="true"></i>
                            <select asp-for="Form.DonViTinhId">
                                <option value="">Chọn đơn vị tính</option>
                                @foreach (var option in Model.DonViTinhOptions)
                                {
                                    <option value="@option.Id">@option.Label</option>
                                }
                            </select>
                            <span class="select-indicator"><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></span>
                        </span>
                        <span asp-validation-for="Form.DonViTinhId" class="login-field-error"></span>
                    </label>

                    <label class="login-field @(trangThaiHasError ? "has-error" : "")">
                        <span>Trạng thái sử dụng</span>
                        <span class="switch-field-shell">
                            <span class="switch-field-icon">
                                <i class="fa-solid fa-toggle-on" aria-hidden="true"></i>
                            </span>
                            <label class="status-switch">
                                <input asp-for="Form.TrangThaiSuDung" class="status-switch-input" />
                                <span class="status-switch-track">
                                    <span class="status-switch-thumb"></span>
                                </span>
                                <span class="status-switch-labels" aria-hidden="true">
                                    <span>Kích hoạt</span>
                                    <span>Khóa</span>
                                </span>
                            </label>
                        </span>
                    </label>
                </div>

                <div class="crud-modal-actions">
                    <a class="secondary-button crud-cancel-button"
                       asp-action="Index"
                       asp-route-keyword="@Model.Filter.Keyword"
                       asp-route-statusFilter="@Model.Filter.StatusFilter"
                       asp-route-page="@Model.CurrentPage">
                        Hủy
                    </a>

                    <button type="submit" class="primary-button" data-processing-button data-processing-text="Đang lưu">
                        <span class="button-content">
                            <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i>
                            <span>@(Model.PopupMode == HangHoaPopupMode.Edit ? "Lưu cập nhật" : "Thêm mới")</span>
                        </span>
                        <span class="button-processing" aria-hidden="true">
                            <span class="button-processing-dot"></span>
                            <span class="button-processing-text">Đang lưu</span>
                        </span>
                    </button>
                </div>
            </form>
        </section>
    </div>
}
