@using System.Globalization
@model XuatKhoExportViewModel
@{
    Layout = null;
    var culture = CultureInfo.GetCultureInfo("vi-VN");
    var ngayXuat = Model.Header.NgayXuatKho ?? DateTime.Today;
    var totalAmount = Model.Details.Sum(detail => detail.TongTienXuat);
    var documentNumbers = string.Join(", ", Model.Details
        .Select(detail => detail.SoChungTu)
        .Where(value => !string.IsNullOrWhiteSpace(value))
        .Select(value => value!.Trim())
        .Distinct());
    var warehouseNames = string.Join(", ", Model.Details
        .Select(detail => detail.TenKho)
        .Where(value => !string.IsNullOrWhiteSpace(value))
        .Select(value => value!.Trim())
        .Distinct());
    var locations = string.Join(", ", Model.Details
        .Select(detail => detail.ViTriLuuKho)
        .Where(value => !string.IsNullOrWhiteSpace(value))
        .Select(value => value!.Trim())
        .Distinct());
    var totalAmountInWords = FormatVietnameseMoney(totalAmount);

    string FormatNumber(decimal value) => value.ToString("#,##0.####", culture);
    string FormatMoney(decimal value) => value.ToString("#,##0.##", culture);
    string FormatVietnameseMoney(decimal value)
    {
        var roundedValue = decimal.Round(value, 0, MidpointRounding.AwayFromZero);
        if (roundedValue > long.MaxValue || roundedValue < long.MinValue)
        {
            return string.Empty;
        }

        var words = ReadVietnameseInteger((long)roundedValue);
        return char.ToUpper(words[0], culture) + words[1..] + " đồng";
    }

    string ReadVietnameseInteger(long number)
    {
        if (number == 0)
        {
            return "không";
        }

        if (number < 0)
        {
            return "âm " + ReadVietnameseInteger(Math.Abs(number));
        }

        var units = new[] { "", " nghìn", " triệu", " tỷ" };
        var groups = new List<int>();
        while (number > 0)
        {
            groups.Add((int)(number % 1000));
            number /= 1000;
        }

        var parts = new List<string>();
        for (var index = groups.Count - 1; index >= 0; index--)
        {
            var group = groups[index];
            if (group == 0)
            {
                continue;
            }

            var forceFull = index < groups.Count - 1;
            var unitIndex = index % 3;
            var billionCycle = index / 3;
            var groupWords = ReadVietnameseGroup(group, forceFull) + units[unitIndex];
            if (unitIndex == 0 && billionCycle > 0)
            {
                groupWords += string.Concat(Enumerable.Repeat(" tỷ", billionCycle));
            }

            parts.Add(groupWords);
        }

        return string.Join(" ", parts);
    }

    string ReadVietnameseGroup(int number, bool forceFull)
    {
        var digits = new[] { "không", "một", "hai", "ba", "bốn", "năm", "sáu", "bảy", "tám", "chín" };
        var hundreds = number / 100;
        var tens = (number % 100) / 10;
        var ones = number % 10;
        var parts = new List<string>();

        if (hundreds > 0 || forceFull)
        {
            parts.Add(digits[hundreds] + " trăm");
        }

        if (tens > 1)
        {
            parts.Add(digits[tens] + " mươi");
            if (ones == 1)
            {
                parts.Add("mốt");
            }
            else if (ones == 5)
            {
                parts.Add("lăm");
            }
            else if (ones > 0)
            {
                parts.Add(digits[ones]);
            }
        }
        else if (tens == 1)
        {
            parts.Add("mười");
            if (ones == 5)
            {
                parts.Add("lăm");
            }
            else if (ones > 0)
            {
                parts.Add(digits[ones]);
            }
        }
        else if (ones > 0)
        {
            if (hundreds > 0 || forceFull)
            {
                parts.Add("linh");
            }

            parts.Add(digits[ones]);
        }

        return string.Join(" ", parts);
    }
}
<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Phiếu xuất kho @Model.Header.MaPhieu</title>
    <style>
        * { box-sizing: border-box; }
        body {
            margin: 0;
            background: #f3f4f6;
            color: #000;
            font-family: "Times New Roman", Times, serif;
            font-size: 16px;
        }
        .page {
            width: 297mm;
            min-height: 210mm;
            margin: 18px auto;
            padding: 24px 36px;
            background: #fff;
        }
        .toolbar {
            width: 297mm;
            margin: 18px auto 0;
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            font-family: Arial, sans-serif;
        }
        .toolbar button {
            border: 1px solid #0f766e;
            border-radius: 6px;
            background: #0f766e;
            color: #fff;
            padding: 9px 14px;
            font-weight: 700;
            cursor: pointer;
        }
        .top {
            display: grid;
            grid-template-columns: 1fr 360px;
            gap: 24px;
            font-weight: 700;
        }
        .top-right { text-align: center; }
        .top-right em {
            display: block;
            font-weight: 700;
        }
        h1 {
            margin: 26px 0 2px;
            text-align: center;
            font-size: 24px;
        }
        .meta {
            text-align: center;
            font-style: italic;
            line-height: 1.45;
        }
        .meta-grid {
            display: inline-grid;
            grid-template-columns: auto 160px auto 120px;
            column-gap: 8px;
            align-items: baseline;
        }
        .line {
            border-bottom: 1px dotted #000;
            min-height: 18px;
            display: inline-block;
            vertical-align: bottom;
        }
        .info {
            margin-top: 20px;
            line-height: 1.45;
        }
        .info-row {
            display: flex;
            gap: 4px;
            align-items: baseline;
        }
        .info-row .line { flex: 1; }
        table {
            width: 100%;
            margin-top: 26px;
            border-collapse: collapse;
            table-layout: fixed;
        }
        th, td {
            border: 1px solid #000;
            padding: 4px 5px;
            vertical-align: middle;
        }
        th {
            text-align: center;
            font-weight: 400;
        }
        .center { text-align: center; }
        .right { text-align: right; }
        .bold { font-weight: 700; }
        .footer-lines {
            margin-top: 16px;
            line-height: 1.45;
        }
        .signatures {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 12px;
            margin-top: 32px;
            text-align: center;
            font-weight: 700;
        }
        .signature-note {
            display: block;
            margin-top: 32px;
            font-style: italic;
            font-weight: 400;
        }
        @@media print {
            body { background: #fff; }
            .toolbar { display: none; }
            .page {
                width: auto;
                min-height: auto;
                margin: 0;
                padding: 0;
            }
        }
    </style>
</head>
<body>
    <div class="toolbar">
        <button type="button" onclick="window.print()">In phiếu</button>
    </div>

    <main class="page">
        <div class="top">
            <div>
                <div>Đơn vị: CÔNG TY TNHH CÔNG NGHỆ APPTECH</div>
                <div>Bộ phận: Kế Toán</div>
            </div>
            <div class="top-right">
                <div>Mẫu số 02 - VT</div>
                <em>(Ban hành theo Thông tư số 133/2016/TT-BTC</em>
                <em>Ngày 26/8/2016 của Bộ Tài chính)</em>
            </div>
        </div>

        <h1>PHIẾU XUẤT KHO</h1>
        <div class="meta">
            <div>Ngày @ngayXuat.Day tháng @ngayXuat.Month năm @ngayXuat.Year</div>
            <div class="meta-grid">
                <span>Số:</span><span class="line">@Model.Header.MaPhieu</span>
                <span>Nợ:</span><span class="line"></span>
                <span></span><span></span>
                <span>Có:</span><span class="line"></span>
            </div>
        </div>

        <div class="info">
            <div class="info-row"><span>- Họ và tên người nhận hàng:</span><span class="line">@Model.Header.NguoiNhanHang</span><span>Địa chỉ (bộ phận)</span><span class="line">@Model.Header.DiaChiNguoiNhanHang</span></div>
            <div class="info-row"><span>- Lý do xuất kho:</span><span class="line">@XuatKhoMucDich.GetDisplayName(Model.Header.MucDichXuat)</span></div>
            <div class="info-row"><span>- Xuất tại kho (ngăn lô):</span><span class="line">@warehouseNames</span><span>Địa điểm</span><span class="line">@locations</span></div>
        </div>

        <table>
            <thead>
                <tr>
                    <th rowspan="2" style="width: 54px;">STT</th>
                    <th rowspan="2">TÊN, NHÃN HIỆU, QUY CÁCH, PHẨM CHẤT VẬT TƯ, DỤNG CỤ, SP, HÀNG HÓA</th>
                    <th rowspan="2" style="width: 72px;">MÃ SỐ</th>
                    <th rowspan="2" style="width: 68px;">ĐVT</th>
                    <th colspan="2">SỐ LƯỢNG</th>
                    <th rowspan="2" style="width: 90px;">ĐƠN GIÁ</th>
                    <th rowspan="2" style="width: 100px;">THÀNH TIỀN</th>
                </tr>
                <tr>
                    <th style="width: 96px;">THEO CHỨNG TỪ</th>
                    <th style="width: 96px;">THỰC XUẤT</th>
                </tr>
                <tr>
                    <th>A</th>
                    <th>B</th>
                    <th>C</th>
                    <th>D</th>
                    <th>1</th>
                    <th>2</th>
                    <th>3</th>
                    <th>4</th>
                </tr>
            </thead>
            <tbody>
                @for (var index = 0; index < Model.Details.Count; index++)
                {
                    var detail = Model.Details[index];
                    <tr>
                        <td class="center">@(index + 1)</td>
                        <td>@(string.IsNullOrWhiteSpace(detail.TenHangHoa) ? detail.TenChiTiet : detail.TenHangHoa)</td>
                        <td class="center">@(string.IsNullOrWhiteSpace(detail.MaSoLo) ? detail.MaHangHoa : detail.MaSoLo)</td>
                        <td class="center">@detail.DonViTinh</td>
                        <td class="right">@detail.SoChungTu</td>
                        <td class="right">@FormatNumber(detail.SoLuongXuat)</td>
                        <td class="right">@FormatMoney(detail.DonGiaXuat)</td>
                        <td class="right">@FormatMoney(detail.TongTienXuat)</td>
                    </tr>
                }
                @for (var index = Model.Details.Count; index < 4; index++)
                {
                    <tr>
                        <td>&nbsp;</td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                    </tr>
                }
                <tr>
                    <td></td>
                    <td class="bold">Cộng</td>
                    <td class="center bold">x</td>
                    <td class="center bold">x</td>
                    <td class="center bold">x</td>
                    <td class="center bold">x</td>
                    <td class="center bold">x</td>
                    <td class="right bold">@FormatMoney(totalAmount)</td>
                </tr>
            </tbody>
        </table>

        <div class="footer-lines">
            <div>- Tổng số tiền (viết bằng chữ):<span class="line" style="width: 72%;">@totalAmountInWords</span></div>
            <div>- Số chứng từ gốc kèm theo:<span class="line" style="width: 70%;">@documentNumbers</span></div>
        </div>

        <div class="signatures">
            <div>Người lập phiếu<span class="signature-note">(Ký, họ tên)</span></div>
            <div>Người nhận hàng<span class="signature-note">(Ký, họ tên)</span></div>
            <div>Giám đốc<span class="signature-note">(Ký, họ tên)</span></div>
            <div>Kế toán trưởng<span class="signature-note">(Hoặc bộ phận có nhu cầu nhập)</span></div>
        </div>
    </main>
</body>
</html>
