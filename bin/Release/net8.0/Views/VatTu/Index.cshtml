@model VatTuManagementViewModel
@{
    ViewData["Title"] = "Vật tư";
    ViewData["Breadcrumb"] = "Trang chủ / Danh mục / Vật tư";

    var hangHoaHasError = ViewData.ModelState.TryGetValue("Form.HangHoaId", out var hangHoaState) && hangHoaState.Errors.Count > 0;
    var khoHasError = ViewData.ModelState.TryGetValue("Form.KhoId", out var khoState) && khoState.Errors.Count > 0;
    var donViTinhHasError = ViewData.ModelState.TryGetValue("Form.DonViTinhId", out var donViTinhState) && donViTinhState.Errors.Count > 0;
    var tenChiTietHasError = ViewData.ModelState.TryGetValue("Form.TenChiTiet", out var tenChiTietState) && tenChiTietState.Errors.Count > 0;
    var soLuongTonHasError = ViewData.ModelState.TryGetValue("Form.SoLuongTon", out var soLuongTonState) && soLuongTonState.Errors.Count > 0;
    var maSoLoHasError = ViewData.ModelState.TryGetValue("Form.MaSoLo", out var maSoLoState) && maSoLoState.Errors.Count > 0;
    var viTriLuuKhoHasError = ViewData.ModelState.TryGetValue("Form.ViTriLuuKho", out var viTriLuuKhoState) && viTriLuuKhoState.Errors.Count > 0;
    var ghiChuHasError = ViewData.ModelState.TryGetValue("Form.GhiChu", out var ghiChuState) && ghiChuState.Errors.Count > 0;
    var qrHasError = ViewData.ModelState.TryGetValue("Form.QRCode", out var qrState) && qrState.Errors.Count > 0;
    var imageHasError = ViewData.ModelState.TryGetValue("Form.NewImageFiles", out var imageState) && imageState.Errors.Count > 0;
    var summaryErrors = ViewData.ModelState.TryGetValue(string.Empty, out var summaryState)
        ? summaryState.Errors.Select(error => error.ErrorMessage).Where(message => !string.IsNullOrWhiteSpace(message)).ToArray()
        : [];

    var existingImages = Model.Form.ExistingImages
        .Where(image => !string.IsNullOrWhiteSpace(image.ImageUrl))
        .ToArray();
    var selectedExistingPrimaryUrl = !string.IsNullOrWhiteSpace(Model.Form.PrimaryImageSelection) &&
        Model.Form.PrimaryImageSelection.StartsWith("existing:", StringComparison.OrdinalIgnoreCase)
            ? Model.Form.PrimaryImageSelection["existing:".Length..].Trim()
            : null;
    var visibleExistingImages = existingImages
        .Where(image => !Model.Form.RemovedImageUrls.Contains(image.ImageUrl, StringComparer.OrdinalIgnoreCase))
        .ToArray();
    var imagePreviewUrl = visibleExistingImages.FirstOrDefault(image =>
            !string.IsNullOrWhiteSpace(selectedExistingPrimaryUrl)
                ? string.Equals(image.ImageUrl, selectedExistingPrimaryUrl, StringComparison.OrdinalIgnoreCase)
                : image.IsPrimary)
        ?.ImageUrl
        ?? visibleExistingImages.FirstOrDefault()?.ImageUrl
        ?? (visibleExistingImages.Length == 0 && Model.Form.RemovedImageUrls.Count == 0 && !string.IsNullOrWhiteSpace(Model.Form.ImageUrl)
            ? Model.Form.ImageUrl
            : null);
    var activeTab = imageHasError || string.Equals(Model.Form.ActiveTab, "hinh-anh", StringComparison.OrdinalIgnoreCase)
        ? "hinh-anh"
        : "thong-tin";
    var isDocumentRelated = Model.PopupMode == VatTuPopupMode.Edit && (Model.Form.PhieuNhapChiTietId.HasValue || Model.Form.PhieuXuatId.HasValue);
    var isInventoryLocked = Model.PopupMode == VatTuPopupMode.Edit && Model.Form.SoLuongTon <= 0 && !isDocumentRelated;
    var isRestrictedByDocument = isDocumentRelated && !isInventoryLocked;
    var lockIdentityFields = isInventoryLocked || isRestrictedByDocument;
    var imageInputSuffix = Model.Form.Id ?? 0;
    var tableColumnCount = 11;
    var groupedTableItems = Model.Items
        .GroupBy(item => new
        {
            Key = item.HangHoaId?.ToString() ?? $"empty:{item.TenHangHoa ?? string.Empty}",
            Name = string.IsNullOrWhiteSpace(item.TenHangHoa) ? "Chưa gắn hàng hóa" : item.TenHangHoa!,
            Code = item.MaHangHoa
        })
        .Select((group, index) => new
        {
            GroupId = $"hang-hoa-group-{index + 1}",
            Name = group.Key.Name,
            Code = group.Key.Code,
            ItemCount = group.Count(),
            TotalStock = group.Sum(item => item.SoLuongTon),
            UnitLabel = group.Select(item => !string.IsNullOrWhiteSpace(item.TenVietTatDonViTinh)
                    ? item.TenVietTatDonViTinh
                    : item.TenDonViTinh)
                .FirstOrDefault(label => !string.IsNullOrWhiteSpace(label)),
            Items = group.ToArray()
        })
        .ToArray();
}

<section class="master-data-page">
    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="floating-status-toast @Model.StatusType"
             data-status-toast
             role="status"
             aria-live="polite">
            <div class="floating-status-toast-icon" aria-hidden="true">
                <i class="fa-solid @(Model.StatusType == "success" ? "fa-circle-check" : Model.StatusType == "error" ? "fa-circle-exclamation" : "fa-circle-info")"></i>
            </div>
            <div class="floating-status-toast-body">
                <strong>@(Model.StatusType == "success" ? "Thành công" : Model.StatusType == "error" ? "Có lỗi xảy ra" : "Thông báo")</strong>
                <span>@Model.StatusMessage</span>
            </div>
            <button type="button" class="floating-status-toast-close" data-status-toast-close aria-label="Đóng thông báo">
                <span aria-hidden="true">×</span>
            </button>
        </div>
    }

    <article class="panel master-data-panel">
        <div class="panel-header master-data-header">
            <div>
                <h3>Danh sách vật tư</h3>
                <p>Quản lý chi tiết hàng hóa theo tồn kho, vị trí lưu, ảnh đại diện và thông tin QR.</p>
            </div>

            <div class="master-data-header-actions">
                <a class="master-data-add-button"
                   asp-action="Index"
                   asp-route-keyword="@Model.Filter.Keyword"
                   asp-route-page="@Model.CurrentPage"
                   asp-route-showCreatePopup="true">
                    <i class="fa-solid fa-plus" aria-hidden="true"></i>
                    <span>Thêm mới</span>
                </a>

                <button type="button"
                        class="secondary-button master-data-copy-button"
                        data-vat-tu-copy-open
                        disabled>
                    <i class="fa-regular fa-copy" aria-hidden="true"></i>
                    <span>Copy</span>
                    <span class="master-data-copy-count" data-vat-tu-selected-count>0</span>
                </button>
            </div>
        </div>

        <form method="get" asp-action="Index" class="master-data-filter-form vat-tu-filter-form">
            <label class="master-data-filter-field" for="keyword">
                <span>Tìm thông tin vật tư</span>
                <span class="login-input-shell">
                    <i class="fa-solid fa-cubes-stacked" aria-hidden="true"></i>
                    <input id="keyword"
                           name="keyword"
                           type="search"
                           value="@Model.Filter.Keyword"
                           placeholder="Khóa cửa ; tầng 1" />
                </span>
            </label>

            <div class="master-data-filter-actions">
                <button type="submit" class="primary-button master-data-filter-button">
                    <span class="button-content">
                        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                        <span>Tìm kiếm</span>
                    </span>
                    <span class="button-processing" aria-hidden="true">
                        <span class="button-processing-dot"></span>
                        <span class="button-processing-text">Đang xử lý</span>
                    </span>
                </button>

                <a class="secondary-button master-data-reset-button" asp-action="Index">Làm mới</a>
            </div>
        </form>

        <div class="master-data-summary">
            <div><strong>@Model.TotalCount</strong> vật tư</div>
            <div>Trang <strong>@Model.CurrentPage</strong>@(Model.TotalPages > 0 ? $" / {Model.TotalPages}" : "")</div>
        </div>

        <div class="table-wrap vat-tu-table-wrap is-temporarily-hidden" aria-label="Danh sách vật tư dạng lưới">
            <table class="data-table master-data-table vat-tu-table">
                <thead>
                    <tr>
                        <th class="selection-col">
                            <label class="login-checkbox vat-tu-selection-toggle" aria-label="Chọn tất cả vật tư trên trang">
                                <input type="checkbox" data-vat-tu-select-all @(Model.Items.Count == 0 ? "disabled" : null) />
                            </label>
                        </th>
                        <th class="hang-hoa-image-col">Ảnh</th>
                        <th class="vat-tu-qr-col">QR</th>
                        <th>Tên chi tiết</th>
                        <th>Hàng hóa</th>
                        <th>Tồn kho</th>
                        <th>Kho</th>
                        <th>Vị trí lưu kho</th>
                        <th>Phiếu nhập</th>
                        <th>Phiếu xuất</th>
                        <th class="actions-col">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="@tableColumnCount" class="master-data-empty">Chưa có vật tư phù hợp với điều kiện tìm kiếm.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var group in groupedTableItems)
                        {
                            var groupSummary = $"{group.ItemCount} vật tư";
                            if (!string.IsNullOrWhiteSpace(group.Code))
                            {
                                groupSummary += $" • {group.Code}";
                            }

                            groupSummary += $" • Tồn {group.TotalStock:0.##}{(!string.IsNullOrWhiteSpace(group.UnitLabel) ? $" {group.UnitLabel}" : string.Empty)}";

                            <tr class="vat-tu-group-row" data-vat-tu-group-row>
                                <td colspan="@tableColumnCount" class="vat-tu-group-cell">
                                    <button type="button"
                                            class="vat-tu-group-toggle"
                                            data-vat-tu-group-toggle
                                            data-vat-tu-group-id="@group.GroupId"
                                            aria-expanded="false">
                                        <span class="vat-tu-group-toggle-icon" aria-hidden="true">
                                            <i class="fa-solid fa-chevron-right"></i>
                                        </span>
                                        <span class="vat-tu-group-toggle-copy">
                                            <strong>@group.Name</strong>
                                            <span>@groupSummary</span>
                                        </span>
                                    </button>
                                </td>
                            </tr>

                            @foreach (var item in group.Items)
                            {
                                <tr class="vat-tu-table-row" data-vat-tu-selection-row data-vat-tu-id="@item.Id" data-vat-tu-group-body="@group.GroupId" hidden>
                                    <td class="selection-col">
                                        <label class="login-checkbox vat-tu-selection-toggle" aria-label="Chọn vật tư @item.TenChiTiet">
                                            <input type="checkbox" value="@item.Id" data-vat-tu-select-checkbox />
                                        </label>
                                    </td>
                                    <td class="hang-hoa-image-cell">
                                        <a class="hang-hoa-image-link"
                                           asp-action="Index"
                                           asp-route-keyword="@Model.Filter.Keyword"
                                           asp-route-page="@Model.CurrentPage"
                                           asp-route-editId="@item.Id"
                                           aria-label="Mở vật tư @item.TenChiTiet để chỉnh sửa">
                                            @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                            {
                                                <div class="hang-hoa-image-thumb">
                                                    <img src="@item.ImageUrl" alt="@item.TenChiTiet" loading="lazy" />
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="hang-hoa-image-thumb is-empty" aria-hidden="true">
                                                    <i class="fa-regular fa-image"></i>
                                                </div>
                                            }
                                        </a>
                                    </td>
                                    <td class="vat-tu-qr-col">
                                        @if (!string.IsNullOrWhiteSpace(item.QRCode))
                                        {
                                            <div class="hang-hoa-image-thumb">
                                                <img src="@Url.Action("QrPreview", "VatTu", new { value = item.QRCode })"
                                                     alt="QR vật tư @item.TenChiTiet"
                                                     loading="lazy" />
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <div class="master-data-name">@item.TenChiTiet</div>
                                    </td>
                                    <td>
                                        <div class="vat-tu-cell-stack">
                                            <strong>@(string.IsNullOrWhiteSpace(item.TenHangHoa) ? "-" : item.TenHangHoa)</strong>
                                            @if (!string.IsNullOrWhiteSpace(item.MaHangHoa))
                                            {
                                                <span>@item.MaHangHoa</span>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <div class="vat-tu-cell-stack">
                                            <strong>
                                                @item.SoLuongTon.ToString("0.##")
                                                @(string.IsNullOrWhiteSpace(item.TenVietTatDonViTinh)
                                                    ? (string.IsNullOrWhiteSpace(item.TenDonViTinh) ? string.Empty : $" {item.TenDonViTinh}")
                                                    : $" {item.TenVietTatDonViTinh}")
                                            </strong>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="vat-tu-cell-stack">
                                            <strong>@(string.IsNullOrWhiteSpace(item.TenKho) ? "-" : item.TenKho)</strong>
                                            @if (!string.IsNullOrWhiteSpace(item.MaKho))
                                            {
                                                <span>@item.MaKho</span>
                                            }
                                        </div>
                                    </td>
                                    <td>@(string.IsNullOrWhiteSpace(item.ViTriLuuKho) ? "-" : item.ViTriLuuKho)</td>
                                    <td>
                                        @if (item.PhieuNhapId.HasValue && !string.IsNullOrWhiteSpace(item.MaPhieuNhap))
                                        {
                                            <a class="table-action-link" asp-controller="NhapKho" asp-action="Index" asp-route-editId="@item.PhieuNhapId.Value">@item.MaPhieuNhap</a>
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.PhieuXuatId.HasValue && !string.IsNullOrWhiteSpace(item.MaPhieuXuat))
                                        {
                                            <a class="table-action-link" asp-controller="XuatKho" asp-action="Index" asp-route-editId="@item.PhieuXuatId.Value">@item.MaPhieuXuat</a>
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }
                                    </td>
                                    <td class="actions-col">
                                        <div class="master-data-actions">
                                            <a class="table-action-button edit"
                                               asp-action="Index"
                                               asp-route-keyword="@Model.Filter.Keyword"
                                               asp-route-page="@Model.CurrentPage"
                                               asp-route-editId="@item.Id">
                                                <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
                                                <span>Sửa</span>
                                            </a>

                                            <form method="post" asp-action="Delete" class="inline-action-form">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="Id" value="@item.Id" />
                                                <input type="hidden" name="Keyword" value="@Model.Filter.Keyword" />
                                                <input type="hidden" name="Page" value="@Model.CurrentPage" />
                                                <button type="submit"
                                                        class="table-action-button delete"
                                                        data-delete-confirm="Bạn có chắc muốn xóa vật tư này?">
                                                    <i class="fa-solid fa-trash-can" aria-hidden="true"></i>
                                                    <span>Xóa</span>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="vat-tu-block-list" aria-label="Danh sách vật tư dạng khối">
            @if (Model.Items.Count == 0)
            {
                <div class="master-data-empty vat-tu-block-empty">Chưa có vật tư phù hợp với điều kiện tìm kiếm.</div>
            }
            else
            {
                @foreach (var group in groupedTableItems)
                {
                    var mobileGroupId = $"{group.GroupId}-mobile";
                    var mobileGroupSummary = $"{group.ItemCount} vật tư";
                    if (!string.IsNullOrWhiteSpace(group.Code))
                    {
                        mobileGroupSummary += $" • {group.Code}";
                    }

                    mobileGroupSummary += $" • Tồn {group.TotalStock:0.##}{(!string.IsNullOrWhiteSpace(group.UnitLabel) ? $" {group.UnitLabel}" : string.Empty)}";

                    <section class="vat-tu-block-group">
                        <button type="button"
                                class="vat-tu-group-toggle vat-tu-group-toggle-mobile"
                                data-vat-tu-group-toggle
                                data-vat-tu-group-id="@mobileGroupId"
                                aria-expanded="false">
                            <span class="vat-tu-group-toggle-icon" aria-hidden="true">
                                <i class="fa-solid fa-chevron-right"></i>
                            </span>
                            <span class="vat-tu-group-toggle-copy">
                                <strong>@group.Name</strong>
                                <span>@mobileGroupSummary</span>
                            </span>
                        </button>

                        <div class="vat-tu-block-group-body" data-vat-tu-group-body="@mobileGroupId" hidden>
                            @foreach (var item in group.Items)
                            {
                                var statusClass = string.IsNullOrWhiteSpace(item.QRCode)
                                    ? "no-qr"
                                    : item.TrangThaiSuDung
                                        ? "active"
                                        : "locked";
                                var khoAndViTri = new[]
                                {
                                    string.IsNullOrWhiteSpace(item.TenKho) ? null : item.TenKho,
                                    string.IsNullOrWhiteSpace(item.ViTriLuuKho) ? null : item.ViTriLuuKho
                                }.Where(value => !string.IsNullOrWhiteSpace(value));

                                <article class="vat-tu-block-card" data-vat-tu-swipe data-vat-tu-select-card data-vat-tu-id="@item.Id">
                                    <div class="vat-tu-block-delete-slot">
                                        <form method="post" asp-action="Delete" class="inline-action-form">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="Id" value="@item.Id" />
                                            <input type="hidden" name="Keyword" value="@Model.Filter.Keyword" />
                                            <input type="hidden" name="Page" value="@Model.CurrentPage" />
                                            <button type="submit"
                                                    class="vat-tu-block-delete-button"
                                                    data-delete-confirm="Bạn có chắc muốn xóa vật tư này?"
                                                    aria-label="Xóa vật tư @item.TenChiTiet">
                                                <i class="fa-solid fa-trash-can" aria-hidden="true"></i>
                                                <span>Xóa</span>
                                            </button>
                                        </form>
                                    </div>

                                    <a class="vat-tu-block-surface"
                                       asp-action="Index"
                                       asp-route-keyword="@Model.Filter.Keyword"
                                       asp-route-page="@Model.CurrentPage"
                                       asp-route-editId="@item.Id"
                                       aria-label="Mở vật tư @item.TenChiTiet để chỉnh sửa"
                                       data-vat-tu-swipe-surface
                                       data-vat-tu-select-surface>
                                        <span class="vat-tu-block-selected-indicator" aria-hidden="true">
                                            <i class="fa-solid fa-check" aria-hidden="true"></i>
                                        </span>
                                        <span class="vat-tu-block-status-strip @statusClass" aria-hidden="true"></span>

                                        <span class="vat-tu-block-row">
                                            <span class="vat-tu-block-media">
                                                @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                                {
                                                    <img src="@item.ImageUrl" alt="@item.TenChiTiet" loading="lazy" draggable="false" />
                                                }
                                                else
                                                {
                                                    <span class="vat-tu-block-media-empty" aria-hidden="true">
                                                        <i class="fa-regular fa-image"></i>
                                                    </span>
                                                }
                                            </span>

                                            <span class="vat-tu-block-copy">
                                                <span class="vat-tu-block-product-name">@item.TenChiTiet</span>
                                                @if (khoAndViTri.Any())
                                                {
                                                    <span class="vat-tu-block-meta">@string.Join(" • ", khoAndViTri)</span>
                                                }
                                            </span>
                                        </span>
                                    </a>
                                </article>
                            }
                        </div>
                    </section>
                }
            }
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="pagination-bar" aria-label="Phân trang vật tư">
                <a class="pagination-button @(Model.CurrentPage <= 1 ? "disabled" : "")"
                   asp-action="Index"
                   asp-route-keyword="@Model.Filter.Keyword"
                   asp-route-page="@(Model.CurrentPage - 1)">
                    <i class="fa-solid fa-angle-left" aria-hidden="true"></i>
                    <span>Trước</span>
                </a>

                <div class="pagination-pages">
                    @foreach (var pageNumber in Model.VisiblePages)
                    {
                        <a class="pagination-page @(pageNumber == Model.CurrentPage ? "active" : "")"
                           asp-action="Index"
                           asp-route-keyword="@Model.Filter.Keyword"
                           asp-route-page="@pageNumber">
                            @pageNumber
                        </a>
                    }
                </div>

                <a class="pagination-button @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")"
                   asp-action="Index"
                   asp-route-keyword="@Model.Filter.Keyword"
                   asp-route-page="@(Model.CurrentPage + 1)">
                    <span>Sau</span>
                    <i class="fa-solid fa-angle-right" aria-hidden="true"></i>
                </a>
            </nav>
        }
    </article>
</section>

<div class="crud-modal-shell" data-vat-tu-copy-shell hidden>
    <div class="crud-modal-backdrop" aria-hidden="true" data-vat-tu-copy-close></div>

    <section class="crud-modal vat-tu-copy-modal" role="dialog" aria-modal="true" aria-labelledby="vat-tu-copy-title">
        <div class="crud-modal-header">
            <div class="crud-modal-heading">
                <h2 id="vat-tu-copy-title">Copy vật tư</h2>
                <p class="crud-modal-subtitle">Nhập số lượng bản sao cho mỗi vật tư đã chọn. Bản sao sẽ không bao gồm mã QR và hình ảnh.</p>
            </div>

            <button type="button"
                    class="menu-nav-button crud-close-button"
                    data-vat-tu-copy-close
                    aria-label="Đóng popup copy vật tư">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>

        <form method="post" asp-action="Copy" class="account-form crud-form" data-vat-tu-copy-form>
            @Html.AntiForgeryToken()
            <input type="hidden" name="SelectedIds" data-vat-tu-copy-selected-ids />
            <input type="hidden" name="Keyword" value="@Model.Filter.Keyword" />
            <input type="hidden" name="Page" value="@Model.CurrentPage" />

            <label class="login-field">
                <span>Số lượng copy</span>
                <span class="login-input-shell">
                    <i class="fa-regular fa-clone" aria-hidden="true"></i>
                    <input type="number"
                           name="CopyQuantity"
                           min="1"
                           step="1"
                           value="1"
                           inputmode="numeric"
                           data-vat-tu-copy-quantity />
                </span>
            </label>

            <div class="page-alert info vat-tu-copy-summary" data-vat-tu-copy-summary>
                <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
                <span>Chọn vật tư cần copy trước khi xác nhận.</span>
            </div>

            <div class="crud-modal-actions">
                <button type="button"
                        class="secondary-button crud-cancel-button"
                        data-vat-tu-copy-close>
                    Hủy
                </button>

                <button type="submit"
                        class="primary-button"
                        data-processing-button
                        data-processing-text="Đang copy">
                    <span class="button-content">
                        <i class="fa-regular fa-copy" aria-hidden="true"></i>
                        <span>Copy</span>
                    </span>
                    <span class="button-processing" aria-hidden="true">
                        <span class="button-processing-dot"></span>
                        <span class="button-processing-text">Đang copy</span>
                    </span>
                </button>
            </div>
        </form>
    </section>
</div>

@if (Model.IsPopupOpen)
{
    <div class="crud-modal-shell" data-crud-modal-shell>
        <div class="crud-modal-backdrop" aria-hidden="true"></div>

        <section class="crud-modal vat-tu-modal" role="dialog" aria-modal="true" aria-labelledby="vat-tu-modal-title">
            <div class="crud-modal-header">
                <div class="crud-modal-heading">
                    <h2 id="vat-tu-modal-title">@Model.PopupTitle</h2>
                    <p class="crud-modal-subtitle">Quản lý thông tin vật tư, liên kết hàng hóa, đơn vị tính, QR và thư viện hình ảnh.</p>
                </div>

                <a class="menu-nav-button crud-close-button"
                   data-crud-modal-close
                   aria-label="Đóng popup"
                   asp-action="Index"
                   asp-route-keyword="@Model.Filter.Keyword"
                   asp-route-page="@Model.CurrentPage">
                    <span aria-hidden="true">&times;</span>
                </a>
            </div>

            <form method="post" asp-action="@Model.SubmitAction" enctype="multipart/form-data" class="account-form crud-form">
                @Html.AntiForgeryToken()

                <input asp-for="Form.Id" type="hidden" />
                <input asp-for="Form.PhieuNhapChiTietId" type="hidden" />
                <input asp-for="Form.PhieuNhapId" type="hidden" />
                <input asp-for="Form.MaPhieuNhap" type="hidden" />
                <input asp-for="Form.PhieuXuatId" type="hidden" />
                <input asp-for="Form.MaPhieuXuat" type="hidden" />
                <input asp-for="Form.Keyword" type="hidden" />
                <input asp-for="Form.Page" type="hidden" />
                @if (lockIdentityFields)
                {
                    <input asp-for="Form.KhoId" type="hidden" />
                    <input asp-for="Form.HangHoaId" type="hidden" />
                    <input asp-for="Form.DonViTinhId" type="hidden" />
                    <input asp-for="Form.TenChiTiet" type="hidden" />
                    <input asp-for="Form.SoLuongTon" type="hidden" />
                    <input asp-for="Form.MaSoLo" type="hidden" />
                }
                <input asp-for="Form.ImageUrl" type="hidden" />
                <input asp-for="Form.PrimaryImageSelection" type="hidden" data-image-primary-input />
                @for (var imageIndex = 0; imageIndex < Model.Form.ExistingImages.Count; imageIndex++)
                {
                    <input type="hidden" name="Form.ExistingImages[@imageIndex].Id" value="@Model.Form.ExistingImages[imageIndex].Id" />
                    <input type="hidden" name="Form.ExistingImages[@imageIndex].ImageUrl" value="@Model.Form.ExistingImages[imageIndex].ImageUrl" />
                    <input type="hidden" name="Form.ExistingImages[@imageIndex].IsPrimary" value="@Model.Form.ExistingImages[imageIndex].IsPrimary.ToString().ToLowerInvariant()" />
                }
                <div data-image-removed-inputs>
                    @foreach (var removedImageUrl in Model.Form.RemovedImageUrls)
                    {
                        <input type="hidden" name="Form.RemovedImageUrls" value="@removedImageUrl" />
                    }
                </div>

                @if (summaryErrors.Length > 0)
                {
                    <div class="page-alert error validation-summary">
                        <i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i>
                        <div>
                            @foreach (var message in summaryErrors)
                            {
                                <div>@message</div>
                            }
                        </div>
                    </div>
                }

                @if (isInventoryLocked)
                {
                    <div class="page-alert info validation-summary">
                        <i class="fa-solid fa-lock" aria-hidden="true"></i>
                        <div>Vật tư đã hết tồn sau khi xuất kho. Thông tin chỉ được xem, không được xóa, đổi QR hoặc cập nhật.</div>
                    </div>
                }

                <div class="crud-tabs" data-tab-group>
                    <input asp-for="Form.ActiveTab" type="hidden" data-active-tab-input />

                    <div class="crud-tab-list" role="tablist" aria-label="Nhóm thông tin vật tư">
                        <button type="button"
                                class="crud-tab-button @(activeTab == "thong-tin" ? "is-active" : "")"
                                data-tab-button
                                data-tab="thong-tin"
                                role="tab"
                                aria-selected="@(activeTab == "thong-tin" ? "true" : "false")">
                            <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
                            <span>Thông tin</span>
                        </button>

                        <button type="button"
                                class="crud-tab-button @(activeTab == "hinh-anh" ? "is-active" : "")"
                                data-tab-button
                                data-tab="hinh-anh"
                                role="tab"
                                aria-selected="@(activeTab == "hinh-anh" ? "true" : "false")">
                            <i class="fa-regular fa-image" aria-hidden="true"></i>
                            <span>Hình ảnh</span>
                        </button>
                    </div>

                    <div class="crud-tab-panel @(activeTab == "thong-tin" ? "is-active" : "")"
                         data-tab-panel
                         data-tab="thong-tin"
                         role="tabpanel"
                         @(activeTab == "thong-tin" ? null : "hidden")>
                        <div class="account-form-grid vat-tu-info-grid">
                            <div class="login-field field-span-2 @(qrHasError ? "has-error" : "")">
                                <span>QR code</span>
                                <div class="qr-scanner-shell" data-qr-scanner>
                                    <div class="qr-scanner-layout">
                                        <div class="qr-scanner-main">
                                            <div class="qr-display-card @(string.IsNullOrWhiteSpace(Model.Form.QRCode) ? "is-empty" : "")" data-qr-summary>
                                                <div class="qr-display-default" data-qr-summary-default>
                                                    <div class="qr-display-icon">
                                                        <i class="fa-solid fa-expand" aria-hidden="true" data-qr-summary-icon></i>
                                                    </div>
                                                </div>
                                                <div class="qr-display-render @(string.IsNullOrWhiteSpace(Model.Form.QRCode) ? "is-hidden" : null)"
                                                     data-qr-render></div>
                                                <div class="qr-scanner-panel" data-qr-panel hidden>
                                                    <div class="qr-scanner-reader" data-qr-reader></div>
                                                    <div class="qr-scanner-frame" aria-hidden="true"></div>
                                                </div>
                                            </div>

                                            <input asp-for="Form.QRCode" type="hidden" data-qr-result />
                                            <span class="login-input-shell readonly-shell qr-result-shell @(string.IsNullOrWhiteSpace(Model.Form.QRCode) ? "is-hidden" : null)"
                                                  data-qr-result-shell>
                                                <i class="fa-solid fa-qrcode" aria-hidden="true"></i>
                                                <span data-qr-result-display>@Model.Form.QRCode</span>
                                            </span>
                                        </div>

                                        <div class="qr-scanner-side">
                                            <div class="qr-scanner-actions @(isInventoryLocked ? "is-hidden" : null)">
                                                <button type="button" class="secondary-button qr-scanner-button" data-qr-start>
                                                    <i class="fa-solid fa-camera" aria-hidden="true"></i>
                                                    <span>Quét camera</span>
                                                </button>
                                                <div class="qr-camera-select-shell" data-qr-camera-shell hidden>
                                                    <span class="login-input-shell select-shell">
                                                        <i class="fa-solid fa-camera-rotate" aria-hidden="true"></i>
                                                        <select data-qr-camera></select>
                                                        <span class="select-indicator"><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></span>
                                                    </span>
                                                </div>
                                                <label class="secondary-button qr-scanner-button qr-file-button" for="qrImageFile-@imageInputSuffix">
                                                    <i class="fa-regular fa-image" aria-hidden="true"></i>
                                                    <span>Quét từ ảnh</span>
                                                </label>
                                                <button type="button" class="secondary-button qr-scanner-button" data-qr-stop hidden>
                                                    <i class="fa-solid fa-stop" aria-hidden="true"></i>
                                                    <span>Dừng quét</span>
                                                </button>
                                                <button type="button" class="secondary-button qr-scanner-button" data-qr-clear>
                                                    <i class="fa-solid fa-eraser" aria-hidden="true"></i>
                                                    <span>Xóa mã</span>
                                                </button>
                                                <input type="file"
                                                       id="qrImageFile-@imageInputSuffix"
                                                       accept="image/*"
                                                       hidden
                                                       data-qr-file />
                                            </div>

                                            <div class="qr-scanner-status" data-qr-status>
                                                Sẵn sàng quét QR bằng camera.
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <span asp-validation-for="Form.QRCode" class="login-field-error"></span>
                            </div>

                            <label class="login-field @(khoHasError ? "has-error" : "")">
                                <span>Kho</span>
                                <span class="login-input-shell select-shell">
                                    <i class="fa-solid fa-warehouse" aria-hidden="true"></i>
                                    <select asp-for="Form.KhoId" disabled="@(lockIdentityFields ? "disabled" : null)">
                                        <option value="">Chọn kho</option>
                                        @foreach (var option in Model.KhoOptions)
                                        {
                                            if (Model.Form.KhoId == option.Id)
                                            {
                                                <option value="@option.Id" selected>@option.Label</option>
                                            }
                                            else
                                            {
                                                <option value="@option.Id">@option.Label</option>
                                            }
                                        }
                                    </select>
                                    <span class="select-indicator"><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></span>
                                </span>
                                <span asp-validation-for="Form.KhoId" class="login-field-error"></span>
                            </label>

                            <label class="login-field @(hangHoaHasError ? "has-error" : "")">
                                <span>Hàng hóa</span>
                                <span class="login-input-shell select-shell">
                                    <i class="fa-solid fa-box-open" aria-hidden="true"></i>
                                    <select asp-for="Form.HangHoaId" disabled="@(lockIdentityFields ? "disabled" : null)">
                                        <option value="">Chọn hàng hóa</option>
                                        @foreach (var option in Model.HangHoaOptions)
                                        {
                                            if (Model.Form.HangHoaId == option.Id)
                                            {
                                                <option value="@option.Id" selected>@option.Label</option>
                                            }
                                            else
                                            {
                                                <option value="@option.Id">@option.Label</option>
                                            }
                                        }
                                    </select>
                                    <span class="select-indicator"><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></span>
                                </span>
                                <span asp-validation-for="Form.HangHoaId" class="login-field-error"></span>
                            </label>

                            <label class="login-field">
                                <span>Phiếu nhập</span>
                                <span class="login-input-shell readonly-shell">
                                    <i class="fa-solid fa-file-import" aria-hidden="true"></i>
                                    @if (Model.Form.PhieuNhapId.HasValue && !string.IsNullOrWhiteSpace(Model.Form.MaPhieuNhap))
                                    {
                                        <span class="readonly-link-group">
                                            <a class="table-action-link"
                                               asp-controller="NhapKho"
                                               asp-action="Index"
                                               asp-route-editId="@Model.Form.PhieuNhapId.Value">@Model.Form.MaPhieuNhap</a>
                                            <button type="button"
                                                    class="login-input-action"
                                                    data-copy-to-clipboard
                                                    data-copy-value="@Model.Form.MaPhieuNhap"
                                                    data-copy-title="Đã copy mã phiếu"
                                                    data-copy-message="@Model.Form.MaPhieuNhap"
                                                    aria-label="Copy mã phiếu nhập">
                                                <i class="fa-regular fa-copy" aria-hidden="true"></i>
                                            </button>
                                        </span>
                                    }
                                    else
                                    {
                                        <input value="-" readonly tabindex="-1" />
                                    }
                                </span>
                            </label>

                            <label class="login-field">
                                <span>Phiếu xuất</span>
                                <span class="login-input-shell readonly-shell">
                                    <i class="fa-solid fa-file-export" aria-hidden="true"></i>
                                    @if (Model.Form.PhieuXuatId.HasValue && !string.IsNullOrWhiteSpace(Model.Form.MaPhieuXuat))
                                    {
                                        <a class="table-action-link" asp-controller="XuatKho" asp-action="Index" asp-route-editId="@Model.Form.PhieuXuatId.Value">@Model.Form.MaPhieuXuat</a>
                                    }
                                    else
                                    {
                                        <input value="-" readonly tabindex="-1" />
                                    }
                                </span>
                            </label>

                            <label class="login-field @(donViTinhHasError ? "has-error" : "")">
                                <span>Đơn vị tính</span>
                                <span class="login-input-shell select-shell">
                                    <i class="fa-solid fa-ruler-combined" aria-hidden="true"></i>
                                    <select asp-for="Form.DonViTinhId" disabled="@(lockIdentityFields ? "disabled" : null)">
                                        <option value="">Chọn đơn vị tính</option>
                                        @foreach (var option in Model.DonViTinhOptions)
                                        {
                                            if (Model.Form.DonViTinhId == option.Id)
                                            {
                                                <option value="@option.Id" selected>@option.Label</option>
                                            }
                                            else
                                            {
                                                <option value="@option.Id">@option.Label</option>
                                            }
                                        }
                                    </select>
                                    <span class="select-indicator"><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></span>
                                </span>
                                <span asp-validation-for="Form.DonViTinhId" class="login-field-error"></span>
                            </label>

                            <label class="login-field @(tenChiTietHasError ? "has-error" : "")">
                                <span>Tên chi tiết</span>
                                <span class="login-input-shell">
                                    <i class="fa-solid fa-cubes" aria-hidden="true"></i>
                                    <input asp-for="Form.TenChiTiet" autocomplete="off" autofocus readonly="@(lockIdentityFields ? "readonly" : null)" />
                                </span>
                                <span asp-validation-for="Form.TenChiTiet" class="login-field-error"></span>
                            </label>

                            <label class="login-field @(soLuongTonHasError ? "has-error" : "")">
                                <span>Số lượng tồn</span>
                                <span class="login-input-shell">
                                    <i class="fa-solid fa-warehouse" aria-hidden="true"></i>
                                    <input asp-for="Form.SoLuongTon" type="number" step="0.01" min="0.01" inputmode="decimal" readonly="@(lockIdentityFields ? "readonly" : null)" />
                                </span>
                                <span asp-validation-for="Form.SoLuongTon" class="login-field-error"></span>
                            </label>

                            <div class="login-field">
                                <span>Trạng thái sử dụng</span>
                                <span class="switch-field-shell">
                                    <span class="switch-field-icon">
                                        <i class="fa-solid fa-toggle-on" aria-hidden="true"></i>
                                    </span>
                                    <label class="status-switch">
                                        <input asp-for="Form.TrangThaiSuDung" class="status-switch-input" disabled="@(isInventoryLocked ? "disabled" : null)" />
                                        <span class="status-switch-track">
                                            <span class="status-switch-thumb"></span>
                                        </span>
                                        <span class="status-switch-labels" aria-hidden="true">
                                            <span>Khóa</span>
                                            <span>Kích hoạt</span>
                                        </span>
                                    </label>
                                </span>
                            </div>

                            <label class="login-field @(maSoLoHasError ? "has-error" : "")">
                                <span>Mã số lô</span>
                                <span class="login-input-shell">
                                    <i class="fa-solid fa-barcode" aria-hidden="true"></i>
                                    <input asp-for="Form.MaSoLo" autocomplete="off" readonly="@(lockIdentityFields ? "readonly" : null)" />
                                </span>
                                <span asp-validation-for="Form.MaSoLo" class="login-field-error"></span>
                            </label>

                            <label class="login-field field-span-2 @(viTriLuuKhoHasError ? "has-error" : "")">
                                <span>Vị trí lưu kho</span>
                                <span class="login-input-shell">
                                    <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
                                    <input asp-for="Form.ViTriLuuKho" autocomplete="off" readonly="@(isInventoryLocked ? "readonly" : null)" />
                                </span>
                                <span asp-validation-for="Form.ViTriLuuKho" class="login-field-error"></span>
                            </label>

                            <label class="login-field field-span-2 @(ghiChuHasError ? "has-error" : "")">
                                <span>Ghi chú</span>
                                <span class="login-textarea-shell">
                                    <i class="fa-regular fa-note-sticky" aria-hidden="true"></i>
                                    <textarea asp-for="Form.GhiChu" rows="4" readonly="@(isInventoryLocked ? "readonly" : null)" placeholder="Thêm ghi chú về lô hàng, tình trạng hoặc cách lưu kho..."></textarea>
                                </span>
                                <span asp-validation-for="Form.GhiChu" class="login-field-error"></span>
                            </label>
                        </div>
                    </div>

                    <div class="crud-tab-panel @(activeTab == "hinh-anh" ? "is-active" : "")"
                         data-tab-panel
                         data-tab="hinh-anh"
                         role="tabpanel"
                         @(activeTab == "hinh-anh" ? null : "hidden")>
                        <div class="vat-tu-image-tab-panel">
                            <div class="login-field field-span-2 @(imageHasError ? "has-error" : "")">
                                <span>Thư viện hình ảnh</span>
                                <div class="vat-tu-image-manager" data-image-manager-v2>
                                    <div class="vat-tu-image-manager-head">
                                        <div class="image-upload-preview vat-tu-image-tab-preview">
                                            <img src="@imagePreviewUrl"
                                                 alt="Ảnh đại diện vật tư"
                                                 class="@(string.IsNullOrWhiteSpace(imagePreviewUrl) ? "is-hidden" : null)"
                                                 data-image-primary-preview />
                                            <div class="image-upload-fallback @(string.IsNullOrWhiteSpace(imagePreviewUrl) ? null : "is-hidden")"
                                                 data-image-primary-empty>
                                                <i class="fa-regular fa-image" aria-hidden="true"></i>
                                                <span>Chưa có ảnh vật tư</span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="vat-tu-image-action-grid @(lockIdentityFields ? "is-hidden" : null)">
                                        <label class="secondary-button image-upload-button" for="vatTuImageLibrary-@imageInputSuffix">
                                            <i class="fa-regular fa-images" aria-hidden="true"></i>
                                            <span>Thêm từ máy / thư viện</span>
                                        </label>
                                        <label class="secondary-button image-upload-button" for="vatTuImageCamera-@imageInputSuffix">
                                            <i class="fa-solid fa-camera" aria-hidden="true"></i>
                                            <span>Chụp hình</span>
                                        </label>
                                    </div>

                                    <div class="vat-tu-image-grid" data-image-gallery>
                                        @foreach (var image in visibleExistingImages)
                                        {
                                            var isPrimaryImage = !string.IsNullOrWhiteSpace(selectedExistingPrimaryUrl)
                                                ? string.Equals(image.ImageUrl, selectedExistingPrimaryUrl, StringComparison.OrdinalIgnoreCase)
                                                : image.IsPrimary;
                                            <article class="vat-tu-image-card @(isPrimaryImage ? "is-primary" : null)"
                                                     data-image-item
                                                     data-image-existing
                                                     data-image-selection="existing:@image.ImageUrl"
                                                     data-image-url="@image.ImageUrl">
                                                <img src="@image.ImageUrl" alt="Ảnh vật tư" loading="lazy" />
                                                <div class="vat-tu-image-card-tools @(lockIdentityFields ? "is-hidden" : null)">
                                                    <button type="button"
                                                            class="vat-tu-image-primary-toggle @(isPrimaryImage ? "is-active" : null)"
                                                            data-image-make-primary
                                                            data-image-action
                                                            aria-label="Chọn làm ảnh đại diện"
                                                            title="Chọn làm ảnh đại diện">
                                                        <i class="fa-solid fa-check" aria-hidden="true"></i>
                                                    </button>
                                                </div>
                                                <div class="vat-tu-image-card-footer">
                                                    <span class="vat-tu-image-badge">@(isPrimaryImage ? "Ảnh đại diện" : "Đã lưu")</span>
                                                    <button type="button"
                                                            class="vat-tu-image-remove"
                                                            data-image-remove-existing
                                                            data-image-action
                                                            disabled="@(lockIdentityFields ? "disabled" : null)"
                                                            aria-label="Xóa ảnh này">
                                                        <i class="fa-solid fa-trash-can" aria-hidden="true"></i>
                                                    </button>
                                                </div>
                                            </article>
                                        }
                                    </div>

                                    <div class="vat-tu-image-empty @(visibleExistingImages.Length == 0 ? null : "is-hidden")"
                                         data-image-empty>
                                        <i class="fa-regular fa-image" aria-hidden="true"></i>
                                        <span>Chưa có ảnh nào trong thư viện vật tư.</span>
                                    </div>

                                    <input type="file"
                                           id="vatTuImageLibrary-@imageInputSuffix"
                                           accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                                           multiple
                                           class="image-upload-input"
                                           data-image-source="library" />
                                    <input type="file"
                                           id="vatTuImageCamera-@imageInputSuffix"
                                           accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                                           capture="environment"
                                           class="image-upload-input"
                                           data-image-source="camera" />
                                    <input type="file"
                                           id="vatTuImageFiles-@imageInputSuffix"
                                           name="Form.NewImageFiles"
                                           accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                                           multiple
                                           hidden
                                           data-image-master />

                                    <div class="vat-tu-image-viewer" data-image-viewer hidden>
                                        <div class="vat-tu-image-viewer-backdrop" data-image-viewer-close></div>
                                        <div class="vat-tu-image-viewer-dialog" role="dialog" aria-modal="true" aria-label="Xem hình ảnh">
                                            <div class="vat-tu-image-viewer-toolbar">
                                                <button type="button" class="vat-tu-image-viewer-button" data-image-zoom-out aria-label="Thu nhỏ">
                                                    <i class="fa-solid fa-magnifying-glass-minus" aria-hidden="true"></i>
                                                </button>
                                                <button type="button" class="vat-tu-image-viewer-button" data-image-zoom-in aria-label="Phóng to">
                                                    <i class="fa-solid fa-magnifying-glass-plus" aria-hidden="true"></i>
                                                </button>
                                                <button type="button" class="vat-tu-image-viewer-button" data-image-rotate-left aria-label="Xoay trái">
                                                    <i class="fa-solid fa-rotate-left" aria-hidden="true"></i>
                                                </button>
                                                <button type="button" class="vat-tu-image-viewer-button" data-image-rotate-right aria-label="Xoay phải">
                                                    <i class="fa-solid fa-rotate-right" aria-hidden="true"></i>
                                                </button>
                                                <button type="button" class="vat-tu-image-viewer-button" data-image-reset-view aria-label="Khôi phục">
                                                    <i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i>
                                                </button>
                                                <button type="button" class="vat-tu-image-viewer-button is-close" data-image-viewer-close aria-label="Đóng">
                                                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                                                </button>
                                            </div>
                                            <div class="vat-tu-image-viewer-stage">
                                                <img src="" alt="Xem to hình ảnh vật tư" data-image-viewer-content />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <span asp-validation-for="Form.NewImageFiles" class="login-field-error"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="crud-modal-actions">
                    <a class="secondary-button crud-cancel-button"
                       asp-action="Index"
                       asp-route-keyword="@Model.Filter.Keyword"
                       asp-route-page="@Model.CurrentPage">
                        Hủy
                    </a>

                    @if (!isInventoryLocked)
                    {
                        <button type="submit" class="primary-button" data-processing-button data-processing-text="Đang lưu">
                            <span class="button-content">
                                <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i>
                                <span>@(Model.PopupMode == VatTuPopupMode.Edit ? "Lưu cập nhật" : "Thêm mới")</span>
                            </span>
                            <span class="button-processing" aria-hidden="true">
                                <span class="button-processing-dot"></span>
                                <span class="button-processing-text">Đang lưu</span>
                            </span>
                        </button>
                    }
                </div>
            </form>
        </section>
    </div>
}
